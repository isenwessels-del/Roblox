      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">ProfileSchema</string>
          <string name="Source"><![CDATA[-- Ownership belongs to the canonical per-house ledger, never to this profile.
-- Fail closed on malformed saved values, including serialized economy intents.
local Config = require(script.Parent.Config)
local Schema = { Version = 2 }

local function number(value, minimum, maximum, integer)
	return type(value) == "number" and value == value and value ~= math.huge
		and value ~= -math.huge and value >= minimum and value <= maximum
		and (not integer or value == math.floor(value))
end

local function identifier(value)
	return type(value) == "string" and #value >= 1 and #value <= 100
		and string.match(value, "^[%w_%-:]+$") ~= nil
end

local function fields(value, allowed)
	if type(value) ~= "table" or getmetatable(value) ~= nil then return false end
	for key in pairs(value) do
		if type(key) ~= "string" or not allowed[key] then return false end
	end
	return true
end

local profileFields = {
	Version = true, HasStarter = true, Cash = true, Bank = true, Rebirths = true,
	BaseLevel = true, TreadmillLevel = true, SpeedXP = true, SecurityLevel = true,
	Collection = true, Statistics = true, Income = true, Settings = true,
	LastSeen = true, DailyDay = true, DailyStreak = true, Pending = true, CreatedAt = true,
}
local statisticFields = { Bought = true, Stolen = true, Defended = true, TotalEarned = true, TotalSpent = true }
local settingFields = { Music = true, SFX = true, ReducedEffects = true }
local pendingFields = {
	Kind = true, Id = true, DefinitionId = true, Variant = true, Size = true, Slot = true,
	Price = true, OperationId = true, CreatedAt = true, ExpectedRevision = true,
}

local function pendingValid(pending)
	if pending == nil then return true end
	if not fields(pending, pendingFields) or not identifier(pending.Id)
		or not identifier(pending.OperationId) or not number(pending.CreatedAt, 0, 1e12, true) then return false end
	if pending.Kind ~= "Buy" and pending.Kind ~= "Sell" and pending.Kind ~= "Starter"
		and pending.Kind ~= "Wild" then return false end
	if pending.DefinitionId ~= nil and not Config.HouseById[pending.DefinitionId] then return false end
	if pending.Variant ~= nil and not Config.VariantById[pending.Variant] then return false end
	if pending.Size ~= nil and not Config.SizeById[pending.Size] then return false end
	if pending.Slot ~= nil and not number(pending.Slot, 1, Config.Game.MaxSlots, true) then return false end
	if pending.Price ~= nil and not number(pending.Price, 0, Config.Game.MaxCash, false) then return false end
	if pending.ExpectedRevision ~= nil and not number(pending.ExpectedRevision, 0, 1e12, true) then return false end
	if pending.Kind == "Sell" then
		return pending.Price ~= nil and number(pending.ExpectedRevision, 1, 1e12 - 1, true)
	end
	if pending.DefinitionId == nil or pending.Variant == nil or pending.Size == nil or pending.Slot == nil then return false end
	if pending.Kind == "Buy" then return pending.Price ~= nil end
	return pending.Price == nil or pending.Price == 0
end

function Schema.New(now)
	now = now or os.time()
	assert(number(now, 0, 1e12, true), "Invalid profile creation time")
	return {
		Version = Schema.Version, HasStarter = false, Cash = Config.Game.StartingCash, Bank = 0,
		Rebirths = 0, BaseLevel = 1, TreadmillLevel = 1, SpeedXP = 0, SecurityLevel = 1,
		Collection = {}, Statistics = { Bought = 0, Stolen = 0, Defended = 0, TotalEarned = 0, TotalSpent = 0 },
		Income = {}, Settings = { Music = true, SFX = true, ReducedEffects = false },
		LastSeen = now, DailyDay = -1, DailyStreak = 0, CreatedAt = now,
	}
end

function Schema.Validate(profile)
	if not fields(profile, profileFields) or profile.Version ~= Schema.Version
		or type(profile.HasStarter) ~= "boolean"
		or not number(profile.Cash, 0, Config.Game.MaxCash, false)
		or not number(profile.Bank, 0, Config.Game.IncomeCap, false)
		or not number(profile.Rebirths, 0, 0, true)
		or not number(profile.BaseLevel, 1, #Config.Bases, true)
		or not number(profile.TreadmillLevel, 1, #Config.Treadmills, true)
		or not number(profile.SpeedXP, 0, 1e12, false)
		or not number(profile.SecurityLevel, 1, #Config.Security, true)
		or not number(profile.LastSeen, 0, 1e12, true)
		or not number(profile.CreatedAt, 0, 1e12, true)
		or not number(profile.DailyDay, -1, 1e8, true)
		or not number(profile.DailyStreak, 0, #Config.DailyRewards, true)
		or not pendingValid(profile.Pending) then return false end
	if not fields(profile.Statistics, statisticFields) or not fields(profile.Settings, settingFields)
		or type(profile.Collection) ~= "table" or getmetatable(profile.Collection) ~= nil
		or type(profile.Income) ~= "table" or getmetatable(profile.Income) ~= nil then return false end
	for name in pairs(statisticFields) do
		local counter = name == "Bought" or name == "Stolen" or name == "Defended"
		if not number(profile.Statistics[name], 0, 1e15, counter) then return false end
	end
	for name in pairs(settingFields) do if type(profile.Settings[name]) ~= "boolean" then return false end end
	local collections = 0
	for id, collected in pairs(profile.Collection) do
		collections += 1
		if not Config.HouseById[id] or collected ~= true or collections > #Config.Houses then return false end
	end
	local incomes = 0
	for id, value in pairs(profile.Income) do
		incomes += 1
		if not identifier(id) or not number(value, 0, Config.Game.IncomeCap, false)
			or incomes > 100 then return false end
	end
	return true
end

function Schema.Clone(profile)
	assert(Schema.Validate(profile), "Invalid profile")
	local function copy(value)
		if type(value) ~= "table" then return value end
		local result = {}
		for key, item in pairs(value) do result[key] = copy(item) end
		return result
	end
	return copy(profile)
end

function Schema.Migrate(raw, now)
	if type(raw) ~= "table" then return nil, "InvalidProfile" end
	-- This game has its own namespace; old furniture-game profiles are rejected.
	if raw.Version ~= Schema.Version then return nil, "UnsupportedProfileVersion" end
	if not Schema.Validate(raw) then return nil, "InvalidProfile" end
	return Schema.Clone(raw)
end

return Schema
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="5">
        <Properties>
          <string name="Name">Utilities</string>
        </Properties>
        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">TableUtils</string>
            <string name="Source"><![CDATA[--!strict
local TableUtils = {}
function TableUtils.Clone(value: any, seen: any?): any
    if type(value) ~= "table" then return value end
    local visited = seen or {}
    if visited[value] then return visited[value] end
    local copy = {}
    visited[value] = copy
    for key, child in pairs(value) do copy[TableUtils.Clone(key, visited)] = TableUtils.Clone(child, visited) end
    return copy
end
function TableUtils.Reconcile(value: any, defaults: any): any
    for key, default in pairs(defaults) do
        if value[key] == nil then value[key] = TableUtils.Clone(default)
        elseif type(default) == "table" and type(value[key]) == "table" then
            TableUtils.Reconcile(value[key], default)
        end
    end
    return value
end
function TableUtils.Count(value: any): number
    local count = 0
    for _ in pairs(value) do count += 1 end
    return count
end
return TableUtils
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">Validation</string>
            <string name="Source"><![CDATA[--!strict
local Validation = {}
function Validation.Finite(value: any): boolean
    return type(value) == "number" and value == value and math.abs(value) < math.huge
end
function Validation.Integer(value: any, minimum: number?, maximum: number?): boolean
    return Validation.Finite(value) and value % 1 == 0
        and (minimum == nil or value >= minimum) and (maximum == nil or value <= maximum)
end
function Validation.Id(value: any, maxLength: number?): boolean
    return type(value) == "string" and #value > 0 and #value <= (maxLength or 128)
        and string.match(value, "^[%w_%-:]+$") ~= nil
end
function Validation.String(value: any, maxLength: number): boolean
    return type(value) == "string" and #value <= maxLength
end
function Validation.Placement(x: any, z: any, rotation: any, size: any,
    width: number, depth: number, gridSize: number?): (boolean, string?)
    if not Validation.Finite(x) or not Validation.Finite(z)
        or not Validation.Integer(rotation, 0, 270) or rotation % 90 ~= 0 then
        return false, "Placement must use finite coordinates and 90-degree rotations."
    end
    local grid = gridSize or 3
    if grid <= 0 or not Validation.Finite(grid) then return false, "Invalid grid." end
    if math.abs(x / grid - math.round(x / grid)) > 1e-5
        or math.abs(z / grid - math.round(z / grid)) > 1e-5 then
        return false, "Place on the furniture grid."
    end
    local sx, sz = size.X, size.Z
    if rotation % 180 ~= 0 then sx, sz = sz, sx end
    if math.abs(x) + sx / 2 > width / 2 - 1 or math.abs(z) + sz / 2 > depth / 2 - 1 then
        return false, "Furniture must fit inside the house."
    end
    return true, nil
end
function Validation.Overlaps(a: any, b: any, aSize: any, bSize: any): boolean
    local ax, az = aSize.X, aSize.Z
    local bx, bz = bSize.X, bSize.Z
    if a.Rotation % 180 ~= 0 then ax, az = az, ax end
    if b.Rotation % 180 ~= 0 then bx, bz = bz, bx end
    return math.abs(a.X - b.X) < (ax + bx) / 2 - 0.05
        and math.abs(a.Z - b.Z) < (az + bz) / 2 - 0.05
end
Validation.IsFinite = Validation.Finite
Validation.IsId = Validation.Id
return Validation
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="8">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="9">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- One bootstrap; gameplay, persistence, presentation, and defense stay modular.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local shared = ReplicatedStorage:WaitForChild("Shared")
local ctx = {
    Config = require(shared.Config), Schema = require(shared.ProfileSchema),
    Validation = require(shared.Utilities.Validation), Players = Players,
    ReplicatedStorage = ReplicatedStorage, Workspace = workspace,
    HttpService = game:GetService("HttpService"), Clock = os.time, Now = os.clock,
    Ready = {}, Closing = false,
}
local function construct(name) return require(script:WaitForChild(name)).new(ctx) end
ctx.Notify = function(player, text, kind, extra)
    if ctx.Remotes and player.Parent == Players then ctx.Remotes.Notification:FireClient(player, text, kind or "Info", extra) end
end
ctx.Announce = function(text) if ctx.Remotes then ctx.Remotes.Announcement:FireAllClients(text) end end
ctx.Request = function(player, action, ...) if ctx.Network then ctx.Network:Request(player, action, ...) end end
local publishing = {}
local function standings()
    local rows = {}
    for _, player in ipairs(Players:GetPlayers()) do
        local profile = ctx.Data:Get(player)
        if profile and ctx.Ready[player] then
            local income = 0
            for _, record in ipairs(ctx.Houses:List(player)) do
                if record.BuildReadyAt <= ctx.Clock() and not ctx.Steal:IsHeld(record.Id) then income += ctx.Houses:Rate(record) end
            end
            table.insert(rows, { Name = player.DisplayName, UserId = player.UserId,
                Cash = profile.Cash, Income = income, Rebirths = 0 })
        end
    end
    table.sort(rows, function(a, b) return a.Income > b.Income end)
    return rows
end
ctx.Publish = function(player)
    if not ctx.Remotes or not ctx.Ready[player] or publishing[player] or player.Parent ~= Players then return end
    local profile, plot = ctx.Data:Get(player), ctx.World:GetPlot(player)
    if not profile or not plot then return end
    publishing[player] = true
    local status = ctx.Data:GetStatus(player)
    publishing[player] = nil
    local houses, rate = {}, 0
    for _, record in ipairs(ctx.Houses:List(player)) do
        local building = record.BuildReadyAt > ctx.Clock()
        if not building and not ctx.Steal:IsHeld(record.Id) then rate += ctx.Houses:Rate(record) end
        table.insert(houses, { Id = record.Id, DefinitionId = record.DefinitionId, Variant = record.Variant,
            Size = record.Size, Slot = record.Slot, Income = profile.Income[record.Id] or 0,
            Building = building, BuildRemaining = math.max(0, record.BuildReadyAt - ctx.Clock()) })
    end
    local market = {}
    for _, definition in ipairs(ctx.Config.Houses) do
        table.insert(market, { Id = definition.Id, DefinitionId = definition.Id, Variant = "Normal",
            Size = "Normal", Price = definition.Price, Income = definition.Income })
    end
    local carrier, lock = ctx.Steal.Carriers[player], ctx.Progression.Locks[player]
    local carry, hold
    if carrier then
        local name = ctx.Config.HouseById[carrier.Record.DefinitionId].Name
        if carrier.Phase == "Hold" then
            hold = { Name = name, Progress = math.clamp((ctx.Now() - carrier.StartedAt) / ctx.Config.Game.StealHoldSeconds, 0, 1) }
        else carry = { Name = name, Id = carrier.Id,
            SecondsRemaining = math.max(0, ctx.Config.Game.CarryTimeoutSeconds - (ctx.Now() - carrier.CarriedAt)),
            Committing = carrier.Phase == "Committing" } end
    end
    local speedLevel = math.floor(math.sqrt(profile.SpeedXP / 20))
    ctx.Remotes.Snapshot:FireClient(player, {
        Profile = ctx.Schema.Clone(profile), Houses = houses, Market = market, Standings = standings(), ServerTime = ctx.Clock(),
        Runtime = { DataMode = status.Mode, Writable = status.Writable, PlotId = plot.Id,
            Slots = ctx.Houses:Capacity(player), Multiplier = 1, IncomePerSecond = rate,
            LockRemaining = lock and math.max(0, lock.Until - ctx.Now()) or 0,
            LockCooldown = lock and math.max(0, lock.CooldownUntil - ctx.Now()) or 0,
            Carry = carry, StealHold = hold, Training = ctx.Progression.Training[player] == true,
            Speed = ctx.Progression:Speed(player), SpeedXP = profile.SpeedXP,
            TrainingRate = ctx.Config.Treadmills[profile.TreadmillLevel].Rate, NextSpeedXP = (speedLevel + 1) ^ 2 * 20,
            BaseLevel = profile.BaseLevel, TreadmillLevel = profile.TreadmillLevel,
            NextBase = ctx.Config.Bases[profile.BaseLevel + 1], NextTreadmill = ctx.Config.Treadmills[profile.TreadmillLevel + 1],
            NextSecurity = ctx.Config.Security[profile.SecurityLevel + 1], AtHome = ctx.World:AtHome(player),
        },
    })
end
ctx.Data = construct("DataService")
ctx.AntiExploit = construct("AntiExploitService")
ctx.Ownership = construct("OwnershipService")
ctx.World = construct("WorldService")
ctx.Houses = construct("HouseService")
ctx.Progression = construct("ProgressionService")
ctx.Wild = construct("WildHouseService")
ctx.Steal = construct("StealService")
ctx.Guards = construct("GuardService")
ctx.Network = construct("NetworkService")
ctx.Remotes = ctx.Network.Remotes
ctx.World:Init()
ctx.Wild:Start()
ctx.PlayerService = construct("PlayerService")
ctx.BeforeDataRelease = function(player) ctx.PlayerService:Cleanup(player) end
ctx.BeforeDataClose = function()
    ctx.Closing = true
    for _, player in ipairs(Players:GetPlayers()) do ctx.Steal:Release(player); ctx.Progression:Train(player, false) end
    ctx.Guards:Shutdown()
end
ctx.Data:Start()
ctx.PlayerService:Start()
local errors = {}
local function safe(name, callback)
    local ok, err = pcall(callback)
    if not ok and (not errors[name] or ctx.Now() - errors[name] > 10) then
        errors[name] = ctx.Now(); warn("[Steal a House]", name, err)
    end
end
task.spawn(function()
    local last, ticks = ctx.Now(), 0
    while not ctx.Closing do
        task.wait(0.2)
        local now = ctx.Now()
        local dt = math.min(now - last, 1)
        last, ticks = now, ticks + 1
        safe("Movement", function() ctx.AntiExploit:Tick() end)
        safe("Progression", function() ctx.Progression:Tick(dt) end)
        safe("Stealing", function() ctx.Steal:Tick(dt) end)
        safe("Guards", function() ctx.Guards:Tick(dt) end)
        safe("Rent", function() ctx.Houses:Tick(dt) end)
        safe("World", function() ctx.World:Tick(dt) end)
        if ticks % 5 == 0 then
            safe("Wild houses", function() ctx.Wild:Tick(dt) end)
            local rows = standings()
            safe("Standings", function() ctx.World:UpdateStandings(rows) end)
            for _, player in ipairs(Players:GetPlayers()) do safe("Snapshot", function() ctx.Publish(player) end) end
        end
    end
end)
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">AntiExploitService</string>
          <string name="Source"><![CDATA[local AntiExploit = {}
AntiExploit.__index = AntiExploit
local rates = { Steal = 2, WildSteal = 2, Sell = 2, Buy = 1, BaseUpgrade = 1,
    TreadmillUpgrade = 1, SecurityUpgrade = 1, Daily = 1, Sync = 1, Train = 2, Lock = 1, Bat = 2 }
function AntiExploit.new(ctx) return setmetatable({ Context = ctx, Players = {} }, AntiExploit) end
function AntiExploit:Register(player)
    self.Players[player] = { Buckets = {}, Score = 0, BlockedUntil = 0, MovementBudget = self.Context.Config.Game.MovementTolerance }
end
function AntiExploit:AllowTeleport(player)
    local state = self.Players[player]
    if state then state.LastPosition = nil; state.MovementBudget = self.Context.Config.Game.MovementTolerance end
end
function AntiExploit:Flag(player, reason)
    local state = self.Players[player]
    if not state then return end
    state.Score += 1
    if state.Score >= 8 then state.BlockedUntil = os.clock() + 3 end
    if not state.LastLog or os.clock() - state.LastLog > 10 then
        state.LastLog = os.clock()
        warn("[AntiExploit]", player.UserId, reason, "score", state.Score)
    end
end
function AntiExploit:Rate(player, action)
    local state = self.Players[player]
    if not state then return false end
    local now = os.clock()
    local function spend(key, rate, burst)
        local bucket = state.Buckets[key] or { Tokens = burst, Time = now }
        state.Buckets[key] = bucket
        bucket.Tokens = math.min(burst, bucket.Tokens + (now - bucket.Time) * rate)
        bucket.Time = now
        if bucket.Tokens < 1 then return false end
        bucket.Tokens -= 1
        return true
    end
    if not spend("Global", 10, 16) or not spend(action, rates[action] or 3, 5) then
        self:Flag(player, "Remote rate limit: " .. action)
        return false
    end
    return true
end
function AntiExploit:Character(player)
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid or humanoid.Health <= 0 then return nil end
    return root, humanoid
end
function AntiExploit:ValidateMovement(player)
    local state = self.Players[player]
    local root = self:Character(player)
    if not state or not root then return false end
    local position = root.Position
    if position.X ~= position.X or position.Y ~= position.Y or position.Z ~= position.Z
        or math.abs(position.X) > 10000 or math.abs(position.Y) > 10000 or math.abs(position.Z) > 10000 then
        if state.LastCFrame then root.CFrame = state.LastCFrame end
        self:Flag(player, "Invalid character position")
        return false
    end
    local now = os.clock()
    if now < state.BlockedUntil then return false end
    if state.LastPosition then
        local elapsed = math.max(0, now - state.LastMoveTime)
        local delta = root.Position - state.LastPosition
        local horizontal = Vector3.new(delta.X, 0, delta.Z).Magnitude
        -- Latency tolerance is one replenishing burst, not a fresh allowance per request.
        local progression = self.Context.Progression
        local allowedSpeed = progression and progression:MovementSpeed(player) or self.Context.Config.Game.SprintSpeed
        local available = state.MovementBudget + allowedSpeed * elapsed
        if horizontal > available + 0.01 then
            if state.LastCFrame then root.CFrame = state.LastCFrame end
            state.BlockedUntil = now + 2
            self:Flag(player, "Impossible horizontal movement")
            return false
        end
        state.MovementBudget = math.min(self.Context.Config.Game.MovementTolerance, available - horizontal)
    end
    state.LastPosition, state.LastMoveTime, state.LastCFrame = root.Position, now, root.CFrame
    return true
end
function AntiExploit:Near(player, position, distance)
    local root = self:Character(player)
    return root ~= nil and self:ValidateMovement(player) and (root.Position - position).Magnitude <= distance
end
function AntiExploit:CanInteract(player, record, distance)
    if not self:Near(player, record.Position, distance) then return false end
    local root = self:Character(player)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { player.Character }
    params.RespectCanCollide = true
    local target = record.Position + Vector3.new(0, 2, 0)
    local result = (self.Context.Workspace or workspace):Raycast(root.Position, target - root.Position, params)
    return result == nil or (record.Model ~= nil and result.Instance:IsDescendantOf(record.Model))
end
function AntiExploit:Tick()
    for player, state in pairs(self.Players) do
        self:ValidateMovement(player)
        if not state.LastDecay or os.clock() - state.LastDecay >= 10 then
            state.Score = math.max(0, state.Score - 1)
            state.LastDecay = os.clock()
        end
    end
end
function AntiExploit:Remove(player) self.Players[player] = nil end
return AntiExploit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[-- Profiles are private server state. A failed load never creates a playable default.
-- Each persistent record has a renewable lease; every write verifies its token.
-- Saves serialize per profile and snapshot only after entering that queue. A save
-- never replaces the live profile, so mutations during a yield remain in memory
-- for the next save. Release freezes transactions before taking its final snapshot.
local DataService = {}
DataService.__index = DataService

local function copy(value, seen, depth, budget)
    local kind = type(value)
    if kind == "number" then
        assert(value == value and math.abs(value) ~= math.huge, "Non-finite profile number")
    elseif kind == "string" then
        assert(#value <= 100000, "Oversized profile string")
    elseif kind == "table" then
        seen, depth, budget = seen or {}, depth or 0, budget or { Count = 0 }
        assert(not seen[value] and depth < 32, "Cyclic or excessively nested profile")
        seen[value] = true
        local result = {}
        for key, item in pairs(value) do
            budget.Count += 1
            assert(budget.Count <= 10000, "Oversized profile")
            assert(type(key) == "string" or (type(key) == "number" and key == key and math.abs(key) ~= math.huge), "Invalid profile key")
            result[key] = copy(item, seen, depth + 1, budget)
        end
        seen[value] = nil
        return result
    else
        assert(kind == "boolean" or kind == "nil", "Profile contains a nonserializable value")
    end
    return value
end

local function playerKey(player)
    return "Player_" .. tostring(player.UserId)
end

local function unpackRecord(raw)
    if raw == nil then return nil, nil, 0 end
    if type(raw) ~= "table" then return nil, nil, 0, "InvalidProfile" end
    if raw._RecordVersion == nil then return raw, nil, 0 end -- pre-envelope profiles
    if raw._RecordVersion ~= 1 or type(raw.Data) ~= "table" then
        return nil, nil, 0, "UnsupportedRecordVersion"
    end
    local session = raw.Session
    if session ~= nil and (type(session) ~= "table" or type(session.Token) ~= "string"
        or type(session.ExpiresAt) ~= "number" or session.ExpiresAt ~= session.ExpiresAt
        or math.abs(session.ExpiresAt) == math.huge) then
        return nil, nil, 0, "InvalidSession"
    end
    local revision = raw.Revision
    if type(revision) ~= "number" or revision < 0 or revision ~= math.floor(revision)
        or revision == math.huge then return nil, nil, 0, "InvalidRevision" end
    if raw.LastWrite ~= nil and (type(raw.LastWrite) ~= "table" or type(raw.LastWrite.Token) ~= "string"
        or type(raw.LastWrite.Id) ~= "string") then return nil, nil, 0, "InvalidWriteMarker" end
    return raw.Data, session, revision
end

function DataService.new(ctx, options)
    options = options or {}
    local self = setmetatable({}, DataService)
    self._Ctx, self._Entries, self._Loading = ctx, {}, {}
    self._WriteSequence = 0
    self._Schema = options.Schema or ctx.Schema
    if not self._Schema then
        self._Schema = require(game:GetService("ReplicatedStorage").Shared.ProfileSchema)
    end
    self._Now = options.Now or os.time -- leases must use wall time across servers
    self._Wait = options.Wait or task.wait
    self._Spawn = options.Spawn or task.spawn
    self._RetryCount = options.RetryCount or 4
    self._Players, self._BindToClose = options.Players, options.BindToClose
    local config = ctx.Config.Game
    self._AutoSave = config.AutoSaveSeconds or 90
    self._Lease = config.SessionLeaseSeconds or 180
    self._Safety = math.min(options.SafetySeconds or 15, self._Lease / 4)
    assert(self._AutoSave > 0 and self._AutoSave + self._Safety < self._Lease, "Autosave must precede lease expiry")
    local isStudio = options.IsStudio
    if isStudio == nil then isStudio = game:GetService("RunService"):IsStudio() end
    self.Status = isStudio and not config.StudioPersistence and "StudioMemory" or "Persistent"
    self._Token = options.Token
    if not self._Token then self._Token = game:GetService("HttpService"):GenerateGUID(false) end
    if self.Status == "Persistent" then
        self._Store = options.Store or game:GetService("DataStoreService"):GetDataStore(config.ProfileStore)
        assert(self._Store ~= nil, "Persistent mode requires a real profile store")
    end
    return self
end

function DataService:_signal(entry, text, kind)
    if self._Ctx.Notify then pcall(self._Ctx.Notify, entry.Player, text, kind) end
    if self._Ctx.Publish then pcall(self._Ctx.Publish, entry.Player) end
end

function DataService:_retry(operation)
    for attempt = 1, self._RetryCount do
        local ok, result, reason = pcall(operation)
        if ok then return result, reason end
        if attempt < self._RetryCount then self._Wait(math.min(2 ^ (attempt - 1), 4)) end
    end
    return nil, "DataStoreUnavailable"
end

function DataService:_valid(profile)
    if type(profile) ~= "table" or profile.Version ~= 2 then return false end
    if self._Schema.Validate then
        local ok, valid = pcall(self._Schema.Validate, profile)
        return ok and valid == true
    end
    return true
end

function DataService:Get(player)
    local entry = self._Entries[playerKey(player)]
    return entry and entry.Player == player and entry.Profile or nil
end

function DataService:GetStatus(player)
    local entry = self._Entries[playerKey(player)]
    if not entry or entry.Player ~= player then return { Mode = self.Status, Loaded = false, Writable = false } end
    return { Mode = self.Status, Loaded = true, Writable = self:IsWritable(player),
        Saving = entry.Saving == true, Error = entry.Error, Revision = entry.Revision }
end

function DataService:IsWritable(player)
    local entry = self._Entries[playerKey(player)]
    if not entry or entry.Player ~= player or self._Closing or entry.Releasing or entry.Lost then return false end
    if self.Status == "StudioMemory" then return true end
    if self._Now() >= entry.LeaseUntil - self._Safety then
        if not entry.Frozen then
            entry.Frozen = true
            entry.Error = "LeaseRenewalRequired"
            self:_signal(entry, "Saving is unavailable. Transactions are paused to protect your progress.", "Warning")
        end
        return false
    end
    return not entry.Frozen
end

function DataService:Load(player)
    local key = playerKey(player)
    if self._Closing or self._CloseStarted then return nil, "ServerClosing" end
    local existing = self._Entries[key]
    if existing then
        if existing.Player == player and not existing.Lost and not existing.Releasing then return existing.Profile end
        if existing.Player == player then return nil, existing.Error or "ProfileReleasing" end
        return nil, "AlreadyLoaded"
    end
    if self._Loading[key] then return nil, "LoadInProgress" end
    self._Loading[key] = true
    local token = self._Token .. ":" .. key
    local profile, lease, revision, failure
    if self.Status == "StudioMemory" then
        local ok, result = pcall(self._Schema.New, self._Now())
        if ok then profile, lease, revision = result, math.huge, 0 else failure = "InvalidDefaultProfile" end
    else
        local record, reason = self:_retry(function()
            local rejection
            local result = self._Store:UpdateAsync(key, function(raw)
                rejection = nil -- UpdateAsync may invoke this callback repeatedly
                local data, session, oldRevision, unpackError = unpackRecord(raw)
                if unpackError then rejection = unpackError; return nil end
                local now = self._Now()
                if session and session.Token ~= token and session.ExpiresAt > now then
                    rejection = "SessionLocked"; return nil
                end
                local ok, migrated, migrationError = pcall(function()
                    if data == nil then return self._Schema.New(now) end
                    return self._Schema.Migrate(copy(data), now)
                end)
                if not ok or migrated == nil then rejection = migrationError or "MigrationFailed"; return nil end
                local copied, snapshot = pcall(copy, migrated)
                if not copied or not self:_valid(snapshot) then rejection = "InvalidProfile"; return nil end
                return { _RecordVersion = 1, Data = snapshot, Revision = oldRevision,
                    Session = { Token = token, ExpiresAt = now + self._Lease } }
            end)
            return result, rejection
        end)
        if record and record._RecordVersion == 1 and record.Session
            and record.Session.Token == token and record.Session.ExpiresAt > self._Now() then
            profile, lease, revision = copy(record.Data), record.Session.ExpiresAt, record.Revision
        else failure = reason or "SessionLost" end
    end
    if not profile or not self:_valid(profile) then
        self._Loading[key] = nil
        return nil, failure or "InvalidProfile"
    end
    local entry = { Player = player, Profile = profile, Token = token, LeaseUntil = lease,
        Revision = revision, NextSave = self._Now() + self._AutoSave }
    self._Entries[key] = entry
    if self._Closing or self._CloseStarted then
        if not self:Release(player) then self._LateReleaseFailed = true end
        self._Loading[key] = nil
        return nil, "ServerClosing"
    end
    self._Loading[key] = nil
    return profile
end

function DataService:Save(player, release)
    local key = playerKey(player)
    local entry = self._Entries[key]
    if not entry or entry.Player ~= player then return false, "ProfileNotLoaded" end
    if release then entry.Releasing = true end -- freeze before waiting for an in-flight save
    while entry.Saving do
        self._Wait(0.05)
        if self._Entries[key] ~= entry then return release == true, if release then nil else "ProfileReleased" end
    end
    if entry.Lost then
        if release then self._Entries[key] = nil end
        return false, entry.Error or "SessionLost"
    end
    if (entry.Releasing or self._Closing) and not release then return false, "ProfileReleasing" end
    entry.Saving = true
    local copied, snapshot = pcall(copy, entry.Profile)
    if not copied or not self:_valid(snapshot) then
        entry.Saving, entry.Error, entry.Frozen = false, "InvalidProfile", true
        return false, entry.Error
    end
    if self.Status == "StudioMemory" then
        entry.Revision += 1
        entry.Saving, entry.Error = false, nil
        if release then self._Entries[key] = nil end
        return true
    end
    self._WriteSequence += 1
    local operationId = entry.Token .. ":" .. tostring(self._WriteSequence)
    local record, failure = self:_retry(function()
        local rejection
        local result = self._Store:UpdateAsync(key, function(raw)
            rejection = nil
            local _, session, oldRevision, unpackError = unpackRecord(raw)
            if unpackError then rejection = unpackError; return nil end
            local now = self._Now()
            -- A committed write can still produce a network error. Retrying an
            -- already completed release must recognize this operation, without
            -- releasing any lease subsequently acquired by a different session.
            local lastWrite = raw and raw.LastWrite
            if lastWrite and lastWrite.Token == entry.Token and lastWrite.Id == operationId then
                if (release and session == nil) or (not release and session
                    and session.Token == entry.Token and session.ExpiresAt > now) then return copy(raw) end
            end
            if not session or session.Token ~= entry.Token or session.ExpiresAt <= now then
                rejection = "SessionLost"; return nil
            end
            return { _RecordVersion = 1, Data = copy(snapshot), Revision = oldRevision + 1,
                LastWrite = { Token = entry.Token, Id = operationId },
                Session = if release then nil else { Token = entry.Token, ExpiresAt = now + self._Lease } }
        end)
        return result, rejection
    end)
    -- A cancelled UpdateAsync may return nil; success always requires our written snapshot.
    if record and record._RecordVersion == 1 and record.Revision > entry.Revision
        and record.LastWrite and record.LastWrite.Token == entry.Token and record.LastWrite.Id == operationId
        and (release and record.Session == nil or not release and record.Session
            and record.Session.Token == entry.Token and record.Session.ExpiresAt > self._Now()) then
        entry.Revision, entry.Error, entry.Frozen = record.Revision, nil, false
        if not release then entry.LeaseUntil = record.Session.ExpiresAt end
        entry.NextSave = self._Now() + self._AutoSave
        entry.Saving = false
        if release then self._Entries[key] = nil end
        return true
    end
    entry.Saving, entry.Error = false, failure or "SessionLost"
    entry.NextSave = self._Now() + math.min(15, self._AutoSave)
    if entry.Error ~= "DataStoreUnavailable"
        or self._Now() >= entry.LeaseUntil then
        entry.Lost, entry.Frozen = true, true
        self:_signal(entry, "Your data session has ended. Rejoin to protect your progress.", "Error")
        if entry.Releasing then self._Entries[key] = nil end
    else
        self:IsWritable(player) -- freeze before the safety boundary even if retries consumed time
    end
    return false, entry.Error
end

function DataService:Release(player)
    if not self:Get(player) then return true end
    return self:Save(player, true)
end

function DataService:Start()
    if self._Started then return end
    self._Started = true
    local players = self._Players or game:GetService("Players")
    self._LeaveConnection = players.PlayerRemoving:Connect(function(player)
        if self._Ctx.BeforeDataRelease then pcall(self._Ctx.BeforeDataRelease, player) end
        self:Release(player)
    end)
    local bind = self._BindToClose or function(callback) game:BindToClose(callback) end
    bind(function() self:Close() end)
    self._Spawn(function()
        while not self._Closing do
            self._Wait(math.min(10, self._AutoSave / 2))
            if self._Closing then break end
            local now = self._Now()
            for _, entry in pairs(self._Entries) do
                self:IsWritable(entry.Player)
                if entry.Lost and entry.Releasing then self._Entries[playerKey(entry.Player)] = nil end
                if not entry.Saving and not entry.Lost and now >= entry.NextSave then
                    entry.NextSave = now + self._AutoSave
                    self._Spawn(function()
                        if entry.Releasing then self:Release(entry.Player) else self:Save(entry.Player) end
                    end)
                end
            end
        end
    end)
end

function DataService:Close()
    if self._CloseStarted then return self._CloseResult or false end
    self._CloseStarted = true
    -- Gameplay first settles temporary loot while profiles are still writable.
    -- The caller's hook must prevent new gameplay transactions immediately.
    if self._Ctx.BeforeDataClose then pcall(self._Ctx.BeforeDataClose) end
    self._Closing = true
    if self._LeaveConnection then self._LeaveConnection:Disconnect() end
    local pending, complete, failed = {}, 0, false
    for _, entry in pairs(self._Entries) do
        entry.Releasing = true
        table.insert(pending, entry.Player)
    end
    for _, player in ipairs(pending) do
        self._Spawn(function()
            local ok = self:Release(player)
            if not ok then failed = true end
            complete += 1
        end)
    end
    local deadline = self._Now() + 25
    while (complete < #pending or next(self._Loading) ~= nil) and self._Now() < deadline do self._Wait(0.05) end
    self._CloseResult = complete == #pending and next(self._Loading) == nil and not failed and not self._LateReleaseFailed
    return self._CloseResult
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">GuardService</string>
          <string name="Source"><![CDATA[-- Server-controlled anchored landlords pursue only their stolen wild prefab.
-- Navigation is cached; no client positions or NPC network ownership are trusted.
local Guard = {}
Guard.__index = Guard

local GRACE, RADIUS, CATCH_RADIUS, PATH_INTERVAL = 6, 60, 4, 1.5

local function horizontal(delta)
    return Vector3.new(delta.X, 0, delta.Z)
end

function Guard.new(ctx)
    local pathfinding = ctx.PathfindingService
    if pathfinding == nil then pathfinding = game:GetService("PathfindingService") end
    return setmetatable({ Context = ctx, Units = {}, Now = ctx.Now or os.clock,
        Spawn = ctx.Spawn or task.spawn, Pathfinding = pathfinding, Closed = false }, Guard)
end

function Guard:_unit(site)
    local unit = self.Units[site]
    if not unit then
        unit = { Site = site, Position = site.GuardOrigin, NextPath = 0, Generation = 0 }
        self.Units[site] = unit
    end
    return unit
end

function Guard:_clear(unit, state)
    if unit.State == state then return end
    unit.State, unit.Path, unit.Index = state, nil, nil
    unit.PathTarget, unit.NextPath = nil, 0
    unit.Generation += 1 -- Discard any yielding path result for a previous carry.
end

function Guard:_route(unit, target)
    if not self.Pathfinding or unit.Computing or self.Now() < unit.NextPath then return end
    if unit.PathTarget and horizontal(target - unit.PathTarget).Magnitude < 5 and unit.Path then return end
    unit.NextPath, unit.Computing = self.Now() + PATH_INTERVAL, true
    local generation, origin = unit.Generation, unit.Position
    self.Spawn(function()
        local ok, waypoints = pcall(function()
            local path = self.Pathfinding:CreatePath({ AgentRadius = 2.5, AgentHeight = 8,
                AgentCanJump = false, AgentCanClimb = false, WaypointSpacing = 5 })
            path:ComputeAsync(origin + Vector3.new(0, 2, 0), target)
            if path.Status == Enum.PathStatus.Success then return path:GetWaypoints() end
            return nil
        end)
        unit.Computing = false
        if self.Closed or generation ~= unit.Generation then return end
        unit.Path, unit.Index, unit.PathTarget = ok and waypoints or nil, 2, target
    end)
end

function Guard:_clearLine(unit, target, character)
    local scene = self.Context.Workspace
    if not scene or not scene.Raycast then return true end
    local params = RaycastParams.new()
    params.FilterType, params.RespectCanCollide = Enum.RaycastFilterType.Exclude, true
    params.FilterDescendantsInstances = { unit.Site.GuardModel }
    if character then table.insert(params.FilterDescendantsInstances, character) end
    local origin = unit.Position + Vector3.new(0, 3.5, 0)
    return scene:Raycast(origin, target - origin, params) == nil
end

function Guard:_move(unit, target, dt, character)
    self:_route(unit, target)
    local waypoint = target
    if unit.Path then
        while unit.Path[unit.Index] and horizontal(unit.Path[unit.Index].Position - unit.Position).Magnitude < 1.4 do
            unit.Index += 1
        end
        if unit.Path[unit.Index] then waypoint = unit.Path[unit.Index].Position end
    elseif not self:_clearLine(unit, target, character) then return end
    local delta = horizontal(waypoint - unit.Position)
    local distance = delta.Magnitude
    if distance <= 0.01 then return end
    local speed = math.clamp(7.5 + (unit.Site.Tier or 1) * 0.5, 8, 11)
    local position = unit.Position + delta.Unit * math.min(distance, speed * dt)
    position = Vector3.new(position.X, unit.Site.GuardOrigin.Y, position.Z)
    unit.Position = position
    unit.Site.GuardModel:PivotTo(CFrame.lookAt(position, position + delta.Unit))
end

function Guard:Tick(dt)
    if self.Closed or self.Context.Closing then return end
    if type(dt) ~= "number" or dt ~= dt or dt <= 0 then return end
    dt = math.min(dt, 0.25)
    local ctx, active = self.Context, {}
    for player, state in pairs(ctx.Steal.Carriers) do
        local site = state.Wild and state.Offer and state.Offer.Site
        if site and site.GuardModel and site.GuardModel.Parent and state.Phase == "Carry"
            and state.CarriedAt and self.Now() - state.CarriedAt >= GRACE
            and self.Now() - state.CarriedAt < ctx.Config.Game.CarryTimeoutSeconds
            and not ctx.World:AtHome(player) then
            local root = ctx.AntiExploit:Character(player)
            if root and horizontal(root.Position - site.GuardOrigin).Magnitude <= RADIUS then
                active[site] = { State = state, Root = root, Player = player }
            end
        end
    end
    for _, site in ipairs(ctx.World.WildSites) do
        if not site.GuardModel or not site.GuardModel.Parent then continue end
        local unit, target = self:_unit(site), active[site]
        self:_clear(unit, target and target.State or nil)
        if target then
            local delta = target.Root.Position - unit.Position
            if horizontal(delta).Magnitude <= CATCH_RADIUS and math.abs(delta.Y) <= 8
                and self:_clearLine(unit, target.Root.Position, target.Player.Character) then
                ctx.Steal:Cancel(target.Player, "The landlord caught you! Your prefab returned to its plot.")
                self:_clear(unit, nil)
            else
                self:_move(unit, target.Root.Position, dt, target.Player.Character)
            end
        elseif horizontal(site.GuardOrigin - unit.Position).Magnitude > 0.25 then
            self:_move(unit, site.GuardOrigin, dt)
        else
            unit.Position = site.GuardOrigin
            site.GuardModel:PivotTo(site.GuardFrame)
        end
    end
end

function Guard:Shutdown()
    self.Closed = true
    for _, unit in pairs(self.Units) do
        unit.Generation += 1
        if unit.Site.GuardModel and unit.Site.GuardModel.Parent then
            unit.Site.GuardModel:PivotTo(unit.Site.GuardFrame)
        end
    end
    self.Units = {}
end

return Guard
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">HouseService</string>
          <string name="Source"><![CDATA[-- Economy intents are saved before touching the independent ownership ledger.
-- A retry/rejoin completes the same UID operation instead of minting another house.
local Houses = {}
Houses.__index = Houses

function Houses.new(ctx)
    return setmetatable({ Context = ctx, Records = {}, Busy = {}, Reserved = {},
        RecoverAt = {}, Recovering = {} }, Houses)
end
function Houses:Capacity(player)
    local profile = self.Context.Data:Get(player)
    return profile and self.Context.Config.Bases[profile.BaseLevel].Slots or 0
end
function Houses:List(player)
    local result = {}
    for _, record in pairs(self.Records[player] or {}) do table.insert(result, record) end
    table.sort(result, function(a, b) return a.Slot < b.Slot end)
    return result
end
function Houses:FreeSlot(player)
    local occupied = {}
    for _, record in pairs(self.Records[player] or {}) do occupied[record.Slot] = true end
    for slot in pairs(self.Reserved[player] or {}) do occupied[slot] = true end
    for slot = 1, self:Capacity(player) do if not occupied[slot] then return slot end end
end
function Houses:Rate(record)
    local config = self.Context.Config
    return config.HouseById[record.DefinitionId].Income
        * config.VariantById[record.Variant].Multiplier * config.SizeById[record.Size].IncomeMultiplier
end
function Houses:_ready(player)
    local ctx = self.Context
    local profile = ctx.Data:Get(player)
    return profile and not ctx.Closing and ctx.Data:IsWritable(player) and not profile.Pending
        and not self.Busy[player] and not ctx.Steal:SourceHousesBusy(player)
end
function Houses:_bank(profile, amount)
    profile.Bank = math.min(self.Context.Config.Game.IncomeCap, profile.Bank + amount)
end
function Houses:_render(player, record)
    local ctx = self.Context
    if ctx.World:GetPlot(player) and not ctx.Steal:IsHeld(record.Id) then
        ctx.World:RenderHouse(player, record)
    end
end
function Houses:_record(player, intent)
    return { Id = intent.Id, DefinitionId = intent.DefinitionId, Variant = intent.Variant,
        Size = intent.Size, OwnerId = player.UserId, Slot = intent.Slot, Revision = 1,
        CreatedAt = intent.CreatedAt, OwnedSince = intent.CreatedAt,
        BuildReadyAt = intent.CreatedAt + (intent.Kind == "Starter" and 0 or self.Context.Config.Game.ConstructionSeconds),
        OperationId = intent.OperationId }
end
function Houses:_resume(player)
    local ctx, profile = self.Context, self.Context.Data:Get(player)
    local intent = profile and profile.Pending
    if not intent then return nil, "No pending transaction." end
    -- This save acknowledges the debit/intent even after an ambiguous previous save.
    local saved, saveError = ctx.Data:Save(player)
    if not saved then return nil, saveError or "Saving unavailable; your purchase will recover on rejoin." end
    local record, err
    if intent.Kind == "Sell" then
        record, err = ctx.Ownership:Remove(intent.Id, player.UserId, intent.ExpectedRevision, intent.OperationId)
    else record, err = ctx.Ownership:Create(self:_record(player, intent)) end
    if not record then
        local canonical, readError = ctx.Ownership:Get(intent.Id)
        if readError then return nil, readError end
        if canonical and intent.Kind ~= "Sell" and canonical.CreatedAt == intent.CreatedAt
            and canonical.DefinitionId == intent.DefinitionId and canonical.Variant == intent.Variant
            and canonical.Size == intent.Size then
            -- The creation completed, but the house may since have been stolen.
            record = canonical
        elseif canonical and intent.Kind == "Sell" and canonical.OwnerId ~= player.UserId
            and not (canonical.OwnerId == 0 and canonical.OperationId == intent.OperationId) then
            -- A conflicted sale cannot credit money for somebody else's house.
            profile.Pending = nil
            ctx.Data:Save(player)
            return nil, "That house changed owner; no sale was paid."
        else return nil, err or "The ownership store is unavailable; transaction retained." end
    end
    if intent.Kind == "Sell" then
        if record.OwnerId ~= 0 or record.OperationId ~= intent.OperationId then return nil, "Sale conflict." end
        local credited = math.min(intent.Price, ctx.Config.Game.MaxCash - profile.Cash)
        profile.Cash += credited
        self:_bank(profile, intent.Price - credited)
        profile.Statistics.TotalEarned = math.min(1e15, profile.Statistics.TotalEarned + credited)
        self:_bank(profile, profile.Income[intent.Id] or 0)
        profile.Income[intent.Id] = nil
        (self.Records[player] or {})[intent.Id] = nil
        ctx.World:RemoveHouse(player, intent.Id)
    else
        profile.HasStarter = true
        profile.Collection[intent.DefinitionId] = true
        if record.OwnerId == player.UserId and ctx.Data:Get(player) == profile and self.Records[player] then
            self.Records[player][record.Id] = record
            profile.Income[record.Id] = profile.Income[record.Id] or 0
            self:_render(player, record)
        end
        if intent.Kind == "Buy" then
            profile.Statistics.Bought += 1
            profile.Statistics.TotalSpent = math.min(1e15, profile.Statistics.TotalSpent + intent.Price)
        elseif intent.Kind == "Wild" then profile.Statistics.Stolen += 1 end
    end
    profile.Pending = nil
    -- Failure here is recoverable: the saved intent and canonical operation remain.
    local finalized = ctx.Data:Save(player)
    if not finalized then ctx.Notify(player, "House transaction committed. Saving will retry automatically.", "Warning") end
    if intent.Kind == "Wild" and record.OwnerId == player.UserId then
        local definition = ctx.Config.HouseById[record.DefinitionId]
        local rare = ctx.Config.Rarities[definition.Rarity].Rank >= 4 or record.Variant ~= "Normal"
        ctx.Notify(player, definition.Name .. " secured: " .. record.Variant .. " • " .. record.Size,
            rare and "Rare" or "Stolen")
    end
    ctx.Publish(player)
    return record
end
function Houses:_intent(player, kind, definitionId, variant, size, slot, id, token)
    local ctx = self.Context
    return { Kind = kind, Id = id or ctx.HttpService:GenerateGUID(false),
        DefinitionId = definitionId, Variant = variant, Size = size, Slot = slot,
        Price = 0, OperationId = token or ctx.HttpService:GenerateGUID(false), CreatedAt = ctx.Clock() }
end
function Houses:Attach(player)
    local ctx, profile = self.Context, self.Context.Data:Get(player)
    self.Records[player], self.Reserved[player] = {}, {}
    if profile.Pending then
        self.Busy[player] = profile.Pending.OperationId
        local _, err = self:_resume(player)
        self.Busy[player] = nil
        if profile.Pending then return false, err or "Unable to recover your transaction." end
    end
    if ctx.Data:Get(player) ~= profile or not ctx.World:GetPlot(player) then return false, "Profile released." end
    local records, err = ctx.Ownership:List(player.UserId)
    if not records then return false, err end
    if ctx.Data:Get(player) ~= profile or not ctx.World:GetPlot(player) then return false, "Profile released." end
    local slots = {}
    for _, record in ipairs(records) do
        if record.Slot > self:Capacity(player) or slots[record.Slot] then
            return false, "Saved houses contain overlapping or unavailable slots. Contact the developer."
        end
        slots[record.Slot] = true
        self.Records[player][record.Id] = record
        profile.Collection[record.DefinitionId] = true
    end
    -- Pending rent stays with its earner even if the house changed owner during a crash.
    for uid, amount in pairs(profile.Income) do
        if not self.Records[player][uid] then self:_bank(profile, amount); profile.Income[uid] = nil end
    end
    local now = ctx.Clock()
    local offline = 0
    for _, record in ipairs(records) do
        local since = math.max(profile.LastSeen, record.OwnedSince, record.BuildReadyAt)
        local seconds = math.clamp(now - since, 0, ctx.Config.Game.OfflineMaxSeconds)
        offline += self:Rate(record) * seconds * ctx.Config.Game.OfflineMultiplier
        profile.Income[record.Id] = profile.Income[record.Id] or 0
        self:_render(player, record)
    end
    self:_bank(profile, offline)
    profile.LastSeen = now
    if not profile.HasStarter then
        if #records > 0 then profile.HasStarter = true
        else
            local intent = self:_intent(player, "Starter", ctx.Config.Houses[1].Id, "Normal", "Normal", 1)
            profile.Pending, self.Busy[player] = intent, intent.OperationId
            local _, starterError = self:_resume(player)
            self.Busy[player] = nil
            if profile.Pending then return false, starterError end
        end
    end
    ctx.World:UpdateSlots(player, self:Capacity(player))
    if offline >= 1 then ctx.Notify(player, "$" .. math.floor(offline) .. " offline rent is waiting at your base.", "Success") end
    return true
end
function Houses:Buy(player, definitionId)
    local ctx, profile = self.Context, self.Context.Data:Get(player)
    local definition = type(definitionId) == "string" and ctx.Config.HouseById[definitionId]
    if not definition or not self:_ready(player) then return false, "Finish your current action first." end
    if not ctx.World:AtHome(player) then return false, "Buy houses from your own base." end
    local slot = self:FreeSlot(player)
    if not slot then return false, "Upgrade your base or free a pad." end
    if profile.Cash < definition.Price then return false, "You need more cash." end
    local intent = self:_intent(player, "Buy", definitionId, "Normal", "Normal", slot)
    intent.Price = definition.Price
    profile.Cash -= definition.Price
    profile.Pending, self.Busy[player] = intent, intent.OperationId
    local record, err = self:_resume(player)
    if self.Busy[player] == intent.OperationId then self.Busy[player] = nil end
    return record ~= nil, record and "House ordered! Construction takes six seconds." or err
end
function Houses:SecureWild(player, offer, state)
    local ctx, profile = self.Context, self.Context.Data:Get(player)
    if not profile then return nil, "Profile released." end
    if profile.Pending then
        if profile.Pending.Id ~= offer.Id or profile.Pending.Kind ~= "Wild"
            or profile.Pending.OperationId ~= state.Token then return nil, "Another transaction is pending." end
        state.IntentPrepared = true
        return self:_resume(player)
    end
    if not ctx.Data:IsWritable(player) or not ctx.Steal:_valid(state, true) then return nil, "The carry was interrupted." end
    local intent = self:_intent(player, "Wild", offer.DefinitionId, offer.Variant, state.Record.Size,
        state.Slot, offer.Id, state.Token)
    profile.Pending = intent
    state.IntentPrepared = true
    return self:_resume(player)
end
function Houses:Sell(player, uid, confirmed)
    local ctx, profile = self.Context, self.Context.Data:Get(player)
    local record = type(uid) == "string" and (self.Records[player] or {})[uid]
    if not record or not self:_ready(player) then return false, "That house is unavailable." end
    if not ctx.World:AtHome(player) then return false, "Sell from your own base." end
    if confirmed ~= true then ctx.Notify(player, "Confirm selling this house.", "ConfirmSell", uid); return true end
    if record.BuildReadyAt > ctx.Clock() then return false, "Wait for construction to finish." end
    local intent = self:_intent(player, "Sell", record.DefinitionId, record.Variant, record.Size, record.Slot, uid)
    intent.ExpectedRevision = record.Revision
    intent.Price = math.floor(ctx.Config.HouseById[record.DefinitionId].Price
        * ctx.Config.VariantById[record.Variant].Multiplier * ctx.Config.SizeById[record.Size].IncomeMultiplier * 0.5)
    profile.Pending, self.Busy[player] = intent, intent.OperationId
    local result, err = self:_resume(player)
    if self.Busy[player] == intent.OperationId then self.Busy[player] = nil end
    return result ~= nil, result and "House sold. Previous rent is waiting at your base." or err
end
function Houses:Collect(player, uid)
    local ctx, profile = self.Context, self.Context.Data:Get(player)
    if not self:_ready(player) or not ctx.World:AtHome(player) then return false, "Collect rent at your own base." end
    if uid ~= nil and (type(uid) ~= "string" or not (self.Records[player] or {})[uid]) then return false, "Unknown house." end
    local amount = uid and (profile.Income[uid] or 0) or profile.Bank
    if not uid then for _, value in pairs(profile.Income) do amount += value end end
    local credit = math.min(amount, ctx.Config.Game.MaxCash - profile.Cash)
    if credit <= 0 then return false, "No rent to collect, or your wallet is full." end
    local remaining = credit
    if not uid then
        local take = math.min(profile.Bank, remaining)
        profile.Bank -= take; remaining -= take
    end
    local ids = uid and { uid } or {}
    if not uid then for id in pairs(profile.Income) do table.insert(ids, id) end; table.sort(ids) end
    for _, id in ipairs(ids) do
        local take = math.min(profile.Income[id] or 0, remaining)
        profile.Income[id] -= take; remaining -= take
        if remaining <= 0 then break end
    end
    profile.Cash += credit
    profile.Statistics.TotalEarned = math.min(1e15, profile.Statistics.TotalEarned + credit)
    ctx.Publish(player)
    return true, "$" .. math.floor(credit) .. " rent collected!"
end
function Houses:ApplyTransfer(source, target, oldRecord, newRecord)
    local ctx = self.Context
    local from, to = ctx.Data:Get(source), ctx.Data:Get(target)
    local previous = (self.Records[target] or {})[newRecord.Id]
    local alreadyApplied = previous and previous.Revision == newRecord.Revision and previous.OperationId == newRecord.OperationId
    if from then self:_bank(from, from.Income[oldRecord.Id] or 0); from.Income[oldRecord.Id] = nil end
    if to and not alreadyApplied then
        to.Income[oldRecord.Id] = 0
        to.Collection[newRecord.DefinitionId] = true
        to.Statistics.Stolen += 1
    end
    if self.Records[source] then self.Records[source][oldRecord.Id] = nil end
    if self.Records[target] then self.Records[target][newRecord.Id] = newRecord end
    ctx.World:RemoveHouse(source, oldRecord.Id)
    -- Held stays set until Steal clears its transaction state; force the destination display.
    if ctx.World:GetPlot(target) then ctx.World:RenderHouse(target, newRecord) end
end
function Houses:Refresh(player)
    if not self.Context.Data:Get(player) then return false end
    local list, err = self.Context.Ownership:List(player.UserId)
    if not list then return false, err end
    local old = self.Records[player] or {}
    local profile = self.Context.Data:Get(player)
    self.Records[player] = {}
    for _, record in ipairs(list) do
        self.Records[player][record.Id] = record
        profile.Income[record.Id] = profile.Income[record.Id] or 0
        profile.Collection[record.DefinitionId] = true
        self:_render(player, record)
    end
    for uid, amount in pairs(profile.Income) do
        if not self.Records[player][uid] then self:_bank(profile, amount); profile.Income[uid] = nil end
    end
    for uid in pairs(old) do if not self.Records[player][uid] then self.Context.World:RemoveHouse(player, uid) end end
    return true
end
function Houses:Tick(dt)
    local ctx = self.Context
    for player, records in pairs(self.Records) do
        local profile = ctx.Data:Get(player)
        if profile and ctx.Data:IsWritable(player) and not self.Busy[player] and not profile.Pending then
            profile.LastSeen = ctx.Clock()
            for uid, record in pairs(records) do
                if not ctx.Steal:IsHeld(uid) and record.BuildReadyAt <= ctx.Clock() then
                    profile.Income[uid] = math.min(ctx.Config.Game.IncomeCap,
                        (profile.Income[uid] or 0) + self:Rate(record) * dt)
                    ctx.World:UpdateIncome(player, uid, profile.Income[uid])
                end
            end
        elseif profile and profile.Pending and not self.Busy[player] and not self.Recovering[player]
            and not ctx.Steal.Carriers[player] and ctx.Data:IsWritable(player)
            and (self.RecoverAt[player] or 0) <= ctx.Now() then
            self.RecoverAt[player], self.Recovering[player] = ctx.Now() + 10, true
            task.spawn(function()
                local pending = profile.Pending
                if pending then
                    self.Busy[player] = pending.OperationId
                    local ok, err = pcall(function() return self:_resume(player) end)
                    if not ok then warn("[House recovery]", err) end
                    if self.Busy[player] == pending.OperationId then self.Busy[player] = nil end
                end
                self.Recovering[player] = nil
            end)
        end
    end
end
function Houses:Release(player)
    self.Records[player], self.Reserved[player] = nil, nil
    self.RecoverAt[player], self.Recovering[player] = nil, nil
end
return Houses
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">ModelFactory</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Original primitive scenery, without asset IDs or Toolbox dependencies.
local Factory = {}

function Factory.Color(value, fallback)
    if typeof(value) == "Color3" then return value end
    if type(value) == "string" then
        local hex = value:gsub("#", "")
        if #hex == 6 and tonumber(hex, 16) then
            return Color3.fromRGB(tonumber(hex:sub(1, 2), 16), tonumber(hex:sub(3, 4), 16), tonumber(hex:sub(5, 6), 16))
        end
    end
    return fallback or Color3.fromRGB(125, 183, 235)
end

function Factory.Part(parent, name, size, frame, color, material)
    local part = Instance.new("Part")
    part.Name, part.Size, part.CFrame = name, size, frame
    part.Anchored = true
    part.Color = Factory.Color(color)
    part.Material = material or Enum.Material.SmoothPlastic
    part.TopSurface, part.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
    part.Parent = parent
    return part
end

function Factory.Model(parent, name)
    local model = Instance.new("Model")
    model.Name, model.Parent = name, parent
    return model
end

function Factory.Anchor(model, frame)
    local anchor = Factory.Part(model, "Interaction", Vector3.new(1, 1, 1), frame, "FFFFFF")
    anchor.Transparency, anchor.CanCollide, anchor.CanTouch, anchor.CanQuery = 1, false, false, false
    model.PrimaryPart = anchor
    return anchor
end

function Factory.Label(part, text, color, height, maxDistance)
    local gui = Instance.new("BillboardGui")
    gui.Name = "Label"
    gui.Size = UDim2.fromOffset(260, height or 72)
    gui.StudsOffset = Vector3.new(0, 3.2, 0)
    gui.MaxDistance, gui.AlwaysOnTop = maxDistance or 130, false
    gui.Adornee, gui.Parent = part, part
    local label = Instance.new("TextLabel")
    label.Name, label.Size = "Text", UDim2.fromScale(1, 1)
    label.BackgroundColor3, label.BackgroundTransparency = Color3.fromRGB(23, 30, 49), 0.15
    label.TextColor3, label.Text = Factory.Color(color, Color3.new(1, 1, 1)), text
    label.Font, label.TextSize, label.TextWrapped = Enum.Font.GothamBold, 18, true
    label.Parent = gui
    local corner = Instance.new("UICorner")
    corner.CornerRadius, corner.Parent = UDim.new(0, 9), label
    return label
end

function Factory.Prompt(part, action, object, radius, hold, callback)
    local prompt = Instance.new("ProximityPrompt")
    prompt.Name, prompt.ActionText, prompt.ObjectText = "Interact", action, object
    prompt.MaxActivationDistance, prompt.HoldDuration = radius or 12, hold or 0
    prompt.RequiresLineOfSight = true
    prompt.KeyboardKeyCode, prompt.GamepadKeyCode = Enum.KeyCode.E, Enum.KeyCode.ButtonX
    prompt.Exclusivity = Enum.ProximityPromptExclusivity.OnePerButton
    prompt.Parent = part
    if callback then prompt.Triggered:Connect(callback) end
    return prompt
end

function Factory.Money(amount)
    amount = math.max(0, math.floor(tonumber(amount) or 0))
    local scales = { { 1e12, "T" }, { 1e9, "B" }, { 1e6, "M" }, { 1e3, "K" } }
    for _, scale in ipairs(scales) do
        if amount >= scale[1] then return "$" .. string.format("%.1f", amount / scale[1]) .. scale[2] end
    end
    return "$" .. tostring(amount)
end

local function localPart(model, name, size, frame, offset, color, scale, rotation, material)
    return Factory.Part(model, name, size * scale,
        frame * CFrame.new(offset * scale) * (rotation or CFrame.new()), color, material)
end

local function windows(model, frame, scale, width, height, depth, floors)
    for row = 1, floors do
        for _, x in ipairs({ -width * 0.27, width * 0.27 }) do
            local pane = localPart(model, "Window", Vector3.new(2.2, 2.2, 0.16), frame,
                Vector3.new(x, height * row / (floors + 1) + 0.6, -depth / 2 - 0.08), "BCF3FF", scale)
            pane.Material, pane.CanCollide = Enum.Material.Glass, false
        end
    end
    localPart(model, "Door", Vector3.new(2.2, 3.7, 0.25), frame,
        Vector3.new(0, 2.2, -depth / 2 - 0.14), "513828", scale)
    localPart(model, "Doorstep", Vector3.new(4, 0.4, 2.5), frame,
        Vector3.new(0, 0.3, -depth / 2 - 1.1), "EBE4D7", scale)
end

function Factory.House(parent, name, frame, definition, variant, scale, construction)
    local model = Factory.Model(parent, name)
    scale = math.clamp(scale or 1, 0.2, 2)
    local body = Factory.Color(definition.Color)
    local trim = Factory.Color(variant and variant.Color, Color3.fromRGB(248, 243, 229))
    local anchor = Factory.Anchor(model, frame * CFrame.new(0, 5 * scale, 0))
    if construction then
        localPart(model, "PrefabBox", Vector3.new(11, 7, 10), frame, Vector3.new(0, 3.8, 0), "C89761", scale)
        localPart(model, "Strap", Vector3.new(1.2, 7.2, 10.2), frame, Vector3.new(0, 3.8, 0), trim, scale)
        localPart(model, "CrossStrap", Vector3.new(11.2, 7.2, 1.2), frame, Vector3.new(0, 3.8, 0), trim, scale)
        localPart(model, "ShippingLabel", Vector3.new(5, 2.8, 0.15), frame, Vector3.new(0, 4, -5.12), "FFF2C8", scale)
        return model, anchor
    end
    local style = string.lower(tostring(definition.Style or "cottage"))
    local width, height, depth, floors = 12, 8, 10, 1
    if style:find("tower") or style:find("town") or style:find("skyscraper") then
        width, height, depth, floors = 9, 15, 9, 3
    elseif style:find("modern") or style:find("villa") or style:find("penthouse") then
        width, height, depth, floors = 12, 10, 10, 2
    elseif style:find("castle") or style:find("palace") or style:find("temple") then
        width, height, depth, floors = 11, 10, 9, 2
    end
    localPart(model, "Foundation", Vector3.new(width + 1.5, 0.65, depth + 1.5), frame,
        Vector3.new(0, 0.45, 0), "DDD8CA", scale)
    localPart(model, "Walls", Vector3.new(width, height, depth), frame,
        Vector3.new(0, height / 2 + 0.7, 0), body, scale)
    windows(model, frame, scale, width, height, depth, floors)
    if style:find("castle") or style:find("palace") or style:find("temple") then
        for _, x in ipairs({ -6, 6 }) do
            localPart(model, "Turret", Vector3.new(3.8, 13, 4), frame, Vector3.new(x, 7, 0), trim, scale)
            for _, z in ipairs({ -1.5, 1.5 }) do
                localPart(model, "Battlement", Vector3.new(1.1, 1.8, 1), frame, Vector3.new(x, 14, z), body, scale)
            end
        end
        localPart(model, "Roof", Vector3.new(width, 0.6, depth), frame,
            Vector3.new(0, height + 1, 0), trim, scale)
    elseif style:find("modern") or style:find("villa") or style:find("penthouse")
        or style:find("tower") or style:find("town") or style:find("skyscraper") then
        localPart(model, "FlatRoof", Vector3.new(width + 1, 0.65, depth + 1), frame,
            Vector3.new(0, height + 1, 0), trim, scale)
        if floors == 2 then
            localPart(model, "Balcony", Vector3.new(width + 1, 0.5, 2.5), frame,
                Vector3.new(0, height * 0.58, -depth / 2 - 0.8), trim, scale)
        else
            localPart(model, "RoofAntenna", Vector3.new(0.3, 4, 0.3), frame,
                Vector3.new(2, height + 3, 1), trim, scale)
        end
    else
        for _, side in ipairs({ -1, 1 }) do
            localPart(model, "SlopedRoof", Vector3.new(width * 0.61, 0.65, depth + 2), frame,
                Vector3.new(side * width * 0.25, height + 1.5, 0), trim, scale,
                CFrame.Angles(0, 0, math.rad(-side * 26)))
        end
        localPart(model, "Chimney", Vector3.new(1.4, 3, 1.4), frame,
            Vector3.new(3.5, height + 2.5, 2), "795C4B", scale)
    end
    return model, anchor
end

function Factory.Landlord(parent, frame, color, tier)
    local model = Factory.Model(parent, "Landlord")
    localPart(model, "Coat", Vector3.new(3, 3.5, 1.7), frame, Vector3.new(0, 3.5, 0), color, 1)
    localPart(model, "Head", Vector3.new(2.3, 2.3, 2.3), frame, Vector3.new(0, 6.4, 0), "E5BA91", 1)
    localPart(model, "Hat", Vector3.new(3, 0.8, 2.8), frame, Vector3.new(0, 7.8, 0), "243149", 1)
    for _, x in ipairs({ -0.8, 0.8 }) do
        localPart(model, "Leg", Vector3.new(1.1, 2.3, 1.3), frame, Vector3.new(x, 1.25, 0), "243149", 1)
        localPart(model, "Arm", Vector3.new(0.9, 3, 1), frame, Vector3.new(x * 2.25, 3.5, 0), color, 1)
        localPart(model, "Eye", Vector3.new(0.2, 0.3, 0.15), frame, Vector3.new(x * 0.65, 6.7, -1.2), "243149", 1)
    end
    local anchor = Factory.Anchor(model, frame)
    local label = Factory.Label(anchor, "LANDLORD " .. tostring(tier) .. "\nProtecting prefab houses", "FFD68A", 60, 95)
    label.Parent.StudsOffset = Vector3.new(0, 10, 0)
    -- The server moves this anchored model. Contact is checked by GuardService;
    -- collidable moving scenery must not fling or trap player characters.
    for _, part in ipairs(model:GetDescendants()) do
        if part:IsA("BasePart") then part.CanCollide, part.CanTouch = false, false end
    end
    return model
end

return Factory
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">NetworkService</string>
          <string name="Source"><![CDATA[-- Remotes and all physical prompts share one narrow server-side action router.
local Network = {}
Network.__index = Network
local allowed = { Sync = true, Buy = true, Steal = true, WildSteal = true, Sell = true,
    Collect = true, CollectAll = true, Lock = true, Bat = true, Sprint = true, Train = true,
    BaseUpgrade = true, TreadmillUpgrade = true, SecurityUpgrade = true, Daily = true,
    Setting = true, OpenShop = true }
function Network.new(ctx)
    local self = setmetatable({ Context = ctx, Remotes = {} }, Network)
    local folder = Instance.new("Folder")
    folder.Name, folder.Parent = "HouseRemotes", ctx.ReplicatedStorage
    for _, name in ipairs({ "Request", "Snapshot", "Notification", "Announcement" }) do
        local remote = Instance.new("RemoteEvent")
        remote.Name, remote.Parent = name, folder
        self.Remotes[name] = remote
    end
    self.Remotes.Request.OnServerEvent:Connect(function(player, action, a, b)
        self:Request(player, action, a, b)
    end)
    return self
end
function Network:Request(player, action, a, b)
    local ctx = self.Context
    if type(action) ~= "string" or #action > 32 or not allowed[action] then return end
    if ctx.Closing or not ctx.AntiExploit:Rate(player, action) then return end
    if action == "Sync" then ctx.Publish(player); return end
    -- A frozen/dead player may still stop their own training or sprint state.
    if (action == "Train" or action == "Sprint") and a == false then
        if action == "Train" then ctx.Progression:Train(player, false) else ctx.Progression:SetSprint(player, false) end
        return
    end
    local profile = ctx.Data:Get(player)
    if not profile or not ctx.Ready[player] or not ctx.Data:IsWritable(player) then
        ctx.Notify(player, "Your progress is loading or saving is unavailable.", "Warning"); return
    end
    if action ~= "Setting" and not ctx.AntiExploit:ValidateMovement(player) then return end
    local ok, message
    if action == "Buy" then
        if ctx.Validation.Id(a, 64) then ok, message = ctx.Houses:Buy(player, a) end
    elseif action == "Steal" then
        if ctx.Validation.Id(a, 44) then ok, message = ctx.Steal:Attempt(player, a) end
    elseif action == "WildSteal" then
        if ctx.Validation.Id(a, 44) then ok, message = ctx.Steal:AttemptWild(player, a) end
    elseif action == "Sell" then
        if ctx.Validation.Id(a, 44) and (b == nil or type(b) == "boolean") then ok, message = ctx.Houses:Sell(player, a, b) end
    elseif action == "Collect" then
        if ctx.Validation.Id(a, 44) then ok, message = ctx.Houses:Collect(player, a) end
    elseif action == "CollectAll" then ok, message = ctx.Houses:Collect(player)
    elseif action == "Lock" then ok, message = ctx.Progression:Lock(player)
    elseif action == "Bat" then ok, message = ctx.Steal:Bat(player)
    elseif action == "Sprint" and type(a) == "boolean" then ok, message = ctx.Progression:SetSprint(player, a)
    elseif action == "Train" and type(a) == "boolean" then ok, message = ctx.Progression:Train(player, a)
    elseif action == "BaseUpgrade" then ok, message = ctx.Progression:BaseUpgrade(player)
    elseif action == "TreadmillUpgrade" then ok, message = ctx.Progression:TreadmillUpgrade(player)
    elseif action == "SecurityUpgrade" then ok, message = ctx.Progression:SecurityUpgrade(player)
    elseif action == "Daily" then ok, message = ctx.Progression:ClaimDaily(player)
    elseif action == "OpenShop" then ctx.Notify(player, "Open the house shop and upgrade your base here.", "Shop")
    elseif action == "Setting" then
        local settings = { Music = true, SFX = true, ReducedEffects = true }
        if type(a) == "string" and settings[a] and type(b) == "boolean" then profile.Settings[a] = b; ctx.Publish(player) end
    end
    if message then ctx.Notify(player, message, ok and "Success" or "Warning") end
end
return Network
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">OwnershipService</string>
          <string name="Source"><![CDATA[-- The profile contains income, never ownership. Each house has one canonical
-- CAS record; owner indexes contain only references and are verified on load.
-- Incoming references are durable before CAS. Their revision protects them
-- from pruning while an ownership operation is still in flight.
local OwnershipService = {}
OwnershipService.__index = OwnershipService

local MAX_REFERENCES = 256
local MAX_REVISION = 1000000000000
local MAX_ID = 44 -- DataStore keys include the six-character "House_" prefix.
local FIELDS = { Id = true, DefinitionId = true, Variant = true, Size = true,
    OwnerId = true, Slot = true, Revision = true, CreatedAt = true,
    OwnedSince = true, BuildReadyAt = true, OperationId = true }

local function copy(value)
    if type(value) ~= "table" then return value end
    local result = {}
    for key, item in pairs(value) do result[key] = copy(item) end
    return result
end

local function integer(value, minimum, maximum)
    return type(value) == "number" and value == value and value >= minimum
        and value <= maximum and value == math.floor(value)
end

local function identifier(value, maximum)
    return type(value) == "string" and #value > 0 and #value <= maximum
        and value:match("^[%w_%-]+$") ~= nil
end

local function operationId(value)
    return type(value) == "string" and #value > 0 and #value <= 160
        and value:match("^[%w_%-%:%.]+$") ~= nil
end

local function timestamp(value)
    return type(value) == "number" and value == value and value >= 0 and value <= MAX_REVISION
end

local function memoryStore()
    local records = {}
    return {
        GetAsync = function(_, key) return copy(records[key]) end,
        UpdateAsync = function(_, key, transform)
            local result = transform(copy(records[key]))
            if result == nil then return nil end
            records[key] = copy(result)
            return copy(result)
        end,
    }
end

function OwnershipService.new(ctx, options)
    options = options or {}
    local self = setmetatable({}, OwnershipService)
    self._Ctx, self._Config = ctx, ctx.Config
    self._Now = options.Now or ctx.Clock or os.time
    self._Wait = options.Wait or task.wait
    self._Retries = options.RetryCount or 4
    self.Status = assert(ctx.Data and ctx.Data.Status, "Ownership requires the profile data mode")
    assert(self.Status == "StudioMemory" or self.Status == "Persistent", "Unknown ownership data mode")
    if self.Status == "StudioMemory" then
        -- Never use an injected/production store in temporary Studio mode.
        self._Store = memoryStore()
    else
        self._Store = options.Store or game:GetService("DataStoreService")
            :GetDataStore(assert(ctx.Config.Game.OwnershipStore, "OwnershipStore must be configured"))
        if not options.Store then
            self._ReadOptions = Instance.new("DataStoreGetOptions")
            self._ReadOptions.UseCache = false -- a cached former owner must not load a duplicate
        end
    end
    return self
end

function OwnershipService:_owner(value, allowRemoved)
    if allowRemoved and value == 0 then return true end
    return integer(value, if self.Status == "StudioMemory" then -9007199254740991 else 1,
        9007199254740991) and value ~= 0
end

function OwnershipService:_valid(record, id)
    if type(record) ~= "table" then return false end
    for field in pairs(record) do if not FIELDS[field] then return false end end
    if not identifier(record.Id, MAX_ID) or (id and record.Id ~= id)
        or not identifier(record.DefinitionId, 64) or not identifier(record.Variant, 64)
        or not identifier(record.Size, 64) or not self:_owner(record.OwnerId, true)
        or not integer(record.Revision, 1, MAX_REVISION)
        or not timestamp(record.CreatedAt) or not timestamp(record.OwnedSince)
        or not timestamp(record.BuildReadyAt) or record.OwnedSince < record.CreatedAt
        or record.BuildReadyAt < record.CreatedAt or not operationId(record.OperationId) then return false end
    if record.OwnerId == 0 then
        if record.Slot ~= 0 then return false end
    elseif not integer(record.Slot, 1, self._Config.Game.MaxSlots or 20) then return false end
    return self._Config.HouseById[record.DefinitionId] ~= nil
        and self._Config.VariantById[record.Variant] ~= nil
        and self._Config.SizeById[record.Size] ~= nil
end

function OwnershipService:_index(raw)
    if raw == nil then return { Version = 1, References = {} } end
    if type(raw) ~= "table" or raw.Version ~= 1 or type(raw.References) ~= "table" then return nil end
    for key in pairs(raw) do if key ~= "Version" and key ~= "References" then return nil end end
    local count = 0
    for id, ref in pairs(raw.References) do
        count += 1
        if count > MAX_REFERENCES or not identifier(id, MAX_ID) or type(ref) ~= "table"
            or not integer(ref.Revision, 1, MAX_REVISION) or not operationId(ref.OperationId) then return nil end
        for key in pairs(ref) do if key ~= "Revision" and key ~= "OperationId" then return nil end end
    end
    return copy(raw)
end

function OwnershipService:_retry(operation)
    for attempt = 1, self._Retries do
        local ok, result, reason = pcall(operation)
        if ok then return true, result, reason end
        if attempt < self._Retries then self._Wait(math.min(2 ^ (attempt - 1), 4)) end
    end
    return false, nil, "OwnershipStoreUnavailable"
end

function OwnershipService:_read(key)
    local ok, value, reason = self:_retry(function()
        return self._Store:GetAsync(key, self._ReadOptions)
    end)
    if not ok then return nil, reason end
    return value
end

function OwnershipService:Get(id)
    if not identifier(id, MAX_ID) then return nil, "InvalidHouseId" end
    local raw, reason = self:_read("House_" .. id)
    if reason then return nil, reason end
    if raw == nil then return nil end -- nil means absent only after a successful read
    if not self:_valid(raw, id) then return nil, "InvalidOwnershipRecord" end
    return copy(raw)
end

function OwnershipService:_readIndex(userId)
    local raw, reason = self:_read("Owner_" .. tostring(userId))
    if reason then return nil, reason end
    local index = self:_index(raw)
    if not index then return nil, "InvalidOwnershipIndex" end
    return index
end

function OwnershipService:List(userId)
    if not self:_owner(userId, false) then return nil, "InvalidOwnerId" end
    local index, reason = self:_readIndex(userId)
    if not index then return nil, reason end
    local records = {}
    for id in pairs(index.References) do
        local record, failure = self:Get(id)
        if failure then return nil, failure end -- never return a partial ownership list
        if record and record.OwnerId == userId then table.insert(records, record) end
    end
    table.sort(records, function(a, b)
        return if a.Slot == b.Slot then a.Id < b.Id else a.Slot < b.Slot
    end)
    return records
end

function OwnershipService:_pruneIndex(userId)
    local index, failure = self:_readIndex(userId)
    if not index then return false, failure end
    local stale = {}
    for id, ref in pairs(index.References) do
        local canonical, reason = self:Get(id)
        if reason then return false, reason end
        -- Missing keys and earlier revisions may be incoming creates/transfers.
        -- Keep them. A later canonical revision conclusively invalidates this ref.
        if canonical and canonical.OwnerId ~= userId and canonical.Revision >= ref.Revision then
            stale[id] = ref
        end
    end
    if next(stale) == nil then return true end
    local ok, result, reason = self:_retry(function()
        local rejection
        local written = self._Store:UpdateAsync("Owner_" .. tostring(userId), function(raw)
            rejection = nil
            local latest = self:_index(raw)
            if not latest then rejection = "InvalidOwnershipIndex"; return nil end
            for id, oldRef in pairs(stale) do
                local ref = latest.References[id]
                -- An incoming operation replaces the ref with a higher revision.
                if ref and ref.Revision == oldRef.Revision and ref.OperationId == oldRef.OperationId then
                    latest.References[id] = nil
                end
            end
            return latest
        end)
        return written, rejection
    end)
    if not ok or not result then return false, reason or "OwnershipIndexWriteFailed" end
    return true
end

function OwnershipService:_reference(userId, id, revision, op)
    local function insert()
        local ok, result, reason = self:_retry(function()
            local rejection
            local written = self._Store:UpdateAsync("Owner_" .. tostring(userId), function(raw)
                rejection = nil
                local index = self:_index(raw)
                if not index then rejection = "InvalidOwnershipIndex"; return nil end
                local ref = index.References[id]
                if ref and ref.Revision >= revision then return index end
                if not ref then
                    local count = 0
                    for _ in pairs(index.References) do count += 1 end
                    if count >= MAX_REFERENCES then rejection = "OwnershipIndexFull"; return nil end
                end
                index.References[id] = { Revision = revision, OperationId = op }
                return index
            end)
            return written, rejection
        end)
        if not ok or not result then return false, reason or "OwnershipIndexWriteFailed" end
        local index = self:_index(result)
        local ref = index and index.References[id]
        if not ref or ref.Revision < revision then return false, "OwnershipIndexWriteFailed" end
        return true
    end
    local ok, reason = insert()
    if ok or reason ~= "OwnershipIndexFull" then return ok, reason end
    local pruned, failure = self:_pruneIndex(userId)
    if not pruned then return false, failure end
    return insert()
end

local function checkAllowed(check)
    if check == nil then return true end
    if type(check) ~= "function" then return false end
    -- This callback runs inside UpdateAsync and must not yield. It only checks
    -- live gameplay/session state; it never reads another DataStore.
    local ok, allowed = pcall(check)
    return ok and allowed == true
end

function OwnershipService:Create(record, check)
    if not self:_valid(record) or record.OwnerId == 0 or record.Revision ~= 1 then
        return nil, "InvalidOwnershipRecord"
    end
    local wanted = copy(record)
    local current, readFailure = self:Get(wanted.Id)
    if readFailure then return nil, readFailure end
    local function same(raw)
        return raw.OperationId == wanted.OperationId and raw.OwnerId == wanted.OwnerId
            and raw.Slot == wanted.Slot and raw.DefinitionId == wanted.DefinitionId
            and raw.Variant == wanted.Variant and raw.Size == wanted.Size and raw.Revision == 1
    end
    if current then
        if same(current) then return current end -- committed retry before live-state checks
        return nil, "HouseAlreadyExists"
    end
    if not checkAllowed(check) then return nil, "OwnershipCheckFailed" end
    local indexed, indexFailure = self:_reference(wanted.OwnerId, wanted.Id, 1, wanted.OperationId)
    if not indexed then return nil, indexFailure end
    local ok, result, reason = self:_retry(function()
        local rejection
        local written = self._Store:UpdateAsync("House_" .. wanted.Id, function(raw)
            rejection = nil
            if raw ~= nil then
                if not self:_valid(raw, wanted.Id) then rejection = "InvalidOwnershipRecord"; return nil end
                if same(raw) then return copy(raw) end
                rejection = "HouseAlreadyExists"; return nil
            end
            if not checkAllowed(check) then rejection = "OwnershipCheckFailed"; return nil end
            return copy(wanted)
        end)
        return written, rejection
    end)
    if not ok or not result then return nil, reason or "OwnershipWriteFailed" end
    if not self:_valid(result, wanted.Id) or not same(result) then return nil, "OwnershipWriteFailed" end
    return copy(result)
end

function OwnershipService:Transfer(id, expectedOwner, expectedRevision, newOwner, newSlot, op, check)
    if not identifier(id, MAX_ID) or not self:_owner(expectedOwner, false)
        or not self:_owner(newOwner, false) or expectedOwner == newOwner
        or not integer(expectedRevision, 1, MAX_REVISION - 1)
        or not integer(newSlot, 1, self._Config.Game.MaxSlots or 20) or not operationId(op) then
        return nil, "InvalidOwnershipTransfer"
    end
    local function same(raw)
        return raw.OperationId == op and raw.OwnerId == newOwner and raw.Slot == newSlot
            and raw.Revision == expectedRevision + 1
    end
    local current, readFailure = self:Get(id)
    if readFailure then return nil, readFailure end
    if not current then return nil, "HouseNotFound" end
    if same(current) then return current end
    if current.OwnerId ~= expectedOwner or current.Revision ~= expectedRevision then return nil, "OwnershipChanged" end
    if not checkAllowed(check) then return nil, "OwnershipCheckFailed" end
    local indexed, indexFailure = self:_reference(newOwner, id, expectedRevision + 1, op)
    if not indexed then return nil, indexFailure end
    local ok, result, reason = self:_retry(function()
        local rejection
        local written = self._Store:UpdateAsync("House_" .. id, function(raw)
            rejection = nil
            if raw == nil then rejection = "HouseNotFound"; return nil end
            if not self:_valid(raw, id) then rejection = "InvalidOwnershipRecord"; return nil end
            if same(raw) then return copy(raw) end
            if raw.OwnerId ~= expectedOwner or raw.Revision ~= expectedRevision then
                rejection = "OwnershipChanged"; return nil
            end
            if not checkAllowed(check) then rejection = "OwnershipCheckFailed"; return nil end
            local changed = copy(raw)
            changed.OwnerId, changed.Slot, changed.Revision = newOwner, newSlot, expectedRevision + 1
            changed.OperationId, changed.OwnedSince = op, math.max(raw.CreatedAt, self._Now())
            return changed
        end)
        return written, rejection
    end)
    if not ok or not result then return nil, reason or "OwnershipWriteFailed" end
    if not self:_valid(result, id) or not same(result) then return nil, "OwnershipWriteFailed" end
    return copy(result)
end

function OwnershipService:Remove(id, expectedOwner, expectedRevision, op, check)
    if not identifier(id, MAX_ID) or not self:_owner(expectedOwner, false)
        or not integer(expectedRevision, 1, MAX_REVISION - 1) or not operationId(op) then
        return nil, "InvalidOwnershipRemoval"
    end
    local function same(raw)
        return raw.OperationId == op and raw.OwnerId == 0 and raw.Slot == 0
            and raw.Revision == expectedRevision + 1
    end
    local ok, result, reason = self:_retry(function()
        local rejection
        local written = self._Store:UpdateAsync("House_" .. id, function(raw)
            rejection = nil
            if raw == nil then rejection = "HouseNotFound"; return nil end
            if not self:_valid(raw, id) then rejection = "InvalidOwnershipRecord"; return nil end
            if same(raw) then return copy(raw) end
            if raw.OwnerId ~= expectedOwner or raw.Revision ~= expectedRevision then
                rejection = "OwnershipChanged"; return nil
            end
            if not checkAllowed(check) then rejection = "OwnershipCheckFailed"; return nil end
            local removed = copy(raw)
            removed.OwnerId, removed.Slot, removed.Revision = 0, 0, expectedRevision + 1
            removed.OperationId, removed.OwnedSince = op, math.max(raw.CreatedAt, self._Now())
            return removed
        end)
        return written, rejection
    end)
    if not ok or not result then return nil, reason or "OwnershipWriteFailed" end
    if not self:_valid(result, id) or not same(result) then return nil, "OwnershipWriteFailed" end
    return copy(result)
end

return OwnershipService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">PlayerService</string>
          <string name="Source"><![CDATA[local PlayerService = {}
PlayerService.__index = PlayerService
function PlayerService.new(ctx)
    return setmetatable({ Context = ctx, Cleaning = {}, Connections = {}, Characters = {},
        Joining = setmetatable({}, { __mode = "k" }) }, PlayerService)
end
function PlayerService:_character(player, character)
    local ctx = self.Context
    local root = character:WaitForChild("HumanoidRootPart", 10)
    local humanoid = character:WaitForChild("Humanoid", 10)
    if not root or not humanoid or player.Character ~= character or player.Parent ~= ctx.Players then return end
    self.Characters[player] = character
    local plot = ctx.World:GetPlot(player)
    if plot then
        ctx.AntiExploit:AllowTeleport(player)
        root.CFrame = CFrame.new(plot.Spawn) * plot.Frame.Rotation
        ctx.World:SetCharacterGroup(player)
    end
    ctx.Progression:UpdateSpeed(player)
    humanoid.Died:Connect(function()
        ctx.Steal:Cancel(player, "You dropped the house.")
        ctx.Progression:Train(player, false)
        ctx.Progression:SetSprint(player, false)
    end)
    local backpack = player:FindFirstChildOfClass("Backpack")
    if backpack and not backpack:FindFirstChild("House Defender") then
        local tool = Instance.new("Tool")
        tool.Name, tool.RequiresHandle, tool.CanBeDropped = "House Defender", true, false
        tool.ToolTip = "Stops nearby house carriers. R / touch Bat / controller trigger"
        local handle = Instance.new("Part")
        handle.Name, handle.Size = "Handle", Vector3.new(0.65, 3.4, 0.65)
        handle.Material, handle.Color = Enum.Material.Wood, Color3.fromRGB(173, 117, 65)
        handle.CanCollide, handle.CanTouch, handle.Massless = false, false, true
        handle.Parent = tool
        tool.Grip = CFrame.new(0, -0.8, 0)
        tool.Activated:Connect(function() ctx.Request(player, "Bat") end)
        tool.Parent = backpack
    end
end
function PlayerService:_join(player)
    local ctx = self.Context
    if self.Joining[player] or ctx.Closing or player.Parent ~= ctx.Players then return end
    self.Joining[player] = true
    ctx.AntiExploit:Register(player)
    self.Connections[player] = player.CharacterAdded:Connect(function(character) self:_character(player, character) end)
    local profile, loadError = ctx.Data:Load(player)
    if not profile then
        if player.Parent == ctx.Players then player:Kick("Your save could not be opened safely. Please rejoin. " .. tostring(loadError)) end
        return
    end
    if ctx.Closing or player.Parent ~= ctx.Players then ctx.Data:Release(player); return end
    local plot = ctx.World:Assign(player)
    if not plot then player:Kick("Every base is occupied. Please join another server."); return end
    local ok, attachError = ctx.Houses:Attach(player)
    if not ok then
        if player.Parent == ctx.Players then player:Kick("Your house ownership could not be verified. Please rejoin. " .. tostring(attachError)) end
        return
    end
    if ctx.Closing or player.Parent ~= ctx.Players then self:Cleanup(player); ctx.Data:Release(player); return end
    ctx.Ready[player] = true
    ctx.Progression:OnJoin(player)
    if player.Character and self.Characters[player] ~= player.Character then self:_character(player, player.Character)
    elseif player.Character then
        local root = player.Character:FindFirstChild("HumanoidRootPart")
        if root then ctx.AntiExploit:AllowTeleport(player); root.CFrame = CFrame.new(plot.Spawn) * plot.Frame.Rotation end
        ctx.World:SetCharacterGroup(player)
        ctx.Progression:UpdateSpeed(player)
    end
    ctx.Publish(player)
    ctx.Notify(player, "Welcome! Steal a growing house box, bring it home, and collect rent. Train on your treadmill to reach richer streets.", "Info")
end
function PlayerService:Cleanup(player)
    if self.Cleaning[player] then return end
    self.Cleaning[player] = true
    local ctx = self.Context
    ctx.Ready[player] = nil
    ctx.Steal:Release(player)
    ctx.Progression:Release(player)
    local deadline = os.clock() + 20
    -- Give an acknowledged ledger operation time to settle before its profiles unload.
    while ctx.Houses.Busy[player] and os.clock() < deadline do task.wait(0.05) end
    ctx.Houses:Release(player)
    ctx.World:Release(player)
    ctx.AntiExploit:Remove(player)
    if self.Connections[player] then self.Connections[player]:Disconnect(); self.Connections[player] = nil end
    self.Characters[player] = nil
    -- Weak keys prevent departed Player instances from being kept forever.
end
function PlayerService:Start()
    self.Cleaning = setmetatable({}, { __mode = "k" })
    local ctx = self.Context
    ctx.Players.PlayerAdded:Connect(function(player) task.spawn(function() self:_join(player) end) end)
    for _, player in ipairs(ctx.Players:GetPlayers()) do task.spawn(function() self:_join(player) end) end
end
return PlayerService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">ProgressionService</string>
          <string name="Source"><![CDATA[-- Progression stays on the server: upgrades debit configured prices, treadmill
-- training consumes server elapsed time, and protection expires on a fixed clock.
local Progression = {}
Progression.__index = Progression

local function finite(value)
	return type(value) == "number" and value == value and math.abs(value) ~= math.huge
end

function Progression.new(ctx)
	return setmetatable({ Context = ctx, Locks = {}, Training = {}, Sprinting = {}, Joined = {} }, Progression)
end

function Progression:_now()
	return (self.Context.Now or os.clock)()
end

function Progression:_notify(player, message, kind)
	if self.Context.Notify then self.Context.Notify(player, message, kind or "Info") end
end

function Progression:_publish(player)
	if self.Context.Publish then self.Context.Publish(player) end
end

function Progression:_profile(player)
	local ctx = self.Context
	if ctx.Closing or not ctx.Data:IsWritable(player) then return nil, "Saving is unavailable. Try again shortly." end
	local profile = ctx.Data:Get(player)
	if not profile then return nil, "Your progress is still loading." end
	if profile.Pending or ctx.Houses and ctx.Houses.Busy[player] then
		return nil, "Finish your current house transaction first."
	end
	if ctx.Steal and ctx.Steal.Carriers[player] then return nil, "Bring the house home first." end
	return profile
end

function Progression:_home(player)
	local ctx = self.Context
	local plot = ctx.World:GetPlot(player)
	if not plot or plot.Owner ~= player or not ctx.AntiExploit:Character(player)
		or not ctx.World:AtHome(player) then return nil end
	return plot
end

function Progression:Speed(player)
	return self.Context.Config.Speed(self.Context.Data:Get(player))
end

function Progression:Multiplier(_player)
	-- House size and mutation multipliers are applied once by HouseService.
	return 1
end

function Progression:MovementSpeed(player)
	local ctx = self.Context
	if ctx.Steal and ctx.Steal.Carriers[player] then return ctx.Config.Game.CarrySpeed end
	if self.Training[player] then return 0 end
	return self:Speed(player) + (if self.Sprinting[player] then 6 else 0)
end

function Progression:UpdateSpeed(player)
	local _, humanoid = self.Context.AntiExploit:Character(player)
	if humanoid then
		humanoid.WalkSpeed = self:MovementSpeed(player)
		humanoid:SetAttribute("HouseTraining", self.Training[player] == true)
	end
end

function Progression:SetSprint(player, enabled)
	if type(enabled) ~= "boolean" then return false, "Invalid sprint request." end
	if not self.Context.Data:Get(player) or not self.Context.AntiExploit:Character(player) then return false end
	self.Sprinting[player] = if enabled then true else nil
	self:UpdateSpeed(player)
	return true
end

function Progression:LockDuration(player)
	local config = self.Context.Config
	local profile = self.Context.Data:Get(player)
	local security = profile and config.Security[profile.SecurityLevel]
	return config.Game.LockSeconds + (security and security.BonusSeconds or 0)
end

function Progression:_renderLock(player, state)
	local plot = self.Context.World:GetPlot(player)
	if plot then
		local remaining = math.max(0, state.Until - self:_now())
		self.Context.World:SetLock(plot, remaining > 0, remaining)
	end
end

function Progression:IsLocked(player)
	local state = self.Locks[player]
	return state ~= nil and self:_now() < state.Until
end

function Progression:OnJoin(player)
	if self.Joined[player] then return end
	self.Joined[player] = true
	local now = self:_now()
	local duration = self.Context.Config.Game.JoinShieldSeconds
	local state = { Until = now + duration, CooldownUntil = now + duration + self.Context.Config.Game.LockCooldownSeconds }
	self.Locks[player] = state
	self:_renderLock(player, state)
	self:UpdateSpeed(player)
end

function Progression:Lock(player)
	local profile, errorMessage = self:_profile(player)
	if not profile then return false, errorMessage end
	local plot = self:_home(player)
	if not plot or not self.Context.AntiExploit:Near(player, plot.LockPosition,
		self.Context.Config.Game.InteractionRadius) then return false, "Stand on your own lock pad." end
	local now = self:_now()
	local existing = self.Locks[player]
	if existing and now < existing.Until then return false, "Your base is already locked." end
	if existing and now < existing.CooldownUntil then return false, "Your lock is cooling down." end
	local untilTime = now + self:LockDuration(player)
	local state = { Until = untilTime, CooldownUntil = untilTime + self.Context.Config.Game.LockCooldownSeconds }
	self.Locks[player] = state
	self:_renderLock(player, state)
	self:_notify(player, "Base locked!", "Success")
	self:_publish(player)
	return true
end

function Progression:_upgrade(player, field, definitions, name)
	local profile, errorMessage = self:_profile(player)
	if not profile then return false, errorMessage end
	if not self:_home(player) then return false, "Return to your own base to upgrade." end
	local level = profile[field]
	if not finite(level) or level ~= math.floor(level) or level < 1 or not definitions[level] then return false end
	local nextLevel = definitions[level + 1]
	if not nextLevel then return false, name .. " is fully upgraded." end
	local cost = nextLevel.Cost
	if not finite(cost) or cost < 0 or not finite(profile.Cash) or profile.Cash < cost then
		return false, "You need more cash for this upgrade."
	end
	-- No yield between validation, debit, and level/stat changes.
	profile.Cash -= cost
	profile[field] = level + 1
	profile.Statistics.TotalSpent = math.min(1e15, profile.Statistics.TotalSpent + cost)
	if field == "BaseLevel" then
		self.Context.World:UpdateSlots(player, nextLevel.Slots)
	elseif field == "TreadmillLevel" then
		self.Context.World:UpdateTreadmill(player, level + 1, self.Training[player] == true)
	end
	self:_notify(player, name .. " upgraded!", "Success")
	self:_publish(player)
	return true
end

function Progression:SecurityUpgrade(player)
	return self:_upgrade(player, "SecurityLevel", self.Context.Config.Security, "Security")
end

function Progression:BaseUpgrade(player)
	return self:_upgrade(player, "BaseLevel", self.Context.Config.Bases, "Base")
end

function Progression:TreadmillUpgrade(player)
	return self:_upgrade(player, "TreadmillLevel", self.Context.Config.Treadmills, "Treadmill")
end

function Progression:_stopTraining(player)
	if not self.Training[player] then return end
	self.Training[player] = nil
	self:UpdateSpeed(player)
	local profile = self.Context.Data:Get(player)
	if profile and self.Context.World:GetPlot(player) then
		self.Context.World:UpdateTreadmill(player, profile.TreadmillLevel, false)
	end
	self:_publish(player)
end

function Progression:_canTrain(player)
	local profile, errorMessage = self:_profile(player)
	if not profile then return nil, errorMessage end
	local plot = self:_home(player)
	if not plot or not self.Context.AntiExploit:Near(player, plot.TreadmillPosition,
		self.Context.Config.Game.InteractionRadius) then return nil, "Stand beside your own treadmill to train." end
	return profile
end

function Progression:Train(player, enabled)
	if type(enabled) ~= "boolean" then return false, "Invalid training request." end
	-- Stopping is always allowed, including a frozen data session or death.
	if not enabled then self:_stopTraining(player); return true end
	local profile, errorMessage = self:_canTrain(player)
	if not profile then return false, errorMessage end
	if self.Training[player] then return true end
	self.Training[player] = true
	self.Sprinting[player] = nil
	self:UpdateSpeed(player)
	self.Context.World:UpdateTreadmill(player, profile.TreadmillLevel, true)
	self:_publish(player)
	return true
end

function Progression:ClaimDaily(player)
	local profile, errorMessage = self:_profile(player)
	if not profile then return false, errorMessage end
	if not self:_home(player) then return false, "Return to your own base to claim your reward." end
	local now = (self.Context.Clock or os.time)()
	if not finite(now) or now < 0 then return false end
	local day = math.floor(now / 86400)
	if day <= profile.DailyDay then return false, "Today's reward has already been claimed." end
	local rewards = self.Context.Config.DailyRewards
	local streak = if day == profile.DailyDay + 1 then profile.DailyStreak % #rewards + 1 else 1
	local credited = math.min(rewards[streak], self.Context.Config.Game.MaxCash - profile.Cash)
	if credited <= 0 then return false, "Your wallet is full." end
	-- Claim marker and cash change together, without a yield or client timestamp.
	profile.DailyDay, profile.DailyStreak = day, streak
	profile.Cash += credited
	profile.Statistics.TotalEarned = math.min(1e15, profile.Statistics.TotalEarned + credited)
	self:_notify(player, "Daily reward claimed!", "Success")
	self:_publish(player)
	return true
end

function Progression:Rebirth(_player, _confirmed)
	return false, "This game progresses through base and treadmill upgrades."
end

function Progression:Tick(dt)
	if not finite(dt) or dt <= 0 then return end
	for player in pairs(self.Training) do
		local profile = self:_canTrain(player)
		local treadmill = profile and self.Context.Config.Treadmills[profile.TreadmillLevel]
		if not treadmill then
			self:_stopTraining(player)
		else
			local before = self:Speed(player)
			profile.SpeedXP = math.min(1e9, profile.SpeedXP + treadmill.Rate * dt)
			self:UpdateSpeed(player)
			if self:Speed(player) ~= before then self:_publish(player) end
		end
	end
	for player, state in pairs(self.Locks) do self:_renderLock(player, state) end
end

function Progression:Release(player)
	self:_stopTraining(player)
	local plot = self.Context.World:GetPlot(player)
	if plot then self.Context.World:SetLock(plot, false, 0) end
	self.Locks[player], self.Sprinting[player], self.Joined[player] = nil, nil, nil
end

return Progression
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">StealService</string>
          <string name="Source"><![CDATA[-- Pickup is provisional. Only the ownership ledger can transfer a player's house.
local Steal = {}
Steal.__index = Steal

function Steal.new(ctx)
    return setmetatable({ Context = ctx, Carriers = {}, Held = {}, BatTimes = {},
        Now = ctx.Now or os.clock, Spawn = ctx.Spawn or task.spawn }, Steal)
end
function Steal:IsHeld(uid)
    local state = self.Held[uid]
    return state ~= nil and state.Phase ~= "Hold"
end
function Steal:SourceHousesBusy(player)
    for _, state in pairs(self.Held) do
        if state.Owner == player or state.Player == player then return true end
    end
    return false
end
function Steal:_available(player, token)
    local ctx = self.Context
    local profile = ctx.Data:Get(player)
    return not ctx.Closing and profile ~= nil and ctx.Data:IsWritable(player)
        and (ctx.Ready == nil or ctx.Ready[player] == true)
        and not profile.Pending and ctx.World:GetPlot(player) ~= nil
        and (not ctx.Houses.Busy[player] or ctx.Houses.Busy[player] == token)
end
function Steal:_owner(uid)
    for player, records in pairs(self.Context.Houses.Records) do
        if records[uid] then return player, records[uid] end
    end
end
function Steal:_slotValid(state)
    local houses = self.Context.Houses
    if not houses.Reserved[state.Player] or houses.Reserved[state.Player][state.Slot] ~= state.Token
        or state.Slot > houses:Capacity(state.Player) then return false end
    for _, record in pairs(houses.Records[state.Player] or {}) do
        if record.Slot == state.Slot then return false end
    end
    return true
end
function Steal:_sourceValid(state)
    local ctx = self.Context
    if state.Wild then
        local offer = ctx.Wild:Get(state.Id)
        return offer == state.Offer and offer.Busy == state.Player
    end
    local records = ctx.Houses.Records[state.Owner]
    local record = records and records[state.Id]
    return self:_available(state.Owner, state.Token) and not ctx.Progression:IsLocked(state.Owner)
        and record ~= nil and record.OwnerId == state.Owner.UserId
        and record.Revision == state.Revision and record.Slot == state.Record.Slot
end
function Steal:_valid(state, atHome)
    local ctx = self.Context
    if self.Carriers[state.Player] ~= state or self.Held[state.Id] ~= state
        or state.CancelReason or not self:_available(state.Player, state.Token)
        or not self:_slotValid(state) or not self:_sourceValid(state)
        or not ctx.AntiExploit:Character(state.Player)
        or not ctx.AntiExploit:ValidateMovement(state.Player) then return false end
    return not atHome or ctx.World:AtHome(state.Player)
end
function Steal:_position(state)
    if state.Wild then return { Position = state.Offer.Position, Model = state.Offer.Model } end
    local ctx = self.Context
    local plot = ctx.World:GetPlot(state.Owner)
    if not plot then return nil end
    local model = ctx.World.GetHouseModel and ctx.World:GetHouseModel(state.Owner, state.Id)
    return { Position = ctx.World:SlotPosition(plot, state.Record.Slot), Model = model }
end
function Steal:_holdValid(state)
    if not self:_valid(state, false) then return false end
    local ctx = self.Context
    if state.Wild and ctx.Progression:Speed(state.Player) < (state.Offer.RequiredSpeed or 0) then return false end
    local target = self:_position(state)
    return target ~= nil and ctx.AntiExploit:CanInteract(state.Player, target, ctx.Config.Game.InteractionRadius)
end
function Steal:_speed(player, carry)
    local ctx = self.Context
    if ctx.Progression.UpdateSpeed then ctx.Progression:UpdateSpeed(player); return end
    local _, humanoid = ctx.AntiExploit:Character(player)
    if humanoid then
        humanoid.WalkSpeed = carry and self.Context.Config.Game.CarrySpeed or self.Context.Progression:Speed(player)
    end
end
function Steal:_begin(player, record, owner, offer)
    local ctx = self.Context
    if self.Carriers[player] or self.Held[record.Id] or not self:_available(player) then return false end
    local slot = ctx.Houses:FreeSlot(player)
    if not slot then ctx.Notify(player, "Your base has no empty pad.", "Error"); return false end
    local token = ctx.HttpService:GenerateGUID(false)
    local state = { Id = record.Id, Record = record, Revision = record.Revision, Owner = owner,
        Player = player, Slot = slot, Token = token, Phase = "Hold", StartedAt = self.Now(),
        Wild = offer ~= nil, Offer = offer }
    ctx.Houses.Reserved[player] = ctx.Houses.Reserved[player] or {}
    ctx.Houses.Reserved[player][slot] = token
    self.Carriers[player], self.Held[state.Id] = state, state
    if not self:_holdValid(state) then self:Cancel(player); return false end
    if ctx.Progression.Train then ctx.Progression:Train(player, false) end
    self:_speed(player, false)
    ctx.Publish(player)
    return true
end
function Steal:Attempt(player, uid)
    if type(uid) ~= "string" or #uid > 100 then return false end
    local owner, record = self:_owner(uid)
    if not owner or owner == player or (record.BuildReadyAt or 0) > self.Context.Clock()
        or not self:_available(owner) or self.Context.Progression:IsLocked(owner) then return false end
    return self:_begin(player, record, owner, nil)
end
function Steal:AttemptWild(player, offerId)
    local ctx = self.Context
    if type(offerId) ~= "string" or #offerId > 100 or self.Carriers[player]
        or self.Held[offerId] or not self:_available(player) then return false end
    local offer = ctx.Wild:Get(offerId)
    if not offer or offer.Busy or ctx.Progression:Speed(player) < (offer.RequiredSpeed or 0)
        or not ctx.AntiExploit:CanInteract(player, offer, ctx.Config.Game.InteractionRadius) then return false end
    offer = ctx.Wild:Claim(offerId, player)
    if not offer then return false end
    local record = { Id = offer.Id, DefinitionId = offer.DefinitionId, Variant = offer.Variant, Size = offer.Size }
    if self:_begin(player, record, nil, offer) then return true end
    ctx.Wild:Release(offerId, player)
    return false
end
function Steal:_cleanup(state)
    local ctx, player = self.Context, state.Player
    if self.Held[state.Id] == state then self.Held[state.Id] = nil end
    if self.Carriers[player] == state then
        self.Carriers[player] = nil
        ctx.World:ClearCarry(player)
        self:_speed(player, false)
    end
    local reserved = ctx.Houses.Reserved[player]
    if reserved and reserved[state.Slot] == state.Token then reserved[state.Slot] = nil end
    for _, participant in ipairs({ player, state.Owner }) do
        if ctx.Houses.Busy[participant] == state.Token then ctx.Houses.Busy[participant] = nil end
    end
    ctx.Publish(player)
    if state.Owner then ctx.Publish(state.Owner) end
end
function Steal:_return(state, reason)
    local ctx = self.Context
    if state.Wild then
        ctx.Wild:Release(state.Id, state.Player)
    elseif state.Phase ~= "Hold" and self:_owner(state.Id) == state.Owner then
        local record = (ctx.Houses.Records[state.Owner] or {})[state.Id]
        if record and record.Revision == state.Revision and ctx.World:GetPlot(state.Owner) then
            ctx.World:RenderHouse(state.Owner, record)
        end
    end
    self:_cleanup(state)
    if reason then ctx.Notify(state.Player, reason, "Error") end
end
function Steal:Cancel(player, reason)
    local state = self.Carriers[player]
    if not state then return end
    if state.Phase == "Committing" then
        -- UpdateAsync may have committed while its response is still in flight.
        state.CancelReason = reason or "Carry interrupted."
        return
    end
    self:_return(state, reason)
end
function Steal:CancelForOwner(player)
    local states = {}
    for _, state in pairs(self.Held) do if state.Owner == player then table.insert(states, state) end end
    for _, state in ipairs(states) do self:Cancel(state.Player, "The original owner left.") end
end
function Steal:_carry(state)
    local ctx = self.Context
    state.Phase, state.CarriedAt = "Carry", self.Now()
    if state.Wild then
        state.Record.Size = state.Offer.Size -- Freeze server-grown size at pickup, never accept client size.
        ctx.World:RemovePrefab(state.Offer)
    else
        ctx.World:RemoveHouse(state.Owner, state.Id)
    end
    ctx.World:CarryModel(state.Player, state.Record)
    self:_speed(state.Player, true)
    ctx.Notify(state.Player, "Carry the house to your own base!", "Info")
    if state.Owner then ctx.Notify(state.Owner, "Someone is carrying your house! Use your bat.", "Warning") end
    ctx.Publish(state.Player)
end
function Steal:_settle(state, record, readKnown)
    local ctx = self.Context
    local committedRevision = if state.Wild then 1 else state.Revision + 1
    if record and record.OwnerId == state.Player.UserId and record.OperationId == state.Token
        and record.Revision == committedRevision and record.Slot == state.Slot then
        if state.Wild then ctx.Wild:Finish(state.Id, state.Player)
        else ctx.Houses:ApplyTransfer(state.Owner, state.Player, state.Record, record) end
        self:_cleanup(state)
        ctx.Notify(state.Player, "House secured!", "Success")
        return true
    end
    local profile = ctx.Data:Get(state.Player)
    if readKnown and ((not state.Wild and record and record.OwnerId == state.Owner.UserId
        and record.Revision == state.Revision) or (state.Wild and not record
        and not state.IntentPrepared and profile ~= nil and not profile.Pending)) then
        self:_return(state, state.CancelReason or "The transfer could not be completed. Try again.")
        return true
    end
    if readKnown and record and ((state.Wild)
        or record.OwnerId ~= state.Owner.UserId or record.Revision ~= state.Revision) then
        -- A later sale/transfer may win while this server awaits a response.
        -- A conclusive canonical change cannot be rolled back to our old copy.
        -- Refresh under the existing economic locks before releasing them.
        local participants, seen = { state.Player }, {}
        if state.Owner then table.insert(participants, state.Owner) end
        if ctx.Players and ctx.Players.GetPlayerByUserId and record.OwnerId ~= 0 then
            local owner = ctx.Players:GetPlayerByUserId(record.OwnerId)
            if owner then table.insert(participants, owner) end
        end
        for _, participant in ipairs(participants) do
            if not seen[participant] and ctx.Data:Get(participant) then
                seen[participant] = true
                local ok, refreshed = pcall(function() return ctx.Houses:Refresh(participant) end)
                if not ok or not refreshed then state.RetryAt = self.Now() + 3; return false end
            end
        end
        if state.Wild then ctx.Wild:Finish(state.Id, state.Player) end
        for participant in pairs(seen) do
            local current = (ctx.Houses.Records[participant] or {})[state.Id]
            if current and current.OwnerId == participant.UserId and ctx.World:GetPlot(participant) then
                -- Refresh suppresses held UIDs, so reveal the reconciled house
                -- explicitly before this transaction releases its locks.
                ctx.World:RenderHouse(participant, current)
            end
        end
        self:_cleanup(state)
        ctx.Notify(state.Player, "House ownership changed; your base has been refreshed.", "Warning")
        return true
    end
    -- Unknown commit outcomes keep the UID and pad frozen; never duplicate a house.
    state.RetryAt = self.Now() + 3
    return false
end
function Steal:_commit(state)
    if state.InFlight then return end
    local ctx = self.Context
    if state.Phase ~= "Committing" then
        if not self:_valid(state, true) then self:Cancel(state.Player, "Carry interrupted."); return end
        state.Phase = "Committing"
        ctx.Houses.Busy[state.Player] = state.Token
        if state.Owner then ctx.Houses.Busy[state.Owner] = state.Token end
    end
    state.InFlight = true
    self.Spawn(function()
        local record
        local ok = pcall(function()
            if state.Wild then
                record = ctx.Houses:SecureWild(state.Player, state.Offer, state)
            else
                record = ctx.Ownership:Transfer(state.Id, state.Owner.UserId, state.Revision,
                    state.Player.UserId, state.Slot, state.Token, function() return self:_valid(state, true) end)
            end
        end)
        if self.Carriers[state.Player] ~= state then state.InFlight = false; return end
        if ok and record then
            local settledOK, settled = pcall(function() return self:_settle(state, record, true) end)
            if settledOK and settled then state.InFlight = false; return end
        end
        local readOK, canonical, err = pcall(function() return ctx.Ownership:Get(state.Id) end)
        local settledOK = pcall(function()
            self:_settle(state, readOK and canonical or nil, readOK and not err)
        end)
        state.InFlight = false -- Keep the transaction locked through yielding reconciliation too.
        if not settledOK then state.RetryAt = self.Now() + 3 end
    end)
end
function Steal:CanCommit(state)
    return self:_valid(state, true)
end
function Steal:Bat(player)
    local ctx, now = self.Context, self.Now()
    if not self:_available(player) or self.Carriers[player]
        or now - (self.BatTimes[player] or -math.huge) < ctx.Config.Game.BatCooldown then return false end
    local root, humanoid = ctx.AntiExploit:Character(player)
    if not root or humanoid.FloorMaterial == Enum.Material.Air
        or not ctx.AntiExploit:ValidateMovement(player) then return false end
    local nearest, distance
    for carrier, state in pairs(self.Carriers) do
        local target = ctx.AntiExploit:Character(carrier)
        if carrier ~= player and state.Phase == "Carry" and target then
            local length = (target.Position - root.Position).Magnitude
            if length <= ctx.Config.Game.BatRange and (not distance or length < distance)
                and ctx.AntiExploit:CanInteract(player, { Position = target.Position, Model = carrier.Character }, ctx.Config.Game.BatRange) then
                nearest, distance = state, length
            end
        end
    end
    self.BatTimes[player] = now
    if not nearest then return false end
    local target = ctx.AntiExploit:Character(nearest.Player)
    self:Cancel(nearest.Player, "The bat stopped your escape!")
    if target then
        local delta = target.Position - root.Position
        local direction = delta.Magnitude > 0.01 and delta.Unit or root.CFrame.LookVector
        target.AssemblyLinearVelocity = direction * 28 + Vector3.new(0, 5, 0)
        ctx.AntiExploit:AllowTeleport(nearest.Player) -- A server-authorized knockback must not trigger rollback.
    end
    local profile = ctx.Data:Get(player)
    if profile and nearest.Owner == player then profile.Statistics.Defended += 1 end
    ctx.Publish(player)
    return true
end
function Steal:Tick(_dt)
    local states = {}
    for _, state in pairs(self.Carriers) do table.insert(states, state) end
    for _, state in ipairs(states) do
        if self.Carriers[state.Player] ~= state then continue end
        if state.Phase == "Committing" then
            if state.RetryAt and self.Now() >= state.RetryAt then self:_commit(state) end
        elseif state.Phase == "Hold" then
            if not self:_holdValid(state) then self:Cancel(state.Player, "Stay beside the house while stealing.")
            elseif self.Now() - state.StartedAt >= self.Context.Config.Game.StealHoldSeconds then self:_carry(state) end
        elseif not self:_valid(state, false) then self:Cancel(state.Player, "Carry interrupted.")
        elseif self.Now() - state.CarriedAt >= self.Context.Config.Game.CarryTimeoutSeconds then self:Cancel(state.Player, "Carry timed out.")
        else
            self:_speed(state.Player, true)
            if self.Context.World:AtHome(state.Player) then self:_commit(state) end
        end
    end
end
function Steal:Release(player)
    self:Cancel(player, "The carrier left.")
    self:CancelForOwner(player)
    self.BatTimes[player] = nil
end
return Steal
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">WildHouseService</string>
          <string name="Source"><![CDATA[-- NPC plots produce growing house boxes; all choices and growth happen here.
local Wild = {}
Wild.__index = Wild
function Wild.new(ctx)
    return setmetatable({ Context = ctx, Offers = {}, Sites = {}, Random = Random.new() }, Wild)
end
function Wild:_weighted(entries)
    local total = 0
    for _, entry in ipairs(entries) do total += entry.Weight end
    local choice = self.Random:NextNumber(0, total)
    for _, entry in ipairs(entries) do choice -= entry.Weight; if choice <= 0 then return entry end end
    return entries[#entries]
end
function Wild:_spawn(site)
    local ctx, eligible = self.Context, {}
    for _, definition in ipairs(ctx.Config.Houses) do
        local rank = ctx.Config.Rarities[definition.Rarity].Rank
        if rank == site.Tier or (site.Tier == 6 and rank == 7) then table.insert(eligible, definition) end
    end
    if #eligible == 0 then eligible = { ctx.Config.Houses[1] } end
    local definition, variant = self:_weighted(eligible), self:_weighted(ctx.Config.Variants)
    local offer = { Id = ctx.HttpService:GenerateGUID(false), DefinitionId = definition.Id,
        Variant = variant.Id, Size = "Normal", Position = site.Position, CreatedAt = ctx.Clock(),
        Site = site, RequiredSpeed = site.RequiredSpeed }
    offer.Model = ctx.World:CreatePrefab(offer)
    self.Offers[offer.Id], site.Offer = offer, offer
    return offer
end
function Wild:Start()
    self.Sites = self.Context.World.WildSites
    for _, site in ipairs(self.Sites) do self:_spawn(site) end
end
function Wild:Get(id) return self.Offers[id] end
function Wild:Claim(id, player)
    local offer = self.Offers[id]
    if not offer or offer.Busy then return nil end
    offer.Busy = player
    return offer
end
function Wild:Release(id, player)
    local offer = self.Offers[id]
    if not offer or offer.Busy ~= player then return end
    offer.Busy = nil
    if not offer.Model or not offer.Model.Parent then offer.Model = self.Context.World:CreatePrefab(offer) end
    self.Context.World:UpdateWild(offer)
end
function Wild:Finish(id, player)
    local offer = self.Offers[id]
    if not offer or offer.Busy ~= player then return end
    self.Context.World:RemovePrefab(offer)
    self.Offers[id], offer.Site.Offer = nil, nil
    offer.Site.NextSpawn = self.Context.Clock() + self.Context.Config.Game.WildRespawnSeconds
end
function Wild:Tick()
    local ctx = self.Context
    for _, site in ipairs(self.Sites) do
        local offer = site.Offer
        if not offer and ctx.Clock() >= (site.NextSpawn or 0) then self:_spawn(site)
        elseif offer then
            local state = offer.Busy and ctx.Steal.Carriers[offer.Busy]
            if not state or state.Phase == "Hold" then
                local age = math.max(0, offer.GrowthAge or 0, ctx.Clock() - offer.CreatedAt)
                offer.GrowthAge = age -- A wall-clock adjustment must never shrink an existing prefab.
                offer.Size = age >= ctx.Config.Game.GrowthGiantSeconds and "Giant"
                    or age >= ctx.Config.Game.GrowthBigSeconds and "Big" or "Normal"
                ctx.World:UpdateWild(offer)
            end
        end
    end
end
return Wild
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">WorldService</string>
          <string name="Source"><![CDATA[--!nonstrict
local Factory = require(script.Parent.ModelFactory)
local World = {}
World.__index = World
local Physics = game:GetService("PhysicsService")

local BASE_WIDTH, BASE_DEPTH = 132, 126
local BASE_COLORS = { "FF9589", "FFD378", "83D8B8", "82B9F3", "B49AEF", "F1A1D1", "7BD7DC" }
local DISTRICTS = {
    { Name = "Starter Lane", Speed = 20, Color = "8FDB9D" },
    { Name = "Garden Street", Speed = 26, Color = "AAD584" },
    { Name = "Metro Avenue", Speed = 34, Color = "88BCD9" },
    { Name = "Skyline Crescent", Speed = 42, Color = "AF9BDD" },
    { Name = "Royal Road", Speed = 52, Color = "E5BE79" },
    { Name = "Astral Heights", Speed = 64, Color = "E697D3" },
}

function World.new(ctx)
    return setmetatable({ Context = ctx, Plots = {}, Assigned = {}, WildSites = {}, Houses = {},
        Carry = {}, Accumulator = 0, CharacterConnections = {}, SiteOffers = {} }, World)
end

function World:_request(player, action, ...)
    if not self.Context.Closing then self.Context.Request(player, action, ...) end
end

function World:_prompt(part, action, object, callback, hold)
    return Factory.Prompt(part, action, object, self.Context.Config.Game.InteractionRadius, hold, callback)
end

function World:_touch(part, callback)
    local last = setmetatable({}, { __mode = "k" })
    part.Touched:Connect(function(hit)
        if hit.Name ~= "HumanoidRootPart" then return end
        local player = self.Context.Players:GetPlayerFromCharacter(hit.Parent)
        local now = self.Context.Now()
        if player and (not last[player] or now - last[player] >= 0.75) then
            last[player] = now
            callback(player)
        end
    end)
end

local function groupName(id) return "HouseBaseOwner" .. id end
local function gateName(id) return "HouseBaseGate" .. id end

function World:_collisionGroups()
    -- A base owner passes only their own gate. There is no shared owner bypass.
    local names = { "HouseVisitors" }
    for id = 1, self.Context.Config.Game.MaxPlayers do
        table.insert(names, groupName(id)); table.insert(names, gateName(id))
    end
    for _, name in ipairs(names) do
        if not Physics:IsCollisionGroupRegistered(name) then Physics:RegisterCollisionGroup(name) end
    end
    for id = 1, self.Context.Config.Game.MaxPlayers do
        Physics:CollisionGroupSetCollidable(gateName(id), groupName(id), false)
        Physics:CollisionGroupSetCollidable(gateName(id), "HouseVisitors", true)
        for other = 1, self.Context.Config.Game.MaxPlayers do
            if other ~= id then Physics:CollisionGroupSetCollidable(gateName(id), groupName(other), true) end
        end
    end
end

function World:_base(id, origin, rotation)
    local frame = CFrame.new(origin) * CFrame.Angles(0, rotation, 0)
    local model = Factory.Model(self.Model, "Base_" .. id)
    local color = BASE_COLORS[id]
    local plot = { Id = id, Origin = origin, Frame = frame, Model = model, Pads = {}, Rendered = {},
        Gates = {}, Capacity = self.Context.Config.Game.StartingSlots,
        Entry = frame:PointToWorldSpace(Vector3.new(0, 2, -65)),
        CollectPosition = frame:PointToWorldSpace(Vector3.new(-20, 2, -44)),
        LockPosition = frame:PointToWorldSpace(Vector3.new(20, 2, -44)),
        TreadmillPosition = frame:PointToWorldSpace(Vector3.new(43, 2, -43)),
        Spawn = frame:PointToWorldSpace(Vector3.new(0, 4, -45)) }
    Factory.Part(model, "Floor", Vector3.new(BASE_WIDTH, 1, BASE_DEPTH), frame, "E6E8DF", Enum.Material.Concrete)
    local gates = {
        { Vector3.new(BASE_WIDTH, 34, 0.8), Vector3.new(0, 17, -BASE_DEPTH / 2) },
        { Vector3.new(BASE_WIDTH, 34, 0.8), Vector3.new(0, 17, BASE_DEPTH / 2) },
        { Vector3.new(0.8, 34, BASE_DEPTH), Vector3.new(-BASE_WIDTH / 2, 17, 0) },
        { Vector3.new(0.8, 34, BASE_DEPTH), Vector3.new(BASE_WIDTH / 2, 17, 0) },
        { Vector3.new(BASE_WIDTH, 0.8, BASE_DEPTH), Vector3.new(0, 34, 0) },
    }
    for _, details in ipairs(gates) do
        local gate = Factory.Part(model, "LockBarrier", details[1], frame * CFrame.new(details[2]), color, Enum.Material.ForceField)
        gate.CollisionGroup, gate.CanTouch = gateName(id), false
        table.insert(plot.Gates, gate)
    end
    for _, x in ipairs({ -65, 65 }) do
        Factory.Part(model, "BaseColumn", Vector3.new(2, 14, 2), frame * CFrame.new(x, 7, -62), color)
    end
    local sign = Factory.Part(model, "OwnerSign", Vector3.new(48, 6, 1), frame * CFrame.new(0, 14, -62), color)
    plot.OwnerText = Factory.Label(sign, "AVAILABLE BASE " .. id, "FFFFFF", 68, 230)
    plot.OwnerText.Parent.StudsOffset = Vector3.new(0, 0, 0)
    local lock = Factory.Part(model, "LockPad", Vector3.new(10, 0.5, 10),
        frame * CFrame.new(20, 0.9, -44), "F09392", Enum.Material.Neon)
    plot.LockText = Factory.Label(lock, "LOCK BASE\n60 seconds", "FFFFFF", 60, 95)
    self:_prompt(lock, "Lock base", "Finite shield", function(player)
        if plot.Owner == player then self:_request(player, "Lock") end
    end)
    local collect = Factory.Part(model, "CollectAll", Vector3.new(13, 0.5, 10),
        frame * CFrame.new(-20, 0.9, -44), "76DEA7", Enum.Material.Neon)
    Factory.Label(collect, "COLLECT ALL RENT", "FFFFFF", 44, 95)
    self:_prompt(collect, "Collect all", "Your rent", function(player)
        if plot.Owner == player then self:_request(player, "CollectAll") end
    end)
    self:_touch(collect, function(player) if plot.Owner == player then self:_request(player, "CollectAll") end end)
    local treadmill = Factory.Part(model, "Treadmill", Vector3.new(10, 1.5, 8),
        frame * CFrame.new(43, 1.1, -43), "3F4B61")
    Factory.Part(model, "RunningBelt", Vector3.new(7, 0.3, 6), frame * CFrame.new(43, 2, -43), "202838")
    plot.TreadmillText = Factory.Label(treadmill, "TREADMILL 1\nTrain to reach faster streets", "9DEBFF", 66, 90)
    self:_prompt(treadmill, "Start training", "Earn speed", function(player)
        if plot.Owner == player then self:_request(player, "Train", true) end
    end)
    local shop = Factory.Part(model, "UpgradeKiosk", Vector3.new(9, 3, 6), frame * CFrame.new(-43, 2, -43), color)
    Factory.Label(shop, "BASE UPGRADES", "FFFFFF", 44, 90)
    self:_prompt(shop, "Open upgrades", "House shop", function(player) self:_request(player, "OpenShop") end)
    for slot = 1, self.Context.Config.Game.MaxSlots do
        local position = self:SlotPosition(plot, slot)
        local pad = Factory.Part(model, "HousePad_" .. slot, Vector3.new(19, 0.45, 19), CFrame.new(position), color)
        local rent = Factory.Part(model, "RentPad_" .. slot, Vector3.new(6, 0.35, 3),
            frame * CFrame.new(((slot - 1) % 5 - 2) * 24, 1.05, math.floor((slot - 1) / 5) * 23 - 21 - 10), "74D6A4")
        local text = Factory.Label(rent, "EMPTY SLOT " .. slot, "FFFFFF", 42, 65)
        text.Parent.StudsOffset = Vector3.new(0, 1.3, 0)
        local padState = { Part = pad, Rent = rent, Text = text }
        padState.Prompt = self:_prompt(rent, "Collect rent", "House " .. slot, function(player)
            if plot.Owner == player and padState.Uid then self:_request(player, "Collect", padState.Uid) end
        end)
        self:_touch(rent, function(player)
            if plot.Owner == player and padState.Uid then self:_request(player, "Collect", padState.Uid) end
        end)
        plot.Pads[slot] = padState
    end
    self.Plots[id] = plot
    self:SetOwner(plot, nil)
    self:SetLock(plot, false, 0)
    self:_slots(plot, plot.Capacity)
end

function World:_wildNeighborhood()
    local id = 0
    for street, roadX in ipairs({ -300, 0, 300 }) do
        Factory.Part(self.Model, "LandlordStreet_" .. street, Vector3.new(36, 0.4, 620),
            CFrame.new(roadX, 0.25, -540), "68717B", Enum.Material.Asphalt)
        for line = 1, 15 do
            Factory.Part(self.Model, "RoadMarking", Vector3.new(1.5, 0.1, 13),
                CFrame.new(roadX, 0.55, -235 - line * 38), "F9E4A8")
        end
        for row, z in ipairs({ -350, -525, -700 }) do
            for sideIndex, side in ipairs({ -1, 1 }) do
                id += 1
                local tier = (row - 1) * 2 + sideIndex
                local district = DISTRICTS[tier]
                local origin = Vector3.new(roadX + side * 96, 1, z)
                local frame = CFrame.lookAt(origin, Vector3.new(roadX, 1, z))
                local model = Factory.Model(self.Model, "LandlordPlot_" .. id)
                -- Adjacent streets leave only 108 studs between rear neighbors.
                -- Keep their ground plates separate to avoid overlapping surfaces.
                Factory.Part(model, "Territory", Vector3.new(100, 0.7, 106), frame, district.Color, Enum.Material.Grass)
                Factory.Part(model, "Walkway", Vector3.new(16, 0.2, 54), frame * CFrame.new(0, 0.6, -26), "E5D6BD")
                local landmark = { Color = district.Color, Style = tier >= 5 and "castle" or tier >= 3 and "modern" or "cottage" }
                Factory.House(model, "LandlordHome", frame * CFrame.new(0, 0.7, 28), landmark, { Color = "FFF2C8" }, 1.8, false)
                local guardFrame = frame * CFrame.new(17, 0.5, -24)
                local guard = Factory.Landlord(model, guardFrame, district.Color, tier)
                local sign = Factory.Part(model, "SpeedSign", Vector3.new(12, 5, 1), frame * CFrame.new(-22, 5, -50), "243149")
                Factory.Label(sign, district.Name .. "\nSPEED " .. district.Speed .. "+", "FFE7A0", 65, 140)
                local position = frame:PointToWorldSpace(Vector3.new(0, 0.8, -9))
                Factory.Part(model, "PrefabStand", Vector3.new(23, 0.5, 22), CFrame.new(position - Vector3.new(0, 0.5, 0)), "EEE2C6")
                table.insert(self.WildSites, { Id = "site_" .. id, Position = position, Model = model,
                    Frame = frame, Tier = tier, RequiredSpeed = district.Speed, GuardModel = guard,
                    GuardOrigin = guardFrame.Position, GuardFrame = guardFrame })
            end
        end
    end
end

function World:Init()
    self:_collisionGroups()
    local old = self.Context.Workspace:FindFirstChild("HouseNeighborhood")
    if old then old:Destroy() end
    self.Model = Factory.Model(self.Context.Workspace, "HouseNeighborhood")
    Factory.Part(self.Model, "Ground", Vector3.new(1090, 1, 1330), CFrame.new(0, -0.7, -380), "6DAD79", Enum.Material.Grass)
    Factory.Part(self.Model, "TownSquare", Vector3.new(650, 0.4, 182), CFrame.new(0, 0.1, 0), "C9C8B9", Enum.Material.Concrete)
    local arrival = Instance.new("SpawnLocation")
    arrival.Name, arrival.Size, arrival.CFrame = "TownArrival", Vector3.new(12, 1, 12), CFrame.new(0, 1, 62)
    arrival.Anchored, arrival.Neutral, arrival.Duration = true, true, 0
    arrival.Color, arrival.Material = Color3.fromRGB(152, 207, 216), Enum.Material.SmoothPlastic
    arrival.Parent = self.Model -- Safe waiting spawn while persistent profiles are loading.
    local fountain = Factory.Part(self.Model, "Fountain", Vector3.new(30, 1.5, 30), CFrame.new(0, 1, 0), "E4E8E8")
    Factory.Part(self.Model, "FountainWater", Vector3.new(26, 0.3, 26), CFrame.new(0, 1.9, 0), "77D4EE", Enum.Material.Glass)
    Factory.Part(self.Model, "FountainPillar", Vector3.new(4, 7, 4), CFrame.new(0, 5, 0), "E4E8E8")
    Factory.Label(fountain, "STEAL A HOUSE\nSteal a prefab • Build • Collect rent • Train", "FFFFFF", 68, 230)
    local market = Factory.Part(self.Model, "TownShop", Vector3.new(16, 5, 9), CFrame.new(-45, 3, 0), "F0B778")
    Factory.Label(market, "HOUSE SHOP + UPGRADES", "FFFFFF", 45, 130)
    self:_prompt(market, "Open shop", "Buy a house", function(player) self:_request(player, "OpenShop") end)
    local board = Factory.Part(self.Model, "Standings", Vector3.new(26, 14, 2), CFrame.new(45, 8, 0), "243149")
    self.StandingsText = Factory.Label(board, "TOWN STANDINGS\nWaiting for residents", "FFF2BC", 170, 140)
    self.StandingsText.Parent.StudsOffset = Vector3.new(0, 0, 0)
    self.StandingsText.Parent.Size = UDim2.fromOffset(360, 250)
    for id, x in ipairs({ -222, -74, 74, 222 }) do self:_base(id, Vector3.new(x, 1, -170), math.pi) end
    for index, x in ipairs({ -148, 0, 148 }) do self:_base(index + 4, Vector3.new(x, 1, 170), 0) end
    self:_wildNeighborhood()
end

function World:SlotPosition(plot, slot)
    if type(slot) ~= "number" or slot < 1 or slot > self.Context.Config.Game.MaxSlots or slot % 1 ~= 0 then return nil end
    return plot.Frame:PointToWorldSpace(Vector3.new(((slot - 1) % 5 - 2) * 24, 0.8,
        math.floor((slot - 1) / 5) * 23 - 21))
end

function World:SetOwner(plot, player)
    plot.Owner = player
    plot.Model:SetAttribute("OwnerId", player and player.UserId or 0)
    plot.OwnerText.Text = player and (player.DisplayName .. "'s BASE\nSteal houses • Collect rent") or ("AVAILABLE BASE " .. plot.Id)
end

function World:Assign(player)
    if self.Assigned[player] then return self.Assigned[player] end
    for _, plot in ipairs(self.Plots) do
        if not plot.Owner then
            self.Assigned[player], self.Houses[player] = plot, {}
            self:SetOwner(plot, player)
            self:SetCharacterGroup(player)
            return plot
        end
    end
    return nil
end

function World:GetPlot(player) return self.Assigned[player] end

function World:Inside(player, plot)
    if not plot then return false end
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    local localPosition = plot.Frame:PointToObjectSpace(root.Position)
    return math.abs(localPosition.X) < BASE_WIDTH / 2 - 2
        and math.abs(localPosition.Z) < BASE_DEPTH / 2 - 2
        and localPosition.Y >= -1 and localPosition.Y <= 15
end

function World:AtHome(player) return self:Inside(player, self:GetPlot(player)) end

function World:SetCharacterGroup(player)
    local connection = self.CharacterConnections[player]
    if connection then connection:Disconnect(); self.CharacterConnections[player] = nil end
    local character = player.Character
    if not character then return end
    local plot = self:GetPlot(player)
    local group = plot and groupName(plot.Id) or "HouseVisitors"
    local function set(part) if part:IsA("BasePart") then part.CollisionGroup = group end end
    for _, part in ipairs(character:GetDescendants()) do set(part) end
    self.CharacterConnections[player] = character.DescendantAdded:Connect(set)
end

function World:SetLock(plot, locked, remaining)
    if not plot then return end
    plot.Locked, plot.LockRemaining = locked == true, math.max(0, remaining or 0)
    plot.Model:SetAttribute("Locked", plot.Locked)
    for _, gate in ipairs(plot.Gates) do
        gate.CanCollide, gate.CanQuery = plot.Locked, plot.Locked
        gate.Transparency = plot.Locked and 0.63 or 1
    end
    plot.LockText.Text = plot.Locked and ("BASE LOCKED\n" .. math.ceil(plot.LockRemaining) .. " seconds") or "LOCK BASE\nFinite shield"
end

function World:_slots(plot, capacity)
    plot.Capacity = math.clamp(math.floor(capacity), 1, #plot.Pads)
    for slot, pad in ipairs(plot.Pads) do
        local enabled = slot <= plot.Capacity
        pad.Part.Transparency, pad.Rent.Transparency = enabled and 0.15 or 0.8, enabled and 0 or 0.8
        pad.Part.Color = enabled and Factory.Color(BASE_COLORS[plot.Id]) or Color3.fromRGB(82, 87, 99)
        pad.Prompt.Enabled = enabled and pad.Uid ~= nil
        if not pad.Uid then pad.Text.Text = enabled and ("EMPTY SLOT " .. slot) or "UPGRADE BASE\nUnlock slot" end
    end
end

function World:UpdateSlots(player, capacity)
    local plot = self:GetPlot(player)
    if plot then self:_slots(plot, capacity) end
end

function World:UpdateTreadmill(player, level, training)
    local plot = self:GetPlot(player)
    if plot then plot.TreadmillText.Text = "TREADMILL " .. tostring(level) .. (training and "\nTRAINING • Earn speed" or "\nTrain to reach faster streets") end
end

function World:_size(id)
    local definition = self.Context.Config.SizeById and self.Context.Config.SizeById[id]
    return definition and (definition.Scale or definition.SizeScale) or (id == "Giant" and 1.5 or id == "Big" and 1.25 or 1)
end

function World:RenderHouse(player, record)
    local plot = self:GetPlot(player)
    local definition = self.Context.Config.HouseById[record.DefinitionId]
    if not plot or not definition then return nil end
    local position = self:SlotPosition(plot, record.Slot)
    if not position then return nil end
    self:RemoveHouse(player, record.Id)
    local construction = (record.BuildReadyAt or 0) > self.Context.Clock()
    local frame = CFrame.new(position) * plot.Frame.Rotation
    local variant = self.Context.Config.VariantById[record.Variant]
    local model, anchor = Factory.House(plot.Model, "House_" .. record.Id, frame, definition, variant, self:_size(record.Size), construction)
    model:SetAttribute("HouseId", record.Id)
    model:SetAttribute("HouseUID", record.Id)
    model:SetAttribute("OwnerId", player.UserId)
    model:SetAttribute("DefinitionId", record.DefinitionId)
    local rarity = self.Context.Config.Rarities[definition.Rarity]
    local text = Factory.Label(anchor, definition.Name, rarity and rarity.Color, 77, 115)
    local promptPart = Factory.Part(model, "HousePrompt", Vector3.new(1, 1, 1), frame * CFrame.new(0, 3, -9), "FFFFFF")
    promptPart.Transparency, promptPart.CanCollide, promptPart.CanTouch, promptPart.CanQuery = 1, false, false, false
    local prompt = self:_prompt(promptPart, "Take / manage house", definition.Name, function(visitor)
        if visitor == player then self:_request(visitor, "Sell", record.Id, false)
        else self:_request(visitor, "Steal", record.Id) end
    end, 0) -- The server performs the two-second hold and publishes progress.
    -- Prompt range and server distance both use the house's slot center.
    prompt.MaxActivationDistance = math.max(2, self.Context.Config.Game.InteractionRadius - 9)
    local state = { Model = model, Record = record, Label = text, Prompt = prompt, Construction = construction, Amount = 0 }
    self.Houses[player] = self.Houses[player] or {}
    self.Houses[player][record.Id] = state
    plot.Rendered[record.Id] = state
    local pad = plot.Pads[record.Slot]
    pad.Uid = record.Id
    pad.Prompt.Enabled = record.Slot <= plot.Capacity
    self:UpdateIncome(player, record.Id, 0)
    return model
end

function World:GetHouseModel(player, uid)
    local state = self.Houses[player] and self.Houses[player][uid]
    return state and state.Model or nil
end

function World:RemoveHouse(player, uid)
    local houses = self.Houses[player]
    local state = houses and houses[uid]
    if not state then return end
    local plot = self:GetPlot(player)
    if plot then
        local pad = plot.Pads[state.Record.Slot]
        if pad and pad.Uid == uid then
            pad.Uid, pad.Prompt.Enabled = nil, false
            pad.Text.Text = state.Record.Slot <= plot.Capacity and ("EMPTY SLOT " .. state.Record.Slot) or "UPGRADE BASE\nUnlock slot"
        end
        plot.Rendered[uid] = nil
    end
    state.Model:Destroy()
    houses[uid] = nil
end

function World:UpdateIncome(player, uid, amount)
    local state = self.Houses[player] and self.Houses[player][uid]
    local plot = self:GetPlot(player)
    if not state or not plot then return end
    state.Amount = math.max(0, amount or 0)
    local definition = self.Context.Config.HouseById[state.Record.DefinitionId]
    local remaining = math.max(0, (state.Record.BuildReadyAt or 0) - self.Context.Clock())
    state.Label.Text = definition.Name .. "\n" .. tostring(state.Record.Variant) .. " • " .. tostring(state.Record.Size)
        .. (remaining > 0 and ("\nBUILDING " .. math.ceil(remaining) .. "s") or "")
    plot.Pads[state.Record.Slot].Text.Text = "COLLECT " .. Factory.Money(state.Amount)
end

function World:CarryModel(player, record)
    self:ClearCarry(player)
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    local definition = self.Context.Config.HouseById[record.DefinitionId]
    if not root or not definition then return nil end
    local variant = self.Context.Config.VariantById[record.Variant]
    local model = Factory.House(self.Model, "CarriedPrefab_" .. player.UserId,
        root.CFrame * CFrame.new(0, 1, -4), definition, variant, 0.43 * self:_size(record.Size), true)
    for _, part in ipairs(model:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Anchored, part.CanCollide, part.CanTouch, part.CanQuery, part.Massless = false, false, false, false, true
            local weld = Instance.new("WeldConstraint")
            weld.Part0, weld.Part1, weld.Parent = root, part, part
        end
    end
    model:SetAttribute("HouseId", record.Id)
    model:SetAttribute("HouseUID", record.Id)
    self.Carry[player] = model
    return model
end

function World:ClearCarry(player)
    local model = self.Carry[player]
    if model then model:Destroy(); self.Carry[player] = nil end
end

function World:_offerFrame(offer)
    local site
    for _, candidate in ipairs(self.WildSites) do
        if candidate.Id == offer.SiteId or candidate == offer.Site then site = candidate; break end
    end
    return CFrame.new(offer.Position) * (site and site.Frame.Rotation or CFrame.new())
end

function World:CreatePrefab(offer)
    self:RemovePrefab(offer)
    local definition = self.Context.Config.HouseById[offer.DefinitionId]
    if not definition then return nil end
    local variant = self.Context.Config.VariantById[offer.Variant]
    local model, anchor = Factory.House(self.Model, "WildPrefab_" .. offer.Id, self:_offerFrame(offer),
        definition, variant, self:_size(offer.Size), true)
    model:SetAttribute("OfferId", offer.Id)
    local rarity = self.Context.Config.Rarities[definition.Rarity]
    offer.WorldLabel = Factory.Label(anchor, definition.Name, rarity and rarity.Color, 88, 130)
    -- RequiresLineOfSight prompts cannot be embedded inside the opaque crate.
    local promptPart = Factory.Part(model, "PrefabPrompt", Vector3.new(1, 1, 1),
        self:_offerFrame(offer) * CFrame.new(0, 3, -5.4 * self:_size(offer.Size) - 1), "FFFFFF")
    promptPart.Transparency, promptPart.CanCollide, promptPart.CanTouch, promptPart.CanQuery = 1, false, false, false
    offer.WorldPrompt = self:_prompt(promptPart, "Steal prefab box", definition.Name, function(player)
        self:_request(player, "WildSteal", offer.Id)
    end, 0) -- No second client-side timer before the server's timed hold.
    offer.WorldPrompt.MaxActivationDistance = math.max(2,
        self.Context.Config.Game.InteractionRadius - (5.4 * self:_size(offer.Size) + 1))
    offer.Model, offer.WorldSize = model, offer.Size
    self.SiteOffers[offer.Id] = offer
    self:UpdateWild(offer)
    return model
end

function World:MovePrefab(offer, position)
    offer.Position = position
    if offer.Model then
        local current = offer.Model:GetPivot()
        offer.Model:PivotTo(CFrame.new(position + Vector3.new(0, 5 * self:_size(offer.Size), 0)) * current.Rotation)
    end
end

function World:RemovePrefab(offer)
    if offer.Model then offer.Model:Destroy(); offer.Model = nil end
    offer.WorldLabel, offer.WorldPrompt = nil, nil
    self.SiteOffers[offer.Id] = nil
end

function World:UpdateWild(offer)
    if not offer.Model then return end
    if offer.WorldSize ~= offer.Size then self:CreatePrefab(offer); return end
    local definition = self.Context.Config.HouseById[offer.DefinitionId]
    offer.WorldLabel.Text = definition.Name .. "\n" .. tostring(offer.Variant) .. " • " .. tostring(offer.Size)
        .. "\nSPEED " .. tostring(offer.RequiredSpeed or 20) .. "+" .. (offer.Busy and " • RESERVED" or " • GROWING")
    offer.WorldPrompt.Enabled = offer.Busy == nil or offer.Busy == false
end

function World:RestoreGuard(site)
    if site.GuardModel then site.GuardModel:PivotTo(site.GuardFrame) end
end

function World:UpdateStandings(players)
    local lines = { "TOWN STANDINGS" }
    for index, entry in ipairs(players) do
        if index > 7 then break end
        table.insert(lines, index .. ". " .. tostring(entry.Name) .. " • " .. Factory.Money(entry.Cash)
            .. " • " .. Factory.Money(entry.Income) .. "/s")
    end
    self.StandingsText.Text = table.concat(lines, "\n")
end

function World:Tick(dt)
    self.Accumulator += dt
    if self.Accumulator < 1 then return end
    self.Accumulator %= 1
    local rebuild = {}
    for player, records in pairs(self.Houses) do
        for _, state in pairs(records) do
            if state.Construction and (state.Record.BuildReadyAt or 0) <= self.Context.Clock() then
                table.insert(rebuild, { Player = player, Record = state.Record, Amount = state.Amount })
            else self:UpdateIncome(player, state.Record.Id, state.Amount) end
        end
    end
    for _, entry in ipairs(rebuild) do
        self:RenderHouse(entry.Player, entry.Record)
        self:UpdateIncome(entry.Player, entry.Record.Id, entry.Amount)
        if self.Context.Notify then self.Context.Notify(entry.Player, "Your " .. self.Context.Config.HouseById[entry.Record.DefinitionId].Name .. " is built and earning rent!", "Built") end
    end
end

function World:Release(player)
    self:ClearCarry(player)
    local plot = self:GetPlot(player)
    if plot then
        local ids = {}
        for uid in pairs(self.Houses[player] or {}) do table.insert(ids, uid) end
        for _, uid in ipairs(ids) do self:RemoveHouse(player, uid) end
        self:SetOwner(plot, nil)
        self:SetLock(plot, false, 0)
        self:_slots(plot, self.Context.Config.Game.StartingSlots)
        plot.TreadmillText.Text = "TREADMILL 1\nTrain to reach faster streets"
    end
    self.Assigned[player], self.Houses[player] = nil, nil
    self:SetCharacterGroup(player)
    local connection = self.CharacterConnections[player]
    if connection then connection:Disconnect(); self.CharacterConnections[player] = nil end
end

function World:Shutdown()
    local players = {}
    for player in pairs(self.Assigned) do table.insert(players, player) end
    for _, player in ipairs(players) do self:Release(player) end
    if self.Model then self.Model:Destroy(); self.Model = nil end
    self.Plots, self.WildSites, self.SiteOffers = {}, {}, {}
end

return World
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="22">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="23">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="24">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--!nonstrict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local UIController = require(script:WaitForChild("UIController"))
local InputController = require(script:WaitForChild("InputController"))
local NotificationController = require(script:WaitForChild("NotificationController"))
local AudioController = require(script:WaitForChild("AudioController"))
local remotes = ReplicatedStorage:WaitForChild("HouseRemotes")
local request = remotes:WaitForChild("Request")
local ui = UIController.new({ Config = Config, Request = function(action, ...) request:FireServer(action, ...) end })
local notifications = NotificationController.new(ui)
local audio = AudioController.new(Config)
local input = InputController.new(ui)
local connections = {}
local received = false
local lastMode, paused = nil, false
table.insert(connections, remotes:WaitForChild("Snapshot").OnClientEvent:Connect(function(snapshot)
    if type(snapshot) ~= "table" then return end
    received = true
    ui:SetSnapshot(snapshot)
    if snapshot.Profile then
        notifications:SetSettings(snapshot.Profile.Settings)
        audio:SetSettings(snapshot.Profile.Settings)
    end
    local runtime = snapshot.Runtime or {}
    if runtime.DataMode ~= lastMode then
        lastMode = runtime.DataMode
        if lastMode == "StudioMemory" then
            notifications:Push("Studio temporary mode: this test session does not save your progress.", "Announcement")
        end
    end
    local nowPaused = runtime.Writable ~= true
    if nowPaused and not paused then
        notifications:Push("Your data could not be safely saved. Gameplay actions are paused until the server recovers.", "Error")
        input:SetSprint(false)
    end
    paused = nowPaused
end))
table.insert(connections, remotes:WaitForChild("Notification").OnClientEvent:Connect(function(text, kind, extra)
    notifications:Push(text, kind, extra)
    audio:Notify(kind)
end))
table.insert(connections, remotes:WaitForChild("Announcement").OnClientEvent:Connect(function(text)
    notifications:Push(text, "Announcement")
end))
local retry = task.spawn(function()
    while not received and ui.Gui.Parent do
        request:FireServer("Sync")
        task.wait(5)
        if not received then ui.Status.Text = "Loading your base and saved data… reconnect if this message stays visible." end
    end
end)
script.Destroying:Connect(function()
    if coroutine.status(retry) ~= "dead" then task.cancel(retry) end
    for _, connection in ipairs(connections) do connection:Disconnect() end
    input:Destroy()
    notifications:Destroy()
    audio:Destroy()
    ui:Destroy()
end)
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">AudioController</string>
            <string name="Source"><![CDATA[-- Optional, bounded client audio. Empty configuration IDs keep the game silent.
local SoundService = game:GetService("SoundService")
local Audio = {}
Audio.__index = Audio

local notificationSounds = {
    Stolen = "Steal", Collected = "Collect", Built = "Build", Rare = "Rare",
    Success = "Buy", Hit = "Hit",
}

local function soundId(value)
    if type(value) ~= "string" and type(value) ~= "number" then return nil end
    local id = tostring(value):match("^rbxassetid://(%d+)$") or tostring(value):match("^(%d+)$")
    if not id or tonumber(id) == 0 then return nil end
    return "rbxassetid://" .. id
end

function Audio.new(config)
    local self = setmetatable({ Sounds = {}, MusicEnabled = true, SFXEnabled = true }, Audio)
    self.Folder = Instance.new("Folder")
    self.Folder.Name = "StealAHouseAudio"
    self.Folder.Parent = SoundService
    for key, value in pairs(config.Game.Audio or {}) do
        local id = soundId(value)
        if id then
            local sound = Instance.new("Sound")
            sound.Name, sound.SoundId = key, id
            sound.Volume = if key == "Music" then 0.2 else 0.35
            sound.Looped = key == "Music"
            sound.Parent = self.Folder
            self.Sounds[key] = sound
        end
    end
    return self
end

function Audio:SetSettings(settings)
    settings = settings or {}
    self.MusicEnabled, self.SFXEnabled = settings.Music ~= false, settings.SFX ~= false
    local music = self.Sounds.Music
    if music then
        if self.MusicEnabled and not music.IsPlaying then music:Play()
        elseif not self.MusicEnabled then music:Stop() end
    end
    if not self.SFXEnabled then
        for key, sound in pairs(self.Sounds) do if key ~= "Music" then sound:Stop() end end
    end
end

function Audio:Notify(kind)
    if not self.SFXEnabled then return end
    local sound = self.Sounds[notificationSounds[kind]]
    if sound then sound:Stop(); sound:Play() end
end

function Audio:Destroy()
    self.Folder:Destroy()
    self.Sounds = {}
end

return Audio
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">InputController</string>
            <string name="Source"><![CDATA[--!nonstrict
local ContextActionService = game:GetService("ContextActionService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local GuiService = game:GetService("GuiService")
local Input = {}
Input.__index = Input

function Input.new(ui)
    local self = setmetatable({ UI = ui, Sprinting = false, Bound = {}, Connections = {} }, Input)
    local function bind(name, callback, ...)
        local key = "StealAHouse_" .. name
        table.insert(self.Bound, key)
        ContextActionService:BindAction(key, function(_, state)
            -- A key released while a menu or chat box is open must still stop
            -- held sprinting; opening UI never swallows the release edge.
            if state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
                callback(state)
                return Enum.ContextActionResult.Pass
            end
            if UserInputService:GetFocusedTextBox() then return Enum.ContextActionResult.Pass end
            if ui.Menu then return Enum.ContextActionResult.Sink end
            callback(state)
            return Enum.ContextActionResult.Sink
        end, false, ...)
    end
    bind("Bat", function(state) if state == Enum.UserInputState.Begin then ui:Request("Bat") end end, Enum.KeyCode.R, Enum.KeyCode.ButtonR2)
    bind("Sprint", function(state)
        if state == Enum.UserInputState.Begin then self:SetSprint(true)
        elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then self:SetSprint(false) end
    end, Enum.KeyCode.LeftShift)
    bind("SprintToggle", function(state) if state == Enum.UserInputState.Begin then self:SetSprint(not self.Sprinting) end end, Enum.KeyCode.ButtonL3)
    bind("Train", function(state)
        if state == Enum.UserInputState.Begin then ui:Request("Train", not ui:IsTraining()) end
    end, Enum.KeyCode.T, Enum.KeyCode.ButtonY)
    bind("Lock", function(state) if state == Enum.UserInputState.Begin then ui:Request("Lock") end end, Enum.KeyCode.L)
    bind("Collect", function(state) if state == Enum.UserInputState.Begin then ui:Request("CollectAll") end end, Enum.KeyCode.V)
    local function menuAction(name, keys, callback)
        local key = "StealAHouse_" .. name
        table.insert(self.Bound, key)
        ContextActionService:BindAction(key, function(_, state)
            if UserInputService:GetFocusedTextBox() then return Enum.ContextActionResult.Pass end
            if state == Enum.UserInputState.Begin and callback() then return Enum.ContextActionResult.Sink end
            return Enum.ContextActionResult.Pass
        end, false, table.unpack(keys))
    end
    menuAction("Menu", { Enum.KeyCode.DPadUp }, function()
        if ui.Menu then return false end -- Up navigates menus; X remains available for world prompts.
        ui:Open("Houses")
        if ui.Menu then GuiService.SelectedObject = ui.CloseButton end
        return true
    end)
    menuAction("CloseMenu", { Enum.KeyCode.ButtonB }, function()
        if not ui.Menu then return false end
        ui:Close()
        return true
    end)
    ui:SetControls({ Sprint = function(enabled) self:SetSprint(enabled) end })
    table.insert(self.Connections, Players.LocalPlayer.CharacterAdded:Connect(function() self:SetSprint(false) end))
    table.insert(self.Connections, UserInputService.WindowFocusReleased:Connect(function() self:SetSprint(false) end))
    return self
end

function Input:SetSprint(enabled)
    enabled = enabled == true
    if enabled and not self.UI:CanAct() then return end
    if self.Sprinting == enabled then return end
    self.Sprinting = enabled
    self.UI:SetSprint(enabled)
    self.UI:Request("Sprint", enabled)
end

function Input:Destroy()
    self:SetSprint(false)
    for _, name in ipairs(self.Bound) do ContextActionService:UnbindAction(name) end
    for _, connection in ipairs(self.Connections) do connection:Disconnect() end
end

return Input
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">NotificationController</string>
            <string name="Source"><![CDATA[--!nonstrict
local Widgets = require(script.Parent.Widgets)
local TweenService = game:GetService("TweenService")
local Notifications = {}
Notifications.__index = Notifications

function Notifications.new(ui)
    local self = setmetatable({ UI = ui, Queue = {}, Running = false, Destroyed = false }, Notifications)
    ui.Toast = function(text, kind) self:Push(text, kind) end
    return self
end

function Notifications:SetSettings(settings)
    self.ReducedEffects = settings and settings.ReducedEffects == true
    if self.ReducedEffects and self.Tween then
        self.Tween:Cancel()
        if self.Current then
            self.Current.BackgroundTransparency, self.Current.TextTransparency = 0, 0
        end
    end
end

function Notifications:Push(text, kind, extra)
    if self.Destroyed or type(text) ~= "string" then return end
    if kind == "Shop" then
        if self.UI.Menu ~= "Shop" then self.UI:Open("Shop") end
        return
    end
    if kind == "ConfirmSell" then
        if type(extra) == "string" then self.UI:Open("Sell", extra) end
        return
    end
    if #self.Queue >= 6 then table.remove(self.Queue, 1) end
    table.insert(self.Queue, { Text = text:sub(1, 420), Kind = kind })
    self:ShowNext()
end

function Notifications:ShowNext()
    if self.Running or self.Destroyed or #self.Queue == 0 then return end
    self.Running = true
    local entry = table.remove(self.Queue, 1)
    local color = if entry.Kind == "Error" then Widgets.Colors.Danger
        elseif entry.Kind == "Announcement" then Widgets.Colors.Orange else Widgets.Colors.Teal
    local label = Widgets.Make("TextLabel", {
        Size = UDim2.fromScale(1, 1), BackgroundColor3 = color, BorderSizePixel = 0,
        Text = entry.Text, TextColor3 = Widgets.Colors.Text, TextWrapped = true,
        TextSize = 16, Font = Enum.Font.GothamBold, ZIndex = 20,
    }, self.UI.NoticeArea)
    Widgets.Round(label, 12)
    Widgets.Make("UIPadding", {
        PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12),
        PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6),
    }, label)
    label.TextScaled = true
    Widgets.Make("UITextSizeConstraint", { MinTextSize = 11, MaxTextSize = 16 }, label)
    self.Current = label
    if not self.ReducedEffects then
        label.BackgroundTransparency, label.TextTransparency = 1, 1
        self.Tween = TweenService:Create(label, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundTransparency = 0, TextTransparency = 0,
        })
        self.Tween:Play()
    end
    self.Timer = task.delay(5, function()
        if self.Destroyed then return end
        label:Destroy()
        self.Current, self.Running = nil, false
        self:ShowNext()
    end)
end

function Notifications:Destroy()
    self.Destroyed = true
    if self.Tween then self.Tween:Cancel() end
    if self.Timer and coroutine.status(self.Timer) ~= "dead" then task.cancel(self.Timer) end
    if self.Current then self.Current:Destroy() end
    self.Queue = {}
end

return Notifications
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">UIController</string>
            <string name="Source"><![CDATA[--!nonstrict
-- This controller displays server snapshots. Prices, ownership and timers are
-- never supplied by the client when requesting an action.
local Players = game:GetService("Players")
local GuiService = game:GetService("GuiService")
local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")
local Widgets = require(script.Parent.Widgets)
local C = Widgets.Colors
local UI = {}
UI.__index = UI

local function money(value) return "$" .. Widgets.Number(value) end
local function seconds(value) return tostring(math.max(0, math.ceil(tonumber(value) or 0))) .. "s" end
local function childrenSignature(rows)
    local parts = {}
    for _, row in ipairs(rows or {}) do
        table.insert(parts, table.concat({ tostring(row.Id), tostring(row.DefinitionId),
            tostring(row.Slot), tostring(row.Variant), tostring(row.Size) }, ":"))
    end
    return table.concat(parts, "|")
end

function UI.new(context)
    local self = setmetatable({
        Config = context.Config, Send = context.Request, Snapshot = nil,
        Menu = nil, SellUid = nil, Connections = {}, MenuButtons = {},
        Cards = {}, ActionButtons = {}, Controls = {}, Sprinting = false,
    }, UI)
    self:Build()
    return self
end

function UI:CanAct()
    return self.Snapshot ~= nil and self.Snapshot.Profile ~= nil
        and self.Snapshot.Runtime ~= nil and self.Snapshot.Runtime.Writable == true
        and self.Snapshot.Profile.Pending == nil
end

function UI:IsTraining()
    return self.Snapshot ~= nil and self.Snapshot.Runtime ~= nil
        and self.Snapshot.Runtime.Training == true
end

function UI:Request(action, ...)
    local stopping = (action == "Sprint" or action == "Train") and select(1, ...) == false
    if action ~= "Sync" and not stopping and not self:CanAct() then
        if self.Toast then
            local pending = self.Snapshot and self.Snapshot.Profile and self.Snapshot.Profile.Pending
            self.Toast(if pending then "Finish your current house transaction before starting another action."
                else "Your saved data is unavailable. Actions are paused.", "Error")
        end
        return
    end
    self.Send(action, ...)
end

function UI:Build()
    local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
    local existing = playerGui:FindFirstChild("StealAHouseUI")
    if existing then existing:Destroy() end
    self.Gui = Widgets.Make("ScreenGui", {
        Name = "StealAHouseUI", ResetOnSpawn = false, IgnoreGuiInset = false,
        DisplayOrder = 10, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        ScreenInsets = Enum.ScreenInsets.DeviceSafeInsets,
    }, playerGui)
    self.Hud = Widgets.Make("Frame", {
        Position = UDim2.fromOffset(12, 8), Size = UDim2.fromOffset(470, 88),
        BackgroundColor3 = C.Panel, BorderSizePixel = 0,
    }, self.Gui)
    Widgets.Round(self.Hud, 14)
    self.Title = Widgets.Text(self.Hud, "STEAL A HOUSE", 24, C.Text, 18)
    self.Title.Position, self.Title.Size = UDim2.fromOffset(12, 4), UDim2.new(1, -24, 0, 24)
    self.Cash = Widgets.Text(self.Hud, "Loading your town…", 24, C.Text, 17)
    self.Cash.Position, self.Cash.Size = UDim2.fromOffset(12, 28), UDim2.new(1, -24, 0, 24)
    self.Rate = Widgets.Text(self.Hud, "Rent and speed will appear here", 20, C.Muted, 13)
    self.Rate.Position, self.Rate.Size = UDim2.fromOffset(12, 55), UDim2.new(1, -24, 0, 22)
    self.Status = Widgets.Make("TextLabel", {
        AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 103),
        Size = UDim2.new(1, -26, 0, 52), BackgroundColor3 = C.Panel,
        BackgroundTransparency = 0.08, BorderSizePixel = 0,
        Text = "Waiting for the server…", TextColor3 = C.Text,
        TextWrapped = true, TextSize = 14, Font = Enum.Font.GothamMedium,
    }, self.Gui)
    Widgets.Round(self.Status, 12)
    self.MenuRail = Widgets.Make("Frame", {
        Position = UDim2.fromOffset(12, 167), Size = UDim2.fromOffset(108, 226),
        BackgroundTransparency = 1,
    }, self.Gui)
    local menuLayout = Widgets.Make("UIListLayout", { Padding = UDim.new(0, 6) }, self.MenuRail)
    for _, name in ipairs({ "Houses", "Shop", "Index", "Standings" }) do
        local button = Widgets.Button(self.MenuRail, name, function() self:Open(name) end, C.Panel)
        button.Name = name
        self.MenuButtons[name] = button
    end
    local utility = Widgets.Make("Frame", {
        AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 10),
        Size = UDim2.fromOffset(94, 84), BackgroundTransparency = 1,
    }, self.Gui)
    Widgets.Make("UIListLayout", { Padding = UDim.new(0, 6) }, utility)
    Widgets.Button(utility, "Daily", function() self:Open("Daily") end, C.Orange)
    Widgets.Button(utility, "Settings", function() self:Open("Settings") end, C.Panel)
    self.Utility = utility
    self.ControlBar = Widgets.Make("Frame", {
        AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -12),
        Size = UDim2.fromOffset(500, 48), BackgroundTransparency = 1,
    }, self.Gui)
    local definitions = {
        { "Bat", "Bat [R]", function() self:Request("Bat") end },
        { "Sprint", "Run [Shift]", function()
            if self.Controls.Sprint then self.Controls.Sprint(not self.Sprinting) end
        end },
        { "Train", "Train [T]", function() self:Request("Train", not self:IsTraining()) end },
        { "Lock", "Lock [L]", function() self:Request("Lock") end },
        { "Collect", "Collect [V]", function() self:Request("CollectAll") end },
    }
    for index, definition in ipairs(definitions) do
        local button = Widgets.Button(self.ControlBar, definition[2], definition[3], C.Panel)
        button.Name = definition[1]
        button.Size = UDim2.new(0.2, -5, 1, 0)
        button.Position = UDim2.new((index - 1) * 0.2, 2, 0, 0)
        button.TextSize = 13
        Widgets.Enabled(button, false)
        self.ActionButtons[definition[1]] = button
    end
    self.Shade = Widgets.Make("Frame", {
        Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0),
        BackgroundTransparency = 0.4, BorderSizePixel = 0, Visible = false, ZIndex = 5,
        Active = true,
    }, self.Gui)
    self.Panel = Widgets.Make("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(630, 520), BackgroundColor3 = C.Panel,
        BorderSizePixel = 0, ZIndex = 6,
    }, self.Shade)
    Widgets.Round(self.Panel, 16)
    self.PanelTitle = Widgets.Text(self.Panel, "", 40, C.Text, 22)
    self.PanelTitle.Position, self.PanelTitle.Size = UDim2.fromOffset(16, 6), UDim2.new(1, -72, 0, 40)
    self.CloseButton = Widgets.Button(self.Panel, "X", function() self:Close() end)
    self.CloseButton.Position, self.CloseButton.Size = UDim2.new(1, -48, 0, 8), UDim2.fromOffset(38, 38)
    self.Content = Widgets.List(self.Panel, true)
    self.Content.Position, self.Content.Size = UDim2.fromOffset(16, 55), UDim2.new(1, -32, 1, -69)
    self.NoticeArea = Widgets.Make("Frame", {
        AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 160),
        Size = UDim2.new(1, -32, 0, 78), BackgroundTransparency = 1, ZIndex = 20,
    }, self.Gui)
    local function resize()
        local camera = Workspace.CurrentCamera
        local viewport = if camera then camera.ViewportSize else Vector2.new(800, 600)
        local small = viewport.X < 680
        local short = viewport.Y < 480
        self.Hud.Size = UDim2.fromOffset(math.max(180, math.min(if small then viewport.X - 125 else 470, viewport.X - 24)), if short then 74 else 88)
        self.Title.Position = UDim2.fromOffset(12, if short then 1 else 4)
        self.Cash.Position = UDim2.fromOffset(12, if short then 22 else 28)
        self.Rate.Position = UDim2.fromOffset(12, if short then 46 else 55)
        self.Title.TextSize = if small then 15 else 18
        self.Cash.TextSize = if small then 14 else 17
        self.Rate.TextSize = if small then 11 else 13
        self.ControlBar.Size = UDim2.fromOffset(math.min(520, viewport.X - 20), 48)
        self.ControlBar.Position = UDim2.new(0.5, 0, 1, if UserInputService.TouchEnabled then -132 else -12)
        self.Panel.Size = UDim2.fromOffset(math.max(220, math.min(660, viewport.X - 24)), math.max(190, math.min(590, viewport.Y - 82)))
        self.Status.Position = UDim2.new(0.5, 0, 0, if short then 87 else 103)
        self.Status.Size = UDim2.new(1, -26, 0, if short then 38 else 52)
        self.Status.TextSize = if short then 12 else 14
        self.MenuRail.Position = UDim2.fromOffset(12, if short then 132 else 167)
        self.MenuRail.Size = if short then UDim2.fromOffset(viewport.X - 24, 34) else UDim2.fromOffset(if small then 88 else 108, 226)
        menuLayout.FillDirection = if short then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical
        self.NoticeArea.Position = UDim2.new(0.5, 0, 0, if short then 87 else 160)
        self.NoticeArea.Size = UDim2.new(1, -32, 0, if short then 38 else 78)
        for _, button in pairs(self.MenuButtons) do
            button.TextSize = if small then 13 else 15
            button.Size = if short then UDim2.new(0.25, -5, 0, 34) else UDim2.new(1, 0, 0, 38)
        end
    end
    local cameraConnection
    local function watchCamera()
        if cameraConnection then cameraConnection:Disconnect() end
        if Workspace.CurrentCamera then
            cameraConnection = Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(resize)
        end
        resize()
    end
    table.insert(self.Connections, Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(watchCamera))
    table.insert(self.Connections, { Disconnect = function() if cameraConnection then cameraConnection:Disconnect() end end })
    watchCamera()
end

function UI:SetControls(controls) self.Controls = controls end
function UI:SetSprint(enabled)
    self.Sprinting = enabled
    self.ActionButtons.Sprint.Text = if enabled then "Walk" else "Run [Shift]"
end

function UI:UpdateSelection()
    for _, button in pairs(self.MenuButtons) do button.Selectable = self.Menu == nil end
    for _, child in ipairs(self.Utility:GetChildren()) do
        if child:IsA("GuiButton") then child.Selectable = self.Menu == nil end
    end
    for _, button in pairs(self.ActionButtons) do
        button.Selectable = self.Menu == nil and button.Active
    end
end

function UI:Open(name, uid)
    if name == self.Menu and name ~= "Sell" then self:Close(); return end
    if name == "Sell" then
        if not self:FindHouse(uid) then return end
        self.ReturnMenu = self.Menu or "Houses"
        self.SellUid = uid
    end
    self.Menu, self.MenuSignature = name, nil
    self.Shade.Visible = true
    self.PanelTitle.Text = if name == "Sell" then "Confirm sale" else name
    self.Content.CanvasPosition = Vector2.zero
    if self.Sprinting and self.Controls.Sprint then self.Controls.Sprint(false) end
    self:RenderMenu(true)
    self:UpdateSelection()
    if GuiService.SelectedObject then GuiService.SelectedObject = self.CloseButton end
end

function UI:Close()
    local oldMenu = self.Menu
    self.Menu, self.SellUid, self.MenuSignature = nil, nil, nil
    self.Shade.Visible = false
    self:UpdateSelection()
    if GuiService.SelectedObject and GuiService.SelectedObject:IsDescendantOf(self.Panel) then
        GuiService.SelectedObject = self.MenuButtons[oldMenu] or self.MenuButtons.Houses
    end
end

function UI:FindHouse(uid)
    for _, house in ipairs(if self.Snapshot then self.Snapshot.Houses or {} else {}) do
        if house.Id == uid then return house end
    end
    return nil
end

function UI:Definition(id)
    return self.Config.HouseById[id] or { Name = "House", Rarity = "Common", Income = 0, Price = 0 }
end

function UI:HouseName(house)
    local definition = self:Definition(house.DefinitionId)
    local variant = self.Config.VariantById[house.Variant]
    local size = self.Config.SizeById[house.Size or "Normal"]
    return (if size and size.Id ~= "Normal" then size.Name .. " " else "")
        .. (if variant and variant.Id ~= "Normal" then variant.Name .. " " else "") .. definition.Name
end

function UI:ClearContent()
    self.Cards, self.MenuActions = {}, {}
    self.TrainingInfo = nil
    Widgets.Clear(self.Content)
end

function UI:Action(parent, text, key, action, ...)
    local arguments = table.pack(...)
    local button = Widgets.Button(parent, text, function() self:Request(action, table.unpack(arguments, 1, arguments.n)) end)
    button:SetAttribute("FocusKey", key)
    if action == "Buy" or action == "Collect" or action == "CollectAll"
        or action == "BaseUpgrade" or action == "TreadmillUpgrade" or action == "SecurityUpgrade" then
        button:SetAttribute("HomeRequired", true)
    end
    self.MenuActions = self.MenuActions or {}
    table.insert(self.MenuActions, button)
    Widgets.Enabled(button, self:CanAct())
    return button
end

function UI:RenderMenu(force)
    if not self.Menu then return end
    local snapshot, name = self.Snapshot, self.Menu
    if not snapshot or not snapshot.Profile then
        self:ClearContent()
        Widgets.Text(self.Content, "Waiting for your saved data…", 48, C.Muted)
        return
    end
    local profile, runtime = snapshot.Profile, snapshot.Runtime or {}
    local signature
    if name == "Houses" then
        signature = childrenSignature(snapshot.Houses) .. ":" .. tostring(runtime.Slots) .. ":" .. tostring(runtime.Multiplier)
    elseif name == "Shop" then
        signature = table.concat({ profile.BaseLevel or 1, profile.TreadmillLevel or 1, profile.SecurityLevel or 0, childrenSignature(snapshot.Market) }, ":")
    elseif name == "Index" then
        local found = {}
        for id, owned in pairs(profile.Collection or {}) do if owned then table.insert(found, id) end end
        table.sort(found)
        signature = table.concat(found, ":")
    elseif name == "Settings" then
        signature = tostring(profile.Settings and profile.Settings.Music) .. tostring(profile.Settings and profile.Settings.SFX) .. tostring(profile.Settings and profile.Settings.ReducedEffects) .. tostring(runtime.DataMode) .. tostring(runtime.Writable)
    elseif name == "Daily" then
        signature = tostring(profile.DailyDay) .. ":" .. tostring(profile.DailyStreak) .. ":" .. tostring(math.floor((snapshot.ServerTime or 0) / 86400))
    elseif name == "Sell" then
        signature = tostring(self.SellUid) .. ":" .. tostring(self:FindHouse(self.SellUid) ~= nil)
    else
        local rows = {}
        for _, standing in ipairs(snapshot.Standings or {}) do table.insert(rows, tostring(standing.UserId) .. ":" .. tostring(standing.Cash) .. ":" .. tostring(standing.Income)) end
        signature = table.concat(rows, "|")
    end
    if force or self.MenuSignature ~= signature then
        local scroll = self.Content.CanvasPosition
        local selected = GuiService.SelectedObject
        local focusKey = if selected and selected:IsDescendantOf(self.Content) then selected:GetAttribute("FocusKey") else nil
        self:ClearContent()
        self.MenuSignature = signature
        if name == "Houses" then
            Widgets.Text(self.Content, "Your houses · " .. #snapshot.Houses .. "/" .. tostring(runtime.Slots or 10) .. " pads", 30, C.Muted)
            Widgets.Text(self.Content, "Rent begins after construction. Collect it at your base; keep the gate locked to protect your houses.", 52, C.Muted, 14)
            self:Action(self.Content, "Collect all rent at my base", "collectAll", "CollectAll")
            if #snapshot.Houses == 0 then Widgets.Text(self.Content, "Steal a house box from an NPC property and bring it home, or buy a starter house in the shop.", 74, C.Muted) end
            local sorted = table.clone(snapshot.Houses)
            table.sort(sorted, function(a, b) return a.Slot < b.Slot end)
            for _, house in ipairs(sorted) do
                local definition = self:Definition(house.DefinitionId)
                local rarity = self.Config.Rarities[definition.Rarity]
                local card = Widgets.Card(self.Content, 150)
                Widgets.Text(card, "Pad " .. house.Slot .. " · " .. self:HouseName(house), 28, if rarity then Widgets.Color(rarity.Color):Lerp(C.Text, 0.55) else C.Text, 17)
                Widgets.Text(card, definition.Rarity .. " · " .. money(definition.Income * ((self.Config.VariantById[house.Variant] or {}).Multiplier or 1) * ((self.Config.SizeById[house.Size or "Normal"] or {}).IncomeMultiplier or 1) * (runtime.Multiplier or 1)) .. "/s", 24, C.Muted, 13)
                local state = Widgets.Text(card, "", 24, C.Text, 14)
                local actions = Widgets.Make("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 38) }, card)
                local collect = self:Action(actions, "Collect", house.Id .. ":collect", "Collect", house.Id)
                collect.Size = UDim2.new(0.5, -4, 1, 0)
                local sell = Widgets.Button(actions, "Sell…", function() self:Open("Sell", house.Id) end, C.Orange)
                sell.Position, sell.Size = UDim2.new(0.5, 4, 0, 0), UDim2.new(0.5, -4, 1, 0)
                sell:SetAttribute("FocusKey", house.Id .. ":sell")
                table.insert(self.MenuActions, sell)
                self.Cards[house.Id] = { State = state, Collect = collect, Sell = sell }
            end
        elseif name == "Shop" then
            Widgets.Text(self.Content, "Buy houses and upgrades at your own base. Collect rent to afford more pads and faster training.", 56, C.Muted, 14)
            self.TrainingInfo = Widgets.Text(self.Content, "", 52, C.Text, 14)
            for _, upgrade in ipairs({
                { "Base", runtime.NextBase, "BaseUpgrade", "More pads for your house collection." },
                { "Treadmill", runtime.NextTreadmill, "TreadmillUpgrade", "Earn speed faster while training at home." },
                { "Security", runtime.NextSecurity, "SecurityUpgrade", "Keep your gate locked for longer." },
            }) do
                local card = Widgets.Card(self.Content, 117)
                Widgets.Text(card, upgrade[1] .. " upgrade", 25, C.Text, 17)
                local benefit = upgrade[4]
                if upgrade[2] then
                    if upgrade[1] == "Base" then benefit = tostring(upgrade[2].Slots) .. " house pads at the next level."
                    elseif upgrade[1] == "Treadmill" then benefit = Widgets.Number(upgrade[2].Rate) .. " speed XP per second while training."
                    elseif upgrade[1] == "Security" then benefit = tostring(self.Config.Game.LockSeconds + upgrade[2].BonusSeconds) .. " seconds of gate protection." end
                end
                Widgets.Text(card, benefit, 25, C.Muted, 13)
                if upgrade[2] then
                    local cost = upgrade[2].Cost or upgrade[2].Price or 0
                    local button = self:Action(card, "Upgrade · " .. money(cost), "upgrade:" .. upgrade[1], upgrade[3])
                    button:SetAttribute("Cost", cost)
                else Widgets.Text(card, "Maximum level reached", 34, C.Teal) end
            end
            Widgets.Text(self.Content, "House shop · normal size, normal variant", 32, C.Text)
            for _, offer in ipairs(snapshot.Market or {}) do
                local definition = self:Definition(offer.DefinitionId)
                local card = Widgets.Card(self.Content, 123)
                Widgets.Text(card, definition.Name, 25, C.Text, 17)
                Widgets.Text(card, definition.Rarity .. " · base rent " .. money(offer.Income) .. "/s", 24, C.Muted, 13)
                local button = self:Action(card, "Buy · " .. money(offer.Price), "buy:" .. offer.DefinitionId, "Buy", offer.DefinitionId)
                button:SetAttribute("Cost", offer.Price)
            end
        elseif name == "Index" then
            local count = 0
            for _, definition in ipairs(self.Config.Houses) do if profile.Collection[definition.Id] then count += 1 end end
            Widgets.Text(self.Content, "Discovered " .. count .. "/" .. #self.Config.Houses .. " house designs", 32, C.Text)
            Widgets.Text(self.Content, "Discover houses by buying them or successfully carrying them home. Variants and sizes change your rent.", 54, C.Muted, 14)
            for _, definition in ipairs(self.Config.Houses) do
                local discovered = profile.Collection[definition.Id] == true
                local card = Widgets.Card(self.Content, 73)
                Widgets.Text(card, (if discovered then "✓ " else "○ ") .. definition.Name, 25, if discovered then C.Text else C.Muted, 16)
                Widgets.Text(card, definition.Rarity .. " · " .. (if discovered then "Discovered" else "Not yet discovered"), 22, C.Muted, 13)
            end
            Widgets.Text(self.Content, "Mutations", 30, C.Text)
            for _, variant in ipairs(self.Config.Variants) do
                Widgets.Text(self.Content, variant.Name .. " · " .. tostring(variant.Multiplier) .. "× rent", 28, C.Muted, 14)
            end
        elseif name == "Standings" then
            Widgets.Text(self.Content, "Players in this town · current cash and rent", 38, C.Muted, 14)
            for index, standing in ipairs(snapshot.Standings or {}) do
                local card = Widgets.Card(self.Content, 75)
                Widgets.Text(card, tostring(index) .. ". " .. tostring(standing.Name), 25, C.Text)
                Widgets.Text(card, money(standing.Cash) .. " cash · " .. money(standing.Income) .. "/s rent", 24, C.Muted, 14)
            end
        elseif name == "Settings" then
            Widgets.Text(self.Content, "Progress storage: " .. (if runtime.DataMode == "StudioMemory" then "temporary Studio session" else "online saves enabled"), 38, C.Muted, 14)
            Widgets.Text(self.Content, "Choose how your town looks and sounds.", 38, C.Muted, 14)
            for _, setting in ipairs({ { "Music", "Music" }, { "SFX", "Sound effects" }, { "ReducedEffects", "Reduced visual effects" } }) do
                local enabled = profile.Settings[setting[1]] == true
                self:Action(self.Content, setting[2] .. ": " .. (if enabled then "ON" else "OFF"), "setting:" .. setting[1], "Setting", setting[1], not enabled)
            end
            Widgets.Text(self.Content, "Keyboard: R defend · Shift run · T train · L lock · V collect. Touch: use the buttons. Controller: X interact, D-pad Up houses, B close, R2 defend, L3 run, Y train; navigate menus with the D-pad.", 90, C.Muted, 14)
        elseif name == "Daily" then
            Widgets.Text(self.Content, "Daily cash bonus · one claim per UTC day", 38, C.Text)
            Widgets.Text(self.Content, "Return on consecutive days to grow your streak. Missing a day resets the streak.", 48, C.Muted, 14)
            for day, reward in ipairs(self.Config.DailyRewards) do
                Widgets.Text(self.Content, "Day " .. day .. " · " .. money(reward), 28, C.Muted, 15)
            end
            local claimed = tonumber(profile.DailyDay) == math.floor((snapshot.ServerTime or 0) / 86400)
            local button = self:Action(self.Content, if claimed then "Claimed today" else "Claim today's reward", "daily", "Daily")
            button:SetAttribute("Unavailable", claimed)
            Widgets.Enabled(button, self:CanAct() and not claimed)
        elseif name == "Sell" then
            local house = self:FindHouse(self.SellUid)
            if not house then
                Widgets.Text(self.Content, "This house is no longer yours. The sale has been cancelled.", 70, C.Muted)
            else
                local definition = self:Definition(house.DefinitionId)
                Widgets.Text(self.Content, self:HouseName(house), 45, C.Text, 21)
                Widgets.Text(self.Content, "Sell this house permanently? It will stop earning rent and leave your base.", 68, C.Muted, 16)
                local rank = (self.Config.Rarities[definition.Rarity] or {}).Rank or 1
                if rank >= 4 or house.Variant ~= "Normal" or house.Size ~= "Normal" then
                    Widgets.Text(self.Content, "This is a special house. Check its rarity, mutation and size before selling.", 60, C.Text, 15)
                end
                local uid = house.Id
                local confirm = Widgets.Button(self.Content, "Yes, sell this house", function()
                    -- Recheck the UID against the latest snapshot; the server
                    -- independently validates ownership and the sale intent.
                    if self:FindHouse(uid) then self:Request("Sell", uid, true) end
                    self:Close()
                end, C.Danger)
                confirm:SetAttribute("FocusKey", "confirmSell")
                confirm:SetAttribute("HomeRequired", true)
                table.insert(self.MenuActions, confirm)
                Widgets.Button(self.Content, "Keep my house", function() self:Close() end, C.Teal)
            end
        end
        self.Content.CanvasPosition = scroll
        local restored = false
        if focusKey then
            for _, descendant in ipairs(self.Content:GetDescendants()) do
                if descendant:IsA("GuiButton") and descendant:GetAttribute("FocusKey") == focusKey then
                    GuiService.SelectedObject = descendant
                    restored = true
                    break
                end
            end
        end
        if selected and not restored and not selected.Parent then GuiService.SelectedObject = self.CloseButton end
    end
    for _, button in ipairs(self.MenuActions or {}) do
        local homeAllowed = not button:GetAttribute("HomeRequired") or runtime.AtHome ~= false
        local cost = button:GetAttribute("Cost")
        Widgets.Enabled(button, self:CanAct() and button:GetAttribute("Unavailable") ~= true
            and homeAllowed and (not cost or profile.Cash >= cost))
    end
    if name == "Shop" and self.TrainingInfo then
        local speed, xp = runtime.Speed or self.Config.Speed(profile), runtime.SpeedXP or profile.SpeedXP or 0
        local rate = runtime.TrainingRate or (self.Config.Treadmills[profile.TreadmillLevel] or {}).Rate or 0
        local nextXP = runtime.NextSpeedXP
        if nextXP == nil and speed < 80 then nextXP = 20 * (((speed - self.Config.Game.MoveSpeed) / 2) + 1) ^ 2 end
        self.TrainingInfo.Text = "Speed " .. Widgets.Number(speed) .. " · " .. Widgets.Number(xp) .. " XP · treadmill " .. Widgets.Number(rate) .. " XP/s\n"
            .. (if nextXP then "Next speed increase at " .. Widgets.Number(nextXP) .. " XP" else "Maximum speed reached")
    end
    if name == "Houses" then
        for _, house in ipairs(snapshot.Houses or {}) do
            local card = self.Cards[house.Id]
            if card then
                card.State.Text = if house.Building then "Building · ready in " .. seconds(house.BuildRemaining) else "Rent waiting: " .. money(house.Income)
                Widgets.Enabled(card.Collect, self:CanAct() and not house.Building and runtime.AtHome ~= false)
            end
        end
    end
end

function UI:SetSnapshot(snapshot)
    if type(snapshot) ~= "table" then return end
    self.Snapshot = snapshot
    local profile, runtime = snapshot.Profile, snapshot.Runtime or {}
    if profile then
        self.Cash.Text = money(profile.Cash) .. "  ·  Bank " .. money(profile.Bank)
        self.Rate.Text = money(runtime.IncomePerSecond) .. "/s rent  ·  Speed " .. Widgets.Number(runtime.Speed) .. "  ·  Base " .. tostring(runtime.BaseLevel or profile.BaseLevel or 1)
    end
    local status = {}
    if runtime.Writable ~= true then table.insert(status, "DATA PAUSED · actions are disabled")
    elseif profile and profile.Pending then table.insert(status, "Finishing your house transaction…") end
    if runtime.DataMode == "StudioMemory" then table.insert(status, "Studio temporary · saves are not kept") end
    if runtime.Carry then
        table.insert(status, "Carry " .. tostring(runtime.Carry.Name) .. " home · " .. seconds(runtime.Carry.SecondsRemaining))
    elseif runtime.StealHold then
        table.insert(status, "Picking up " .. tostring(runtime.StealHold.Name) .. " · " .. math.floor(math.clamp(runtime.StealHold.Progress or 0, 0, 1) * 100) .. "%")
    elseif runtime.Training then table.insert(status, "Training speed · stay on your own treadmill") end
    if (runtime.LockRemaining or 0) > 0 then
        table.insert(status, "Gate locked · " .. seconds(runtime.LockRemaining))
    elseif (runtime.LockCooldown or 0) > 0 then table.insert(status, "Lock ready in " .. seconds(runtime.LockCooldown))
    else table.insert(status, "Gate open · lock your base before exploring") end
    if #status == 0 then table.insert(status, "Explore NPC properties, steal a house box, and carry it home") end
    self.Status.Text = table.concat(status, "  •  ")
    for _, button in pairs(self.ActionButtons) do Widgets.Enabled(button, self:CanAct()) end
    self.ActionButtons.Train.Text = if runtime.Training then "Stop train" else "Train [T]"
    if runtime.Training and self.Sprinting and self.Controls.Sprint then self.Controls.Sprint(false) end
    self.ActionButtons.Lock.Text = if (runtime.LockRemaining or 0) > 0 then "Locked" else "Lock [L]"
    Widgets.Enabled(self.ActionButtons.Lock, self:CanAct() and (runtime.LockRemaining or 0) <= 0 and (runtime.LockCooldown or 0) <= 0)
    Widgets.Enabled(self.ActionButtons.Collect, self:CanAct() and runtime.AtHome ~= false)
    self:RenderMenu(false)
    self:UpdateSelection()
end

function UI:Destroy()
    for _, connection in ipairs(self.Connections) do connection:Disconnect() end
    self.Connections = {}
    if self.Gui then self.Gui:Destroy() end
end

return UI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">Widgets</string>
            <string name="Source"><![CDATA[--!nonstrict
-- UI construction and formatting only; no economy state is changed here.
local Widgets = {}
Widgets.Colors = {
    Background = Color3.fromRGB(224, 243, 255), Panel = Color3.fromRGB(250, 253, 255),
    Raised = Color3.fromRGB(231, 241, 249), Stroke = Color3.fromRGB(167, 197, 216),
    Text = Color3.fromRGB(24, 49, 70), Muted = Color3.fromRGB(68, 94, 111),
    Teal = Color3.fromRGB(74, 211, 177), Orange = Color3.fromRGB(255, 193, 82),
    Danger = Color3.fromRGB(255, 153, 158),
}

function Widgets.Make(className, properties, parent)
    local instance = Instance.new(className)
    for key, value in pairs(properties) do instance[key] = value end
    instance.Parent = parent
    return instance
end

function Widgets.Round(parent, radius)
    Widgets.Make("UICorner", { CornerRadius = UDim.new(0, radius or 10) }, parent)
end

function Widgets.Text(parent, text, height, color, size)
    return Widgets.Make("TextLabel", {
        BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, height or 24),
        Text = tostring(text), TextColor3 = color or Widgets.Colors.Text,
        Font = Enum.Font.GothamMedium, TextSize = size or 16, TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, parent)
end

function Widgets.Button(parent, text, callback, color)
    local button = Widgets.Make("TextButton", {
        Size = UDim2.new(1, 0, 0, 38), BackgroundColor3 = color or Widgets.Colors.Raised,
        Text = text, TextColor3 = Widgets.Colors.Text, Font = Enum.Font.GothamBold,
        TextSize = 15, TextWrapped = true, AutoButtonColor = true, Selectable = true,
    }, parent)
    Widgets.Round(button, 8)
    button.Activated:Connect(callback)
    return button
end

function Widgets.Card(parent, height)
    local card = Widgets.Make("Frame", {
        Size = UDim2.new(1, -4, 0, height or 112), BackgroundColor3 = Widgets.Colors.Raised,
        BorderSizePixel = 0,
    }, parent)
    Widgets.Round(card)
    Widgets.Make("UIPadding", {
        PaddingTop = UDim.new(0, 9), PaddingBottom = UDim.new(0, 9),
        PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12),
    }, card)
    Widgets.Make("UIListLayout", { Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder }, card)
    return card
end

function Widgets.List(parent, scrolling)
    local list = Widgets.Make(if scrolling then "ScrollingFrame" else "Frame", {
        BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), BorderSizePixel = 0,
    }, parent)
    if scrolling then
        list.AutomaticCanvasSize = Enum.AutomaticSize.Y
        list.CanvasSize = UDim2.new()
        list.ScrollBarThickness = 4
        list.ScrollBarImageColor3 = Widgets.Colors.Teal
        list.ScrollingDirection = Enum.ScrollingDirection.Y
    else
        list.Size = UDim2.new(1, 0, 0, 0)
        list.AutomaticSize = Enum.AutomaticSize.Y
    end
    Widgets.Make("UIListLayout", { Padding = UDim.new(0, 9), SortOrder = Enum.SortOrder.LayoutOrder }, list)
    return list
end

function Widgets.Clear(parent)
    for _, child in ipairs(parent:GetChildren()) do
        if child:IsA("GuiObject") then child:Destroy() end
    end
end

function Widgets.Number(number)
    number = tonumber(number) or 0
    if number ~= number or math.abs(number) == math.huge then number = 0 end
    local abs = math.abs(number)
    for _, suffix in ipairs({ {1e12, "T"}, {1e9, "B"}, {1e6, "M"}, {1e3, "K"} }) do
        if abs >= suffix[1] then return string.format("%.1f%s", number / suffix[1], suffix[2]) end
    end
    return tostring(math.floor(number))
end

function Widgets.Enabled(button, enabled)
    button.Active = enabled
    button.Selectable = enabled
    button.AutoButtonColor = enabled
    button.BackgroundTransparency = if enabled then 0 else 0.45
    button.TextTransparency = if enabled then 0 else 0.45
end

function Widgets.Color(hex)
    if typeof(hex) == "Color3" then return hex end
    if type(hex) == "string" then
        local clean = hex:gsub("#", "")
        if #clean == 6 then
            return Color3.fromRGB(tonumber(clean:sub(1, 2), 16) or 255,
                tonumber(clean:sub(3, 4), 16) or 255, tonumber(clean:sub(5, 6), 16) or 255)
        end
    end
    return Widgets.Colors.Muted
end

function Widgets.Actions(parent, leftText, leftCallback, rightText, rightCallback)
    local frame = Widgets.Make("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 38) }, parent)
    local left = Widgets.Button(frame, leftText, leftCallback)
    left.Size = UDim2.new(if rightText then 0.5 else 1, if rightText then -4 else 0, 1, 0)
    if rightText then
        local right = Widgets.Button(frame, rightText, rightCallback)
        right.Position, right.Size = UDim2.new(0.5, 4, 0, 0), UDim2.new(0.5, -4, 1, 0)
    end
    return left
end

return Widgets
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="30">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="FilteringEnabled">true</bool>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
  </Item>
</roblox>