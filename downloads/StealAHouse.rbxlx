      <Item class="Folder" referent="27">
        <Properties>
          <string name="Name">Utilities</string>
        </Properties>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">FormatNumber</string>
            <string name="Source"><![CDATA[--!strict
local FormatNumber = {}
local units = { {1e12, "T"}, {1e9, "B"}, {1e6, "M"}, {1e3, "K"} }
function FormatNumber.Compact(value: number): string
    if value ~= value or math.abs(value) == math.huge then return "0" end
    local magnitude = math.abs(value)
    for _, unit in ipairs(units) do
        if magnitude >= unit[1] then
            local result = string.format("%.1f", value / unit[1])
            return string.gsub(result, "%.0$", "") .. unit[2]
        end
    end
    return tostring(math.floor(value))
end
function FormatNumber.Integer(value: number): string
    local raw = tostring(math.floor(value))
    local sign = if string.sub(raw, 1, 1) == "-" then "-" else ""
    if sign ~= "" then raw = string.sub(raw, 2) end
    local reversed = string.reverse(raw)
    local grouped = string.gsub(reversed, "(%d%d%d)", "%1,")
    return sign .. string.gsub(string.reverse(grouped), "^,", "")
end
function FormatNumber.Currency(value: number): string return "$" .. FormatNumber.Compact(value) end
FormatNumber.Cash = FormatNumber.Currency
return setmetatable(FormatNumber, { __call = function(_, value: number) return FormatNumber.Compact(value) end })
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">MathUtils</string>
            <string name="Source"><![CDATA[--!strict
local MathUtils = {}
function MathUtils.Snap(value: number, grid: number): number return math.round(value / grid) * grid end
function MathUtils.LevelFromXP(xp: number, perLevel: number): number return 1 + math.floor(math.max(0, xp) / perLevel) end
function MathUtils.RotatedSize(size: any, rotation: number): (number, number)
    if rotation % 180 == 0 then return size.X, size.Z end
    return size.Z, size.X
end
return MathUtils
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">TableUtils</string>
            <string name="Source"><![CDATA[--!strict
local TableUtils = {}
function TableUtils.Clone(value: any, seen: any?): any
    if type(value) ~= "table" then return value end
    local visited = seen or {}
    if visited[value] then return visited[value] end
    local copy = {}
    visited[value] = copy
    for key, child in pairs(value) do copy[TableUtils.Clone(key, visited)] = TableUtils.Clone(child, visited) end
    return copy
end
function TableUtils.Reconcile(value: any, defaults: any): any
    for key, default in pairs(defaults) do
        if value[key] == nil then value[key] = TableUtils.Clone(default)
        elseif type(default) == "table" and type(value[key]) == "table" then
            TableUtils.Reconcile(value[key], default)
        end
    end
    return value
end
function TableUtils.Count(value: any): number
    local count = 0
    for _ in pairs(value) do count += 1 end
    return count
end
return TableUtils
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">Validation</string>
            <string name="Source"><![CDATA[--!strict
local Validation = {}
function Validation.Finite(value: any): boolean
    return type(value) == "number" and value == value and math.abs(value) < math.huge
end
function Validation.Integer(value: any, minimum: number?, maximum: number?): boolean
    return Validation.Finite(value) and value % 1 == 0
        and (minimum == nil or value >= minimum) and (maximum == nil or value <= maximum)
end
function Validation.Id(value: any, maxLength: number?): boolean
    return type(value) == "string" and #value > 0 and #value <= (maxLength or 128)
        and string.match(value, "^[%w_%-:]+$") ~= nil
end
function Validation.String(value: any, maxLength: number): boolean
    return type(value) == "string" and #value <= maxLength
end
function Validation.Placement(x: any, z: any, rotation: any, size: any,
    width: number, depth: number, gridSize: number?): (boolean, string?)
    if not Validation.Finite(x) or not Validation.Finite(z)
        or not Validation.Integer(rotation, 0, 270) or rotation % 90 ~= 0 then
        return false, "Placement must use finite coordinates and 90-degree rotations."
    end
    local grid = gridSize or 3
    if grid <= 0 or not Validation.Finite(grid) then return false, "Invalid grid." end
    if math.abs(x / grid - math.round(x / grid)) > 1e-5
        or math.abs(z / grid - math.round(z / grid)) > 1e-5 then
        return false, "Place on the furniture grid."
    end
    local sx, sz = size.X, size.Z
    if rotation % 180 ~= 0 then sx, sz = sz, sx end
    if math.abs(x) + sx / 2 > width / 2 - 1 or math.abs(z) + sz / 2 > depth / 2 - 1 then
        return false, "Furniture must fit inside the house."
    end
    return true, nil
end
function Validation.Overlaps(a: any, b: any, aSize: any, bSize: any): boolean
    local ax, az = aSize.X, aSize.Z
    local bx, bz = bSize.X, bSize.Z
    if a.Rotation % 180 ~= 0 then ax, az = az, ax end
    if b.Rotation % 180 ~= 0 then bx, bz = bz, bx end
    return math.abs(a.X - b.X) < (ax + bx) / 2 - 0.05
        and math.abs(a.Z - b.Z) < (az + bz) / 2 - 0.05
end
Validation.IsFinite = Validation.Finite
Validation.IsId = Validation.Id
return Validation
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">WeightedRandom</string>
            <string name="Source"><![CDATA[--!strict
-- Inject a function returning a number in [0, 1) for deterministic simulations.
local WeightedRandom = {}
local function finite(value: any): boolean
    return type(value) == "number" and value == value and math.abs(value) < math.huge
end
local function roll(randomSource: any): number
    local value
    if randomSource == nil then
        value = math.random()
    elseif type(randomSource) == "function" then
        value = randomSource()
    else
        value = randomSource:NextNumber()
    end
    assert(finite(value) and value >= 0 and value <= 1, "Random source must return a value in [0,1]")
    return math.min(value, 1 - 1e-12)
end
function WeightedRandom.Choose(entries: {any}, randomSource: any?, weightKey: string?): (any?, number?)
    local total = 0
    local weights = {}
    for index, entry in ipairs(entries) do
        local weight = entry[weightKey or "SpawnWeight"] or entry.Weight or 0
        if finite(weight) and weight > 0 then
            total += weight
            weights[index] = weight
        end
    end
    if total <= 0 or not finite(total) then return nil, nil end
    local target = roll(randomSource) * total
    for index, entry in ipairs(entries) do
        target -= weights[index] or 0
        if target < 0 then return entry, index end
    end
    return nil, nil
end
function WeightedRandom.Pick(entries: {[string]: any}, randomSource: any?, weightFunction: any?): (any?, string?)
    local ids = {}
    for id in pairs(entries) do table.insert(ids, id) end
    table.sort(ids)
    local weighted = {}
    for _, id in ipairs(ids) do
        local entry = entries[id]
        table.insert(weighted, {
            Id = id, Entry = entry,
            SpawnWeight = if weightFunction then weightFunction(entry, id) else entry.SpawnWeight,
        })
    end
    local selected = WeightedRandom.Choose(weighted, randomSource)
    if selected then return selected.Entry, selected.Id end
    return nil, nil
end
return WeightedRandom
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="33">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="34">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- Controlled startup. Services receive one private context and do not create globals.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local shared = ReplicatedStorage:WaitForChild("Shared")
local ctx = {
    Config = require(shared.Config), Schema = require(shared.ProfileSchema),
    Players = Players, ReplicatedStorage = ReplicatedStorage,
    HttpService = game:GetService("HttpService"), Lighting = game:GetService("Lighting"),
    Clock = os.time, Closing = false,
}
local function construct(name) return require(script:WaitForChild(name)).new(ctx) end
local network
ctx.Notify = function(player, text, kind)
    if ctx.Remotes and player.Parent == Players then ctx.Remotes.UI.Notification:FireClient(player, text, kind or "Info") end
end
ctx.Announce = function(text) if ctx.Remotes then ctx.Remotes.UI.Announcement:FireAllClients(text) end end
ctx.Request = function(player, action, ...) if network then network:Request(player, action, ...) end end
local publishing = {}
ctx.Publish = function(player)
    if publishing[player] or not ctx.Remotes or player.Parent ~= Players then return end
    local profile = ctx.Data:Get(player)
    local plot = ctx.World and ctx.World:GetPlot(player)
    if not profile or not plot then return end
    publishing[player] = true
    -- IsWritable may emit a status notification; the recursion guard keeps publishing bounded.
    local status = ctx.Data:GetStatus(player)
    publishing[player] = nil
    ctx.House:Value(player)
    ctx.Leaderboard:Update(player)
    local state = ctx.Robbery:Get(player)
    local carry = {}
    if state then for _, entry in pairs(state.Carry) do table.insert(carry, ctx.Schema.Clone(entry)) end end
    table.sort(carry, function(a, b) return a.UniqueId < b.UniqueId end)
    ctx.Remotes.UI.Snapshot:FireClient(player, {
        Profile = ctx.Schema.Clone(profile), Quests = ctx.Quest:Get(player), Leaderboard = ctx.Leaderboard:Get(),
        Runtime = {
            Heat = ctx.Heat:Get(player), Capacity = ctx.Inventory:Capacity(player), CarryWeight = ctx.Inventory:CarryWeight(player), Carry = carry,
            Robbery = { Active = state ~= nil, TargetHouse = state and state.TargetHouse, TargetName = state and state.TargetName },
            Plot = { Id = plot.Id, Origin = { X = plot.Origin.X, Y = plot.Origin.Y, Z = plot.Origin.Z } },
            DataStatus = status.Mode, DataWritable = status.Writable, DataError = status.Error,
            Event = ctx.Events:GetActive(), ShopPosition = { X = ctx.World.ShopPosition.X, Y = ctx.World.ShopPosition.Y, Z = ctx.World.ShopPosition.Z },
        },
    })
end
ctx.Data = construct("DataService")
ctx.Analytics = construct("AnalyticsService")
ctx.Events = construct("EventService")
ctx.AntiExploit = construct("AntiExploitService")
ctx.Economy = construct("EconomyService")
ctx.Inventory = construct("InventoryService")
ctx.House = construct("HouseService")
ctx.Heat = construct("HeatService")
ctx.Security = construct("SecurityService")
ctx.Quest = construct("QuestService")
ctx.World = construct("WorldService")
ctx.Items = construct("ItemService")
ctx.Robbery = construct("RobberyService")
ctx.Police = construct("PoliceService")
ctx.Leaderboard = construct("LeaderboardService")
ctx.PlayerService = construct("PlayerService")
network = construct("NetworkService")
ctx.Remotes = network.Remotes
ctx.World:Init()
ctx.Items:Start()
ctx.BeforeDataRelease = function(player) ctx.PlayerService:Cleanup(player) end
ctx.BeforeDataClose = function()
    ctx.Closing = true
    for _, player in ipairs(Players:GetPlayers()) do ctx.Robbery:Fail(player, "Server shutting down") end
    ctx.Police:Shutdown()
    ctx.Events:Destroy()
    ctx.Leaderboard:Flush()
end
ctx.PlayerService:Start()
ctx.Data:Start()
local lastError = {}
local function safeTick(name, fn)
    local ok, err = pcall(fn)
    if not ok and (not lastError[name] or os.clock() - lastError[name] > 15) then
        lastError[name] = os.clock()
        warn("[StealAHouse runtime]", name, err)
    end
end
task.spawn(function()
    local last, ticks = os.clock(), 0
    while not ctx.Closing do
        task.wait(0.5)
        local now = os.clock()
        local dt = math.min(now - last, 2)
        last, ticks = now, ticks + 1
        safeTick("Movement", function() ctx.AntiExploit:Tick() end)
        safeTick("Robbery", function() ctx.Robbery:Tick() end)
        safeTick("Heat", function() ctx.Heat:Tick(dt) end)
        safeTick("Police", function() ctx.Police:Tick(dt) end)
        safeTick("Loot", function() ctx.Items:Tick() end)
        safeTick("Events", function() ctx.Events:Tick(dt) end)
        safeTick("Leaderboards", function() ctx.Leaderboard:Tick(dt) end)
        for _, player in ipairs(Players:GetPlayers()) do
            if ctx.Data:Get(player) then
                safeTick("Progression", function() ctx.Quest:Tick(player, dt) end)
                if ctx.Data:IsWritable(player) then ctx.Data:Get(player).Playtime += dt end
                if ticks % 2 == 0 then safeTick("Snapshot", function() ctx.Publish(player) end) end
            end
        end
    end
end)
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">AnalyticsService</string>
          <string name="Source"><![CDATA[-- Bounded aggregate metrics. No inventory, credential, chat, or personal data is logged.
local AnalyticsService = {}
AnalyticsService.__index = AnalyticsService

local function validAmount(amount)
    return type(amount) == "number" and amount == amount and amount >= 0 and amount < math.huge
end

local function bounded(value)
    if type(value) == "string" then return string.sub(value, 1, 100) end
    if type(value) == "boolean" then return tostring(value) end
    if type(value) == "number" and value == value and math.abs(value) < math.huge then return tostring(value) end
    return nil
end

function AnalyticsService.new(ctx)
    return setmetatable({
        ctx = ctx, clock = ctx.Clock or os.time, counters = {}, samples = {}, eventCount = 0,
        sources = 0, sinks = 0, lastConsole = {}, windowAt = 0, backendCount = 0,
        sessions = {},
    }, AnalyticsService)
end

function AnalyticsService:InitPlayer(player)
    self.sessions[player] = { StartedAt = self.clock(), FirstRobbery = false, FirstItem = false, FirstUpgrade = false }
    self:Emit(player, "SessionStarted", {})
end

function AnalyticsService:Emit(player, event, fields)
    if type(event) ~= "string" or #event < 1 or #event > 48 or not string.match(event, "^[%w_]+$") then return end
    if self.counters[event] == nil then
        if self.eventCount >= 64 then return end
        self.eventCount += 1
        self.counters[event] = 0
    end
    self.counters[event] += 1
    fields = type(fields) == "table" and fields or {}
    if event == "CashSource" and validAmount(fields.Amount) then self.sources += fields.Amount end
    if event == "CashSink" and validAmount(fields.Amount) then self.sinks += fields.Amount end
    local clean = {}
    local keys = {}
    for key in pairs(fields) do
        if type(key) == "string" and #key <= 32 then table.insert(keys, key) end
    end
    table.sort(keys)
    for index = 1, math.min(8, #keys) do
        local key = keys[index]
        local value = bounded(fields[key])
        if value then clean[key] = value end
    end
    self.samples[event] = clean
    local now = self.clock()
    -- One console sample per event per minute, with at most 64 distinct event labels.
    if not self.lastConsole[event] or now - self.lastConsole[event] >= 60 then
        self.lastConsole[event] = now
        local parts = { "[StealAHouse analytics]", "event=" .. event, "count=" .. self.counters[event] }
        for _, key in ipairs(keys) do
            if clean[key] then table.insert(parts, key .. "=" .. clean[key]) end
        end
        local log = self.ctx.Log or print
        log(table.concat(parts, " "))
    end
    -- Roblox telemetry is optional and queued; it never yields inside an economy transaction.
    local backend = self.ctx.AnalyticsBackend
    if not backend or not player or self.ctx.Config.Game.EnableRobloxAnalytics ~= true then return end
    if now - self.windowAt >= 60 then self.windowAt = now; self.backendCount = 0 end
    if self.backendCount >= 100 then return end
    self.backendCount += 1
    local custom = {}
    for index = 1, math.min(3, #keys) do
        if clean[keys[index]] then custom["CustomField0" .. index] = keys[index] .. ":" .. clean[keys[index]] end
    end
    local spawn = self.ctx.Spawn or task.spawn
    spawn(function()
        pcall(function() backend:LogCustomEvent(player, event, 1, custom) end)
    end)
end

function AnalyticsService:Economy(player, flow, amount, reason)
    if flow ~= "Source" and flow ~= "Sink" then return end
    self:Emit(player, "Cash" .. flow, { Amount = amount, Reason = reason })
end

function AnalyticsService:Milestone(player, milestone)
    local session = self.sessions[player]
    if not session or session[milestone] ~= false then return end
    session[milestone] = true
    self:Emit(player, milestone, { SecondsSinceJoin = self.clock() - session.StartedAt })
end

function AnalyticsService:Remove(player)
    local session = self.sessions[player]
    if session then self:Emit(player, "SessionEnded", { Seconds = self.clock() - session.StartedAt }) end
    self.sessions[player] = nil
end

function AnalyticsService:Get()
    local counts = {}
    for event, count in pairs(self.counters) do counts[event] = count end
    return { Counters = counts, CashCreated = self.sources, CashDestroyed = self.sinks }
end

return AnalyticsService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="36">
        <Properties>
          <string name="Name">AntiExploitService</string>
          <string name="Source"><![CDATA[local AntiExploit = {}
AntiExploit.__index = AntiExploit
local rates = { Steal = 3, Sell = 3, Place = 4, Pickup = 4, Upgrade = 2, QuestClaim = 2, DailyClaim = 1, Sync = 2 }
function AntiExploit.new(ctx) return setmetatable({ Context = ctx, Players = {} }, AntiExploit) end
function AntiExploit:Register(player)
    self.Players[player] = { Buckets = {}, Score = 0, BlockedUntil = 0, MovementBudget = self.Context.Config.Game.MovementTolerance }
end
function AntiExploit:AllowTeleport(player)
    local state = self.Players[player]
    if state then state.LastPosition = nil; state.MovementBudget = self.Context.Config.Game.MovementTolerance end
end
function AntiExploit:Flag(player, reason)
    local state = self.Players[player]
    if not state then return end
    state.Score += 1
    if state.Score >= 8 then state.BlockedUntil = os.clock() + 3 end
    if not state.LastLog or os.clock() - state.LastLog > 10 then
        state.LastLog = os.clock()
        warn("[AntiExploit]", player.UserId, reason, "score", state.Score)
    end
end
function AntiExploit:Rate(player, action)
    local state = self.Players[player]
    if not state then return false end
    local now = os.clock()
    local function spend(key, rate, burst)
        local bucket = state.Buckets[key] or { Tokens = burst, Time = now }
        state.Buckets[key] = bucket
        bucket.Tokens = math.min(burst, bucket.Tokens + (now - bucket.Time) * rate)
        bucket.Time = now
        if bucket.Tokens < 1 then return false end
        bucket.Tokens -= 1
        return true
    end
    if not spend("Global", 10, 16) or not spend(action, rates[action] or 3, 5) then
        self:Flag(player, "Remote rate limit: " .. action)
        return false
    end
    return true
end
function AntiExploit:Character(player)
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid or humanoid.Health <= 0 then return nil end
    return root, humanoid
end
function AntiExploit:ValidateMovement(player)
    local state = self.Players[player]
    local root = self:Character(player)
    if not state or not root then return false end
    local now = os.clock()
    if now < state.BlockedUntil then return false end
    if state.LastPosition then
        local elapsed = math.max(0, now - state.LastMoveTime)
        local delta = root.Position - state.LastPosition
        local horizontal = Vector3.new(delta.X, 0, delta.Z).Magnitude
        -- Latency tolerance is one replenishing burst, not a fresh allowance per request.
        local available = state.MovementBudget + self.Context.Config.Game.SprintSpeed * elapsed
        if horizontal > available + 0.01 then
            if state.LastCFrame then root.CFrame = state.LastCFrame end
            state.BlockedUntil = now + 2
            self:Flag(player, "Impossible horizontal movement")
            return false
        end
        state.MovementBudget = math.min(self.Context.Config.Game.MovementTolerance, available - horizontal)
    end
    state.LastPosition, state.LastMoveTime, state.LastCFrame = root.Position, now, root.CFrame
    return true
end
function AntiExploit:Near(player, position, distance)
    local root = self:Character(player)
    return root ~= nil and self:ValidateMovement(player) and (root.Position - position).Magnitude <= distance
end
function AntiExploit:CanInteract(player, record, distance)
    if not self:Near(player, record.Position, distance) then return false end
    local root = self:Character(player)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { player.Character }
    params.RespectCanCollide = true
    local target = record.Position + Vector3.new(0, 2, 0)
    local result = (self.Context.Workspace or workspace):Raycast(root.Position, target - root.Position, params)
    return result == nil or (record.Model ~= nil and result.Instance:IsDescendantOf(record.Model))
end
function AntiExploit:Tick()
    for player, state in pairs(self.Players) do
        self:ValidateMovement(player)
        if not state.LastDecay or os.clock() - state.LastDecay >= 10 then
            state.Score = math.max(0, state.Score - 1)
            state.LastDecay = os.clock()
        end
    end
end
function AntiExploit:Remove(player) self.Players[player] = nil end
return AntiExploit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="37">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[-- Profiles are private server state. A failed load never creates a playable default.
-- Each persistent record has a renewable lease; every write verifies its token.
-- Saves serialize per profile and snapshot only after entering that queue. A save
-- never replaces the live profile, so mutations during a yield remain in memory
-- for the next save. Release freezes transactions before taking its final snapshot.
local DataService = {}
DataService.__index = DataService

local function copy(value, seen, depth, budget)
    local kind = type(value)
    if kind == "number" then
        assert(value == value and math.abs(value) ~= math.huge, "Non-finite profile number")
    elseif kind == "string" then
        assert(#value <= 100000, "Oversized profile string")
    elseif kind == "table" then
        seen, depth, budget = seen or {}, depth or 0, budget or { Count = 0 }
        assert(not seen[value] and depth < 32, "Cyclic or excessively nested profile")
        seen[value] = true
        local result = {}
        for key, item in pairs(value) do
            budget.Count += 1
            assert(budget.Count <= 10000, "Oversized profile")
            assert(type(key) == "string" or (type(key) == "number" and key == key and math.abs(key) ~= math.huge), "Invalid profile key")
            result[key] = copy(item, seen, depth + 1, budget)
        end
        seen[value] = nil
        return result
    else
        assert(kind == "boolean" or kind == "nil", "Profile contains a nonserializable value")
    end
    return value
end

local function playerKey(player)
    return "Player_" .. tostring(player.UserId)
end

local function unpackRecord(raw)
    if raw == nil then return nil, nil, 0 end
    if type(raw) ~= "table" then return nil, nil, 0, "InvalidProfile" end
    if raw._RecordVersion == nil then return raw, nil, 0 end -- pre-envelope profiles
    if raw._RecordVersion ~= 1 or type(raw.Data) ~= "table" then
        return nil, nil, 0, "UnsupportedRecordVersion"
    end
    local session = raw.Session
    if session ~= nil and (type(session) ~= "table" or type(session.Token) ~= "string"
        or type(session.ExpiresAt) ~= "number" or session.ExpiresAt ~= session.ExpiresAt
        or math.abs(session.ExpiresAt) == math.huge) then
        return nil, nil, 0, "InvalidSession"
    end
    local revision = raw.Revision
    if type(revision) ~= "number" or revision < 0 or revision ~= math.floor(revision)
        or revision == math.huge then return nil, nil, 0, "InvalidRevision" end
    if raw.LastWrite ~= nil and (type(raw.LastWrite) ~= "table" or type(raw.LastWrite.Token) ~= "string"
        or type(raw.LastWrite.Id) ~= "string") then return nil, nil, 0, "InvalidWriteMarker" end
    return raw.Data, session, revision
end

function DataService.new(ctx, options)
    options = options or {}
    local self = setmetatable({}, DataService)
    self._Ctx, self._Entries, self._Loading = ctx, {}, {}
    self._WriteSequence = 0
    self._Schema = options.Schema or ctx.Schema
    if not self._Schema then
        self._Schema = require(game:GetService("ReplicatedStorage").Shared.ProfileSchema)
    end
    self._Now = options.Now or os.time -- leases must use wall time across servers
    self._Wait = options.Wait or task.wait
    self._Spawn = options.Spawn or task.spawn
    self._RetryCount = options.RetryCount or 4
    self._Players, self._BindToClose = options.Players, options.BindToClose
    local config = ctx.Config.Game
    self._AutoSave = config.AutoSaveSeconds or 90
    self._Lease = config.SessionLeaseSeconds or 180
    self._Safety = math.min(options.SafetySeconds or 15, self._Lease / 4)
    assert(self._AutoSave > 0 and self._AutoSave + self._Safety < self._Lease, "Autosave must precede lease expiry")
    local isStudio = options.IsStudio
    if isStudio == nil then isStudio = game:GetService("RunService"):IsStudio() end
    self.Status = isStudio and not config.StudioPersistence and "StudioMemory" or "Persistent"
    self._Token = options.Token
    if not self._Token then self._Token = game:GetService("HttpService"):GenerateGUID(false) end
    if self.Status == "Persistent" then
        self._Store = options.Store or game:GetService("DataStoreService"):GetDataStore(config.ProfileStore)
        assert(self._Store ~= nil, "Persistent mode requires a real profile store")
    end
    return self
end

function DataService:_signal(entry, text, kind)
    if self._Ctx.Notify then pcall(self._Ctx.Notify, entry.Player, text, kind) end
    if self._Ctx.Publish then pcall(self._Ctx.Publish, entry.Player) end
end

function DataService:_retry(operation)
    for attempt = 1, self._RetryCount do
        local ok, result, reason = pcall(operation)
        if ok then return result, reason end
        if attempt < self._RetryCount then self._Wait(math.min(2 ^ (attempt - 1), 4)) end
    end
    return nil, "DataStoreUnavailable"
end

function DataService:_valid(profile)
    if type(profile) ~= "table" or profile.Version ~= 2 then return false end
    if self._Schema.Validate then
        local ok, valid = pcall(self._Schema.Validate, profile)
        return ok and valid == true
    end
    return true
end

function DataService:Get(player)
    local entry = self._Entries[playerKey(player)]
    return entry and entry.Player == player and entry.Profile or nil
end

function DataService:GetStatus(player)
    local entry = self._Entries[playerKey(player)]
    if not entry or entry.Player ~= player then return { Mode = self.Status, Loaded = false, Writable = false } end
    return { Mode = self.Status, Loaded = true, Writable = self:IsWritable(player),
        Saving = entry.Saving == true, Error = entry.Error, Revision = entry.Revision }
end

function DataService:IsWritable(player)
    local entry = self._Entries[playerKey(player)]
    if not entry or entry.Player ~= player or self._Closing or entry.Releasing or entry.Lost then return false end
    if self.Status == "StudioMemory" then return true end
    if self._Now() >= entry.LeaseUntil - self._Safety then
        if not entry.Frozen then
            entry.Frozen = true
            entry.Error = "LeaseRenewalRequired"
            self:_signal(entry, "Saving is unavailable. Transactions are paused to protect your progress.", "Warning")
        end
        return false
    end
    return not entry.Frozen
end

function DataService:Load(player)
    local key = playerKey(player)
    if self._Closing or self._CloseStarted then return nil, "ServerClosing" end
    local existing = self._Entries[key]
    if existing then
        if existing.Player == player and not existing.Lost and not existing.Releasing then return existing.Profile end
        if existing.Player == player then return nil, existing.Error or "ProfileReleasing" end
        return nil, "AlreadyLoaded"
    end
    if self._Loading[key] then return nil, "LoadInProgress" end
    self._Loading[key] = true
    local token = self._Token .. ":" .. key
    local profile, lease, revision, failure
    if self.Status == "StudioMemory" then
        local ok, result = pcall(self._Schema.New, self._Now())
        if ok then profile, lease, revision = result, math.huge, 0 else failure = "InvalidDefaultProfile" end
    else
        local record, reason = self:_retry(function()
            local rejection
            local result = self._Store:UpdateAsync(key, function(raw)
                rejection = nil -- UpdateAsync may invoke this callback repeatedly
                local data, session, oldRevision, unpackError = unpackRecord(raw)
                if unpackError then rejection = unpackError; return nil end
                local now = self._Now()
                if session and session.Token ~= token and session.ExpiresAt > now then
                    rejection = "SessionLocked"; return nil
                end
                local ok, migrated, migrationError = pcall(function()
                    if data == nil then return self._Schema.New(now) end
                    return self._Schema.Migrate(copy(data), now)
                end)
                if not ok or migrated == nil then rejection = migrationError or "MigrationFailed"; return nil end
                local copied, snapshot = pcall(copy, migrated)
                if not copied or not self:_valid(snapshot) then rejection = "InvalidProfile"; return nil end
                return { _RecordVersion = 1, Data = snapshot, Revision = oldRevision,
                    Session = { Token = token, ExpiresAt = now + self._Lease } }
            end)
            return result, rejection
        end)
        if record and record._RecordVersion == 1 and record.Session
            and record.Session.Token == token and record.Session.ExpiresAt > self._Now() then
            profile, lease, revision = copy(record.Data), record.Session.ExpiresAt, record.Revision
        else failure = reason or "SessionLost" end
    end
    if not profile or not self:_valid(profile) then
        self._Loading[key] = nil
        return nil, failure or "InvalidProfile"
    end
    local entry = { Player = player, Profile = profile, Token = token, LeaseUntil = lease,
        Revision = revision, NextSave = self._Now() + self._AutoSave }
    self._Entries[key] = entry
    if self._Closing or self._CloseStarted then
        if not self:Release(player) then self._LateReleaseFailed = true end
        self._Loading[key] = nil
        return nil, "ServerClosing"
    end
    self._Loading[key] = nil
    return profile
end

function DataService:Save(player, release)
    local key = playerKey(player)
    local entry = self._Entries[key]
    if not entry or entry.Player ~= player then return false, "ProfileNotLoaded" end
    if release then entry.Releasing = true end -- freeze before waiting for an in-flight save
    while entry.Saving do
        self._Wait(0.05)
        if self._Entries[key] ~= entry then return release == true, if release then nil else "ProfileReleased" end
    end
    if entry.Lost then
        if release then self._Entries[key] = nil end
        return false, entry.Error or "SessionLost"
    end
    if (entry.Releasing or self._Closing) and not release then return false, "ProfileReleasing" end
    entry.Saving = true
    local copied, snapshot = pcall(copy, entry.Profile)
    if not copied or not self:_valid(snapshot) then
        entry.Saving, entry.Error, entry.Frozen = false, "InvalidProfile", true
        return false, entry.Error
    end
    if self.Status == "StudioMemory" then
        entry.Revision += 1
        entry.Saving, entry.Error = false, nil
        if release then self._Entries[key] = nil end
        return true
    end
    self._WriteSequence += 1
    local operationId = entry.Token .. ":" .. tostring(self._WriteSequence)
    local record, failure = self:_retry(function()
        local rejection
        local result = self._Store:UpdateAsync(key, function(raw)
            rejection = nil
            local _, session, oldRevision, unpackError = unpackRecord(raw)
            if unpackError then rejection = unpackError; return nil end
            local now = self._Now()
            -- A committed write can still produce a network error. Retrying an
            -- already completed release must recognize this operation, without
            -- releasing any lease subsequently acquired by a different session.
            local lastWrite = raw and raw.LastWrite
            if lastWrite and lastWrite.Token == entry.Token and lastWrite.Id == operationId then
                if (release and session == nil) or (not release and session
                    and session.Token == entry.Token and session.ExpiresAt > now) then return copy(raw) end
            end
            if not session or session.Token ~= entry.Token or session.ExpiresAt <= now then
                rejection = "SessionLost"; return nil
            end
            return { _RecordVersion = 1, Data = copy(snapshot), Revision = oldRevision + 1,
                LastWrite = { Token = entry.Token, Id = operationId },
                Session = if release then nil else { Token = entry.Token, ExpiresAt = now + self._Lease } }
        end)
        return result, rejection
    end)
    -- A cancelled UpdateAsync may return nil; success always requires our written snapshot.
    if record and record._RecordVersion == 1 and record.Revision > entry.Revision
        and record.LastWrite and record.LastWrite.Token == entry.Token and record.LastWrite.Id == operationId
        and (release and record.Session == nil or not release and record.Session
            and record.Session.Token == entry.Token and record.Session.ExpiresAt > self._Now()) then
        entry.Revision, entry.Error, entry.Frozen = record.Revision, nil, false
        if not release then entry.LeaseUntil = record.Session.ExpiresAt end
        entry.NextSave = self._Now() + self._AutoSave
        entry.Saving = false
        if release then self._Entries[key] = nil end
        return true
    end
    entry.Saving, entry.Error = false, failure or "SessionLost"
    entry.NextSave = self._Now() + math.min(15, self._AutoSave)
    if entry.Error ~= "DataStoreUnavailable"
        or self._Now() >= entry.LeaseUntil then
        entry.Lost, entry.Frozen = true, true
        self:_signal(entry, "Your data session has ended. Rejoin to protect your progress.", "Error")
        if entry.Releasing then self._Entries[key] = nil end
    else
        self:IsWritable(player) -- freeze before the safety boundary even if retries consumed time
    end
    return false, entry.Error
end

function DataService:Release(player)
    if not self:Get(player) then return true end
    return self:Save(player, true)
end

function DataService:Start()
    if self._Started then return end
    self._Started = true
    local players = self._Players or game:GetService("Players")
    self._LeaveConnection = players.PlayerRemoving:Connect(function(player)
        if self._Ctx.BeforeDataRelease then pcall(self._Ctx.BeforeDataRelease, player) end
        self:Release(player)
    end)
    local bind = self._BindToClose or function(callback) game:BindToClose(callback) end
    bind(function() self:Close() end)
    self._Spawn(function()
        while not self._Closing do
            self._Wait(math.min(10, self._AutoSave / 2))
            if self._Closing then break end
            local now = self._Now()
            for _, entry in pairs(self._Entries) do
                self:IsWritable(entry.Player)
                if entry.Lost and entry.Releasing then self._Entries[playerKey(entry.Player)] = nil end
                if not entry.Saving and not entry.Lost and now >= entry.NextSave then
                    entry.NextSave = now + self._AutoSave
                    self._Spawn(function()
                        if entry.Releasing then self:Release(entry.Player) else self:Save(entry.Player) end
                    end)
                end
            end
        end
    end)
end

function DataService:Close()
    if self._CloseStarted then return self._CloseResult or false end
    self._CloseStarted = true
    -- Gameplay first settles temporary loot while profiles are still writable.
    -- The caller's hook must prevent new gameplay transactions immediately.
    if self._Ctx.BeforeDataClose then pcall(self._Ctx.BeforeDataClose) end
    self._Closing = true
    if self._LeaveConnection then self._LeaveConnection:Disconnect() end
    local pending, complete, failed = {}, 0, false
    for _, entry in pairs(self._Entries) do
        entry.Releasing = true
        table.insert(pending, entry.Player)
    end
    for _, player in ipairs(pending) do
        self._Spawn(function()
            local ok = self:Release(player)
            if not ok then failed = true end
            complete += 1
        end)
    end
    local deadline = self._Now() + 25
    while (complete < #pending or next(self._Loading) ~= nil) and self._Now() < deadline do self._Wait(0.05) end
    self._CloseResult = complete == #pending and next(self._Loading) == nil and not failed and not self._LateReleaseFailed
    return self._CloseResult
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="38">
        <Properties>
          <string name="Name">EconomyService</string>
          <string name="Source"><![CDATA[-- Currency mutations are synchronous and only operate on an acquired profile.
local Economy = {}
Economy.__index = Economy
function Economy.new(ctx) return setmetatable({ Context = ctx }, Economy) end
function Economy:CanAfford(player, amount)
    local profile = self.Context.Data:Get(player)
    return profile ~= nil and typeof(amount) == "number" and amount == amount
        and amount >= 0 and amount % 1 == 0 and profile.Cash >= amount
end
function Economy:AddCash(player, amount, reason)
    local ctx = self.Context
    local profile = ctx.Data:Get(player)
    local limit = ctx.Config.Economy.MaxCash or 1e15
    if not profile or not ctx.Data:IsWritable(player) or typeof(amount) ~= "number"
        or amount ~= amount or amount < 0 or amount % 1 ~= 0 or amount > limit then return false end
    if profile.Cash + amount > limit then return false end
    profile.Cash += amount
    profile.Statistics.TotalCashEarned = math.min(limit, profile.Statistics.TotalCashEarned + amount)
    if ctx.Analytics then ctx.Analytics:Emit(player, "CashSource", { Amount = amount, Reason = reason }) end
    if ctx.Quest then ctx.Quest:Progress(player, "EarnCash", amount) end
    return true
end
function Economy:RemoveCash(player, amount, reason)
    local ctx = self.Context
    if not ctx.Data:IsWritable(player) or not self:CanAfford(player, amount) then return false end
    local profile = ctx.Data:Get(player)
    profile.Cash -= amount
    profile.Statistics.TotalCashSpent = math.min(ctx.Config.Economy.MaxCash or 1e15, profile.Statistics.TotalCashSpent + amount)
    if ctx.Analytics then ctx.Analytics:Emit(player, "CashSink", { Amount = amount, Reason = reason }) end
    return true
end
function Economy:Sell(player, uid, confirmed)
    local ctx = self.Context
    local profile = ctx.Data:Get(player)
    if not profile or not ctx.Data:IsWritable(player) or not ctx.AntiExploit:Near(player, ctx.World.ShopPosition, ctx.Config.Game.ShopRadius) then
        return false, "Visit the furniture shop in the town square to sell."
    end
    if ctx.Robbery:Get(player) then return false, "Bring your stolen bag home before selling." end
    if typeof(uid) ~= "string" or #uid > 80 then return false, "Invalid item." end
    local entry = profile.Inventory[uid]
    local item = entry and ctx.Config.Items[entry.ItemId]
    if not item or item.Sellable == false then return false, "This stored item cannot be sold." end
    if ctx.Config.Rarities[item.Rarity].Rank >= 3 and confirmed ~= true then return false, "Confirm selling this valuable item." end
    local multiplier = ctx.Events and ctx.Events:Multiplier("Cash") or 1
    local amount = math.floor(item.Value * (ctx.Config.Economy.SellMultiplier or 1) * multiplier)
    if profile.Cash + amount > (ctx.Config.Economy.MaxCash or 1e15) then return false, "Cash limit reached." end
    -- All prerequisites are checked before either side of this transaction changes.
    profile.Inventory[uid] = nil
    if not self:AddCash(player, amount, "SellItem") then profile.Inventory[uid] = entry; return false, "Sale unavailable." end
    profile.Statistics.ItemsSold += 1
    ctx.Quest:Progress(player, "SellItems", 1)
    ctx.Publish(player)
    return true, "Sold " .. item.Name .. " for $" .. amount .. "."
end
return Economy
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="39">
        <Properties>
          <string name="Name">EventService</string>
          <string name="Source"><![CDATA[-- One server-owned scheduler; bootstrap calls Tick instead of starting independent loops.
local EventService = {}
EventService.__index = EventService

local SUPPORTED = { Blackout = true, GoldenHour = true, PoliceRaid = true, DoubleCash = true, DoubleXP = true }
local MULTIPLIERS = { Cash = "CashMultiplier", XP = "XPMultiplier", Security = "SecurityMultiplier", Spawn = "SpawnMultiplier" }

local function service(ctx, name)
    if ctx[name] then return ctx[name] end
    if game then return game:GetService(name) end
    return nil
end

function EventService.new(ctx)
    local clock = ctx.Clock or os.time
    local ids = {}
    for id, definition in pairs(ctx.Config.Events) do
        if SUPPORTED[id] and definition.Enabled ~= false then table.insert(ids, id) end
    end
    table.sort(ids)
    return setmetatable({
        ctx = ctx, clock = clock, lighting = service(ctx, "Lighting"), players = service(ctx, "Players"),
        colors = ctx.Color3 or Color3,
        active = nil, lightingBefore = nil, ids = ids, sequence = 0,
        nextAt = clock() + (ctx.Config.Game.EventIntervalSeconds or 480),
    }, EventService)
end

function EventService:_announce(text, kind)
    if self.ctx.Announce then
        self.ctx.Announce(text, kind)
    elseif self.players then
        for _, player in ipairs(self.players:GetPlayers()) do
            if self.ctx.Notify then self.ctx.Notify(player, text, kind) end
            if self.ctx.Publish and self.ctx.Data:Get(player) then self.ctx.Publish(player) end
        end
    end
end

function EventService:_restoreLighting()
    if self.lighting and self.lightingBefore then
        for key, value in pairs(self.lightingBefore) do self.lighting[key] = value end
    end
    self.lightingBefore = nil
end

function EventService:_visual(id)
    if not self.lighting then return end
    self.lightingBefore = {
        ClockTime = self.lighting.ClockTime, Brightness = self.lighting.Brightness,
        Ambient = self.lighting.Ambient, OutdoorAmbient = self.lighting.OutdoorAmbient,
    }
    if id == "Blackout" then
        self.lighting.ClockTime = 0
        self.lighting.Brightness = 0.45
        self.lighting.Ambient = self.colors.fromRGB(25, 27, 45)
        self.lighting.OutdoorAmbient = self.colors.fromRGB(35, 38, 59)
    elseif id == "GoldenHour" then
        self.lighting.ClockTime = 17.3
        self.lighting.Brightness = 2.4
        self.lighting.Ambient = self.colors.fromRGB(165, 133, 85)
    elseif id == "PoliceRaid" then
        self.lighting.ClockTime = 19
        self.lighting.Ambient = self.colors.fromRGB(86, 86, 120)
    end
end

function EventService:StartEvent(id)
    local definition = type(id) == "string" and self.ctx.Config.Events[id] or nil
    if not definition or not SUPPORTED[id] or definition.Enabled == false then
        return false, "This event is unavailable in the launch build."
    end
    if self.active then self:StopEvent() end
    local now = self.clock()
    self.active = {
        Id = id, Name = definition.Name, Color = definition.Color,
        StartedAt = now, EndsAt = now + definition.Duration, Duration = definition.Duration,
    }
    self:_visual(id)
    self:_announce(definition.Name .. "! " .. definition.Duration .. " seconds remaining.", "Event")
    if self.ctx.Analytics then self.ctx.Analytics:Emit(nil, "EventStarted", { Event = id }) end
    return true
end

function EventService:StopEvent()
    if not self.active then return end
    local name = self.active.Name
    local id = self.active.Id
    self.active = nil
    self:_restoreLighting()
    self.nextAt = self.clock() + (self.ctx.Config.Game.EventIntervalSeconds or 480)
    self:_announce(name .. " has ended.", "Event")
    if self.ctx.Analytics then self.ctx.Analytics:Emit(nil, "EventEnded", { Event = id }) end
end

function EventService:GetActive()
    if not self.active or self.clock() >= self.active.EndsAt then return nil end
    return {
        Id = self.active.Id, Name = self.active.Name, Color = self.active.Color,
        StartedAt = self.active.StartedAt, EndsAt = self.active.EndsAt, Duration = self.active.Duration,
        SecondsRemaining = math.max(0, self.active.EndsAt - self.clock()),
    }
end

function EventService:GetActiveEvent()
    return self:GetActive()
end

function EventService:IsActive(id)
    local active = self:GetActive()
    return active ~= nil and active.Id == id
end

function EventService:Multiplier(kind)
    local active = self:GetActive()
    if not active then return 1 end
    local definition = self.ctx.Config.Events[active.Id]
    if kind == "Heat" and active.Id == "PoliceRaid" then return definition.HeatMultiplier or 1.5 end
    local field = MULTIPLIERS[kind] or (kind .. "Multiplier")
    return definition[field] or 1
end

function EventService:Tick(_dt)
    local now = self.clock()
    if self.active then
        if now >= self.active.EndsAt then self:StopEvent() end
        return
    end
    if now >= self.nextAt and #self.ids > 0 then
        self.sequence = self.sequence % #self.ids + 1
        self:StartEvent(self.ids[self.sequence])
    end
end

function EventService:Destroy()
    self.active = nil
    self:_restoreLighting()
end

return EventService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="40">
        <Properties>
          <string name="Name">HeatService</string>
          <string name="Source"><![CDATA[local Heat = {}
Heat.__index = Heat
function Heat.new(ctx) return setmetatable({ Context = ctx, Values = {} }, Heat) end
function Heat:Get(player) return self.Values[player] or 0 end
function Heat:Add(player, amount)
    self.Values[player] = math.clamp(self:Get(player) + amount, 0, 100)
end
function Heat:Tick(dt)
    local ctx = self.Context
    for _, player in ipairs(ctx.Players:GetPlayers()) do
        local robbery = ctx.Robbery:Get(player)
        local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if robbery and root then
            local target = ctx.World:GetNPC(robbery.TargetHouse)
            if target and ctx.World:GetNPCAt(root.Position) == target then
                local area = ctx.Config.Game.Areas[target.Area]
                self:Add(player, (area.HeatPerSecond or 1) * dt * ctx.Events:Multiplier("Heat"))
            end
        elseif self:Get(player) > 0 then
            self:Add(player, -ctx.Config.Game.HeatDecayPerSecond * dt)
        end
    end
end
function Heat:Remove(player) self.Values[player] = nil end
return Heat
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="41">
        <Properties>
          <string name="Name">HouseService</string>
          <string name="Source"><![CDATA[local House = {}
House.__index = House
local function finite(value) return typeof(value) == "number" and value == value and math.abs(value) < 1e6 end
local function footprint(spec, rotation)
    local x, z = spec.Size.X, spec.Size.Z
    if rotation % 180 ~= 0 then return z, x end
    return x, z
end
function House.new(ctx) return setmetatable({ Context = ctx }, House) end
function House:Value(player)
    local ctx = self.Context
    local profile = ctx.Data:Get(player)
    if not profile then return 0 end
    local value = ctx.Config.Houses[profile.House.Tier].Value
    local count = 0
    for _, entry in pairs(profile.House.Furniture) do
        local item = ctx.Config.Items[entry.ItemId]
        if item then
            value += math.floor(item.Value * (1 + (ctx.Config.Rarities[item.Rarity].Rank - 1) * 0.05))
            count += 1
        end
    end
    value += math.floor(count / 4) * 100
    profile.House.HouseValue = value
    return value
end
function House:AtHome(player)
    local plot = self.Context.World:GetPlot(player)
    local root = self.Context.AntiExploit:Character(player)
    return plot ~= nil and root ~= nil and self.Context.AntiExploit:ValidateMovement(player)
        and self.Context.World:IsInHome(player, root.Position)
end
function House:Render(player)
    local ctx = self.Context
    self:Value(player)
    local ok, err = pcall(function() ctx.World:RenderHome(player, ctx.Data:Get(player)) end)
    if not ok then warn("[HouseRender]", player.UserId, err) end
    return ok
end
function House:Place(player, uid, x, z, rotation)
    local ctx = self.Context
    local profile = ctx.Data:Get(player)
    if not profile or not ctx.Data:IsWritable(player) or not self:AtHome(player) then return false, "Return to your own house to place furniture." end
    if ctx.Robbery:Get(player) then return false, "Secure your robbery bag first." end
    if typeof(uid) ~= "string" or #uid > 80 or not finite(x) or not finite(z)
        or not finite(rotation) or rotation % 90 ~= 0 or rotation < 0 or rotation > 270 then return false, "Invalid placement." end
    local entry = profile.Inventory[uid]
    local item = entry and ctx.Config.Items[entry.ItemId]
    if not item or item.Displayable == false then return false, "You don't own this stored furniture." end
    local tier = ctx.Config.Houses[profile.House.Tier]
    local width, depth = footprint(item, rotation)
    -- Snap to the server's grid, then check the complete rotated footprint.
    local grid = ctx.Config.Game.GridSize
    x, z = math.round(x / grid) * grid, math.round(z / grid) * grid
    if math.abs(x) + width / 2 > tier.Width / 2 - 2 or math.abs(z) + depth / 2 > tier.Depth / 2 - 2 then
        return false, "Furniture must fit entirely inside your house."
    end
    -- Keep a walkable doorway corridor in every tier.
    if math.abs(x) < 4 + width / 2 and z < -tier.Depth / 2 + 9 + depth / 2 then return false, "Keep the doorway clear." end
    local count = 0
    for _, placed in pairs(profile.House.Furniture) do
        count += 1
        local other = ctx.Config.Items[placed.ItemId]
        if other then
            local w, d = footprint(other, placed.Rotation)
            if math.abs(x - placed.X) < (width + w) / 2 + 0.2 and math.abs(z - placed.Z) < (depth + d) / 2 + 0.2 then
                return false, "Furniture overlaps another item."
            end
        end
    end
    if count >= tier.MaxFurniture then return false, "Upgrade your house for more display space." end
    profile.Inventory[uid] = nil
    profile.House.Furniture[uid] = { UniqueId = uid, ItemId = entry.ItemId, AcquiredAt = entry.AcquiredAt, X = x, Z = z, Rotation = rotation }
    profile.Statistics.ItemsPlaced += 1
    self:Render(player)
    ctx.Quest:Progress(player, "PlaceItem", 1)
    ctx.Publish(player)
    return true, "Placed " .. item.Name .. ". House value increased!"
end
function House:Pickup(player, uid)
    local ctx = self.Context
    local profile = ctx.Data:Get(player)
    if not profile or not ctx.Data:IsWritable(player) or not self:AtHome(player) then return false, "Return home to pick up furniture." end
    if ctx.Robbery:Get(player) then return false, "Finish your robbery first." end
    if typeof(uid) ~= "string" or #uid > 80 then return false, "Invalid item." end
    local entry = profile.House.Furniture[uid]
    if not entry or profile.Inventory[uid] then return false, "This item isn't placed in your house." end
    profile.House.Furniture[uid] = nil
    profile.Inventory[uid] = { UniqueId = uid, ItemId = entry.ItemId, AcquiredAt = entry.AcquiredAt }
    self:Render(player)
    ctx.Publish(player)
    return true, "Furniture returned to storage."
end
function House:Upgrade(player, security)
    local ctx = self.Context
    local profile = ctx.Data:Get(player)
    if not profile or not ctx.Data:IsWritable(player) or not self:AtHome(player) then return false, "Upgrade while at your own house." end
    if ctx.Robbery:Get(player) then return false, "Finish your robbery first." end
    local level = (if security then profile.House.SecurityLevel else profile.House.Tier) + 1
    local spec = (if security then ctx.Config.Security else ctx.Config.Houses)[level]
    if not spec then return false, "Already fully upgraded." end
    if profile.Level < spec.RequiredLevel then return false, "Reach level " .. spec.RequiredLevel .. " first." end
    if not ctx.Economy:RemoveCash(player, spec.Cost, if security then "SecurityUpgrade" else "HouseUpgrade") then return false, "Not enough cash." end
    if security then profile.House.SecurityLevel = level else profile.House.Tier = level end
    if security then profile.Statistics.SecurityUpgrades += 1 else profile.Statistics.HouseUpgrades += 1 end
    self:Render(player)
    ctx.Quest:Progress(player, if security then "UpgradeSecurity" else "UpgradeHouse", 1)
    ctx.Quest:AwardXP(player, 25 * level)
    ctx.Quest:UpdateTutorial(player, "Upgrade")
    ctx.Publish(player)
    return true, spec.Name .. " unlocked!"
end
function House:Customize(player, theme)
    local ctx = self.Context
    local profile = ctx.Data:Get(player)
    if not profile or not ctx.Data:IsWritable(player) or not self:AtHome(player) then return false, "Customize at your own house." end
    if typeof(theme) ~= "string" then return false, "Unknown theme." end
    local spec = ctx.Config.Game.Themes[theme]
    if not spec then return false, "Unknown theme." end
    if not profile.OwnedThemes[theme] then
        if not ctx.Economy:RemoveCash(player, spec.Cost, "HouseTheme") then return false, "Not enough cash for this cosmetic." end
        profile.OwnedThemes[theme] = true
    end
    profile.House.Theme = theme
    self:Render(player)
    ctx.Publish(player)
    return true, theme .. " theme applied."
end
return House
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="42">
        <Properties>
          <string name="Name">InventoryService</string>
          <string name="Source"><![CDATA[local Inventory = {}
Inventory.__index = Inventory
function Inventory.new(ctx) return setmetatable({ Context = ctx }, Inventory) end
function Inventory:Count(player)
    local profile = self.Context.Data:Get(player)
    if not profile then return 0 end
    local count = 0
    for _ in pairs(profile.Inventory) do count += 1 end
    for _ in pairs(profile.House.Furniture) do count += 1 end
    return count
end
function Inventory:ReservedCount(player)
    local state = self.Context.Robbery and self.Context.Robbery:Get(player)
    local count = 0
    if state then for _ in pairs(state.Carry) do count += 1 end end
    return count
end
function Inventory:CanStore(player, itemId)
    return self.Context.Config.Items[itemId] ~= nil
        and self:Count(player) + self:ReservedCount(player) < self.Context.Config.Game.MaxStoredItems
end
function Inventory:Capacity(player)
    local profile = self.Context.Data:Get(player)
    local spec = profile and self.Context.Config.Backpacks[profile.Backpack.Level]
    return spec and spec.Capacity or 0
end
function Inventory:CarryWeight(player)
    local robbery = self.Context.Robbery and self.Context.Robbery:Get(player)
    local total = 0
    if robbery then
        for _, entry in pairs(robbery.Carry) do total += self.Context.Config.Items[entry.ItemId].Weight end
    end
    return total
end
function Inventory:HasCapacity(player, itemId)
    local spec = self.Context.Config.Items[itemId]
    return spec ~= nil and self:CarryWeight(player) + spec.Weight <= self:Capacity(player)
end
function Inventory:AddStoredItem(player, itemId, reason, existing)
    local ctx = self.Context
    local profile = ctx.Data:Get(player)
    local state = ctx.Robbery and ctx.Robbery:Get(player)
    local handoff = existing and state and state.Carry[existing.UniqueId] == existing
    local room = if handoff then self:Count(player) < ctx.Config.Game.MaxStoredItems else self:CanStore(player, itemId)
    if not profile or not ctx.Data:IsWritable(player) or not room then return nil, "Home storage is full." end
    if existing and (existing.ItemId ~= itemId or typeof(existing.UniqueId) ~= "string") then return nil, "Invalid item handoff." end
    local entry = existing or { UniqueId = ctx.HttpService:GenerateGUID(false), ItemId = itemId, AcquiredAt = os.time() }
    if profile.Inventory[entry.UniqueId] or profile.House.Furniture[entry.UniqueId] then return nil, "Duplicate item rejected." end
    profile.Inventory[entry.UniqueId] = entry
    local collection = profile.Collection[itemId]
    if not collection then collection = { Discovered = true, FirstFound = os.time(), Count = 0 }; profile.Collection[itemId] = collection end
    collection.Count += 1
    if ctx.Analytics then ctx.Analytics:Emit(player, "ItemStored", { ItemId = itemId, Reason = reason }) end
    return entry
end
function Inventory:Upgrade(player, kind)
    local ctx = self.Context
    local profile = ctx.Data:Get(player)
    if not profile or not ctx.Data:IsWritable(player) then return false, "Data unavailable." end
    if ctx.Robbery:Get(player) then return false, "Finish your robbery before upgrading." end
    local nextLevel, spec
    if kind == "Backpack" then nextLevel = profile.Backpack.Level + 1; spec = ctx.Config.Backpacks[nextLevel]
    elseif kind == "Tool" then nextLevel = profile.Tools.LockpickLevel + 1; spec = ctx.Config.Tools[nextLevel]
    else return false, "Unknown upgrade." end
    if not spec then return false, "Already at maximum level." end
    if profile.Level < spec.RequiredLevel then return false, "Reach level " .. spec.RequiredLevel .. " first." end
    if not ctx.Economy:RemoveCash(player, spec.Cost, "Upgrade" .. kind) then return false, "Not enough cash." end
    if kind == "Backpack" then profile.Backpack.Level = nextLevel else profile.Tools.LockpickLevel = nextLevel end
    if kind == "Backpack" then profile.Statistics.BackpackUpgrades += 1 else profile.Statistics.ToolUpgrades += 1 end
    ctx.Quest:UpdateTutorial(player, "Upgrade")
    ctx.Publish(player)
    return true, kind .. " upgraded!"
end
return Inventory
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="43">
        <Properties>
          <string name="Name">ItemService</string>
          <string name="Source"><![CDATA[local ItemService = {}
ItemService.__index = ItemService
function ItemService.new(ctx)
    return setmetatable({ Context = ctx, Records = {}, Slots = {}, Random = Random.new() }, ItemService)
end
function ItemService:Select(house, spawn)
    local ctx = self.Context
    local pool, total = {}, 0
    for id, item in pairs(ctx.Config.Items) do
        local rank = ctx.Config.Rarities[item.Rarity].Rank
        local minimum = tonumber(spawn.MinRarity) or ctx.Config.Rarities[spawn.MinRarity or "Common"].Rank
        local maximum = tonumber(spawn.MaxRarity) or ctx.Config.Rarities[spawn.MaxRarity or "Secret"].Rank
        local categoryAllowed = not spawn.Categories or table.find(spawn.Categories, item.Category) ~= nil
        if categoryAllowed and item.RequiredArea <= house.Area and rank >= minimum and rank <= maximum then
            local weight = math.max(0, item.SpawnWeight)
            if item.Tags and table.find(item.Tags, "Golden") and ctx.Events:IsActive("GoldenHour") then weight *= ctx.Events:Multiplier("Spawn") end
            if item.Tags and table.find(item.Tags, "Alien") and ctx.Events:IsActive("AlienInvasion") then weight *= 4 end
            if weight > 0 then total += weight; table.insert(pool, { Id = id, Weight = weight }) end
        end
    end
    if total <= 0 then return nil end
    table.sort(pool, function(a, b) return a.Id < b.Id end)
    local roll = self.Random:NextNumber(0, total)
    for _, row in ipairs(pool) do roll -= row.Weight; if roll <= 0 then return row.Id end end
    return pool[#pool].Id
end
function ItemService:Spawn(house, point)
    local ctx = self.Context
    local key = house.Id .. ":" .. point.Id
    local slot = self.Slots[key]
    if slot and slot.Record then return end
    local itemId = self:Select(house, point)
    if not itemId then return end
    local record = { UniqueId = ctx.HttpService:GenerateGUID(false), ItemId = itemId, HouseId = house.Id,
        SpawnId = point.Id, Position = point.Position, SlotKey = key }
    local ok, model = pcall(function() return ctx.World:RenderLoot(record) end)
    if not ok or not model then
        warn("[LootSpawn]", key, tostring(model))
        self.Slots[key] = { House = house, Point = point, Ready = os.clock() + 5 }
        return
    end
    record.Model = model
    self.Records[record.UniqueId] = record
    self.Slots[key] = { House = house, Point = point, Record = record }
end
function ItemService:Start()
    for _, house in pairs(self.Context.World.NPCs) do
        for _, point in ipairs(house.SpawnPoints) do self:Spawn(house, point) end
    end
end
function ItemService:Get(id) return self.Records[id] end
function ItemService:Consume(record)
    if self.Records[record.UniqueId] ~= record then return false end
    self.Records[record.UniqueId] = nil
    self.Context.World:RemoveLoot(record)
    local slot = self.Slots[record.SlotKey]
    if slot then slot.Record = nil; slot.Ready = os.clock() + self.Context.Config.Game.ItemRespawnSeconds end
    return true
end
function ItemService:Tick()
    for _, slot in pairs(self.Slots) do
        if not slot.Record and (slot.Ready or 0) <= os.clock() then self:Spawn(slot.House, slot.Point) end
    end
end
return ItemService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="44">
        <Properties>
          <string name="Name">LeaderboardService</string>
          <string name="Source"><![CDATA[-- Live stats are synchronous; OrderedDataStore reads/writes run only on a coarse, cached schedule.
local LeaderboardService = {}
LeaderboardService.__index = LeaderboardService

local GLOBAL_METRICS = { "HouseValue", "CashEarned", "Robberies", "RareItems" }

local function integer(value)
    if type(value) ~= "number" or value ~= value or value < 0 or value >= math.huge then return 0 end
    return math.min(1000000000000000, math.floor(value))
end

local function newInstance(ctx, class)
    return ctx.CreateInstance and ctx.CreateInstance(class) or Instance.new(class)
end

function LeaderboardService.new(ctx)
    local self = setmetatable({
        ctx = ctx, clock = ctx.Clock or os.time, players = {}, pending = {}, written = {}, stores = {},
        global = {}, updatedAt = 0, saveElapsed = 0, readElapsed = 120,
        writing = false, reading = false, storeWarning = false,
        persistent = ctx.Data.Status == "Persistent",
    }, LeaderboardService)
    if self.persistent then
        local backend = ctx.DataStoreService or game:GetService("DataStoreService")
        local prefix = ctx.Config.Game.ProfileStore or "StealAHouse_v2"
        for _, metric in ipairs(GLOBAL_METRICS) do
            self.stores[metric] = backend:GetOrderedDataStore(prefix .. "_Rank_" .. metric)
            self.global[metric] = {}
        end
    end
    return self
end

function LeaderboardService:_warn(message)
    if self.storeWarning then return end
    self.storeWarning = true
    local log = self.ctx.Log or warn
    log("[StealAHouse] Global leaderboard unavailable; live server standings remain active. " .. tostring(message))
end

function LeaderboardService:InitPlayer(player)
    local folder = player:FindFirstChild("leaderstats")
    if not folder then
        folder = newInstance(self.ctx, "Folder")
        folder.Name = "leaderstats"
        folder.Parent = player
    end
    local values = {}
    for _, name in ipairs({ "Cash", "HouseValue", "ItemsStolen", "RareItems" }) do
        local value = folder:FindFirstChild(name)
        if not value then
            value = newInstance(self.ctx, "IntValue")
            value.Name = name
            value.Parent = folder
        end
        values[name] = value
    end
    self.players[player] = { Values = values }
    self:Update(player)
end

function LeaderboardService:Update(player)
    local profile = self.ctx.Data:Get(player)
    local state = self.players[player]
    if not profile or not state then return end
    local statistics = profile.Statistics or {}
    local house = profile.House or {}
    local row = {
        UserId = player.UserId, Name = player.DisplayName or player.Name,
        Cash = integer(profile.Cash), HouseValue = integer(house.HouseValue),
        ItemsStolen = integer(statistics.ItemsStolen), RareItems = integer(statistics.RareItemsFound),
    }
    state.Row = row
    for name, value in pairs(state.Values) do value.Value = row[name] end
    if self.persistent and self.ctx.Data:IsWritable(player) then
        local snapshot = {
            HouseValue = row.HouseValue, CashEarned = integer(statistics.TotalCashEarned),
            Robberies = integer(statistics.SuccessfulRobberies), RareItems = row.RareItems,
        }
        local previous = self.written[player.UserId]
        local changed = not previous
        for _, metric in ipairs(GLOBAL_METRICS) do
            if not previous or snapshot[metric] > (previous[metric] or -1) then changed = true end
        end
        if changed then self.pending[player.UserId] = snapshot end
    end
end

function LeaderboardService:_spawn(callback)
    local spawn = self.ctx.Spawn or task.spawn
    spawn(callback)
end

function LeaderboardService:Flush()
    if not self.persistent or self.writing or next(self.pending) == nil then return end
    local batch = {}
    for userId, values in pairs(self.pending) do batch[userId] = values end
    self.writing = true
    self:_spawn(function()
        for userId, values in pairs(batch) do
            local successful = true
            local cached = self.written[userId] or {}
            for _, metric in ipairs(GLOBAL_METRICS) do
                if not cached[metric] or values[metric] > cached[metric] then
                    local ok, result = pcall(function()
                        return self.stores[metric]:UpdateAsync(tostring(userId), function(old)
                            -- Lifetime records are monotonic, including highest-ever displayed house value.
                            return math.max(integer(old), values[metric])
                        end)
                    end)
                    if ok then
                        cached[metric] = integer(result)
                    else
                        successful = false
                        self:_warn(result)
                    end
                end
            end
            self.written[userId] = cached
            if successful and self.pending[userId] == values then self.pending[userId] = nil end
        end
        self.writing = false
    end)
end

function LeaderboardService:_refresh()
    if not self.persistent or self.reading then return end
    self.reading = true
    self:_spawn(function()
        local refreshed = false
        for _, metric in ipairs(GLOBAL_METRICS) do
            local ok, rows = pcall(function()
                return self.stores[metric]:GetSortedAsync(false, 10):GetCurrentPage()
            end)
            if ok then
                local result = {}
                for _, entry in ipairs(rows) do
                    local userId = tonumber(entry.key)
                    if userId then table.insert(result, { UserId = userId, Value = integer(entry.value) }) end
                end
                self.global[metric] = result
                refreshed = true
            else
                self:_warn(rows)
            end
        end
        if refreshed then self.updatedAt = self.clock() end
        self.reading = false
    end)
end

function LeaderboardService:Get()
    local live, global = {}, {}
    for _, state in pairs(self.players) do
        if state.Row then
            local row = {}
            for key, value in pairs(state.Row) do row[key] = value end
            table.insert(live, row)
        end
    end
    table.sort(live, function(a, b)
        if a.HouseValue ~= b.HouseValue then return a.HouseValue > b.HouseValue end
        if a.Cash ~= b.Cash then return a.Cash > b.Cash end
        return a.UserId < b.UserId
    end)
    for metric, rows in pairs(self.global) do
        global[metric] = {}
        for _, row in ipairs(rows) do table.insert(global[metric], { UserId = row.UserId, Value = row.Value }) end
    end
    return { Live = live, Global = global, PersistenceEnabled = self.persistent, UpdatedAt = self.updatedAt }
end

function LeaderboardService:Remove(player)
    self:Update(player)
    self.players[player] = nil
    self:Flush()
end

function LeaderboardService:Tick(dt)
    self.saveElapsed += dt
    self.readElapsed += dt
    if self.saveElapsed >= 90 then self.saveElapsed = 0; self:Flush() end
    if self.readElapsed >= 120 then self.readElapsed = 0; self:_refresh() end
end

return LeaderboardService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="45">
        <Properties>
          <string name="Name">ModelFactory</string>
          <string name="Source"><![CDATA[-- Built-in geometry only: every item has a recognizable silhouette without asset permissions.
local ModelFactory = {}

local DARK = Color3.fromRGB(31, 36, 47)
local WOOD = Color3.fromRGB(133, 91, 61)
local WHITE = Color3.fromRGB(222, 227, 228)
local RARITY = {
    Common = Color3.fromRGB(171, 184, 197), Uncommon = Color3.fromRGB(98, 205, 140),
    Rare = Color3.fromRGB(82, 156, 244), Epic = Color3.fromRGB(170, 105, 235),
    Legendary = Color3.fromRGB(255, 194, 77), Mythic = Color3.fromRGB(243, 89, 140),
    Secret = Color3.fromRGB(93, 235, 232),
}

function ModelFactory.Part(parent, name, size, cf, color, material)
    local part = Instance.new("Part")
    part.Name, part.Size, part.CFrame = name, size, cf
    part.Anchored, part.CanCollide, part.CanTouch = true, true, false
    part.Color, part.Material = color, material or Enum.Material.SmoothPlastic
    part.TopSurface, part.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
    part.Parent = parent
    return part
end

function ModelFactory.Label(part, text, color, height, distance)
    local gui = Instance.new("BillboardGui")
    gui.Name, gui.Size = "Label", UDim2.fromOffset(220, 58)
    gui.StudsOffset = Vector3.new(0, height or 4, 0)
    gui.MaxDistance, gui.AlwaysOnTop = distance or 72, false
    gui.Parent = part
    local label = Instance.new("TextLabel")
    label.Size, label.BackgroundTransparency = UDim2.fromScale(1, 1), 1
    label.Text, label.TextColor3 = text, color or Color3.new(1, 1, 1)
    label.TextStrokeTransparency, label.TextStrokeColor3 = 0.3, DARK
    label.TextSize, label.Font = 16, Enum.Font.GothamBold
    label.TextWrapped, label.Parent = true, gui
    return label
end

function ModelFactory.Prompt(part, action, title, callback, duration, distance)
    local prompt = Instance.new("ProximityPrompt")
    prompt.ActionText, prompt.ObjectText = action, title
    prompt.HoldDuration, prompt.MaxActivationDistance = duration or 0, distance or 10
    prompt.RequiresLineOfSight = true
    prompt.KeyboardKeyCode, prompt.GamepadKeyCode = Enum.KeyCode.E, Enum.KeyCode.ButtonX
    prompt.Parent = part
    prompt.Triggered:Connect(callback)
    return prompt
end

function ModelFactory.Furniture(item, rarityConfig, parent, cf)
    local model = Instance.new("Model")
    model.Name = item.Id or item.ItemId or "Furniture"
    local accent = (rarityConfig and rarityConfig.Color) or RARITY[item.Rarity] or WHITE
    if type(accent) == "string" then accent = Color3.fromHex((string.gsub(accent, "#", ""))) end
    local id = string.lower(model.Name .. " " .. (item.ModelKind or ""))
    local category = string.lower(item.Category or "Furniture")
    local width, depth = (item.Size and item.Size.X) or item.Width or 3, (item.Size and item.Size.Z) or item.Depth or 3
    local primary
    local function p(name, x, y, z, sx, sy, sz, color, material)
        local part = ModelFactory.Part(model, name, Vector3.new(sx, sy, sz), cf * CFrame.new(x, y, z), color, material)
        primary = primary or part
        return part
    end
    local function legs(top, w, d, height, color)
        for _, x in ipairs({ -w / 2 + 0.25, w / 2 - 0.25 }) do
            for _, z in ipairs({ -d / 2 + 0.25, d / 2 - 0.25 }) do
                p("Leg", x, top - height / 2, z, 0.25, height, 0.25, color)
            end
        end
    end
    if string.find(id, "toilet") then
        p("Pedestal", 0, 0.6, 0, width * 0.4, 1.2, depth * 0.45, WHITE)
        p("Bowl", 0, 1.45, -depth * 0.12, width * 0.8, 1.2, depth * 0.66, accent).Shape = Enum.PartType.Ball
        p("Seat", 0, 2, -depth * 0.12, width * 0.82, 0.2, depth * 0.65, WHITE)
        p("Tank", 0, 2.25, depth * 0.3, width * 0.72, 2, depth * 0.3, accent)
        p("Flush", width * 0.24, 2.7, depth * 0.13, 0.3, 0.2, 0.15, DARK)
    elseif string.find(id, "duck") or string.find(id, "chicken") then
        p("DisplayFoot", 0, 0.2, 0, width * 0.8, 0.4, depth * 0.8, DARK)
        p("Body", 0, 1.3, depth * 0.08, width * 0.78, 1.9, depth * 0.64, accent).Shape = Enum.PartType.Ball
        p("Head", 0, 2.55, -depth * 0.2, width * 0.45, 1.3, depth * 0.38, accent).Shape = Enum.PartType.Ball
        p("Beak", 0, 2.4, -depth * 0.42, width * 0.35, 0.25, depth * 0.12, Color3.fromRGB(255, 150, 67))
        for _, side in ipairs({ -1, 1 }) do
            p("Eye", side * width * 0.13, 2.8, -depth * 0.37, 0.14, 0.14, 0.1, DARK)
        end
        if string.find(id, "chicken") then
            p("Comb", 0, 3.2, -depth * 0.2, width * 0.2, 0.4, depth * 0.15, Color3.fromRGB(231, 81, 97))
        end
    elseif string.find(id, "dinosaur") or string.find(id, "dragon") then
        p("DisplayBase", 0, 0.2, 0, width, 0.4, depth, DARK)
        p("Body", 0, 1.6, 0, width * 0.64, 2.2, depth * 0.5, accent).Shape = Enum.PartType.Ball
        p("Neck", -width * 0.27, 2.8, -depth * 0.15, width * 0.16, 2, depth * 0.2, accent)
        p("Head", -width * 0.25, 3.7, -depth * 0.24, width * 0.38, 1, depth * 0.3, accent)
        p("Tail", width * 0.3, 1.7, depth * 0.18, width * 0.3, 0.6, depth * 0.2, accent)
        p("Eye", -width * 0.29, 3.9, -depth * 0.4, 0.16, 0.16, 0.1, DARK)
        for _, side in ipairs({ -1, 1 }) do
            p("Leg", side * width * 0.2, 0.8, 0, width * 0.12, 1.2, depth * 0.2, accent)
        end
    elseif string.find(id, "spoon") then
        p("Base", 0, 0.2, 0, width * 0.75, 0.4, depth, DARK)
        p("Handle", 0, 1.4, depth * 0.1, width * 0.15, 0.3, depth * 0.6, accent, Enum.Material.Metal)
        p("SpoonBowl", 0, 1.45, -depth * 0.3, width * 0.65, 0.5, depth * 0.34, accent, Enum.Material.Metal).Shape = Enum.PartType.Ball
    elseif string.find(id, "ufo") then
        local saucer = p("Saucer", 0, 1.7, 0, 0.55, width, depth, accent, Enum.Material.Metal)
        saucer.Shape = Enum.PartType.Cylinder
        saucer.CFrame *= CFrame.Angles(0, 0, math.pi / 2)
        p("Dome", 0, 2.2, 0, width * 0.55, 1.4, depth * 0.55, Color3.fromRGB(115, 230, 205), Enum.Material.Glass).Shape = Enum.PartType.Ball
        for _, side in ipairs({ -1, 1 }) do
            p("LandingGear", side * width * 0.25, 0.7, 0, 0.3, 1.4, 0.3, DARK)
            p("Light", side * width * 0.3, 1.85, -depth * 0.3, 0.35, 0.2, 0.35, WHITE, Enum.Material.Neon)
        end
    elseif string.find(id, "aquarium") then
        p("Stand", 0, 0.6, 0, width * 0.85, 1.2, depth * 0.85, DARK)
        p("Tank", 0, 2.5, 0, width, 2.5, depth, Color3.fromRGB(86, 198, 217), Enum.Material.Glass).Transparency = 0.3
        p("Sand", 0, 1.3, 0, width * 0.95, 0.3, depth * 0.95, Color3.fromRGB(215, 192, 125))
        p("Top", 0, 3.8, 0, width, 0.2, depth, DARK)
        p("Fish", -width * 0.15, 2.5, 0, width * 0.25, 0.45, 0.4, accent)
        p("Fish", width * 0.21, 2.1, 0, width * 0.18, 0.3, 0.3, WHITE)
    elseif string.find(id, "piano") then
        p("Body", 0, 2.4, depth * 0.08, width, 1.7, depth * 0.7, accent)
        p("Keyboard", 0, 2.3, -depth * 0.32, width * 0.9, 0.18, depth * 0.25, WHITE)
        legs(1.6, width - 0.3, depth * 0.68, 1.6, DARK)
        for index = 1, 6 do
            p("BlackKey", -width * 0.43 + index * width * 0.12, 2.43, -depth * 0.25, 0.15, 0.08, depth * 0.12, DARK)
        end
    elseif string.find(id, "sofa") or string.find(id, "couch") then
        p("Seat", 0, 1.25, 0, width, 0.8, depth, accent)
        p("Back", 0, 2.25, depth / 2 - 0.3, width, 2, 0.6, accent)
        p("LeftArm", -width / 2 + 0.3, 1.7, 0, 0.6, 1.7, depth, accent)
        p("RightArm", width / 2 - 0.3, 1.7, 0, 0.6, 1.7, depth, accent)
        legs(0.9, width - 0.2, depth - 0.2, 0.7, DARK)
        p("Cushion", -width / 4, 1.8, 0, width / 2 - 0.3, 0.25, depth - 0.7, WHITE)
        p("Cushion", width / 4, 1.8, 0, width / 2 - 0.3, 0.25, depth - 0.7, WHITE)
    elseif string.find(id, "chair") or string.find(id, "throne") or string.find(id, "stool") then
        p("Seat", 0, 1.8, 0, width, 0.45, depth, accent)
        legs(1.6, width - 0.1, depth - 0.1, 1.6, DARK)
        if not string.find(id, "stool") then
            p("Back", 0, 3, depth / 2 - 0.15, width, 2.4, 0.35, accent)
            p("BackTrim", 0, 4.25, depth / 2 - 0.15, width + 0.1, 0.18, 0.4, DARK)
        end
        if string.find(id, "throne") or string.find(id, "gaming") then
            p("Arm", -width / 2 + 0.1, 2.4, 0, 0.3, 0.3, depth, DARK)
            p("Arm", width / 2 - 0.1, 2.4, 0, 0.3, 0.3, depth, DARK)
        end
    elseif string.find(id, "bed") then
        p("Frame", 0, 0.7, 0, width, 1, depth, WOOD)
        p("Mattress", 0, 1.4, 0, width - 0.3, 0.6, depth - 0.3, WHITE)
        p("Blanket", 0, 1.75, -depth / 6, width - 0.4, 0.12, depth * 0.62, accent)
        p("Headboard", 0, 1.9, depth / 2 - 0.15, width, 3, 0.4, WOOD)
        p("Pillow", -width / 4, 1.9, depth / 3, width * 0.38, 0.3, 1, WHITE)
        p("Pillow", width / 4, 1.9, depth / 3, width * 0.38, 0.3, 1, WHITE)
    elseif (string.find(id, "table") or string.find(id, "desk"))
        and not string.find(id, "lamp") and not string.find(id, "shelf") and not string.find(id, "book") and not string.find(id, "cabinet") then
        p("Top", 0, 2.8, 0, width, 0.4, depth, WOOD)
        legs(2.6, width - 0.2, depth - 0.2, 2.6, DARK)
        p("Trim", 0, 2.45, -depth / 2 + 0.15, width - 0.25, 0.35, 0.25, accent)
    elseif string.find(id, "shelf") or string.find(id, "book") or string.find(id, "cabinet") then
        p("Left", -width / 2 + 0.15, 2.5, 0, 0.3, 5, depth, WOOD)
        p("Right", width / 2 - 0.15, 2.5, 0, 0.3, 5, depth, WOOD)
        p("Back", 0, 2.5, depth / 2 - 0.1, width, 5, 0.2, WOOD)
        for y = 0.2, 4.8, 1.15 do p("Shelf", 0, y, 0, width, 0.2, depth, WOOD) end
        for index = 1, 4 do
            p("Book", -width / 2 + index * width / 5, 1.9, 0, width / 7, 1, depth * 0.65, if index % 2 == 0 then accent else WHITE)
        end
    elseif string.find(id, "lamp") then
        p("Base", 0, 0.15, 0, width * 0.65, 0.3, depth * 0.65, DARK)
        p("Stem", 0, 1.8, 0, 0.18, 3.3, 0.18, DARK, Enum.Material.Metal)
        p("Shade", 0, 3.7, 0, width, 1, depth, accent)
        p("Light", 0, 3.1, 0, width * 0.8, 0.12, depth * 0.8, Color3.fromRGB(255, 239, 160), Enum.Material.Neon)
    elseif string.find(id, "plant") or string.find(id, "bonsai") or string.find(id, "flower") or string.find(id, "tree") then
        p("Pot", 0, 0.65, 0, width * 0.65, 1.3, depth * 0.65, accent)
        p("Soil", 0, 1.32, 0, width * 0.6, 0.12, depth * 0.6, WOOD)
        p("Stem", 0, 2.2, 0, 0.22, 1.7, 0.22, WOOD)
        local leaf = p("Leaves", 0, 3.1, 0, width, 1.8, depth, Color3.fromRGB(62, 145, 95))
        leaf.Shape = Enum.PartType.Ball
        p("Branch", width * 0.14, 2.5, 0, width * 0.7, 0.6, depth * 0.7, Color3.fromRGB(93, 183, 111)).Shape = Enum.PartType.Ball
    elseif string.find(id, "statue") or string.find(id, "trophy") or string.find(id, "sculpt") then
        p("Plinth", 0, 0.35, 0, width, 0.7, depth, DARK, Enum.Material.Marble)
        p("Body", 0, 1.9, 0, width * 0.5, 2.4, depth * 0.4, accent, Enum.Material.Metal)
        p("Head", 0, 3.55, 0, width * 0.45, 1, depth * 0.45, accent, Enum.Material.Metal).Shape = Enum.PartType.Ball
        p("Arm", -width * 0.35, 2.5, 0, width * 0.24, 1.6, depth * 0.25, accent, Enum.Material.Metal)
        p("Arm", width * 0.35, 2.5, 0, width * 0.24, 1.6, depth * 0.25, accent, Enum.Material.Metal)
    elseif string.find(id, "painting") or string.find(id, "art") or string.find(id, "portrait") then
        p("Frame", 0, 2.5, depth * 0.2, width, 4, 0.35, WOOD)
        p("Canvas", 0, 2.5, depth * 0.2 - 0.21, width - 0.45, 3.55, 0.06, accent)
        p("AbstractSun", -width / 5, 3.15, depth * 0.2 - 0.27, width * 0.35, 1.1, 0.07, WHITE).Shape = Enum.PartType.Ball
        p("Stand", 0, 0.5, 0, 0.3, 1, 0.3, DARK)
        p("Foot", 0, 0.15, 0, width * 0.75, 0.3, depth, DARK)
    elseif string.find(id, "car") or string.find(id, "bike") or string.find(id, "scooter") or category == "vehicles" or category == "vehicle" then
        p("Body", 0, 1.25, 0, width * 0.95, 1.25, depth * 0.85, accent, Enum.Material.Metal)
        p("Cabin", 0, 2.35, depth * 0.05, width * 0.72, 1.4, depth * 0.4, DARK)
        p("Windshield", 0, 2.45, -depth * 0.16, width * 0.62, 0.8, 0.1, Color3.fromRGB(124, 207, 220), Enum.Material.Glass)
        for _, x in ipairs({ -width * 0.46, width * 0.46 }) do
            for _, z in ipairs({ -depth * 0.22, depth * 0.22 }) do
                local wheel = p("Wheel", x, 0.8, z, 0.45, 1.5, 1.5, DARK)
                wheel.Shape = Enum.PartType.Cylinder
            end
        end
        p("Headlight", -width * 0.27, 1.4, -depth * 0.43, 0.6, 0.35, 0.15, WHITE, Enum.Material.Neon)
        p("Headlight", width * 0.27, 1.4, -depth * 0.43, 0.6, 0.35, 0.15, WHITE, Enum.Material.Neon)
    elseif string.find(id, "fridge") or string.find(id, "refriger") or string.find(id, "washer") then
        p("Body", 0, 2.6, 0, width, 5.2, depth * 0.8, WHITE, Enum.Material.Metal)
        p("Door", 0, 2.6, -depth * 0.4 - 0.05, width - 0.25, 4.85, 0.12, accent)
        p("Handle", width * 0.3, 3, -depth * 0.4 - 0.15, 0.15, 1.4, 0.2, DARK)
        p("Seam", 0, 3.6, -depth * 0.4 - 0.11, width, 0.08, 0.12, DARK)
    elseif string.find(id, "oven") or string.find(id, "microwave") or string.find(id, "coffee") or category == "appliances" or category == "appliance" then
        p("Body", 0, 1.55, 0, width, 3.1, depth * 0.8, accent, Enum.Material.Metal)
        p("Window", 0, 1.45, -depth * 0.4 - 0.04, width * 0.78, 1.8, 0.1, DARK)
        p("Handle", 0, 2.5, -depth * 0.4 - 0.15, width * 0.6, 0.14, 0.2, WHITE)
        for _, x in ipairs({ -width / 4, width / 4 }) do
            p("Hotplate", x, 3.13, 0, width * 0.3, 0.1, depth * 0.45, DARK)
        end
    elseif string.find(id, "tv") or string.find(id, "screen") or string.find(id, "monitor") or string.find(id, "pc") or category == "electronics" then
        p("Stand", 0, 0.18, 0, width * 0.6, 0.35, depth * 0.6, DARK)
        p("Stem", 0, 0.8, 0, 0.35, 1, 0.35, DARK)
        p("ScreenFrame", 0, 2.25, 0, width, 2.6, 0.3, DARK)
        p("Display", 0, 2.25, -0.18, width - 0.25, 2.35, 0.08, accent, Enum.Material.Neon)
        p("ScreenGraphic", -width / 6, 2.25, -0.24, width * 0.35, 1.5, 0.04, WHITE)
        if string.find(id, "pc") or string.find(id, "computer") then
            p("Tower", width * 0.36, 0.75, depth * 0.26, width * 0.25, 1.5, depth * 0.38, DARK)
            p("RGB", width * 0.36, 0.85, depth * 0.26 - depth * 0.2, width * 0.15, 1.2, 0.04, accent, Enum.Material.Neon)
        end
    elseif string.find(id, "safe") or string.find(id, "vault") then
        p("Vault", 0, 2, 0, width, 4, depth, DARK, Enum.Material.Metal)
        p("Door", 0, 2, -depth / 2 - 0.08, width - 0.35, 3.65, 0.18, accent, Enum.Material.Metal)
        p("Dial", 0, 2.15, -depth / 2 - 0.23, 0.7, 0.7, 0.25, WHITE).Shape = Enum.PartType.Ball
    else
        -- Collectible display pieces use a pedestal and faceted jewel rather than a generic cube.
        p("Base", 0, 0.25, 0, width, 0.5, depth, WOOD)
        p("Pedestal", 0, 1.1, 0, width * 0.55, 1.2, depth * 0.55, DARK)
        local jewel = p("Collectible", 0, 2.4, 0, width * 0.65, 1.8, depth * 0.65, accent, Enum.Material.Metal)
        jewel.CFrame *= CFrame.Angles(0, math.pi / 4, math.pi / 12)
        p("Trim", 0, 1.85, 0, width * 0.8, 0.2, depth * 0.8, WHITE)
    end
    model.PrimaryPart = primary
    -- An exposed interaction point prevents a fridge door or mattress from hiding its own prompt.
    local attachment = Instance.new("Attachment")
    attachment.Name = "InteractionAttachment"
    attachment.Position = primary.CFrame:PointToObjectSpace((cf * CFrame.new(0, 5.8, 0)).Position)
    attachment.Parent = primary
    model:SetAttribute("ItemId", item.Id or item.ItemId)
    model:SetAttribute("Rarity", item.Rarity)
    if item.Rarity == "Legendary" or item.Rarity == "Mythic" or item.Rarity == "Secret" then
        local glow = Instance.new("Highlight")
        glow.Name, glow.FillTransparency = "RarityAccent", 0.93
        glow.OutlineColor, glow.OutlineTransparency = accent, 0.4
        glow.DepthMode, glow.Parent = Enum.HighlightDepthMode.Occluded, model
    end
    model.Parent = parent
    return model
end

return ModelFactory
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="46">
        <Properties>
          <string name="Name">NetworkService</string>
          <string name="Source"><![CDATA[-- One allowlisted router is shared by remotes and server ProximityPrompt handlers.
local Network = {}
Network.__index = Network
local groups = {
    Gameplay = { RequestSteal = "Steal", RequestSell = "Sell", RequestPlaceItem = "Place", RequestPickupItem = "Pickup",
        RequestUpgrade = "Upgrade", RequestEscape = "Escape", RequestEnterHouse = "EnterHouse", RequestDisableSecurity = "DisableSecurity", RequestSprint = "Sprint" },
    House = { RequestHouseUpgrade = "HouseUpgrade", RequestHouseCustomization = "Theme", RequestSecurityUpgrade = "SecurityUpgrade", RequestHouseVisit = "Visit" },
    Quests = { RequestQuestClaim = "QuestClaim", RequestDailyClaim = "DailyClaim" },
    Settings = { RequestSetting = "Setting" },
    UI = { RequestSync = "Sync", Snapshot = false, Notification = false, RareItemFound = false, AlarmTriggered = false, HeatChanged = false, Announcement = false },
}
function Network.new(ctx)
    local self = setmetatable({ Context = ctx, Remotes = {} }, Network)
    local parent = Instance.new("Folder")
    parent.Name, parent.Parent = "Remotes", ctx.ReplicatedStorage
    for group, entries in pairs(groups) do
        local folder = Instance.new("Folder")
        folder.Name, folder.Parent = group, parent
        self.Remotes[group] = {}
        for name, action in pairs(entries) do
            local event = Instance.new("RemoteEvent")
            event.Name, event.Parent = name, folder
            self.Remotes[group][name] = event
            if action then
                event.OnServerEvent:Connect(function(player, ...) self:Request(player, action, ...) end)
            end
        end
    end
    return self
end
function Network:Request(player, action, a, b, c, d)
    local ctx = self.Context
    if ctx.Closing or not ctx.AntiExploit:Rate(player, action) then return end
    local profile = ctx.Data:Get(player)
    if action == "Sync" then ctx.Publish(player); return end
    if not profile or not ctx.Data:IsWritable(player) then ctx.Notify(player, "Your profile is loading or saving is unavailable.", "Warning"); return end
    if action ~= "Setting" and action ~= "QuestClaim" and action ~= "DailyClaim" and not ctx.AntiExploit:ValidateMovement(player) then return end
    local ok, message
    if action == "Steal" then ok, message = ctx.Robbery:Steal(player, a)
    elseif action == "EnterHouse" then ok, message = ctx.Robbery:Enter(player, a)
    elseif action == "Escape" then ok, message = ctx.Robbery:Escape(player)
    elseif action == "Sell" then ok, message = ctx.Economy:Sell(player, a, b)
    elseif action == "Place" then ok, message = ctx.House:Place(player, a, b, c, d)
    elseif action == "Pickup" then ok, message = ctx.House:Pickup(player, a)
    elseif action == "Upgrade" then ok, message = ctx.Inventory:Upgrade(player, a)
    elseif action == "HouseUpgrade" then ok, message = ctx.House:Upgrade(player, false)
    elseif action == "SecurityUpgrade" then ok, message = ctx.House:Upgrade(player, true)
    elseif action == "Theme" then ok, message = ctx.House:Customize(player, a)
    elseif action == "DisableSecurity" then ok, message = ctx.Security:Disable(player, a)
    elseif action == "QuestClaim" then ok, message = ctx.Quest:Claim(player, a)
    elseif action == "DailyClaim" then ok, message = ctx.Quest:ClaimDaily(player)
    elseif action == "InspectSecurity" then
        if a == player.UserId and ctx.House:AtHome(player) then ctx.Notify(player, "Your house is protected. Upgrade security in the House menu.", "House") end
    elseif action == "OpenShop" then
        if ctx.AntiExploit:Near(player, ctx.World.ShopPosition, ctx.Config.Game.ShopRadius) then
            ctx.Remotes.UI.Notification:FireClient(player, "Open the Shop or Inventory tab to sell stored items.", "Shop")
        end
    elseif action == "Sprint" then
        if typeof(a) == "boolean" then
            local _, humanoid = ctx.AntiExploit:Character(player)
            if humanoid then humanoid.WalkSpeed = if a then ctx.Config.Game.SprintSpeed else ctx.Config.Game.MoveSpeed end
        end
    elseif action == "Setting" then
        local allowed = { Music = true, SFX = true, Notifications = true, ReducedEffects = true, CameraShake = true }
        if typeof(a) == "string" and allowed[a] and typeof(b) == "boolean" then profile.Settings[a] = b; ctx.Publish(player)
        elseif a == "UIScale" and typeof(b) == "number" and b == b and b >= 0.8 and b <= 1.3 then profile.Settings.UIScale = b; ctx.Publish(player) end
    elseif action == "Visit" then
        if typeof(a) == "number" and a % 1 == 0 then
            for _, target in ipairs(ctx.Players:GetPlayers()) do
                if target.UserId == a then
                    local plot = ctx.World:GetPlot(target)
                    if plot and ctx.AntiExploit:Near(player, plot.Origin, 40) then
                        ok, message = true, target.DisplayName .. "'s house value: $" .. ctx.House:Value(target)
                    end
                end
            end
        end
    end
    if message then ctx.Notify(player, message, if ok then "Success" else "Warning") end
end
return Network
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="47">
        <Properties>
          <string name="Name">PlayerService</string>
          <string name="Source"><![CDATA[local PlayerService = {}
PlayerService.__index = PlayerService
function PlayerService.new(ctx) return setmetatable({ Context = ctx, Joined = {}, Connections = {}, Cleaned = setmetatable({}, { __mode = "k" }) }, PlayerService) end
function PlayerService:Spawn(player, character)
    local ctx = self.Context
    local root = character:WaitForChild("HumanoidRootPart", 10)
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local plot = ctx.World:GetPlot(player)
    if root and humanoid and plot and player.Character == character then
        ctx.AntiExploit:AllowTeleport(player)
        character:PivotTo(CFrame.new(plot.Origin + Vector3.new(0, 5, -20)))
        ctx.AntiExploit:ValidateMovement(player)
        humanoid.WalkSpeed = ctx.Config.Game.MoveSpeed
        local connection = humanoid.Died:Connect(function() ctx.Robbery:Fail(player, "You were caught during the robbery") end)
        self.DeathConnections = self.DeathConnections or {}
        if self.DeathConnections[player] then self.DeathConnections[player]:Disconnect() end
        self.DeathConnections[player] = connection
    end
end
function PlayerService:Join(player)
    local ctx = self.Context
    if self.Joined[player] or ctx.Closing then return end
    self.Joined[player] = true
    ctx.AntiExploit:Register(player)
    ctx.Notify(player, "Loading your house and collection…", "Info")
    local profile, errorMessage = ctx.Data:Load(player)
    if player.Parent ~= ctx.Players then ctx.Data:Release(player); self.Joined[player] = nil; ctx.AntiExploit:Remove(player); return end
    if not profile then
        self.Joined[player] = nil
        player:Kick("Your saved data could not be loaded safely (" .. tostring(errorMessage) .. "). Please try another server.")
        return
    end
    local plot = ctx.World:Assign(player)
    if not plot then
        ctx.Data:Release(player)
        player:Kick("All eight plots are occupied. Please join another server.")
        return
    end
    ctx.House:Render(player)
    ctx.Quest:InitPlayer(player)
    ctx.Leaderboard:InitPlayer(player)
    ctx.Analytics:InitPlayer(player)
    self.Connections[player] = player.CharacterAdded:Connect(function(character) self:Spawn(player, character) end)
    if player.Character then task.spawn(function() self:Spawn(player, player.Character) end) end
    if ctx.Data.Status == "StudioMemory" then ctx.Notify(player, "Studio practice mode: progress is not saved. Enable StudioPersistence only in a test place to test saving.", "Warning") end
    ctx.Publish(player)
end
function PlayerService:Cleanup(player)
    if self.Cleaned[player] then return end
    self.Cleaned[player] = true
    local ctx = self.Context
    ctx.Robbery:Remove(player)
    if self.Connections[player] then self.Connections[player]:Disconnect(); self.Connections[player] = nil end
    if self.DeathConnections and self.DeathConnections[player] then self.DeathConnections[player]:Disconnect(); self.DeathConnections[player] = nil end
    ctx.World:Release(player)
    ctx.Quest:Remove(player)
    ctx.Leaderboard:Remove(player)
    ctx.Analytics:Remove(player)
    ctx.Heat:Remove(player)
    ctx.Security:Remove(player)
    ctx.AntiExploit:Remove(player)
    self.Joined[player] = nil
end
function PlayerService:Start()
    local ctx = self.Context
    ctx.Players.PlayerAdded:Connect(function(player) task.spawn(function() self:Join(player) end) end)
    ctx.Players.PlayerRemoving:Connect(function(player)
        self:Cleanup(player)
        ctx.Data:Release(player)
        self.Cleaned[player] = nil
    end)
    for _, player in ipairs(ctx.Players:GetPlayers()) do task.spawn(function() self:Join(player) end) end
end
return PlayerService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="48">
        <Properties>
          <string name="Name">PoliceService</string>
          <string name="Source"><![CDATA[-- Police decisions, navigation and capture are evaluated on the server.
-- Tick runs at a low frequency; no per-frame or client-controlled AI is used.
local Players = game:GetService("Players")
local PathfindingService = game:GetService("PathfindingService")

local PoliceService = {}
PoliceService.__index = PoliceService

local function characterRoot(player)
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if root and root:IsA("BasePart") and humanoid and humanoid.Health > 0 then
        return root, character
    end
    return nil, character
end

local function flatDistance(first, second)
    local delta = first - second
    return Vector3.new(delta.X, 0, delta.Z).Magnitude
end

local function rigPart(model, name, size, color, offset, spawnCFrame, collidable)
    local part = Instance.new("Part")
    part.Name = name
    part.Size = size
    part.Color = color
    part.Material = Enum.Material.SmoothPlastic
    part.TopSurface = Enum.SurfaceType.Smooth
    part.BottomSurface = Enum.SurfaceType.Smooth
    part.CanCollide = collidable == true
    part.Massless = name ~= "HumanoidRootPart" and name ~= "Torso"
    part.CFrame = spawnCFrame * CFrame.new(offset)
    part.Parent = model
    return part
end

local function motor(name, first, second, c0, c1)
    local joint = Instance.new("Motor6D")
    joint.Name = name
    joint.Part0 = first
    joint.Part1 = second
    joint.C0 = c0
    joint.C1 = c1
    joint.Parent = first
end

local function createRig(parent, position)
    local model = Instance.new("Model")
    model.Name = "PoliceOfficer"
    local spawnCFrame = CFrame.new(position)
    local navy = Color3.fromRGB(34, 61, 113)
    local skin = Color3.fromRGB(238, 190, 133)
    local root = rigPart(model, "HumanoidRootPart", Vector3.new(2, 2, 1), navy, Vector3.zero, spawnCFrame, false)
    root.Transparency = 1
    local torso = rigPart(model, "Torso", Vector3.new(2, 2, 1), navy, Vector3.zero, spawnCFrame, true)
    local head = rigPart(model, "Head", Vector3.new(2, 1, 1), skin, Vector3.new(0, 1.5, 0), spawnCFrame, true)
    local leftArm = rigPart(model, "Left Arm", Vector3.new(1, 2, 1), navy, Vector3.new(-1.5, 0, 0), spawnCFrame, false)
    local rightArm = rigPart(model, "Right Arm", Vector3.new(1, 2, 1), navy, Vector3.new(1.5, 0, 0), spawnCFrame, false)
    local leftLeg = rigPart(model, "Left Leg", Vector3.new(1, 2, 1), navy, Vector3.new(-0.5, -2, 0), spawnCFrame, false)
    local rightLeg = rigPart(model, "Right Leg", Vector3.new(1, 2, 1), navy, Vector3.new(0.5, -2, 0), spawnCFrame, false)
    motor("RootJoint", root, torso, CFrame.new(), CFrame.new())
    motor("Neck", torso, head, CFrame.new(0, 1, 0), CFrame.new(0, -0.5, 0))
    motor("Left Shoulder", torso, leftArm, CFrame.new(-1, 0.5, 0), CFrame.new(0.5, 0.5, 0))
    motor("Right Shoulder", torso, rightArm, CFrame.new(1, 0.5, 0), CFrame.new(-0.5, 0.5, 0))
    motor("Left Hip", torso, leftLeg, CFrame.new(-0.5, -1, 0), CFrame.new(0, 1, 0))
    motor("Right Hip", torso, rightLeg, CFrame.new(0.5, -1, 0), CFrame.new(0, 1, 0))
    local humanoid = Instance.new("Humanoid")
    humanoid.Name = "Humanoid"
    -- New Humanoids default to R6; RigType is not changed at runtime.
    humanoid.MaxHealth = 100
    humanoid.Health = 100
    humanoid.WalkSpeed = 19
    humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
    humanoid.BreakJointsOnDeath = false
    humanoid.Parent = model
    local badge = Instance.new("BillboardGui")
    badge.Name = "PoliceLabel"
    badge.Size = UDim2.fromOffset(125, 42)
    badge.StudsOffset = Vector3.new(0, 2, 0)
    badge.MaxDistance = 100
    badge.Adornee = head
    badge.Parent = head
    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.Text = "POLICE\nInvestigating"
    label.TextColor3 = Color3.fromRGB(154, 201, 255)
    label.TextStrokeTransparency = 0.2
    label.Font = Enum.Font.GothamBold
    label.TextSize = 13
    label.Parent = badge
    model.PrimaryPart = root
    model.Parent = parent
    -- A single welded assembly is explicitly owned by the server, not a nearby client.
    pcall(function() root:SetNetworkOwner(nil) end)
    return model, root, humanoid, label
end

function PoliceService.new(ctx)
    local self = setmetatable({}, PoliceService)
    self.Ctx = ctx
    self.Units = {}
    self.LastSpawn = {}
    self.Metrics = { Ticks = 0, PathRequests = 0, Spawned = 0, Despawned = 0, Captures = 0, Live = 0 }
    self.Destroyed = false
    self.Elapsed = 0
    local gameConfig = ctx.Config and (ctx.Config.Game or ctx.Config) or {}
    self.Maximum = math.clamp(tonumber(gameConfig.MaximumPolice) or 16, 1, 16)
    self.CatchRadius = math.clamp(tonumber(gameConfig.PoliceCatchRadius) or 5, 1, 5)
    local folder = Instance.new("Folder")
    folder.Name = "Police"
    folder.Parent = ctx.World and ctx.World.Map or workspace
    self.Folder = folder
    return self
end

function PoliceService:_heat(player)
    local value = self.Ctx.Heat:Get(player)
    if type(value) == "table" then value = value.Heat or value.Value end
    if type(value) ~= "number" or value ~= value then return 0 end
    return math.clamp(value, 0, 100)
end

function PoliceService:_active(player)
    local robbery = self.Ctx.Robbery:Get(player)
    return type(robbery) == "table" and robbery.Active == true
end

function PoliceService:_atHome(player, position)
    local world = self.Ctx.World
    return world and world.IsInHome and world:IsInHome(player, position) == true
end

function PoliceService:_visible(unit, player, target)
    local _, character = characterRoot(player)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = character and { self.Folder, character } or { self.Folder }
    params.RespectCanCollide = true
    local origin = unit.Root.Position + Vector3.new(0, 1.25, 0)
    return workspace:Raycast(origin, target + Vector3.new(0, 1, 0) - origin, params) == nil
end

function PoliceService:_spawnPosition(target)
    local points = self.Ctx.World and self.Ctx.World.PoliceSpawnPositions or {}
    local choices = {}
    for _, point in ipairs(points) do
        if typeof(point) == "Vector3" then
            local distance = flatDistance(point, target)
            if distance >= 50 and distance <= 160 then table.insert(choices, point) end
        end
    end
    -- Randomized traversal avoids stacking every officer on the same spawn marker.
    for index = #choices, 2, -1 do
        local other = math.random(index)
        choices[index], choices[other] = choices[other], choices[index]
    end
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = { self.Folder }
    rayParams.RespectCanCollide = true
    local overlap = OverlapParams.new()
    overlap.FilterType = Enum.RaycastFilterType.Exclude
    overlap.FilterDescendantsInstances = { self.Folder }
    overlap.MaxParts = 24
    for _, point in ipairs(choices) do
        local ground = workspace:Raycast(point + Vector3.new(0, 12, 0), Vector3.new(0, -40, 0), rayParams)
        if not ground or ground.Normal.Y < 0.7 then continue end
        local position = ground.Position + Vector3.new(0, 3.1, 0)
        local clear = true
        for _, player in ipairs(Players:GetPlayers()) do
            local root = characterRoot(player)
            if root and (root.Position - position).Magnitude < 12 then clear = false; break end
        end
        if clear then
            for _, unit in ipairs(self.Units) do
                if (unit.Root.Position - position).Magnitude < 8 then clear = false; break end
            end
        end
        if clear then
            for _, part in ipairs(workspace:GetPartBoundsInBox(CFrame.new(position), Vector3.new(4, 5, 4), overlap)) do
                if part.CanCollide then clear = false; break end
            end
        end
        if clear then return position end
    end
    return nil
end

function PoliceService:_spawn(player, target)
    local position = self:_spawnPosition(target)
    if not position then return end
    local model, root, humanoid, label = createRig(self.Folder, position)
    model:SetAttribute("SuspectUserId", player.UserId)
    model:SetAttribute("PoliceState", "Investigating")
    local unit = {
        Player = player, Model = model, Root = root, Humanoid = humanoid, Label = label,
        State = "Investigating", Home = position, LastSeen = target, Born = self.Elapsed,
        LastSeenAt = self.Elapsed, LastPathAt = -math.huge, PathTarget = nil,
        Waypoints = {}, Waypoint = 1, PendingPath = false, PathGeneration = 0,
        Removed = false, ReturningAt = nil,
        LastPosition = position, LastMovedAt = self.Elapsed,
    }
    table.insert(self.Units, unit)
    self.Metrics.Spawned += 1
    self.Metrics.Live = #self.Units
    self.LastSpawn[player] = self.Elapsed
end

function PoliceService:_state(unit, name)
    if unit.State == name then return end
    unit.State = name
    unit.Model:SetAttribute("PoliceState", name)
    unit.Label.Text = "POLICE\n" .. name
    unit.Label.TextColor3 = name == "Chasing" and Color3.fromRGB(255, 117, 117) or Color3.fromRGB(154, 201, 255)
    unit.Humanoid.WalkSpeed = name == "Chasing" and 24 or 19
end

function PoliceService:_navigate(unit, target, visible)
    if (unit.Root.Position - unit.LastPosition).Magnitude >= 2 then
        unit.LastPosition = unit.Root.Position
        unit.LastMovedAt = self.Elapsed
    end
    if visible then
        -- Invalidate an in-flight path so it cannot overwrite fresh direct movement.
        if unit.PendingPath then unit.PathGeneration += 1; unit.PendingPath = false end
        unit.Waypoints = {}
        unit.PathTarget = nil
        unit.Humanoid:MoveTo(target)
        return
    end
    -- A newly closed door can invalidate an otherwise cached route.
    if not unit.PendingPath and self.Elapsed - unit.LastMovedAt >= 6
        and (unit.Root.Position - target).Magnitude > 8 then
        unit.PathTarget = nil
        unit.Waypoints = {}
        unit.LastMovedAt = self.Elapsed
    end
    local moved = not unit.PathTarget or (target - unit.PathTarget).Magnitude >= 10
    if not unit.PendingPath and self.Elapsed - unit.LastPathAt >= 3 and moved then
        unit.PendingPath = true
        unit.LastPathAt = self.Elapsed
        unit.PathTarget = target
        unit.PathGeneration += 1
        self.Metrics.PathRequests += 1
        local generation = unit.PathGeneration
        local origin = unit.Root.Position
        task.spawn(function()
            local path = PathfindingService:CreatePath({ AgentRadius = 2, AgentHeight = 5, AgentCanJump = true, WaypointSpacing = 5 })
            local ok = pcall(function() path:ComputeAsync(origin, target) end)
            if self.Destroyed or unit.Removed or generation ~= unit.PathGeneration then path:Destroy(); return end
            unit.PendingPath = false
            if ok and path.Status == Enum.PathStatus.Success then
                unit.Waypoints = path:GetWaypoints()
                unit.Waypoint = 2
            else
                unit.Waypoints = {}
                -- Failed routes may retry after the cooldown even if the suspect stands still.
                unit.PathTarget = nil
            end
            path:Destroy()
        end)
    end
    local waypoint = unit.Waypoints[unit.Waypoint]
    while waypoint and (unit.Root.Position - waypoint.Position).Magnitude < 4 do
        unit.Waypoint += 1
        waypoint = unit.Waypoints[unit.Waypoint]
    end
    if waypoint then
        if waypoint.Action == Enum.PathWaypointAction.Jump then unit.Humanoid.Jump = true end
        unit.Humanoid:MoveTo(waypoint.Position)
    end
end

function PoliceService:_destroy(index)
    local unit = self.Units[index]
    if not unit then return end
    unit.Removed = true
    unit.PathGeneration += 1
    unit.Model:Destroy()
    table.remove(self.Units, index)
    self.Metrics.Despawned += 1
    self.Metrics.Live = #self.Units
end

function PoliceService:_destroyUnit(unit)
    local index = table.find(self.Units, unit)
    if index then self:_destroy(index) end
end

function PoliceService:_return(unit)
    if not unit.ReturningAt then unit.ReturningAt = self.Elapsed end
    self:_state(unit, "Returning")
    self:_navigate(unit, unit.Home, false)
end

function PoliceService:Tick(dt)
    if self.Destroyed then return end
    self.Metrics.Ticks += 1
    local map = self.Ctx.World and self.Ctx.World.Map
    if map and map.Parent and self.Folder.Parent ~= map then self.Folder.Parent = map end
    self.Elapsed += math.clamp(tonumber(dt) or 1, 0, 5)
    -- A robbery failure can synchronously Remove() every officer for a suspect.
    -- Iterate a bounded snapshot so that callback removal cannot shift later entries.
    local units = table.clone(self.Units)
    for index = #units, 1, -1 do
        local unit = units[index]
        if unit.Removed then continue end
        local player = unit.Player
        local root = characterRoot(player)
        if not unit.Model.Parent or not unit.Root.Parent or unit.Humanoid.Health <= 0
            or player.Parent ~= Players or not root then
            self:_destroyUnit(unit)
            continue
        end
        local heat = self:_heat(player)
        local active = self:_active(player)
        if unit.ReturningAt or not active or heat <= 20 or self:_atHome(player, root.Position)
            or self.Elapsed - unit.Born >= 100 then
            self:_return(unit)
            if self.Elapsed - unit.ReturningAt >= 8 or (unit.Root.Position - unit.Home).Magnitude < 6 then
                self:_destroyUnit(unit)
            end
            continue
        end
        local visible = self:_visible(unit, player, root.Position)
        if heat >= 60 and visible then
            unit.LastSeen = root.Position
            unit.LastSeenAt = self.Elapsed
            self:_state(unit, "Chasing")
            -- LOS, life, position and active robbery are all checked again on the server.
            if (unit.Root.Position - root.Position).Magnitude <= self.CatchRadius then
                self.Metrics.Captures += 1
                local data = self.Ctx.Data
                if data and data:IsWritable(player) then
                    local profile = data:Get(player)
                    if profile and profile.Statistics then
                        profile.Statistics.PoliceCatches = (profile.Statistics.PoliceCatches or 0) + 1
                    end
                end
                self.Ctx.Robbery:Fail(player, "Caught by police")
                if not unit.Removed then self:_return(unit) end
                continue
            end
            self:_navigate(unit, root.Position, true)
        elseif unit.State == "Chasing" or unit.State == "Searching" then
            self:_state(unit, "Searching")
            self:_navigate(unit, unit.LastSeen, false)
            if self.Elapsed - unit.LastSeenAt >= 25 then self:_return(unit) end
        else
            self:_state(unit, "Investigating")
            if visible then unit.LastSeen = root.Position end
            self:_navigate(unit, unit.LastSeen, visible)
        end
    end
    for _, player in ipairs(Players:GetPlayers()) do
        if #self.Units >= self.Maximum then break end
        local root = characterRoot(player)
        local heat = self:_heat(player)
        if not root or heat < 40 or not self:_active(player) or self:_atHome(player, root.Position) then continue end
        local count = 0
        for _, unit in ipairs(self.Units) do
            if unit.Player == player then count += 1 end
        end
        local desired = heat >= 85 and 3 or (heat >= 60 and 2 or 1)
        if self.Ctx.Events and self.Ctx.Events:IsActive("PoliceRaid") then
            desired = math.min(3, desired + 1)
        end
        if count < desired and self.Elapsed - (self.LastSpawn[player] or -math.huge) >= 7 then
            self:_spawn(player, root.Position)
        end
    end
end

function PoliceService:Remove(player)
    for index = #self.Units, 1, -1 do
        if self.Units[index].Player == player then self:_destroy(index) end
    end
    self.LastSpawn[player] = nil
end

function PoliceService:Shutdown()
    self.Destroyed = true
    for index = #self.Units, 1, -1 do self:_destroy(index) end
    self.LastSpawn = {}
    self.Folder:Destroy()
end

return PoliceService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="49">
        <Properties>
          <string name="Name">QuestService</string>
          <string name="Source"><![CDATA[-- Progression is driven by validated server actions. Claims never yield between checks and grants.
local QuestService = {}
QuestService.__index = QuestService

local TUTORIAL = {
    { Action = "VisitHouses", Text = "Enter the first house on Starter Street." },
    { Action = "StealItems", Text = "Hold E or tap a furniture prompt to steal your first item." },
    { Action = "CompleteRobbery", Text = "RUN! Bring your backpack home to secure the loot." },
    { Action = "PlaceItem", Text = "Open your inventory and display an item in your house." },
    { Action = "Upgrade", Text = "Sell spare loot, then upgrade your house or backpack from its menu." },
}

local function positiveInteger(value)
    return type(value) == "number" and value == value and value < math.huge and value >= 0 and value % 1 == 0
end

local function clockDay(now)
    return math.floor(now / 86400)
end

local function finish(self, player)
    if self.ctx.Publish then self.ctx.Publish(player) end
end

function QuestService.new(ctx)
    return setmetatable({ ctx = ctx, clock = ctx.Clock or os.time, timers = {}, eventSeen = {} }, QuestService)
end

function QuestService:_profile(player)
    local profile = self.ctx.Data:Get(player)
    if not profile or not self.ctx.Data:IsWritable(player) then return nil end
    profile.Quests = profile.Quests or {}
    local quests = profile.Quests
    quests.Daily = quests.Daily or {}
    quests.Weekly = quests.Weekly or {}
    quests.Progress = quests.Progress or {}
    quests.Claimed = quests.Claimed or {}
    profile.Achievements = profile.Achievements or {}
    profile.DailyReward = profile.DailyReward or { CurrentDay = 1, LastClaim = 0 }
    return profile
end

function QuestService:_reset(player, profile)
    local today = clockDay(self.clock())
    local week = math.floor((today + 3) / 7) -- UTC weeks start on Monday.
    local quests = profile.Quests
    if quests.Day ~= today then
        quests.Day = today
        quests.Daily = {}
        for key in pairs(quests.Progress) do
            if string.sub(key, 1, 6) == "Daily:" then quests.Progress[key] = nil end
        end
        for key in pairs(quests.Claimed) do
            if string.sub(key, 1, 6) == "Daily:" then quests.Claimed[key] = nil end
        end
        for index, difficulty in ipairs({ "Easy", "Medium", "Hard" }) do
            local eligible = {}
            for id, entry in pairs(self.ctx.Config.Quests) do
                if entry.Difficulty == difficulty then table.insert(eligible, id) end
            end
            table.sort(eligible)
            if #eligible > 0 then
                -- Stable across reconnects, with a different selection for each UTC day/player.
                local seed = today * 1103515245 + player.UserId * 97 + index * 31
                table.insert(quests.Daily, eligible[(seed % #eligible) + 1])
            end
        end
    end
    if quests.Week ~= week then
        quests.Week = week
        quests.Weekly = {}
        for key in pairs(quests.Progress) do
            if string.sub(key, 1, 7) == "Weekly:" then quests.Progress[key] = nil end
        end
        for key in pairs(quests.Claimed) do
            if string.sub(key, 1, 7) == "Weekly:" then quests.Claimed[key] = nil end
        end
        for id, entry in pairs(self.ctx.Config.Quests) do
            if entry.Difficulty == "Weekly" then table.insert(quests.Weekly, id) end
        end
        table.sort(quests.Weekly)
    end
end

function QuestService:InitPlayer(player)
    local profile = self:_profile(player)
    if not profile then return end
    self:_reset(player, profile)
    if profile.FirstJoin == false then
        profile.TutorialStep = #TUTORIAL + 1
    else
        profile.TutorialStep = math.clamp(profile.TutorialStep or 1, 1, #TUTORIAL + 1)
    end
    self:_achievements(player, profile)
end

function QuestService:XPRequired(level)
    local base = self.ctx.Config.Economy.XPPerLevel or 100
    return math.max(1, math.floor(base * (1 + (math.max(1, level) - 1) * 0.25)))
end

function QuestService:_awardXP(profile, amount)
    local multiplier = self.ctx.Events and self.ctx.Events:Multiplier("XP") or 1
    profile.XP = (profile.XP or 0) + math.floor(amount * multiplier)
    profile.Level = profile.Level or 1
    local maximum = self.ctx.Config.Economy.MaxLevel or 1000
    while profile.Level < maximum and profile.XP >= self:XPRequired(profile.Level) do
        profile.XP -= self:XPRequired(profile.Level)
        profile.Level += 1
    end
    if profile.Level >= maximum then profile.XP = math.min(profile.XP, self:XPRequired(maximum)) end
end

function QuestService:AwardXP(player, amount)
    if not positiveInteger(amount) or amount > 10000000 then return false end
    local profile = self:_profile(player)
    if not profile then return false end
    self:_awardXP(profile, amount)
    return true
end

function QuestService:_analytics(player, event, fields)
    if self.ctx.Analytics then self.ctx.Analytics:Emit(player, event, fields) end
end

function QuestService:_reward(player, profile, reward, reason)
    local cash, xp = reward.Cash or 0, reward.XP or 0
    if not positiveInteger(cash) or not positiveInteger(xp) or xp > 10000000 then return false end
    local maximum = self.ctx.Config.Economy.MaxCash or 1000000000000
    if cash > maximum or profile.Cash > maximum - cash then return false end
    profile.Cash += cash
    profile.Statistics.TotalCashEarned = math.min(1000000000000000, (profile.Statistics.TotalCashEarned or 0) + cash)
    self:_awardXP(profile, xp)
    self:_analytics(player, "CashSource", { Amount = cash, Reason = reason })
    return true
end

function QuestService:_achievements(player, profile)
    for _, definition in ipairs(self.ctx.Config.Economy.Achievements or {}) do
        local state = profile.Achievements[definition.Id]
        if type(state) ~= "table" then
            state = { Claimed = state == true, Unlocked = state == true }
            profile.Achievements[definition.Id] = state
        end
        state.Progress = math.min(definition.Target, profile.Statistics[definition.Statistic] or 0)
        if state.Progress >= definition.Target and not state.Unlocked then
            state.Unlocked = true
            if self.ctx.Notify then self.ctx.Notify(player, "Achievement unlocked: " .. definition.Name, "Success") end
            self:_analytics(player, "AchievementUnlocked", { Achievement = definition.Id })
        end
    end
end

function QuestService:UpdateTutorial(player, action)
    local profile = self:_profile(player)
    if not profile or profile.FirstJoin == false then return false end
    local index = profile.TutorialStep or 1
    local step = TUTORIAL[index]
    if not step or (step.Action ~= action and not (step.Action == "Upgrade" and action == "UpgradeHouse")) then return false end
    profile.TutorialStep = index + 1
    if index == #TUTORIAL then
        profile.FirstJoin = false
        self:_analytics(player, "TutorialCompleted", {})
        if self.ctx.Notify then self.ctx.Notify(player, "Tutorial complete. Steal, escape, build, protect!", "Success") end
    end
    return true
end

function QuestService:Progress(player, typeName, amount, detail)
    amount = amount or 1
    if type(typeName) ~= "string" or not positiveInteger(amount) or amount <= 0 then return end
    local profile = self:_profile(player)
    if not profile then return end
    self:_reset(player, profile)
    local quests = profile.Quests
    local active = self.ctx.Events and self.ctx.Events:GetActive()
    if active and (typeName == "StealItems" or typeName == "CompleteRobbery") then
        local eventKey = active.Id .. ":" .. active.StartedAt
        if self.eventSeen[player] ~= eventKey then
            self.eventSeen[player] = eventKey
            profile.Statistics.EventsParticipated = math.min(1000000000000000, (profile.Statistics.EventsParticipated or 0) + 1)
            self:Progress(player, "ParticipateInEvent", 1, active.Id)
            self:_analytics(player, "EventParticipated", { Event = active.Id })
        end
    end
    for _, period in ipairs({ "Daily", "Weekly" }) do
        for _, id in ipairs(quests[period]) do
            local definition = self.ctx.Config.Quests[id]
            local key = period .. ":" .. id
            local rarity = type(detail) == "table" and detail.Rarity or detail
            if definition and definition.Type == typeName and (not definition.Rarity or definition.Rarity == rarity) then
                quests.Progress[key] = math.min(definition.Target, (quests.Progress[key] or 0) + amount)
            end
        end
    end
    self:_achievements(player, profile)
    self:UpdateTutorial(player, typeName)
end

function QuestService:Claim(player, id)
    if type(id) ~= "string" or #id > 100 then return false, "Invalid quest." end
    local profile = self:_profile(player)
    if not profile then return false, "Your profile is not ready." end
    self:_reset(player, profile)
    local quests = profile.Quests
    if string.sub(id, 1, 12) == "Achievement:" then
        local wanted = string.sub(id, 13)
        self:_achievements(player, profile)
        for _, definition in ipairs(self.ctx.Config.Economy.Achievements or {}) do
            if definition.Id == wanted then
                local state = profile.Achievements[wanted]
                if not state or not state.Unlocked then return false, "Achievement is not complete." end
                if state.Claimed then return false, "You already claimed this achievement." end
                if not self:_reward(player, profile, { Cash = definition.Cash or 0, XP = definition.XP or 0 }, "Achievement") then
                    return false, "Reward cannot be granted right now."
                end
                state.Claimed = true
                self:_achievements(player, profile)
                finish(self, player)
                return true, "Achievement reward claimed!"
            end
        end
        return false, "Unknown achievement."
    end
    for _, period in ipairs({ "Daily", "Weekly" }) do
        for _, assigned in ipairs(quests[period]) do
            if id == assigned then
                local definition = self.ctx.Config.Quests[id]
                local key = period .. ":" .. id
                if quests.Claimed[key] then return false, "You already claimed this quest." end
                if not definition or (quests.Progress[key] or 0) < definition.Target then
                    return false, "Quest is not complete."
                end
                if not self:_reward(player, profile, definition.Reward, period .. "Quest") then
                    return false, "Reward cannot be granted right now."
                end
                quests.Claimed[key] = true
                profile.Statistics.QuestsClaimed = math.min(1000000000000000, (profile.Statistics.QuestsClaimed or 0) + 1)
                self:_analytics(player, "QuestClaimed", { Quest = id, Period = period })
                self:_achievements(player, profile)
                finish(self, player)
                return true, "Quest reward claimed!"
            end
        end
    end
    return false, "That quest is not assigned to you."
end

function QuestService:_daily(profile)
    local state = profile.DailyReward
    local now = self.clock()
    local elapsed = now - (state.LastClaim or 0)
    local interval = self.ctx.Config.Economy.DailyClaimSeconds or 86400
    local rewards = self.ctx.Config.Economy.DailyRewards or {}
    local day = math.clamp(state.CurrentDay or 1, 1, math.max(1, #rewards))
    if state.LastClaim ~= 0 and elapsed >= (self.ctx.Config.Economy.DailyResetSeconds or 172800) then day = 1 end
    return day, state.LastClaim == 0 or elapsed >= interval, math.max(0, interval - elapsed), rewards[day]
end

function QuestService:ClaimDaily(player)
    local profile = self:_profile(player)
    if not profile then return false, "Your profile is not ready." end
    local day, available, _, reward = self:_daily(profile)
    if not available then return false, "Your next daily reward is not ready yet." end
    if not reward then return false, "Daily rewards are unavailable." end
    local cash, xp = reward.Cash or 0, reward.XP or 0
    local maximum = self.ctx.Config.Economy.MaxCash or 1000000000000
    if not positiveInteger(cash) or not positiveInteger(xp) or xp > 10000000 or profile.Cash > maximum - cash then
        return false, "Reward cannot be granted right now."
    end
    -- Item gifts use the same storage checks as ordinary inventory operations.
    if reward.ItemId then
        if not self.ctx.Inventory or not self.ctx.Inventory:CanStore(player, reward.ItemId) then
            return false, "Free storage space before claiming this item reward."
        end
        local entry = self.ctx.Inventory:AddStoredItem(player, reward.ItemId, "DailyReward")
        if not entry then return false, "The daily item cannot be granted right now." end
    end
    if reward.Theme then
        profile.OwnedThemes = profile.OwnedThemes or { Default = true }
        profile.OwnedThemes[reward.Theme] = true
    end
    -- No client timestamp or requested day is used; all grants and the claim marker are synchronous.
    profile.DailyReward.LastClaim = self.clock()
    profile.DailyReward.CurrentDay = day % #self.ctx.Config.Economy.DailyRewards + 1
    profile.Statistics.DailyRewardsClaimed = math.min(1000000000000000, (profile.Statistics.DailyRewardsClaimed or 0) + 1)
    self:_reward(player, profile, reward, "DailyReward")
    self:_achievements(player, profile)
    self:_analytics(player, "DailyRewardClaimed", { Day = day })
    finish(self, player)
    return true, "Day " .. day .. " reward claimed!"
end

function QuestService:Get(player)
    local profile = self.ctx.Data:Get(player)
    if not profile or not profile.Quests then return { Daily = {}, Weekly = {}, Achievements = {} } end
    local output = { Daily = {}, Weekly = {}, Achievements = {} }
    for _, period in ipairs({ "Daily", "Weekly" }) do
        for _, id in ipairs(profile.Quests[period] or {}) do
            local definition = self.ctx.Config.Quests[id]
            if definition then
                local key = period .. ":" .. id
                local progress = profile.Quests.Progress[key] or 0
                table.insert(output[period], {
                    Id = id, Name = definition.Name, Type = definition.Type,
                    Rarity = definition.Rarity, Difficulty = definition.Difficulty,
                    Target = definition.Target, Progress = progress,
                    Complete = progress >= definition.Target, Claimed = profile.Quests.Claimed[key] == true,
                    CanClaim = progress >= definition.Target and profile.Quests.Claimed[key] ~= true,
                    Reward = { Cash = definition.Reward.Cash or 0, XP = definition.Reward.XP or 0 },
                })
            end
        end
    end
    for _, definition in ipairs(self.ctx.Config.Economy.Achievements or {}) do
        local state = profile.Achievements[definition.Id] or {}
        table.insert(output.Achievements, {
            Id = "Achievement:" .. definition.Id, Name = definition.Name,
            Progress = type(state) == "table" and (state.Progress or 0) or 0,
            Target = definition.Target, Complete = type(state) == "table" and state.Unlocked == true,
            Claimed = type(state) == "table" and state.Claimed == true,
            CanClaim = type(state) == "table" and state.Unlocked == true and state.Claimed ~= true,
            Reward = { Cash = definition.Cash or 0, XP = definition.XP or 0 },
        })
    end
    local day, available, remaining, reward = self:_daily(profile)
    output.DailyReward = {
        Day = day, CanClaim = available, SecondsRemaining = remaining,
        Cash = reward and reward.Cash or 0, XP = reward and reward.XP or 0,
        ItemId = reward and reward.ItemId, Theme = reward and reward.Theme,
    }
    local index = profile.TutorialStep or 1
    output.Tutorial = {
        Step = index, Total = #TUTORIAL, Complete = profile.FirstJoin == false or index > #TUTORIAL,
        Text = TUTORIAL[index] and TUTORIAL[index].Text or "Steal. Escape. Build. Protect.",
        Action = TUTORIAL[index] and TUTORIAL[index].Action,
    }
    output.Level = profile.Level
    output.XP = profile.XP
    output.XPRequired = self:XPRequired(profile.Level or 1)
    output.DailyResetAt = (clockDay(self.clock()) + 1) * 86400
    return output
end

function QuestService:Tick(player, dt)
    self.timers[player] = (self.timers[player] or 0) + dt
    if self.timers[player] < 10 then return end
    self.timers[player] = 0
    local profile = self:_profile(player)
    if profile then
        self:_reset(player, profile)
        self:_achievements(player, profile)
    end
end

function QuestService:Remove(player)
    self.timers[player] = nil
    self.eventSeen[player] = nil
end

return QuestService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="50">
        <Properties>
          <string name="Name">RobberyService</string>
          <string name="Source"><![CDATA[local Robbery = {}
Robbery.__index = Robbery
function Robbery.new(ctx) return setmetatable({ Context = ctx, States = {}, Attempts = {} }, Robbery) end
function Robbery:Get(player) return self.States[player] end
function Robbery:Enter(player, id)
    local ctx = self.Context
    local profile = ctx.Data:Get(player)
    local house = typeof(id) == "string" and #id <= 80 and ctx.World:GetNPC(id)
    if not profile or not ctx.Data:IsWritable(player) or not house then return false, "Unknown robbery house." end
    if not ctx.AntiExploit:Near(player, house.EntryPosition, 18) then return false, "Stand at the house entrance." end
    if self.States[player] then return false, "Bring your current bag home first." end
    local area = ctx.Config.Game.Areas[house.Area]
    if profile.Level < area.RequiredLevel then return false, "This district requires level " .. area.RequiredLevel .. "." end
    local requiredTool = math.min(math.max(1, math.floor(house.Area / 2)), #ctx.Config.Tools)
    if profile.Tools.LockpickLevel < requiredTool then return false, "Upgrade your lockpick tool to level " .. requiredTool .. "." end
    self.States[player] = { Active = true, TargetHouse = house.Id, TargetName = area.Name,
        Started = os.clock(), Carry = {}, ItemsStolen = 0, Alarm = false }
    ctx.Quest:Progress(player, "VisitHouses", 1)
    ctx.Publish(player)
    return true, "Robbery started. Steal furniture, then return home to secure it."
end
function Robbery:Steal(player, uid)
    local ctx = self.Context
    local state = self.States[player]
    if typeof(uid) ~= "string" or #uid > 80 or not state or self.Attempts[player] then return false, "Enter a house before stealing." end
    local record = ctx.Items:Get(uid)
    if not record or record.HouseId ~= state.TargetHouse or record.Busy then return false, "This loot is unavailable." end
    if not ctx.Data:IsWritable(player) or not ctx.AntiExploit:CanInteract(player, record, ctx.Config.Game.InteractionDistance) then return false, "Move closer to the loot." end
    local spec = ctx.Config.Items[record.ItemId]
    if not ctx.Inventory:HasCapacity(player, record.ItemId) then return false, "Backpack full! Return home or upgrade it." end
    if ctx.Inventory:Count(player) + state.ItemsStolen >= ctx.Config.Game.MaxStoredItems then return false, "Home storage full. Sell some stored items first." end
    local attempt = { Record = record, State = state, Started = os.clock() }
    self.Attempts[player], record.Busy = attempt, attempt
    ctx.Notify(player, "Stealing " .. spec.Name .. "… stay nearby.", "Info")
    task.spawn(function()
        local function valid()
            return self.States[player] == state and self.Attempts[player] == attempt and ctx.Items:Get(uid) == record
                and ctx.Data:IsWritable(player) and ctx.AntiExploit:CanInteract(player, record, ctx.Config.Game.InteractionDistance)
                and ctx.Inventory:HasCapacity(player, record.ItemId)
                and ctx.Inventory:Count(player) + state.ItemsStolen < ctx.Config.Game.MaxStoredItems
        end
        while valid() and os.clock() - attempt.Started < ctx.Config.Game.StealSeconds do task.wait(0.1) end
        local success = valid() and os.clock() - attempt.Started >= ctx.Config.Game.StealSeconds
        if self.Attempts[player] == attempt then self.Attempts[player] = nil end
        if record.Busy == attempt then record.Busy = nil end
        if not success then ctx.Notify(player, "Theft cancelled.", "Warning"); return end
        -- No yield occurs between the final validation and consuming the unique record.
        if not ctx.Items:Consume(record) then return end
        state.Carry[uid] = { UniqueId = uid, ItemId = record.ItemId, AcquiredAt = os.time() }
        state.ItemsStolen += 1
        local profile = ctx.Data:Get(player)
        profile.Statistics.ItemsStolen += 1
        local rank = ctx.Config.Rarities[spec.Rarity].Rank
        if rank >= 3 then profile.Statistics.RareItemsFound += 1 end
        if rank == 5 then profile.Statistics.LegendaryItemsFound += 1 end
        if rank == 6 then profile.Statistics.MythicItemsFound += 1 end
        if rank == 7 then profile.Statistics.SecretItemsFound += 1 end
        ctx.Heat:Add(player, ctx.Config.Rarities[spec.Rarity].Heat or 15)
        ctx.Quest:Progress(player, "StealItems", 1)
        ctx.Quest:Progress(player, "FindRarity", 1, spec.Rarity)
        ctx.Quest:AwardXP(player, ctx.Config.Economy.XPPerSteal * rank)
        ctx.Quest:UpdateTutorial(player, "Steal")
        if rank >= 3 then ctx.Remotes.UI.RareItemFound:FireClient(player, { ItemId = spec.Id, Name = spec.Name, Rarity = spec.Rarity, Value = spec.Value }) end
        if rank >= 6 then ctx.Remotes.UI.Announcement:FireAllClients(player.DisplayName .. " found a " .. spec.Rarity .. " " .. spec.Name .. "!") end
        ctx.Publish(player)
        ctx.Notify(player, "Loot in backpack. Escape to your home pad to keep it!", "Success")
    end)
    return true
end
function Robbery:Escape(player)
    local ctx = self.Context
    local state = self.States[player]
    local plot = ctx.World:GetPlot(player)
    if not state or not plot or not ctx.Data:IsWritable(player)
        or not ctx.AntiExploit:Near(player, plot.HomePad.Position, ctx.Config.Game.InteractionDistance) then return false, "Reach your own home pad to escape." end
    if self.Attempts[player] then return false, "Finish or cancel your current theft first." end
    local count = 0
    for _ in pairs(state.Carry) do count += 1 end
    if count == 0 then
        self.States[player] = nil
        ctx.Police:Remove(player)
        ctx.Publish(player)
        return true, "Empty robbery ended. Try another house."
    end
    if ctx.Inventory:Count(player) + count > ctx.Config.Game.MaxStoredItems then return false, "Home storage full." end
    local profile = ctx.Data:Get(player)
    for uid in pairs(state.Carry) do
        if profile.Inventory[uid] or profile.House.Furniture[uid] then return false, "Duplicate item detected. Contact the developer." end
    end
    for _, entry in pairs(state.Carry) do
        assert(ctx.Inventory:AddStoredItem(player, entry.ItemId, "RobberyEscape", entry), "Validated escape failed")
    end
    self.States[player] = nil
    ctx.Security:Remove(player)
    ctx.Police:Remove(player)
    ctx.Heat:Add(player, -50)
    profile.Statistics.SuccessfulRobberies += 1
    profile.Statistics.HousesRobbed += 1
    ctx.Quest:Progress(player, "CompleteRobbery", 1)
    ctx.Quest:AwardXP(player, ctx.Config.Economy.XPPerEscape)
    ctx.Quest:UpdateTutorial(player, "ReturnHome")
    ctx.Analytics:Emit(player, "RobberyEscape", { Count = count, Area = state.TargetHouse })
    ctx.Publish(player)
    return true, "ESCAPED! " .. count .. " items secured. Display them or visit the shop to sell."
end
function Robbery:Fail(player, reason)
    local ctx = self.Context
    local state = self.States[player]
    if not state then return end
    local attempt = self.Attempts[player]
    if attempt and attempt.Record.Busy == attempt then attempt.Record.Busy = nil end
    self.Attempts[player] = nil
    local protected = 0
    if ctx.Data:IsWritable(player) then
        for _, entry in pairs(state.Carry) do
            if ctx.Config.Rarities[ctx.Config.Items[entry.ItemId].Rarity].Rank >= 3 then
                if ctx.Inventory:AddStoredItem(player, entry.ItemId, "RareLootProtection", entry) then protected += 1 end
            end
        end
        ctx.Data:Get(player).Statistics.FailedRobberies += 1
    end
    self.States[player] = nil
    ctx.Security:Remove(player)
    ctx.Police:Remove(player)
    ctx.Heat:Add(player, -60)
    ctx.Notify(player, reason .. ". Unsecured common loot lost; " .. protected .. " rare items protected.", "Warning")
    ctx.Publish(player)
end
function Robbery:Tick()
    local ctx = self.Context
    for player, state in pairs(self.States) do
        local root = ctx.AntiExploit:Character(player)
        if not root then self:Fail(player, "Robbery ended after death")
        elseif not ctx.Data:IsWritable(player) then self:Fail(player, "Profile saving is unavailable")
        elseif os.clock() - state.Started > ctx.Config.Game.MaxRobberySeconds then self:Fail(player, "Robbery timed out")
        else
            local house = ctx.World:GetNPC(state.TargetHouse)
            if house and ctx.World:GetNPCAt(root.Position) == house and not state.Alarm
                and os.clock() - state.Started >= ctx.Security:DetectionDelay(player, house)
                and not ctx.Security:IsDisabled(player, house) then
                state.Alarm = true
                local spec = ctx.Config.Security[ctx.Security:Level(house)]
                ctx.Heat:Add(player, spec.HeatBonus or 35)
                ctx.Remotes.UI.AlarmTriggered:FireClient(player, "ALARM! Police have been alerted. RUN!")
                ctx.Notify(player, "ALARM TRIGGERED — RUN HOME!", "Alarm")
                ctx.Publish(player)
            end
        end
    end
end
function Robbery:Remove(player)
    self:Fail(player, "Player left during robbery")
    self.States[player], self.Attempts[player] = nil, nil
end
return Robbery
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="51">
        <Properties>
          <string name="Name">SecurityService</string>
          <string name="Source"><![CDATA[local Security = {}
Security.__index = Security
function Security.new(ctx) return setmetatable({ Context = ctx, Disabled = {} }, Security) end
function Security:Level(house)
    return math.clamp(tonumber(house.Difficulty) or house.Area or 1, 1, 10)
end
function Security:DetectionDelay(player, house)
    local ctx = self.Context
    local spec = ctx.Config.Security[self:Level(house)]
    local profile = ctx.Data:Get(player)
    local tool = profile and ctx.Config.Tools[profile.Tools.LockpickLevel]
    return math.max(1, (spec.DetectionDelay + (tool and tool.DetectionReduction or 0)) / math.max(0.1, ctx.Events:Multiplier("Security")))
end
function Security:IsDisabled(player, house)
    local map = self.Disabled[player]
    return map ~= nil and (map[house.Id] or 0) > os.clock()
end
function Security:Disable(player, id)
    local ctx = self.Context
    local house = typeof(id) == "string" and ctx.World:GetNPC(id)
    local profile = ctx.Data:Get(player)
    local state = ctx.Robbery:Get(player)
    if not house or not profile or not state or state.TargetHouse ~= house.Id then return false, "Enter this NPC house first." end
    if not ctx.AntiExploit:Near(player, house.EntryPosition, 15) then return false, "Stand near the security panel by the entrance." end
    if profile.Tools.LockpickLevel < math.min(self:Level(house), #ctx.Config.Tools) then return false, "Upgrade your counter-security tool first." end
    if self:IsDisabled(player, house) then return false, "Security is already disabled." end
    self.Disabled[player] = self.Disabled[player] or {}
    self.Disabled[player][id] = os.clock() + 25
    ctx.Notify(player, "Security disabled for 25 seconds.", "Success")
    return true, "Security bypassed. Steal quickly."
end
function Security:Remove(player) self.Disabled[player] = nil end
return Security
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="52">
        <Properties>
          <string name="Name">WorldService</string>
          <string name="Source"><![CDATA[-- Procedural, bounded map. No toolbox models, mesh permissions or external assets are needed.
local Lighting = game:GetService("Lighting")
local Factory = require(script.Parent.ModelFactory)

local WorldService = {}
WorldService.__index = WorldService

local COLORS = {
    Asphalt = Color3.fromRGB(42, 48, 59), Pavement = Color3.fromRGB(191, 192, 179),
    Grass = Color3.fromRGB(104, 147, 95), Ink = Color3.fromRGB(32, 39, 54),
    Cream = Color3.fromRGB(239, 224, 194), Teal = Color3.fromRGB(49, 188, 177),
    Gold = Color3.fromRGB(250, 203, 100), Wood = Color3.fromRGB(146, 107, 76),
}
local DISTRICTS = {
    { Side = -1, Z = 0, Color = "#E7BF89", Ground = "#94B687", Landmark = "Water Tower" },
    { Side = 1, Z = 0, Color = "#99BBC4", Ground = "#A3B99B", Landmark = "Town Park" },
    { Side = -1, Z = -230, Color = "#BAB3CE", Ground = "#9FA5B1", Landmark = "Clock Tower" },
    { Side = 1, Z = -230, Color = "#F0DBAC", Ground = "#C7B991", Landmark = "Golden Fountain" },
    { Side = -1, Z = 230, Color = "#ABCAB3", Ground = "#95AA81", Landmark = "Diamond Monument" },
    { Side = 1, Z = 230, Color = "#756787", Ground = "#756980", Landmark = "Alien Beacon" },
}

local function color(hex)
    return Color3.fromHex((string.gsub(hex, "#", "")))
end

local function folder(parent, name)
    local obj = Instance.new("Folder")
    obj.Name, obj.Parent = name, parent
    return obj
end

local function model(parent, name)
    local obj = Instance.new("Model")
    obj.Name, obj.Parent = name, parent
    return obj
end

local function p(parent, name, size, position, tint, material)
    return Factory.Part(parent, name, size, CFrame.new(position), tint, material)
end

local function sign(parent, position, title, subtitle, tint, width)
    local board = p(parent, "Sign", Vector3.new(width or 18, 6, 0.45), position + Vector3.new(0, 7, 0), tint or COLORS.Ink)
    board.CanCollide = false
    local post = p(parent, "SignPost", Vector3.new(0.5, 5, 0.5), position + Vector3.new(0, 2.5, 0), COLORS.Wood, Enum.Material.Wood)
    post.CanCollide = false
    local surface = Instance.new("SurfaceGui")
    surface.Name, surface.Face, surface.CanvasSize = "SignText", Enum.NormalId.Front, Vector2.new(600, 200)
    surface.Parent = board
    local text = Instance.new("TextLabel")
    text.Size, text.BackgroundTransparency = UDim2.fromScale(1, 1), 1
    text.Text = title .. (if subtitle then "\n" .. subtitle else "")
    local boardColor = tint or COLORS.Ink
    text.TextColor3 = if boardColor.R * 0.3 + boardColor.G * 0.59 + boardColor.B * 0.11 > 0.55 then COLORS.Ink else COLORS.Cream
    text.TextScaled = true
    text.Font, text.Parent = Enum.Font.GothamBold, surface
    return board
end

local function tree(parent, position, tint)
    local trunk = p(parent, "TreeTrunk", Vector3.new(1.3, 6, 1.3), position + Vector3.new(0, 3, 0), COLORS.Wood, Enum.Material.Wood)
    local crown = p(parent, "TreeCrown", Vector3.new(9, 9, 9), position + Vector3.new(0, 8.5, 0), tint or Color3.fromRGB(73, 126, 87))
    crown.Shape = Enum.PartType.Ball
    trunk.CanCollide, crown.CanCollide = false, false
end

local function street(parent, x, z, width, depth)
    p(parent, "Street", Vector3.new(width, 0.18, depth), Vector3.new(x, 0.2, z), COLORS.Asphalt, Enum.Material.Asphalt)
    if width > depth then
        p(parent, "Sidewalk", Vector3.new(width, 0.35, 5), Vector3.new(x, 0.3, z - depth / 2 - 2.5), COLORS.Pavement, Enum.Material.Concrete)
        p(parent, "Sidewalk", Vector3.new(width, 0.35, 5), Vector3.new(x, 0.3, z + depth / 2 + 2.5), COLORS.Pavement, Enum.Material.Concrete)
        for offset = -width / 2 + 10, width / 2 - 10, 24 do
            p(parent, "LaneStripe", Vector3.new(10, 0.025, 0.35), Vector3.new(x + offset, 0.305, z), COLORS.Cream)
        end
    else
        p(parent, "Sidewalk", Vector3.new(5, 0.35, depth), Vector3.new(x - width / 2 - 2.5, 0.3, z), COLORS.Pavement, Enum.Material.Concrete)
        p(parent, "Sidewalk", Vector3.new(5, 0.35, depth), Vector3.new(x + width / 2 + 2.5, 0.3, z), COLORS.Pavement, Enum.Material.Concrete)
        for offset = -depth / 2 + 10, depth / 2 - 10, 24 do
            p(parent, "LaneStripe", Vector3.new(0.35, 0.025, 10), Vector3.new(x, 0.305, z + offset), COLORS.Cream)
        end
    end
end

-- A walk-through doorway and open roof keep every room readable from the Roblox camera.
local function shell(parent, origin, width, depth, tint, trim, upgraded)
    local floor = p(parent, "Floor", Vector3.new(width, 1, depth), origin - Vector3.new(0, 0.5, 0), COLORS.Cream, Enum.Material.WoodPlanks)
    local height, doorWidth = 10, 9
    p(parent, "BackWall", Vector3.new(width, height, 0.7), origin + Vector3.new(0, height / 2, depth / 2), tint)
    for _, side in ipairs({ -1, 1 }) do
        p(parent, "SideWall", Vector3.new(0.7, height, depth), origin + Vector3.new(side * width / 2, height / 2, 0), tint)
        p(parent, "FrontWall", Vector3.new((width - doorWidth) / 2, height, 0.7),
            origin + Vector3.new(side * (width + doorWidth) / 4, height / 2, -depth / 2), tint)
        p(parent, "WindowFrame", Vector3.new(5.3, 3.5, 0.3),
            origin + Vector3.new(side * width * 0.31, 5.5, -depth / 2 - 0.4), trim)
        p(parent, "WindowGlass", Vector3.new(4.65, 2.85, 0.15),
            origin + Vector3.new(side * width * 0.31, 5.5, -depth / 2 - 0.62), Color3.fromRGB(119, 186, 200), Enum.Material.Glass)
        p(parent, "WindowCross", Vector3.new(0.15, 2.85, 0.15),
            origin + Vector3.new(side * width * 0.31, 5.5, -depth / 2 - 0.74), trim)
        p(parent, "Column", Vector3.new(1.1, height + 0.5, 1.1),
            origin + Vector3.new(side * width / 2, height / 2, -depth / 2), trim)
    end
    p(parent, "DoorLintel", Vector3.new(doorWidth, 2, 0.75), origin + Vector3.new(0, height - 1, -depth / 2), trim)
    p(parent, "WelcomeMat", Vector3.new(8, 0.12, 3), origin + Vector3.new(0, 0.1, -depth / 2 + 2), trim)
    p(parent, "FrontStep", Vector3.new(10, 0.6, 3), origin + Vector3.new(0, -0.7, -depth / 2 - 1.5), COLORS.Pavement)
    p(parent, "BackCornice", Vector3.new(width + 1.5, 0.7, 1.5), origin + Vector3.new(0, height + 0.4, depth / 2), trim)
    for _, side in ipairs({ -1, 1 }) do
        p(parent, "SideCornice", Vector3.new(1.5, 0.7, depth + 1.5), origin + Vector3.new(side * width / 2, height + 0.4, 0), trim)
    end
    p(parent, "FrontCornice", Vector3.new(width + 1.5, 0.7, 1.5), origin + Vector3.new(0, height + 0.4, -depth / 2), trim)
    if upgraded then
        p(parent, "Rug", Vector3.new(width * 0.45, 0.08, depth * 0.45), origin + Vector3.new(0, 0.055, 1), trim)
    end
    return floor
end

function WorldService.new(ctx)
    return setmetatable({ ctx = ctx, Plots = {}, NPCs = {}, LootModels = {}, PoliceSpawnPositions = {},
        Metrics = { StaticParts = 0, NPCs = 0, SpawnPoints = 0, LootLive = 0, HomeRenders = 0 } }, WorldService)
end

function WorldService:_prompt(part, action, title, callbackAction, arguments, hold)
    local target = part:FindFirstChild("InteractionAttachment") or part
    return Factory.Prompt(target, action, title, function(player)
        self.ctx.Request(player, callbackAction, table.unpack(arguments or {}))
    end, hold or 0, self.ctx.Config.Game.InteractionDistance)
end

function WorldService:_landmark(parent, origin, definition)
    local name, tint = definition.Landmark, color(definition.Color)
    local landmark = model(parent, name)
    p(landmark, "Plaza", Vector3.new(32, 0.6, 28), origin + Vector3.new(0, 0.2, 0), COLORS.Pavement)
    if name == "Town Park" then
        p(landmark, "Lawn", Vector3.new(29, 0.2, 25), origin + Vector3.new(0, 0.6, 0), COLORS.Grass)
        tree(landmark, origin, Color3.fromRGB(70, 141, 105))
        p(landmark, "ParkBench", Vector3.new(8, 1, 3), origin + Vector3.new(0, 2, -9), COLORS.Wood)
        p(landmark, "ParkBenchBack", Vector3.new(8, 3, 0.5), origin + Vector3.new(0, 3, -7.5), COLORS.Wood)
    elseif name == "Golden Fountain" then
        p(landmark, "Basin", Vector3.new(17, 1.5, 17), origin + Vector3.new(0, 1, 0), tint, Enum.Material.Marble)
        p(landmark, "Water", Vector3.new(15, 0.2, 15), origin + Vector3.new(0, 1.85, 0), COLORS.Teal, Enum.Material.Glass)
        p(landmark, "Column", Vector3.new(2, 9, 2), origin + Vector3.new(0, 5.5, 0), COLORS.Gold, Enum.Material.Metal)
        p(landmark, "UpperBasin", Vector3.new(8, 1, 8), origin + Vector3.new(0, 10, 0), COLORS.Gold)
    elseif name == "Water Tower" or name == "Clock Tower" then
        for _, x in ipairs({ -4, 4 }) do
            for _, z in ipairs({ -4, 4 }) do
                p(landmark, "Support", Vector3.new(1, 16, 1), origin + Vector3.new(x, 8, z), COLORS.Ink)
            end
        end
        p(landmark, "Tower", Vector3.new(12, 10, 12), origin + Vector3.new(0, 20, 0), tint)
        p(landmark, "Cap", Vector3.new(14, 1, 14), origin + Vector3.new(0, 25.5, 0), COLORS.Ink)
        if name == "Clock Tower" then
            p(landmark, "ClockFace", Vector3.new(7, 7, 0.3), origin + Vector3.new(0, 20, -6.2), COLORS.Cream)
            p(landmark, "ClockHand", Vector3.new(0.3, 2.8, 0.3), origin + Vector3.new(0, 21.2, -6.4), COLORS.Ink)
            p(landmark, "ClockHand", Vector3.new(2.5, 0.3, 0.3), origin + Vector3.new(1, 20, -6.4), COLORS.Ink)
        end
    else
        p(landmark, "Pedestal", Vector3.new(9, 4, 9), origin + Vector3.new(0, 2.7, 0), COLORS.Ink)
        local jewel = p(landmark, "Beacon", Vector3.new(9, 9, 9), origin + Vector3.new(0, 10, 0),
            if name == "Alien Beacon" then Color3.fromRGB(103, 255, 207) else Color3.fromRGB(139, 217, 251), Enum.Material.Neon)
        jewel.CFrame *= CFrame.Angles(0, math.pi / 4, math.pi / 4)
    end
end

function WorldService:_npc(parent, areaIndex, houseIndex, definition)
    local area = self.ctx.Config.Game.Areas[areaIndex]
    local origin = Vector3.new(definition.Side * (260 + (houseIndex - 1) * 125), 1.2, definition.Z)
    local id = "NPC_" .. areaIndex .. "_" .. houseIndex
    local houseModel = model(parent, id)
    local width, depth = 46 + areaIndex * 2, 36 + areaIndex * 2
    local floor = shell(houseModel, origin, width, depth, color(definition.Color), COLORS.Ink, true)
    houseModel.PrimaryPart = floor
    houseModel:SetAttribute("Area", areaIndex)
    houseModel:SetAttribute("HouseId", id)
    -- Four corners + central display, all far enough apart for the largest 8x8 footprint.
    local slots = {
        { "EntryDisplay", Vector3.new(-8, 0, -depth / 2 + 4), { "Furniture", "Electronics" } },
        { "LivingRoom", Vector3.new(-width * 0.27, 0, -depth * 0.23), { "Furniture", "Electronics" } },
        { "Kitchen", Vector3.new(width * 0.27, 0, -depth * 0.23), { "Appliance" } },
        { "Bedroom", Vector3.new(-width * 0.27, 0, depth * 0.23), { "Furniture" } },
        { "Gallery", Vector3.new(width * 0.27, 0, depth * 0.23), { "Art", "Electronics" } },
        { "Centerpiece", Vector3.new(0, 0, depth * 0.16), { "Furniture", "Art", "Vehicle" } },
    }
    local points, markers = {}, folder(houseModel, "SpawnPoints")
    for _, slot in ipairs(slots) do
        local point = {
            Id = slot[1], Position = origin + slot[2], Categories = slot[3],
            MinRarity = area.MinRarity, MaxRarity = area.MaxRarity, Probability = 1,
        }
        table.insert(points, point)
        local marker = p(markers, point.Id, Vector3.new(1, 0.1, 1), point.Position, COLORS.Teal)
        marker.Transparency, marker.CanCollide = 1, false
    end
    local entry = origin + Vector3.new(0, 0, -depth / 2 - 4)
    local threshold = p(houseModel, "RobberyEntrance", Vector3.new(8, 0.15, 3), entry, COLORS.Gold)
    local display = area.Name .. " • House " .. houseIndex
    Factory.Label(threshold, "ROB " .. display .. "\nLevel " .. area.RequiredLevel .. " • Security " .. area.Difficulty, COLORS.Gold, 6, 95)
    self:_prompt(threshold, "Start robbery", display, "EnterHouse", { id })
    local panelPosition = entry + Vector3.new(6, 2.5, 0)
    local panel = p(houseModel, "SecurityPanel", Vector3.new(1.6, 2, 0.7), panelPosition, COLORS.Ink, Enum.Material.Metal)
    local panelScreen = p(houseModel, "SecurityPanelScreen", Vector3.new(1.1, 1.2, 0.1), panelPosition + Vector3.new(0, 0, -0.45),
        Color3.fromRGB(235, 110, 107), Enum.Material.Neon)
    panelScreen.CanCollide, panelScreen.CanQuery = false, false
    self:_prompt(panel, "Disable security", "Security " .. area.Difficulty, "DisableSecurity", { id }, 0.75)
    local house = {
        Id = id, Origin = origin, Area = areaIndex, Difficulty = area.Difficulty,
        Model = houseModel, EntryPosition = entry, SpawnPoints = points,
        Width = width, Depth = depth,
    }
    self.NPCs[id] = house
    self.Metrics.NPCs += 1
    self.Metrics.SpawnPoints += #points
    table.insert(self.PoliceSpawnPositions, Vector3.new(origin.X + 55, 3.5, definition.Z - 55))
    table.insert(self.PoliceSpawnPositions, Vector3.new(origin.X - 55, 3.5, definition.Z - 55))
end

function WorldService:Init()
    local existing = workspace:FindFirstChild("StealAHouse")
    if existing then existing:Destroy() end
    table.clear(self.Plots)
    table.clear(self.NPCs)
    table.clear(self.LootModels)
    table.clear(self.PoliceSpawnPositions)
    self.Metrics = { StaticParts = 0, NPCs = 0, SpawnPoints = 0, LootLive = 0, HomeRenders = 0 }
    local map = folder(workspace, "StealAHouse")
    self.Map = map
    Lighting.ClockTime, Lighting.Brightness = 14, 2
    Lighting.Ambient, Lighting.OutdoorAmbient = Color3.fromRGB(147, 155, 178), Color3.fromRGB(173, 185, 194)
    Lighting.FogStart, Lighting.FogEnd = 800, 1700
    Lighting.GlobalShadows = true
    p(map, "Ground", Vector3.new(1220, 2, 850), Vector3.new(0, -1, 0), COLORS.Grass, Enum.Material.Grass)
    for _, data in ipairs({
        { Vector3.new(1220, 80, 2), Vector3.new(0, 35, -425) },
        { Vector3.new(1220, 80, 2), Vector3.new(0, 35, 425) },
        { Vector3.new(2, 80, 850), Vector3.new(-610, 35, 0) },
        { Vector3.new(2, 80, 850), Vector3.new(610, 35, 0) },
    }) do
        local boundary = p(map, "MapBoundary", data[1], data[2], COLORS.Grass)
        boundary.Transparency = 1
    end
    local roads = folder(map, "Roads")
    street(roads, 0, 0, 20, 680)
    street(roads, 0, -135, 370, 19)
    street(roads, 0, 125, 370, 19)
    street(roads, -190, -5, 17, 590)
    street(roads, 190, -5, 17, 590)
    local spawn = Instance.new("SpawnLocation")
    spawn.Name, spawn.Size, spawn.CFrame = "TownSpawn", Vector3.new(12, 1, 12), CFrame.new(0, 1, -5)
    spawn.Anchored, spawn.Neutral, spawn.Duration = true, true, 0
    spawn.Color, spawn.Material = COLORS.Teal, Enum.Material.Neon
    spawn.Parent = map
    sign(map, Vector3.new(0, 0, 18), "STEAL A HOUSE", "STEAL • ESCAPE • BUILD • PROTECT", COLORS.Ink, 32)
    sign(map, Vector3.new(-52, 0, -7), "← STARTER STREET", "Start a robbery at a yellow doorstep", COLORS.Teal, 25)
    sign(map, Vector3.new(51, 0, -7), "HOME DISTRICT", "Return to your green pad to secure loot", COLORS.Ink, 25)
    local playerPlots = folder(map, "PlayerPlots")
    for index = 1, self.ctx.Config.Game.MaxPlayers do
        local x = ((index - 1) % 4 - 1.5) * self.ctx.Config.Game.PlotSpacing
        local z = if index <= 4 then -72 else 72
        local origin = Vector3.new(x, 1.2, z)
        local plotModel = model(playerPlots, "Plot" .. index)
        p(plotModel, "PlotBase", Vector3.new(72, 0.7, 72), Vector3.new(x, 0.35, z), COLORS.Pavement, Enum.Material.Concrete)
        for _, side in ipairs({ -1, 1 }) do
            local hedge = p(plotModel, "Hedge", Vector3.new(1.5, 2, 70), origin + Vector3.new(side * 35, 0.2, 0), COLORS.Grass)
            hedge.CanCollide = false
        end
        local homepad = p(plotModel, "HomePad", Vector3.new(9, 0.2, 6), origin + Vector3.new(0, 0.05, -32), COLORS.Teal, Enum.Material.Neon)
        local title = Factory.Label(homepad, "Available plot", COLORS.Cream, 4, 85)
        self:_prompt(homepad, "Secure loot / open home", "Your home", "Escape", {})
        self.Plots[index] = { Id = index, Origin = origin, Model = plotModel, HomePad = homepad, Title = title, Owner = nil }
    end
    local districts = folder(map, "Districts")
    for areaIndex, definition in ipairs(DISTRICTS) do
        local area = self.ctx.Config.Game.Areas[areaIndex]
        local areaFolder = folder(districts, area.Name)
        p(areaFolder, "DistrictGround", Vector3.new(405, 0.15, 170),
            Vector3.new(definition.Side * 395, 0.1, definition.Z + 20), color(definition.Ground))
        street(roads, definition.Side * 390, definition.Z - 55, 420, 18)
        sign(areaFolder, Vector3.new(definition.Side * 218, 0, definition.Z - 40),
            string.upper(area.Name), "LEVEL " .. area.RequiredLevel .. " • SECURITY " .. area.Difficulty, color(definition.Color), 23)
        for houseIndex = 1, 3 do self:_npc(areaFolder, areaIndex, houseIndex, definition) end
        self:_landmark(areaFolder, Vector3.new(definition.Side * 390, 0, definition.Z + 66), definition)
        for treeIndex = 1, 4 do
            tree(areaFolder, Vector3.new(definition.Side * (235 + treeIndex * 80), 0, definition.Z + 98))
        end
    end
    local shop = model(map, "LootExchange")
    local shopOrigin = Vector3.new(0, 1.2, 166)
    shell(shop, shopOrigin, 58, 26, Color3.fromRGB(208, 227, 215), COLORS.Teal, false)
    local desk = p(shop, "ExchangeCounter", Vector3.new(18, 3, 3), shopOrigin + Vector3.new(0, 1.5, 4), COLORS.Teal)
    self.ShopPosition = Vector3.new(0, 1.2, 146)
    local shopPad = p(shop, "ShopEntrance", Vector3.new(8, 0.15, 5), self.ShopPosition, COLORS.Gold)
    self:_prompt(shopPad, "Sell / upgrade / shop", "Loot Exchange", "OpenShop", {})
    self:_prompt(desk, "Sell / upgrade / shop", "Loot Exchange", "OpenShop", {})
    sign(shop, Vector3.new(0, 0, 150), "LOOT EXCHANGE", "Sell loot • Buy upgrades • Get rich", COLORS.Teal, 31)
    Factory.Label(spawn, "Welcome! Find a yellow doorstep.\nYour home is a green safe zone.", COLORS.Cream, 3, 65)
    for _, object in ipairs(map:GetDescendants()) do
        if object:IsA("BasePart") then self.Metrics.StaticParts += 1 end
    end
end

function WorldService:Assign(player)
    local assigned = self:GetPlot(player)
    if assigned then return assigned end
    for _, plot in ipairs(self.Plots) do
        if not plot.Owner then
            plot.Owner = player
            plot.Model:SetAttribute("OwnerId", player.UserId)
            plot.Title.Text = player.DisplayName .. "'s home\nReturn here to secure loot"
            return plot
        end
    end
    return nil
end

function WorldService:GetPlot(player)
    for _, plot in ipairs(self.Plots) do
        if plot.Owner == player then return plot end
    end
    return nil
end

function WorldService:Release(playerOrPlot)
    local plot = if type(playerOrPlot) == "table" and playerOrPlot.Model then playerOrPlot else self:GetPlot(playerOrPlot)
    if not plot then return end
    local home = plot.Model:FindFirstChild("Home")
    if home then home:Destroy() end
    plot.Owner, plot.Width, plot.Depth = nil, nil, nil
    plot.Model:SetAttribute("OwnerId", nil)
    plot.Title.Text = "Available plot"
end

function WorldService:RenderHome(player, profile)
    local plot = self:GetPlot(player)
    if not plot then return end
    self.Metrics.HomeRenders += 1
    local previous = plot.Model:FindFirstChild("Home")
    if previous then previous:Destroy() end
    local house = profile.House
    local tier = self.ctx.Config.Houses[house.Tier] or self.ctx.Config.Houses[1]
    local theme = self.ctx.Config.Game.Themes[house.Theme] or self.ctx.Config.Game.Themes.Default
    local home = model(plot.Model, "Home")
    plot.Width, plot.Depth = tier.Width, tier.Depth
    local floor = shell(home, plot.Origin, tier.Width, tier.Depth, color(theme.Color), COLORS.Ink, house.Tier >= 2)
    home.PrimaryPart = floor
    home:SetAttribute("OwnerId", player.UserId)
    home:SetAttribute("HouseTier", house.Tier)
    local displayed = folder(home, "Furniture")
    for uniqueId, placement in pairs(house.Furniture) do
        local item = self.ctx.Config.Items[placement.ItemId]
        if item then
            local cf = CFrame.new(plot.Origin + Vector3.new(placement.X, 0, placement.Z)) * CFrame.Angles(0, math.rad(placement.Rotation), 0)
            local furniture = Factory.Furniture(item, self.ctx.Config.Rarities[item.Rarity], displayed, cf)
            furniture.Name = uniqueId
            furniture:SetAttribute("UniqueId", uniqueId)
            furniture:SetAttribute("OwnerId", player.UserId)
            self:_prompt(furniture.PrimaryPart, "Pick up / inspect", item.Name, "Pickup", { uniqueId, player.UserId })
        end
    end
    local securityLevel = house.SecurityLevel or 1
    local security = self.ctx.Config.Security[securityLevel]
    local devicePosition = plot.Origin + Vector3.new(tier.Width / 2 - 3, 3.5, -tier.Depth / 2 - 0.7)
    local device = p(home, "SecurityDevice", Vector3.new(2, 1.5, 1.2), devicePosition, COLORS.Ink, Enum.Material.Metal)
    local lens = p(home, "SecurityLens", Vector3.new(0.7, 0.7, 0.2), devicePosition + Vector3.new(0, 0, -0.75), COLORS.Teal, Enum.Material.Neon)
    lens.CanCollide, lens.CanQuery = false, false
    device:SetAttribute("OwnerId", player.UserId)
    self:_prompt(device, "View / upgrade security", security.Name, "InspectSecurity", { player.UserId })
    if securityLevel >= 6 then
        for _, x in ipairs({ -3.5, 3.5 }) do
            local beam = p(home, "SecurityLaser", Vector3.new(0.08, 5, 0.08),
                plot.Origin + Vector3.new(x, 2.6, -tier.Depth / 2 + 0.3), Color3.fromRGB(255, 86, 119), Enum.Material.Neon)
            beam.CanCollide = false
        end
    end
    if securityLevel >= 7 then
        p(home, "SecurityDrone", Vector3.new(3, 0.65, 3),
            plot.Origin + Vector3.new(tier.Width / 2 - 5, 8, -tier.Depth / 2 + 4), COLORS.Ink, Enum.Material.Metal)
    end
    plot.Title.Text = player.DisplayName .. "'s " .. tier.Name .. "\nSafe zone • Security " .. securityLevel
end

function WorldService:IsInHome(player, position)
    local plot = self:GetPlot(player)
    if not plot then return false end
    local delta = position - plot.Origin
    local inside = math.abs(delta.X) <= (plot.Width or 30) / 2 + 3
        and delta.Z >= -(plot.Depth or 24) / 2 - 4 and delta.Z <= (plot.Depth or 24) / 2 + 3
        and delta.Y >= -3 and delta.Y <= 20
    local padDelta = position - plot.HomePad.Position
    local atPad = math.abs(padDelta.X) <= 8 and math.abs(padDelta.Z) <= 8 and padDelta.Y >= -3 and padDelta.Y <= 12
    return inside or atPad
end

function WorldService:GetNPC(id)
    return self.NPCs[id]
end

function WorldService:GetNPCAt(position)
    for _, house in pairs(self.NPCs) do
        local delta = position - house.Origin
        if math.abs(delta.X) <= house.Width / 2 and math.abs(delta.Z) <= house.Depth / 2
            and delta.Y >= -2 and delta.Y <= 16 then return house end
    end
    return nil
end

function WorldService:RenderLoot(record)
    self:RemoveLoot(record)
    local house = self:GetNPC(record.HouseId)
    local item = self.ctx.Config.Items[record.ItemId]
    if not house or not item then return nil end
    local lootFolder = house.Model:FindFirstChild("Loot") or folder(house.Model, "Loot")
    local loot = Factory.Furniture(item, self.ctx.Config.Rarities[item.Rarity], lootFolder, CFrame.new(record.Position))
    loot.Name = record.UniqueId
    loot:SetAttribute("UniqueId", record.UniqueId)
    loot:SetAttribute("HouseId", record.HouseId)
    Factory.Label(loot.PrimaryPart, item.Name .. "\n" .. item.Rarity .. " • $" .. tostring(item.Value),
        color(self.ctx.Config.Rarities[item.Rarity].Color), 4, 36)
    self:_prompt(loot.PrimaryPart, "Steal", item.Name .. " • " .. item.Rarity, "Steal", { record.UniqueId }, 0.2)
    self.LootModels[record.UniqueId] = loot
    self.Metrics.LootLive += 1
    return loot
end

function WorldService:RemoveLoot(record)
    local uniqueId = if type(record) == "table" then record.UniqueId else record
    local existing = self.LootModels[uniqueId]
    if existing then existing:Destroy(); self.Metrics.LootLive -= 1 end
    self.LootModels[uniqueId] = nil
end

function WorldService:Shutdown()
    if self.Map then self.Map:Destroy() end
    table.clear(self.Plots)
    table.clear(self.NPCs)
    table.clear(self.LootModels)
    table.clear(self.PoliceSpawnPositions)
    self.Metrics.LootLive = 0
end

return WorldService
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="53">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="54">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="55">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Explicit client boot order. Clients display snapshots and request actions only.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local Context = { Config = Config, Remotes = remotes, State = nil }

function Context:Request(group, name, ...)
    local folder = self.Remotes:FindFirstChild(group)
    local remote = folder and folder:FindFirstChild(name)
    if remote and remote:IsA("RemoteEvent") then remote:FireServer(...)
    else
        warn("Missing game remote: " .. group .. "." .. name)
        if self.Notifications then self.Notifications:Push("This action is unavailable. Please rejoin if it continues.", "Error") end
    end
end

Context.UI = require(script.UIController).new(Context)
Context.Camera = require(script.CameraController).new(Context)
Context.Audio = require(script.AudioController).new(Context)
Context.Notifications = require(script.NotificationController).new(Context)
Context.Inventory = require(script.InventoryController).new(Context)
Context.House = require(script.HouseController).new(Context)
Context.Progression = require(script.ProgressionController).new(Context)
Context.Interaction = require(script.InteractionController).new(Context)
Context.Robbery = require(script.RobberyController).new(Context)
Context.Input = require(script.InputController).new(Context)

local uiRemotes = remotes:WaitForChild("UI")
uiRemotes:WaitForChild("Snapshot").OnClientEvent:Connect(function(snapshot)
    if type(snapshot) ~= "table" or type(snapshot.Profile) ~= "table" or type(snapshot.Runtime) ~= "table" then return end
    Context.State = snapshot
    Context.UI:OnSnapshot(snapshot)
    Context.House:OnSnapshot(snapshot)
    Context.Audio:OnSnapshot(snapshot)
end)
uiRemotes:WaitForChild("Notification").OnClientEvent:Connect(function(text, kind)
    Context.Notifications:Push(text, kind)
    if (kind == "Shop" or kind == "House") and Context.UI.ActiveMenu ~= kind then Context.UI:ToggleMenu(kind) end
    if kind == "Success" then Context.Audio:Play("Success") end
end)
uiRemotes:WaitForChild("RareItemFound").OnClientEvent:Connect(function(data) Context.Notifications:Rare(data) end)
uiRemotes:WaitForChild("AlarmTriggered").OnClientEvent:Connect(function(text) Context.Robbery:Alarm(text) end)
uiRemotes:WaitForChild("HeatChanged").OnClientEvent:Connect(function(heat) Context.Robbery:Heat(heat) end)
uiRemotes:WaitForChild("Announcement").OnClientEvent:Connect(function(text) Context.Notifications:Push(text, "Announcement", true) end)
-- Join snapshots can precede client readiness. A bounded retry handles that race.
Context:Request("UI", "RequestSync")
task.spawn(function()
    for _ = 1, 5 do
        task.wait(3)
        if Context.State then return end
        Context:Request("UI", "RequestSync")
    end
end)
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">AudioController</string>
            <string name="Source"><![CDATA[--!nonstrict
local SoundService = game:GetService("SoundService")
local Audio = {}
Audio.__index = Audio

function Audio.new(ctx)
    local self = setmetatable({ Context = ctx, Sounds = {} }, Audio)
    -- Zero/unset assets remain silent. Only developer-provided, licensed assets play.
    for name, id in pairs(ctx.Config.Game.Audio or {}) do
        if type(id) == "number" and id > 0 then
            local sound = Instance.new("Sound")
            sound.Name, sound.SoundId = "StealAHouse_" .. name, "rbxassetid://" .. tostring(id)
            sound.Volume, sound.Looped = if name == "Music" then 0.25 else 0.45, name == "Music"
            sound.Parent = SoundService
            self.Sounds[name] = sound
        end
    end
    return self
end

function Audio:Play(name)
    local settings = self.Context.State and self.Context.State.Profile.Settings or {}
    if name == "Music" and settings.Music == false or name ~= "Music" and settings.SFX == false then return end
    local sound = self.Sounds[name]
    if sound then sound:Play() end
end

function Audio:OnSnapshot(state)
    local settings = state.Profile.Settings
    for name, sound in pairs(self.Sounds) do
        local enabled = if name == "Music" then settings.Music else settings.SFX
        if not enabled then sound:Stop()
        elseif name == "Music" and not sound.IsPlaying then sound:Play() end
    end
end

return Audio
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">CameraController</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Placement uses a local overhead camera. All world movement stays server-controlled.
local Camera = {}
Camera.__index = Camera
function Camera.new(ctx)
    local self = setmetatable({ Context = ctx }, Camera)
    game:GetService("RunService"):BindToRenderStep("HeistCameraEffects", Enum.RenderPriority.Camera.Value + 1, function()
        if not self.ShakeUntil or os.clock() > self.ShakeUntil then return end
        local camera = workspace.CurrentCamera
        local profile = self.Context.State and self.Context.State.Profile
        if not camera or camera.CameraType ~= Enum.CameraType.Custom or profile and (profile.Settings.CameraShake == false or profile.Settings.ReducedEffects) then return end
        local amplitude = math.max(0, self.ShakeUntil - os.clock()) * 0.08
        camera.CFrame *= CFrame.new(math.sin(os.clock() * 65) * amplitude, math.cos(os.clock() * 47) * amplitude, 0)
    end)
    return self
end
function Camera:Shake(duration) self.ShakeUntil = os.clock() + duration end
function Camera:Placement(origin)
    self:Restore()
    local camera = workspace.CurrentCamera
    if not camera then return end
    self.Previous = { Camera = camera, Type = camera.CameraType, Subject = camera.CameraSubject, CFrame = camera.CFrame }
    camera.CameraType = Enum.CameraType.Scriptable
    camera.CFrame = CFrame.lookAt(origin + Vector3.new(0, 58, 34), origin, Vector3.yAxis)
end
function Camera:Restore()
    local old = self.Previous
    if not old then return end
    self.Previous = nil
    if old.Camera and old.Camera.Parent then
        old.Camera.CameraType = old.Type
        old.Camera.CameraSubject = old.Subject
        old.Camera.CFrame = old.CFrame
    end
end
return Camera
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">HouseController</string>
            <string name="Source"><![CDATA[--!nonstrict
local ContextActionService = game:GetService("ContextActionService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local W = require(script.Parent.Widgets)
local House = {}
House.__index = House
local ACTIONS = { "HouseRotate", "HouseConfirm", "HouseCancel", "HouseLeft", "HouseRight", "HouseUp", "HouseDown", "HouseAxis" }

function House.new(ctx)
    local self = setmetatable({ Context = ctx, Active = false }, House)
    ctx.UI:Register("House", function(parent, state) self:RenderMenu(parent, state) end)
    UserInputService.InputChanged:Connect(function(input)
        if self.Active and input.UserInputType == Enum.UserInputType.MouseMovement then self:Pointer(input.Position.X, input.Position.Y) end
    end)
    UserInputService.TouchTapInWorld:Connect(function(position, processed)
        if self.Active and not processed then self:Pointer(position.X, position.Y) end
    end)
    Players.LocalPlayer.CharacterRemoving:Connect(function() self:Cancel() end)
    RunService.RenderStepped:Connect(function(dt)
        if not self.Active then return end
        self.AxisTimer = (self.AxisTimer or 0) + dt
        if self.Axis and self.Axis.Magnitude > 0.3 and self.AxisTimer > 0.16 then
            self.AxisTimer = 0
            if math.abs(self.Axis.X) > math.abs(self.Axis.Y) then self:Nudge(if self.Axis.X > 0 then 1 else -1, 0)
            else self:Nudge(0, if self.Axis.Y > 0 then -1 else 1) end
        end
    end)
    return self
end

function House:RenderMenu(parent, state)
    if not state or not state.Profile then return end
    local p = state.Profile
    local tier = self.Context.Config.Houses[p.House.Tier]
    W.Text(parent, tier.Name .. " • TIER " .. p.House.Tier, 32, W.Colors.Teal, 21)
    W.Text(parent, "Home value $" .. W.Number(p.House.HouseValue) .. "  •  Security " .. p.House.SecurityLevel
        .. "\nDisplaying loot raises your home value. Your secured items stay safe at home.", 65, W.Colors.Muted, 14)
    local upgrade = self.Context.Config.Houses[p.House.Tier + 1]
    if upgrade then
        W.Button(parent, "Upgrade to " .. upgrade.Name .. " • $" .. W.Number(upgrade.Cost) .. " • Level " .. upgrade.RequiredLevel,
            function() self.Context:Request("House", "RequestHouseUpgrade") end)
    end
    local security = self.Context.Config.Security[p.House.SecurityLevel + 1]
    if security then W.Button(parent, "Security style: " .. security.Name .. " • $" .. W.Number(security.Cost) .. " • Level " .. security.RequiredLevel,
        function() self.Context:Request("House", "RequestSecurityUpgrade") end) end
    W.Text(parent, "HOUSE STYLE", 32, W.Colors.Orange, 18)
    local themes = {}
    for id in pairs(self.Context.Config.Game.Themes) do table.insert(themes, id) end
    table.sort(themes)
    for _, id in ipairs(themes) do
        local theme = self.Context.Config.Game.Themes[id]
        local owned = (p.OwnedThemes or {})[id]
        local selected = p.House.Theme == id
        W.Button(parent, theme.Name .. (if selected then " • Active" elseif owned then " • Apply" else " • $" .. W.Number(theme.Cost)),
            function() self.Context:Request("House", "RequestHouseCustomization", id) end, W.Color(theme.Color):Lerp(W.Colors.Panel, 0.72))
    end
    W.Text(parent, "DISPLAYED FURNITURE", 32, W.Colors.Teal, 18)
    local items = self.Context.Inventory:SortedItems(p.House.Furniture)
    if #items == 0 then W.Text(parent, "Select a secured item in Inventory, then choose Place at home.", 50, W.Colors.Muted) end
    for _, item in ipairs(items) do
        local spec = self.Context.Config.Items[item.Entry.ItemId]
        if spec then
            local card = W.Card(parent, 115)
            W.Text(card, spec.Name, 24, W.Color(self.Context.Config.Rarities[spec.Rarity].Color), 18)
            W.Text(card, "$" .. W.Number(spec.Value) .. "  •  Grid " .. item.Entry.X .. ", " .. item.Entry.Z, 24, W.Colors.Muted, 13)
            W.Button(card, "Pick up into storage (at home)", function() self.Context:Request("Gameplay", "RequestPickupItem", item.Uid) end)
        end
    end
end

function House:Begin(uid)
    self:Cancel()
    local state = self.Context.State
    if not state or not state.Runtime.Plot then return end
    local entry = state.Profile.Inventory[uid]
    local spec = entry and self.Context.Config.Items[entry.ItemId]
    if not spec then return end
    local plot = state.Runtime.Plot
    local o = plot.Origin
    self.Origin = Vector3.new(o.X, o.Y, o.Z)
    local character = Players.LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root or (root.Position - self.Origin).Magnitude > self.Context.Config.Game.HomeRadius + 3 then
        self.Context.Notifications:Push("Return to your HOME beacon to place furniture.", "Warning")
        return
    end
    local world = workspace:FindFirstChild("StealAHouse")
    local plots = world and world:FindFirstChild("PlayerPlots")
    self.Plot = plots and plots:FindFirstChild("Plot" .. tostring(plot.Id))
    self.Floors = {}
    if self.Plot then
        for _, part in ipairs(self.Plot:GetDescendants()) do
            if part:IsA("BasePart") and part.Name == "Floor" then table.insert(self.Floors, part) end
        end
    end
    if #self.Floors == 0 then self.Context.Notifications:Push("Your house floor is still loading. Try again shortly.", "Warning"); return end
    self.Uid, self.Spec, self.Active, self.X, self.Z, self.Rotation = uid, spec, true, 0, 0, 0
    self.Ghost = W.Make("Part", { Name = "PlacementPreview", Anchored = true, CanCollide = false, CanTouch = false,
        CanQuery = false, Transparency = 0.5, Material = Enum.Material.Neon, CastShadow = false }, workspace)
    self.Context.UI:CloseMenu()
    self.Context.UI.Objective.Visible = false
    self.Context.Camera:Placement(self.Origin)
    self:BuildControls()
    self:BindActions()
    self:UpdateGhost()
end

function House:BuildControls()
    local controls = W.Make("Frame", { BackgroundColor3 = W.Colors.Panel, BorderSizePixel = 0,
        AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -73), Size = UDim2.new(1, -24, 0, 172) }, self.Context.UI.Gui)
    W.Round(controls, 12)
    W.Make("UISizeConstraint", { MaxSize = Vector2.new(600, 172) }, controls)
    self.Controls = controls
    self.Caption = W.Text(controls, self.Spec.Name .. " • Tap the floor or use arrows to move", 25, W.Colors.Teal, 14)
    self.Caption.Position, self.Caption.Size = UDim2.fromOffset(10, 7), UDim2.new(1, -20, 0, 25)
    local function button(text, x, y, callback)
        local item = W.Button(controls, text, callback)
        item.Size, item.Position = UDim2.fromOffset(42, 36), UDim2.fromOffset(x, y)
    end
    button("↑", 55, 38, function() self:Nudge(0, -1) end)
    button("←", 10, 77, function() self:Nudge(-1, 0) end)
    button("↓", 55, 77, function() self:Nudge(0, 1) end)
    button("→", 100, 77, function() self:Nudge(1, 0) end)
    local rotate = W.Button(controls, "Rotate (R / RB)", function() self:Rotate() end)
    rotate.Position, rotate.Size = UDim2.fromOffset(155, 40), UDim2.new(1, -165, 0, 36)
    self.PlaceButton = W.Button(controls, "Place (Enter / A)", function() self:Confirm() end, W.Colors.Teal:Lerp(W.Colors.Panel, 0.6))
    self.PlaceButton.Position, self.PlaceButton.Size = UDim2.fromOffset(155, 80), UDim2.new(1, -165, 0, 36)
    local cancel = W.Button(controls, "Cancel (Esc / B)", function() self:Cancel() end)
    cancel.Position, cancel.Size = UDim2.fromOffset(10, 126), UDim2.new(1, -20, 0, 36)
end

function House:BindActions()
    local function bind(name, callback, ...)
        ContextActionService:BindActionAtPriority(name, function(_, state, input)
            if state == Enum.UserInputState.Begin then callback(input) end
            return Enum.ContextActionResult.Sink
        end, false, 3100, ...)
    end
    bind("HouseRotate", function() self:Rotate() end, Enum.KeyCode.R, Enum.KeyCode.ButtonR1)
    bind("HouseConfirm", function() self:Confirm() end, Enum.KeyCode.Return, Enum.KeyCode.ButtonA)
    bind("HouseCancel", function() self:Cancel() end, Enum.KeyCode.Escape, Enum.KeyCode.ButtonB)
    bind("HouseLeft", function() self:Nudge(-1, 0) end, Enum.KeyCode.Left, Enum.KeyCode.A, Enum.KeyCode.DPadLeft)
    bind("HouseRight", function() self:Nudge(1, 0) end, Enum.KeyCode.Right, Enum.KeyCode.D, Enum.KeyCode.DPadRight)
    bind("HouseUp", function() self:Nudge(0, -1) end, Enum.KeyCode.Up, Enum.KeyCode.W, Enum.KeyCode.DPadUp)
    bind("HouseDown", function() self:Nudge(0, 1) end, Enum.KeyCode.Down, Enum.KeyCode.S, Enum.KeyCode.DPadDown)
    ContextActionService:BindActionAtPriority("HouseAxis", function(_, state, input)
        self.Axis = if state == Enum.UserInputState.End then Vector2.zero else Vector2.new(input.Position.X, input.Position.Y)
        return Enum.ContextActionResult.Sink
    end, false, 3100, Enum.KeyCode.Thumbstick1)
end

function House:Pointer(x, y)
    local camera = workspace.CurrentCamera
    if not camera then return end
    local ray = camera:ScreenPointToRay(x, y)
    local params = RaycastParams.new()
    params.FilterType, params.FilterDescendantsInstances = Enum.RaycastFilterType.Include, self.Floors
    local hit = workspace:Raycast(ray.Origin, ray.Direction * 600, params)
    if hit then
        local grid = self.Context.Config.Game.GridSize
        self.X = math.round((hit.Position.X - self.Origin.X) / grid) * grid
        self.Z = math.round((hit.Position.Z - self.Origin.Z) / grid) * grid
        self:UpdateGhost()
    end
end

function House:Nudge(x, z)
    if not self.Active then return end
    local grid = self.Context.Config.Game.GridSize
    local tier = self.Context.Config.Houses[self.Context.State.Profile.House.Tier]
    self.X, self.Z = math.clamp(self.X + x * grid, -tier.Width / 2, tier.Width / 2), math.clamp(self.Z + z * grid, -tier.Depth / 2, tier.Depth / 2)
    self.X, self.Z = math.round(self.X / grid) * grid, math.round(self.Z / grid) * grid
    self:UpdateGhost()
end

function House:Rotate()
    if not self.Active then return end
    self.Rotation = (self.Rotation + 90) % 360
    self:UpdateGhost()
end

function House:UpdateGhost()
    if not self.Active then return end
    local sx, sz = self.Spec.Size.X, self.Spec.Size.Z
    if self.Rotation % 180 ~= 0 then sx, sz = sz, sx end
    local tier = self.Context.Config.Houses[self.Context.State.Profile.House.Tier]
    local valid = math.abs(self.X) + sx / 2 <= tier.Width / 2 - 2 and math.abs(self.Z) + sz / 2 <= tier.Depth / 2 - 2
    if math.abs(self.X) < 4 + sx / 2 and self.Z < -tier.Depth / 2 + 9 + sz / 2 then valid = false end
    local count = 0
    for _, item in pairs(self.Context.State.Profile.House.Furniture) do
        count += 1
        local spec = self.Context.Config.Items[item.ItemId]
        if spec then
            local ix, iz = spec.Size.X, spec.Size.Z
            if item.Rotation % 180 ~= 0 then ix, iz = iz, ix end
            if math.abs(item.X - self.X) < (ix + sx) / 2 + 0.2 and math.abs(item.Z - self.Z) < (iz + sz) / 2 + 0.2 then valid = false end
        end
    end
    if count >= tier.MaxFurniture then valid = false end
    self.Valid = valid
    self.Ghost.Size = Vector3.new(self.Spec.Size.X, 2, self.Spec.Size.Z)
    local floor = self.Floors[1]
    if not floor or not floor.Parent then
        self.Floors = {}
        if self.Plot and self.Plot.Parent then
            for _, part in ipairs(self.Plot:GetDescendants()) do
                if part:IsA("BasePart") and part.Name == "Floor" then table.insert(self.Floors, part) end
            end
        end
        floor = self.Floors[1]
        if not floor then self:Cancel(); return end
    end
    local y = floor.Position.Y + floor.Size.Y / 2 + 1
    self.Ghost.CFrame = CFrame.new(self.Origin.X + self.X, y, self.Origin.Z + self.Z) * CFrame.Angles(0, math.rad(self.Rotation), 0)
    self.Ghost.Color = if valid then W.Colors.Teal else W.Colors.Danger
    self.PlaceButton.Text = if valid then "PLACE • " .. self.Rotation .. "° (Enter / A)" else "BLOCKED • move to a free spot"
end

function House:Confirm()
    if not self.Active then return end
    if not self.Valid then self.Context.Notifications:Push("Choose a free spot inside your house.", "Warning"); return end
    self.Context:Request("Gameplay", "RequestPlaceItem", self.Uid, self.X, self.Z, self.Rotation)
    self:Cancel()
end

function House:Cancel()
    self.Active, self.Axis = false, Vector2.zero
    for _, action in ipairs(ACTIONS) do ContextActionService:UnbindAction(action) end
    if self.Ghost then self.Ghost:Destroy(); self.Ghost = nil end
    if self.Controls then self.Controls:Destroy(); self.Controls = nil end
    self.Context.Camera:Restore()
    if not self.Context.UI.ActiveMenu then self.Context.UI.Objective.Visible = true end
end

function House:OnSnapshot(state)
    if not self.Active then return end
    if not state.Profile.Inventory[self.Uid] then self:Cancel(); return end
    self:UpdateGhost()
end

return House
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">InputController</string>
            <string name="Source"><![CDATA[--!nonstrict
local ContextActionService = game:GetService("ContextActionService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local Input = {}
Input.__index = Input

function Input.new(ctx)
    local self = setmetatable({ Context = ctx, Sprinting = false }, Input)
    ContextActionService:BindAction("HeistSprint", function(_, state)
        if state == Enum.UserInputState.Begin then
            self.Sprinting = true
            ctx:Request("Gameplay", "RequestSprint", true)
        elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
            self.Sprinting = false
            ctx:Request("Gameplay", "RequestSprint", false)
        end
        return Enum.ContextActionResult.Sink
    end, true, Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonL3)
    ContextActionService:SetTitle("HeistSprint", "SPRINT")
    ContextActionService:SetPosition("HeistSprint", UDim2.new(1, -92, 1, -145))
    ContextActionService:BindActionAtPriority("HeistInventory", function(_, state)
        if state == Enum.UserInputState.Begin then ctx.UI:ToggleMenu("Inventory") end
        return Enum.ContextActionResult.Sink
    end, false, 2100, Enum.KeyCode.Tab, Enum.KeyCode.ButtonStart)
    ContextActionService:BindAction("HeistClose", function(_, state)
        if state == Enum.UserInputState.Begin and ctx.UI.ActiveMenu then ctx.UI:CloseMenu(); return Enum.ContextActionResult.Sink end
        return Enum.ContextActionResult.Pass
    end, false, Enum.KeyCode.ButtonB)
    UserInputService.WindowFocusReleased:Connect(function()
        if self.Sprinting then self.Sprinting = false; ctx:Request("Gameplay", "RequestSprint", false) end
    end)
    Players.LocalPlayer.CharacterRemoving:Connect(function() self.Sprinting = false end)
    return self
end

return Input
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">InteractionController</string>
            <string name="Source"><![CDATA[--!nonstrict
local ProximityPromptService = game:GetService("ProximityPromptService")
local W = require(script.Parent.Widgets)
local Interaction = {}
Interaction.__index = Interaction

function Interaction.new(ctx)
    local self = setmetatable({ Context = ctx, Highlights = {} }, Interaction)
    -- Native prompts support keyboard, touch and console. Their Triggered callbacks
    -- remain on the server; this controller adds only a local focus outline.
    ProximityPromptService.PromptShown:Connect(function(prompt)
        local state = ctx.State
        if state and state.Profile.Settings.ReducedEffects then return end
        local parent = prompt.Parent
        if not parent then return end
        local target = parent:FindFirstAncestorWhichIsA("Model") or parent
        if not target:IsA("Model") and not target:IsA("BasePart") then return end
        local highlight = Instance.new("Highlight")
        highlight.Name, highlight.Adornee = "LocalInteractionFocus", target
        highlight.FillColor, highlight.OutlineColor = W.Colors.Teal, W.Colors.Orange
        highlight.FillTransparency, highlight.OutlineTransparency = 0.92, 0.2
        highlight.DepthMode = Enum.HighlightDepthMode.Occluded
        highlight.Parent = target
        self.Highlights[prompt] = highlight
    end)
    ProximityPromptService.PromptHidden:Connect(function(prompt)
        local highlight = self.Highlights[prompt]
        if highlight then highlight:Destroy(); self.Highlights[prompt] = nil end
    end)
    return self
end

return Interaction
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="61">
          <Properties>
            <string name="Name">InventoryController</string>
            <string name="Source"><![CDATA[--!nonstrict
local W = require(script.Parent.Widgets)
local Inventory = {}
Inventory.__index = Inventory

function Inventory.new(ctx)
    local self = setmetatable({ Context = ctx }, Inventory)
    ctx.UI:Register("Inventory", function(parent, state) self:RenderInventory(parent, state) end)
    ctx.UI:Register("Shop", function(parent, state) self:RenderShop(parent, state) end)
    ctx.UI:Register("Collection", function(parent, state) self:RenderCollection(parent, state) end)
    return self
end

function Inventory:SortedItems(items)
    local result = {}
    for uid, entry in pairs(items or {}) do table.insert(result, { Uid = uid, Entry = entry }) end
    table.sort(result, function(a, b)
        local ac, bc = self.Context.Config.Items[a.Entry.ItemId], self.Context.Config.Items[b.Entry.ItemId]
        local ar = if ac then self.Context.Config.Rarities[ac.Rarity].Rank else 0
        local br = if bc then self.Context.Config.Rarities[bc.Rarity].Rank else 0
        if ar ~= br then return ar > br end
        return tostring(a.Uid) < tostring(b.Uid)
    end)
    return result
end

function Inventory:Sell(uid, spec)
    local payout = math.floor(spec.Value * self.Context.Config.Economy.SellMultiplier)
    self.Context.UI:Confirm("Sell " .. spec.Name .. "?", spec.Rarity .. " • $" .. W.Number(payout)
        .. "\nThis permanently exchanges the item for cash. Stand at the orange SELL SHOP to complete the sale.", function()
        self.Context:Request("Gameplay", "RequestSell", uid, true)
    end)
end

function Inventory:ItemCard(parent, uid, entry, mode)
    local spec = self.Context.Config.Items[entry.ItemId]
    local card = W.Card(parent, if mode == "Carry" then 76 else 120)
    if not spec then
        W.Text(card, "Archived item", 25, W.Colors.Muted)
        W.Text(card, "This saved item needs a matching catalog entry.", 32, W.Colors.Muted, 13)
        return
    end
    local rarity = self.Context.Config.Rarities[spec.Rarity]
    W.Text(card, spec.Name, 25, W.Color(rarity.Color), 18)
    W.Text(card, spec.Rarity .. "  •  $" .. W.Number(spec.Value) .. "  •  " .. tostring(spec.Weight) .. " weight", 22, W.Colors.Muted, 13)
    if mode == "Carry" then return end
    if mode == "Shop" then
        W.Button(card, "Sell for $" .. W.Number(spec.Value * self.Context.Config.Economy.SellMultiplier), function() self:Sell(uid, spec) end)
    else
        W.Actions(card, "Place at home", function() self.Context.House:Begin(uid) end,
            "Sell at shop", function() self:Sell(uid, spec) end)
    end
end

function Inventory:RenderInventory(parent, state)
    if not state or not state.Profile then W.Text(parent, "Loading inventory...", 45); return end
    local carry = state.Runtime.Carry or {}
    W.Text(parent, "CARRIED LOOT • UNSECURED", 30, W.Colors.Orange, 17)
    W.Text(parent, "Police can confiscate your haul. Return to your HOME beacon before selling or displaying it.", 46, W.Colors.Muted, 14)
    if #carry == 0 then W.Text(parent, "Your backpack is empty. Enter a house and hold the STEAL prompt near an item.", 52, W.Colors.Muted) end
    for _, entry in ipairs(carry) do self:ItemCard(parent, entry.UniqueId, entry, "Carry") end
    if #carry > 0 then W.Button(parent, "Secure haul (stand at HOME)", function() self.Context:Request("Gameplay", "RequestEscape") end) end
    local stored = self:SortedItems(state.Profile.Inventory)
    W.Text(parent, "HOME STORAGE • " .. #stored .. " ITEMS", 34, W.Colors.Teal, 17)
    if #stored == 0 then W.Text(parent, "Bring a successful haul home to start your collection.", 48, W.Colors.Muted) end
    for _, item in ipairs(stored) do self:ItemCard(parent, item.Uid, item.Entry, "Storage") end
end

function Inventory:RenderShop(parent, state)
    if not state or not state.Profile then return end
    W.Text(parent, "SELL SHOP", 32, W.Colors.Orange, 21)
    W.Text(parent, "Stand at the orange shop in the town square to sell secured items. Displayed items must first be picked up in House. Carrying loot? Secure it at home first.", 74, W.Colors.Muted, 14)
    local stored = self:SortedItems(state.Profile.Inventory)
    if #stored == 0 then W.Text(parent, "No secured items to sell yet.", 44, W.Colors.Muted) end
    for _, item in ipairs(stored) do self:ItemCard(parent, item.Uid, item.Entry, "Shop") end
    W.Text(parent, "UPGRADES", 32, W.Colors.Teal, 19)
    local backpack = state.Profile.Backpack.Level
    local tool = state.Profile.Tools.LockpickLevel
    for _, row in ipairs({ { "Backpack", self.Context.Config.Backpacks, backpack }, { "Tool", self.Context.Config.Tools, tool } }) do
        local nextTier = row[2][row[3] + 1]
        local card = W.Card(parent, 122)
        W.Text(card, row[1] .. "  •  Level " .. row[3], 25, W.Colors.Text, 18)
        if nextTier then
            local detail = if row[1] == "Backpack" then tostring(nextTier.Capacity) .. " capacity" else "Counters stronger security"
            W.Text(card, nextTier.Name .. "  •  " .. detail .. "  •  Requires level " .. nextTier.RequiredLevel, 25, W.Colors.Muted, 13)
            W.Button(card, "Upgrade • $" .. W.Number(nextTier.Cost), function() self.Context:Request("Gameplay", "RequestUpgrade", row[1]) end)
        else W.Text(card, "Maximum level reached.", 45, W.Colors.Teal) end
    end
end

function Inventory:RenderCollection(parent, state)
    if not state or not state.Profile then return end
    local profile = state.Profile
    local ids = {}
    local found, total = 0, 0
    for id, spec in pairs(self.Context.Config.Items) do
        total += 1
        if profile.Collection[id] then found += 1 end
        if spec.Rarity ~= "Secret" or profile.Collection[id] then table.insert(ids, id) end
    end
    W.Text(parent, "COLLECTION BOOK  •  " .. found .. " / " .. total, 33, W.Colors.Teal, 20)
    W.Text(parent, "Discover items by stealing and escaping. Secret treasures stay hidden until discovered.", 45, W.Colors.Muted, 14)
    table.sort(ids, function(a, b)
        local sa, sb = self.Context.Config.Items[a], self.Context.Config.Items[b]
        local ra, rb = self.Context.Config.Rarities[sa.Rarity].Rank, self.Context.Config.Rarities[sb.Rarity].Rank
        if ra ~= rb then return ra > rb end
        return sa.Name < sb.Name
    end)
    for _, id in ipairs(ids) do
        local spec = self.Context.Config.Items[id]
        local discovered = profile.Collection[id]
        local card = W.Card(parent, 75)
        W.Text(card, if discovered then spec.Name else "??? • " .. spec.Rarity, 25,
            if discovered then W.Color(self.Context.Config.Rarities[spec.Rarity].Color) else W.Colors.Muted, 18)
        W.Text(card, if discovered then spec.Rarity .. " • " .. spec.Category .. " • $" .. W.Number(spec.Value) else "Undiscovered • Explore higher districts", 25, W.Colors.Muted, 13)
    end
end

return Inventory
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">NotificationController</string>
            <string name="Source"><![CDATA[--!nonstrict
local TweenService = game:GetService("TweenService")
local W = require(script.Parent.Widgets)
local Notifications = {}
Notifications.__index = Notifications

function Notifications.new(ctx)
    local self = setmetatable({ Context = ctx, Queue = {} }, Notifications)
    self.Container = W.Make("Frame", { BackgroundTransparency = 1, Position = UDim2.new(1, -12, 0, 178),
        AnchorPoint = Vector2.new(1, 0), Size = UDim2.new(0.9, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, ZIndex = 60 }, ctx.UI.Gui)
    W.Make("UISizeConstraint", { MaxSize = Vector2.new(390, 600) }, self.Container)
    W.Make("UIListLayout", { Padding = UDim.new(0, 7), HorizontalAlignment = Enum.HorizontalAlignment.Right }, self.Container)
    return self
end

function Notifications:Push(text, kind, force, overrideColor)
    local settings = self.Context.State and self.Context.State.Profile.Settings or {}
    if settings.Notifications == false and not force and kind ~= "Error" and kind ~= "Alarm" then return end
    if type(text) == "table" then text = text.Text or text.Message or "Notification" end
    text = tostring(text)
    local color = overrideColor or (if kind == "Error" or kind == "Alarm" then W.Colors.Danger elseif kind == "Warning" then W.Colors.Orange else W.Colors.Teal)
    local toast = W.Make("TextLabel", { BackgroundColor3 = W.Colors.Panel, BorderSizePixel = 0,
        Text = text, TextColor3 = color, Font = Enum.Font.GothamMedium, TextSize = 15, TextWrapped = true,
        Size = UDim2.new(1, 0, 0, 65), ZIndex = 60 }, self.Container)
    W.Round(toast, 10)
    W.Make("UIStroke", { Color = color, Thickness = 1, Transparency = 0.5 }, toast)
    W.Make("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }, toast)
    table.insert(self.Queue, toast)
    if #self.Queue > 3 then local old = table.remove(self.Queue, 1); old:Destroy() end
    if not settings.ReducedEffects then
        toast.TextTransparency, toast.BackgroundTransparency = 1, 1
        TweenService:Create(toast, TweenInfo.new(0.18), { TextTransparency = 0, BackgroundTransparency = 0.03 }):Play()
    end
    task.delay(if force then 7 else 4, function()
        local index = table.find(self.Queue, toast)
        if index then table.remove(self.Queue, index) end
        if toast.Parent then toast:Destroy() end
    end)
end

function Notifications:Rare(data)
    if type(data) ~= "table" then return end
    local rarity = self.Context.Config.Rarities[data.Rarity]
    self:Push(tostring(data.Rarity or "Rare") .. " FIND!  " .. tostring(data.Name or data.ItemId)
        .. "  •  $" .. W.Number(data.Value) .. "\nEscape and return home to secure it.", "Rare", true, if rarity then W.Color(rarity.Color) else nil)
    self.Context.Audio:Play("Rare")
end

return Notifications
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">ProgressionController</string>
            <string name="Source"><![CDATA[--!nonstrict
local W = require(script.Parent.Widgets)
local Progression = {}
Progression.__index = Progression

function Progression.new(ctx)
    local self = setmetatable({ Context = ctx }, Progression)
    ctx.UI:Register("Quests", function(parent, state) self:Quests(parent, state) end)
    ctx.UI:Register("Settings", function(parent, state) self:Settings(parent, state) end)
    ctx.UI:Register("Leaderboard", function(parent, state) self:Leaderboard(parent, state) end)
    return self
end

function Progression:QuestRows(parent, rows, heading)
    W.Text(parent, heading, 31, W.Colors.Teal, 19)
    for _, quest in ipairs(rows or {}) do
        local card = W.Card(parent, if quest.Claimed then 86 else 122)
        local progress, target = tonumber(quest.Progress) or 0, tonumber(quest.Target) or 1
        W.Text(card, quest.Name .. "  •  " .. (if quest.Claimed then "CLAIMED" else tostring(math.min(progress, target)) .. "/" .. target), 28,
            if quest.Complete then W.Colors.Teal else W.Colors.Text, 17)
        local reward = quest.Reward or {}
        W.Text(card, "$" .. W.Number(reward.Cash) .. "  +  " .. W.Number(reward.XP) .. " XP", 22, W.Colors.Orange, 13)
        if not quest.Claimed then
            local button = W.Button(card, if quest.Complete then "Claim reward" else "In progress", function()
                if quest.Complete then self.Context:Request("Quests", "RequestQuestClaim", quest.Id) end
            end)
            if not quest.Complete then button.TextColor3, button.Selectable = W.Colors.Muted, false end
        end
    end
end

function Progression:Quests(parent, state)
    if not state or not state.Profile then return end
    local q = state.Quests
    if not q then W.Text(parent, "Quest state is loading...", 50); return end
    W.Text(parent, "LEVEL " .. tostring(q.Level or state.Profile.Level) .. "  •  " .. tostring(q.XP or state.Profile.XP) .. " / " .. tostring(q.XPRequired or "--") .. " XP", 31, W.Colors.Orange, 18)
    local daily = q.DailyReward
    if daily then
        local card = W.Card(parent, 133)
        W.Text(card, "DAILY REWARD  •  DAY " .. daily.Day, 28, W.Colors.Teal, 18)
        local bonus = if daily.ItemId and self.Context.Config.Items[daily.ItemId] then " + " .. self.Context.Config.Items[daily.ItemId].Name elseif daily.Theme then " + " .. daily.Theme .. " theme" else ""
        W.Text(card, "$" .. W.Number(daily.Cash) .. " + " .. W.Number(daily.XP) .. " XP" .. bonus, 34, W.Colors.Text, 14)
        local minutes = math.ceil((daily.SecondsRemaining or 0) / 60)
        W.Button(card, if daily.CanClaim then "Claim today's reward" else "Next reward in " .. minutes .. " min", function()
            if daily.CanClaim then self.Context:Request("Quests", "RequestDailyClaim") end
        end)
    end
    if q.Tutorial and not q.Tutorial.Complete then W.Text(parent, "FIRST HEIST  " .. q.Tutorial.Step .. "/" .. (q.Tutorial.Total or 5) .. "  •  " .. q.Tutorial.Text, 55, W.Colors.Teal, 14) end
    self:QuestRows(parent, q.Daily, "DAILY MISSIONS")
    self:QuestRows(parent, q.Weekly, "WEEKLY MISSIONS")
    self:QuestRows(parent, q.Achievements, "ACHIEVEMENTS")
end

function Progression:Settings(parent, state)
    if not state or not state.Profile then return end
    W.Text(parent, "MAKE IT YOURS", 34, W.Colors.Teal, 21)
    local settings = state.Profile.Settings or {}
    for _, setting in ipairs({ { "Music", "Music" }, { "SFX", "Sound effects" }, { "Notifications", "Notifications" },
        { "CameraShake", "Camera shake" }, { "ReducedEffects", "Reduced visual effects" } }) do
        W.Button(parent, setting[2] .. "  •  " .. (if settings[setting[1]] then "ON" else "OFF"), function()
            self.Context:Request("Settings", "RequestSetting", setting[1], not settings[setting[1]])
        end)
    end
    W.Text(parent, "CONTROLS", 33, W.Colors.Orange, 19)
    W.Text(parent, "Keyboard: hold E to interact • Shift to sprint • Tab for inventory.\nPlacement: mouse + R + Enter, or arrow keys. Esc cancels.\nTouch: hold interaction prompts; use the placement arrows.\nGamepad: X to interact • L3 sprint • Start inventory. Placement: left stick / D-pad, RB rotate, A place, B cancel.", 145, W.Colors.Muted, 14)
    W.Text(parent, "Sound only plays when the developer has configured licensed audio assets. Server controls cash, items and progression.", 62, W.Colors.Muted, 13)
end

function Progression:Leaderboard(parent, state)
    if not state then return end
    local leaderboard = state.Leaderboard or {}
    local live = leaderboard.Live or leaderboard
    W.Text(parent, "RICHEST HOMES • THIS SERVER", 34, W.Colors.Teal, 20)
    for rank, entry in ipairs(live) do
        local card = W.Card(parent, 75)
        W.Text(card, "#" .. rank .. "  " .. tostring(entry.Name or entry.DisplayName or "Player"), 28, if rank == 1 then W.Colors.Orange else W.Colors.Text, 18)
        W.Text(card, "Home $" .. W.Number(entry.HouseValue) .. "  •  Cash $" .. W.Number(entry.Cash)
            .. "  •  " .. W.Number(entry.ItemsStolen) .. " steals", 25, W.Colors.Muted, 13)
    end
    if leaderboard.PersistenceEnabled then
        W.Text(parent, "GLOBAL HOUSE VALUE • SAVED SCORES", 34, W.Colors.Orange, 18)
        local global = leaderboard.Global and leaderboard.Global.HouseValue or {}
        if #global == 0 then W.Text(parent, "Global scores update after successful profile saves.", 50, W.Colors.Muted, 14) end
        for rank, entry in ipairs(global) do W.Text(parent, "#" .. rank .. "  Player " .. entry.UserId .. "  •  $" .. W.Number(entry.Value), 33, W.Colors.Text, 15) end
    else W.Text(parent, "Global scores are available in a published game with persistence enabled.", 56, W.Colors.Muted, 14) end
end

return Progression
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">RobberyController</string>
            <string name="Source"><![CDATA[--!nonstrict
local TweenService = game:GetService("TweenService")
local W = require(script.Parent.Widgets)
local Robbery = {}
Robbery.__index = Robbery

function Robbery.new(ctx)
    local self = setmetatable({ Context = ctx }, Robbery)
    self.AlarmBorder = W.Make("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -6, 1, -6),
        Position = UDim2.fromOffset(3, 3), Visible = false, ZIndex = 70 }, ctx.UI.Gui)
    self.Stroke = W.Make("UIStroke", { Color = W.Colors.Danger, Thickness = 5, Transparency = 0.2 }, self.AlarmBorder)
    return self
end

function Robbery:Heat(data)
    local heat = if type(data) == "table" then data.Heat else data
    self.Context.UI:UpdateHeat(heat)
end

function Robbery:Alarm(text)
    self.Context.Notifications:Push(text or "ALARM! Escape before the police reach you.", "Alarm", true)
    self.Context.Audio:Play("Alarm")
    local state = self.Context.State
    if state and state.Profile.Settings.ReducedEffects then return end
    self.Generation = (self.Generation or 0) + 1
    local generation = self.Generation
    self.AlarmBorder.Visible, self.Stroke.Transparency = true, 0.05
    TweenService:Create(self.Stroke, TweenInfo.new(0.35, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, 5, true), { Transparency = 0.9 }):Play()
    self.Context.Camera:Shake(0.8)
    task.delay(4.2, function() if self.Generation == generation then self.AlarmBorder.Visible = false end end)
end

return Robbery
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="65">
          <Properties>
            <string name="Name">UIController</string>
            <string name="Source"><![CDATA[--!nonstrict
local Players = game:GetService("Players")
local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")
local HttpService = game:GetService("HttpService")
local W = require(script.Parent.Widgets)
local C = W.Colors
local UI = {}
UI.__index = UI

function UI.new(ctx)
    local self = setmetatable({ Context = ctx, Builders = {}, ActiveMenu = nil }, UI)
    self.Gui = W.Make("ScreenGui", { Name = "StealAHouseUI", ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 10 }, Players.LocalPlayer:WaitForChild("PlayerGui"))
    local hud = W.Make("Frame", { Size = UDim2.new(1, -24, 0, 98), Position = UDim2.fromOffset(12, 10),
        BackgroundColor3 = C.Background, BackgroundTransparency = 0.08, BorderSizePixel = 0 }, self.Gui)
    W.Round(hud, 14)
    self.Brand = W.Text(hud, "STEAL A HOUSE", 27, C.Teal, 19)
    self.Brand.Position, self.Brand.Size = UDim2.fromOffset(12, 5), UDim2.new(0.6, -12, 0, 27)
    self.Connection = W.Text(hud, "Loading your home...", 24, C.Muted, 12)
    self.Connection.Position, self.Connection.Size, self.Connection.TextXAlignment = UDim2.new(0.55, 0, 0, 7), UDim2.new(0.45, -12, 0, 24), Enum.TextXAlignment.Right
    self.Stats = {}
    for i, label in ipairs({ "CASH", "GEMS", "LEVEL", "HOME VALUE" }) do
        local stat = W.Text(hud, label .. "  --", 27, if i == 1 then C.Orange else C.Text, 14)
        stat.Size, stat.Position = UDim2.new(0.25, -12, 0, 27), UDim2.new((i - 1) * 0.25, 12, 0, 35)
        self.Stats[i] = stat
    end
    self.HeatBar, self.HeatText = self:Meter(hud, 0, C.Danger, "HEAT 0 / 100")
    self.BagBar, self.BagText = self:Meter(hud, 0.5, C.Teal, "BAG 0 / 5")
    self.Objective = W.Make("TextLabel", { Position = UDim2.fromOffset(12, 117), Size = UDim2.new(1, -24, 0, 51),
        BackgroundColor3 = C.Panel, BorderSizePixel = 0, TextColor3 = C.Text, Font = Enum.Font.GothamMedium,
        TextSize = 14, TextWrapped = true, Text = "STEAL. ESCAPE. BUILD. PROTECT." }, self.Gui)
    W.Round(self.Objective)
    self.Tabs = W.Make("ScrollingFrame", { BackgroundColor3 = C.Background, BorderSizePixel = 0,
        Size = UDim2.new(1, -24, 0, 56), Position = UDim2.new(0, 12, 1, -67),
        CanvasSize = UDim2.new(0, 700, 0, 0), ScrollBarThickness = 3, ScrollingDirection = Enum.ScrollingDirection.X,
        ScrollBarImageColor3 = C.Teal }, self.Gui)
    W.Round(self.Tabs)
    self.TabButtons = {}
    for i, name in ipairs({ "Inventory", "House", "Shop", "Collection", "Quests", "Settings", "Leaderboard" }) do
        local button = W.Button(self.Tabs, name, function() self:ToggleMenu(name) end)
        button.Size, button.Position = UDim2.fromOffset(94, 42), UDim2.fromOffset(5 + (i - 1) * 99, 5)
        self.TabButtons[name] = button
    end
    self.Menu = W.Make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.53),
        Size = UDim2.fromOffset(680, 520), BackgroundColor3 = C.Panel, BorderSizePixel = 0, Visible = false }, self.Gui)
    W.Round(self.Menu, 14)
    W.Make("UIStroke", { Color = C.Stroke, Thickness = 1 }, self.Menu)
    self.Title = W.Text(self.Menu, "Inventory", 42, C.Teal, 22)
    self.Title.Size, self.Title.Position = UDim2.new(1, -85, 0, 42), UDim2.fromOffset(18, 4)
    local close = W.Button(self.Menu, "X", function() self:CloseMenu() end)
    close.Size, close.Position = UDim2.fromOffset(40, 34), UDim2.new(1, -49, 0, 8)
    self.Content = W.List(self.Menu, true)
    self.Content.Position, self.Content.Size = UDim2.fromOffset(15, 56), UDim2.new(1, -30, 1, -69)
    self.Loading = W.Make("TextLabel", { BackgroundColor3 = C.Background, BackgroundTransparency = 0.05,
        Size = UDim2.fromScale(1, 1), TextColor3 = C.Teal, Font = Enum.Font.GothamBold, TextSize = 26,
        Text = "STEAL A HOUSE\n\nLoading your home and collection...", TextWrapped = true, ZIndex = 20 }, self.Gui)
    task.delay(15, function()
        if self.Loading.Parent and self.Loading.Visible then self.Loading.Text = "STEAL A HOUSE\n\nStill loading. Waiting for the server..." end
    end)
    local function resize()
        local camera = workspace.CurrentCamera
        local size = if camera then camera.ViewportSize else Vector2.new(1024, 768)
        self.Menu.Size = UDim2.fromOffset(math.min(680, size.X - 24), math.max(130, math.min(530, size.Y - 210)))
        self.Tabs.CanvasSize = UDim2.fromOffset(math.max(700, size.X - 24), 0)
        for _, stat in ipairs(self.Stats) do stat.TextSize = if size.X < 500 then 11 else 15 end
    end
    local camera = workspace.CurrentCamera
    if camera then camera:GetPropertyChangedSignal("ViewportSize"):Connect(resize) end
    workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
        camera = workspace.CurrentCamera
        if camera then camera:GetPropertyChangedSignal("ViewportSize"):Connect(resize) end
        resize()
    end)
    resize()
    return self
end

function UI:Meter(parent, column, color, text)
    local label = W.Text(parent, text, 18, C.Muted, 11)
    label.Size, label.Position = UDim2.new(0.5, -24, 0, 18), UDim2.new(column, 12, 0, 64)
    local track = W.Make("Frame", { BackgroundColor3 = C.Raised, BorderSizePixel = 0,
        Size = UDim2.new(0.5, -24, 0, 5), Position = UDim2.new(column, 12, 0, 85) }, parent)
    W.Round(track, 4)
    local bar = W.Make("Frame", { BackgroundColor3 = color, Size = UDim2.fromScale(0, 1), BorderSizePixel = 0 }, track)
    W.Round(bar, 4)
    return bar, label
end

function UI:Register(name, builder) self.Builders[name] = builder end

function UI:MenuSignature()
    local state = self.Context.State
    if not state or not state.Profile then return "Loading" end
    local p, r = state.Profile, state.Runtime or {}
    local data
    if self.ActiveMenu == "Inventory" then data = { p.Inventory, r.Carry }
    elseif self.ActiveMenu == "Shop" then data = { p.Inventory, p.Backpack, p.Tools }
    elseif self.ActiveMenu == "House" then data = { p.House, p.OwnedThemes }
    elseif self.ActiveMenu == "Collection" then data = p.Collection
    elseif self.ActiveMenu == "Settings" then data = p.Settings
    elseif self.ActiveMenu == "Leaderboard" then
        local board = state.Leaderboard or {}
        data = { board.Live or board, board.Global, board.PersistenceEnabled }
    else
        data = table.clone(state.Quests or {})
        if data.DailyReward then
            data.DailyReward = table.clone(data.DailyReward)
            data.DailyReward.SecondsRemaining = math.ceil((data.DailyReward.SecondsRemaining or 0) / 60)
        end
    end
    local ok, encoded = pcall(function() return HttpService:JSONEncode(data) end)
    return if ok then encoded else nil
end

function UI:RenderMenu()
    if not self.ActiveMenu then return end
    -- Heat snapshots must not destroy a button while a touch press is held.
    local signature = self:MenuSignature()
    if signature and self.Signature == signature then return end
    self.Signature = signature
    local oldY = self.Content.CanvasPosition.Y
    local selected = GuiService.SelectedObject
    local restoreFocus = selected and selected:IsDescendantOf(self.Menu)
    W.Clear(self.Content)
    local builder = self.Builders[self.ActiveMenu]
    if builder then builder(self.Content, self.Context.State) else W.Text(self.Content, "Waiting for your profile...", 55) end
    self.Content.CanvasPosition = Vector2.new(0, oldY)
    if not self.Modal and (restoreFocus or UserInputService.GamepadEnabled) then
        for _, child in ipairs(self.Content:GetDescendants()) do
            if child:IsA("TextButton") and child.Visible then GuiService.SelectedObject = child; break end
        end
    end
end

function UI:ToggleMenu(name)
    if self.ActiveMenu == name then self:CloseMenu(); return end
    if self.Context.House and self.Context.House.Active then self.Context.House:Cancel() end
    self.ActiveMenu, self.Menu.Visible, self.Objective.Visible = name, true, false
    self.Signature = nil
    self.Title.Text = name:upper()
    for tab, button in pairs(self.TabButtons) do button.TextColor3 = if tab == name then C.Teal else C.Text end
    self.Content.CanvasPosition = Vector2.zero
    self:RenderMenu()
end

function UI:CloseMenu()
    self.ActiveMenu, self.Menu.Visible, self.Objective.Visible = nil, false, true
    if GuiService.SelectedObject and GuiService.SelectedObject:IsDescendantOf(self.Menu) then GuiService.SelectedObject = nil end
    for _, button in pairs(self.TabButtons) do button.TextColor3 = C.Text end
end

function UI:Confirm(title, text, callback)
    if self.Modal then self.Modal:Destroy() end
    local overlay = W.Make("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(),
        BackgroundTransparency = 0.28, Text = "", AutoButtonColor = false, ZIndex = 50 }, self.Gui)
    self.Modal = overlay
    local card = W.Card(overlay, 212)
    card.AnchorPoint, card.Position, card.Size = Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5), UDim2.new(0.86, 0, 0, 212)
    W.Make("UISizeConstraint", { MaxSize = Vector2.new(460, 212) }, card)
    card.ZIndex = 51
    W.Text(card, title, 33, C.Orange, 22)
    W.Text(card, text, 83, C.Text, 15)
    local function close()
        overlay:Destroy()
        if self.Modal == overlay then self.Modal = nil end
        if UserInputService.GamepadEnabled then
            GuiService.SelectedObject = if self.ActiveMenu then self.Menu:FindFirstChildWhichIsA("TextButton", true) else nil
        end
    end
    local accept = W.Actions(card, "Confirm sale", function() close(); callback() end, "Keep item", close)
    if UserInputService.GamepadEnabled then GuiService.SelectedObject = accept end
end

function UI:OnSnapshot(state)
    local p, r = state.Profile, state.Runtime or {}
    if not p then return end
    self.Loading.Visible = false
    self.Stats[1].Text = "CASH $" .. W.Number(p.Cash)
    self.Stats[2].Text = "GEMS " .. W.Number(p.Gems)
    self.Stats[3].Text = "LEVEL " .. tostring(p.Level)
    self.Stats[4].Text = "HOME $" .. W.Number(p.House.HouseValue)
    self.Connection.Text = if r.DataWritable == false then "Profile read-only"
        elseif r.DataStatus == "StudioMemory" then "Studio • temporary"
        elseif r.DataStatus == "Persistent" then "Persistent profile" else tostring(r.DataStatus or "Connected")
    self:UpdateHeat(r.Heat or 0)
    local weight, capacity = r.CarryWeight or 0, r.Capacity or 5
    self.BagText.Text = "BACKPACK  " .. weight .. " / " .. capacity
    self.BagBar.Size = UDim2.fromScale(math.clamp(weight / math.max(1, capacity), 0, 1), 1)
    local robbery = r.Robbery or {}
    local quest = state.Quests
    if robbery.Active then
        self.Objective.Text = "HEIST: " .. tostring(robbery.TargetName or robbery.TargetHouse or "House") .. "  |  Grab loot, avoid police, return to your HOME beacon to secure it."
    elseif #((r.Carry) or {}) > 0 then
        self.Objective.Text = "YOUR HAUL IS AT RISK  |  Return to your HOME beacon to secure these items."
    elseif quest and quest.Tutorial and not quest.Tutorial.Complete then
        self.Objective.Text = "FIRST HEIST  " .. tostring(quest.Tutorial.Step or 1) .. "/5  |  " .. tostring(quest.Tutorial.Text)
    else self.Objective.Text = "STEAL. ESCAPE. BUILD. PROTECT.  |  Enter a district house. Return home to secure loot. Sell at the orange shop." end
    if r.Event then
        local event = if type(r.Event) == "table" then r.Event.Name or r.Event.Id else r.Event
        self.Brand.Text = "STEAL A HOUSE  /  " .. tostring(event)
    else self.Brand.Text = "STEAL A HOUSE" end
    self:RenderMenu()
end

function UI:UpdateHeat(heat)
    heat = math.clamp(tonumber(heat) or 0, 0, 100)
    local status = if heat >= 81 then "CRITICAL" elseif heat >= 61 then "WANTED" elseif heat >= 41 then "ALERT" elseif heat >= 21 then "SUSPICIOUS" else "SAFE"
    self.HeatText.Text = "HEAT " .. math.floor(heat) .. " / 100  " .. status
    self.HeatBar.Size = UDim2.fromScale(heat / 100, 1)
    self.HeatBar.BackgroundColor3 = if heat > 60 then C.Danger elseif heat > 20 then C.Orange else C.Teal
end

return UI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="66">
          <Properties>
            <string name="Name">Widgets</string>
            <string name="Source"><![CDATA[--!nonstrict
-- UI construction and formatting only; no economy state is changed here.
local Widgets = {}
Widgets.Colors = {
    Background = Color3.fromRGB(13, 21, 34), Panel = Color3.fromRGB(22, 34, 51),
    Raised = Color3.fromRGB(31, 46, 65), Stroke = Color3.fromRGB(56, 75, 95),
    Text = Color3.fromRGB(237, 245, 250), Muted = Color3.fromRGB(161, 181, 197),
    Teal = Color3.fromRGB(66, 228, 196), Orange = Color3.fromRGB(255, 182, 83),
    Danger = Color3.fromRGB(255, 104, 128),
}

function Widgets.Make(className, properties, parent)
    local instance = Instance.new(className)
    for key, value in pairs(properties) do instance[key] = value end
    instance.Parent = parent
    return instance
end

function Widgets.Round(parent, radius)
    Widgets.Make("UICorner", { CornerRadius = UDim.new(0, radius or 10) }, parent)
end

function Widgets.Text(parent, text, height, color, size)
    return Widgets.Make("TextLabel", {
        BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, height or 24),
        Text = tostring(text), TextColor3 = color or Widgets.Colors.Text,
        Font = Enum.Font.GothamMedium, TextSize = size or 16, TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, parent)
end

function Widgets.Button(parent, text, callback, color)
    local button = Widgets.Make("TextButton", {
        Size = UDim2.new(1, 0, 0, 38), BackgroundColor3 = color or Widgets.Colors.Raised,
        Text = text, TextColor3 = Widgets.Colors.Text, Font = Enum.Font.GothamBold,
        TextSize = 15, TextWrapped = true, AutoButtonColor = true, Selectable = true,
    }, parent)
    Widgets.Round(button, 8)
    button.Activated:Connect(callback)
    return button
end

function Widgets.Card(parent, height)
    local card = Widgets.Make("Frame", {
        Size = UDim2.new(1, -4, 0, height or 112), BackgroundColor3 = Widgets.Colors.Raised,
        BorderSizePixel = 0,
    }, parent)
    Widgets.Round(card)
    Widgets.Make("UIPadding", {
        PaddingTop = UDim.new(0, 9), PaddingBottom = UDim.new(0, 9),
        PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12),
    }, card)
    Widgets.Make("UIListLayout", { Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder }, card)
    return card
end

function Widgets.List(parent, scrolling)
    local list = Widgets.Make(if scrolling then "ScrollingFrame" else "Frame", {
        BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), BorderSizePixel = 0,
    }, parent)
    if scrolling then
        list.AutomaticCanvasSize = Enum.AutomaticSize.Y
        list.CanvasSize = UDim2.new()
        list.ScrollBarThickness = 4
        list.ScrollBarImageColor3 = Widgets.Colors.Teal
        list.ScrollingDirection = Enum.ScrollingDirection.Y
    else
        list.Size = UDim2.new(1, 0, 0, 0)
        list.AutomaticSize = Enum.AutomaticSize.Y
    end
    Widgets.Make("UIListLayout", { Padding = UDim.new(0, 9), SortOrder = Enum.SortOrder.LayoutOrder }, list)
    return list
end

function Widgets.Clear(parent)
    for _, child in ipairs(parent:GetChildren()) do
        if child:IsA("GuiObject") then child:Destroy() end
    end
end

function Widgets.Number(number)
    number = tonumber(number) or 0
    local abs = math.abs(number)
    for _, suffix in ipairs({ {1e9, "B"}, {1e6, "M"}, {1e3, "K"} }) do
        if abs >= suffix[1] then return string.format("%.1f%s", number / suffix[1], suffix[2]) end
    end
    return tostring(math.floor(number))
end

function Widgets.Color(hex)
    if typeof(hex) == "Color3" then return hex end
    if type(hex) == "string" then
        local clean = hex:gsub("#", "")
        if #clean == 6 then
            return Color3.fromRGB(tonumber(clean:sub(1, 2), 16) or 255,
                tonumber(clean:sub(3, 4), 16) or 255, tonumber(clean:sub(5, 6), 16) or 255)
        end
    end
    return Widgets.Colors.Muted
end

function Widgets.Actions(parent, leftText, leftCallback, rightText, rightCallback)
    local frame = Widgets.Make("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 38) }, parent)
    local left = Widgets.Button(frame, leftText, leftCallback)
    left.Size = UDim2.new(if rightText then 0.5 else 1, if rightText then -4 else 0, 1, 0)
    if rightText then
        local right = Widgets.Button(frame, rightText, rightCallback)
        right.Position, right.Size = UDim2.new(0.5, 4, 0, 0), UDim2.new(0.5, -4, 1, 0)
    end
    return left
end

return Widgets
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
