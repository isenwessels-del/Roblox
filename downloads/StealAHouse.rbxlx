    { Name = "Drone Scrambler", Cost = 1000000, RequiredLevel = 12, DetectionReduction = 3 },
    { Name = "AI Decoy", Cost = 4000000, RequiredLevel = 16, DetectionReduction = 3.5 },
    { Name = "Vault Decoder", Cost = 15000000, RequiredLevel = 20, DetectionReduction = 4 },
    { Name = "Quantum Lockpick", Cost = 60000000, RequiredLevel = 25, DetectionReduction = 4.5 },
}
]]></string>
